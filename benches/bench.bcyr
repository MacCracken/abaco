}

# One window sample. The periodic rows run at (16, 63), which is the same
# phase as the symmetric (16, 64) — periodic(n, N) is symmetric(n, N + 1) bit
# for bit — so each pair times the same arithmetic through the shared core.
fn _bench_window_hann() {
    window_hann(16, 64);
    return 0;
}

fn _bench_window_hann_periodic() {
    window_hann_periodic(16, 63);
    return 0;
}

fn _bench_window_hamming() {
    window_hamming(16, 64);
    return 0;
}

fn _bench_window_hamming_periodic() {
    window_hamming_periodic(16, 63);
    return 0;
}

fn _bench_window_blackman() {
    window_blackman(16, 64);
    return 0;
}

fn _bench_window_blackman_periodic() {
    window_blackman_periodic(16, 63);
    return 0;
}

fn _bench_window_kaiser() {
    window_kaiser(16, 64, f64_from(8));
    return 0;
}

fn _bench_window_kaiser_periodic() {
    window_kaiser_periodic(16, 63, f64_from(8));
    return 0;
}

# 2.7.0: the new windows (one sample, as above), the window metrics on a
# 1024-sample periodic Blackman-Harris, and the RBJ biquad: a peaking design,
# one response point, and 256 samples through the section.
fn _bench_window_nuttall() {
    window_nuttall(16, 64);
    return 0;
}

fn _bench_window_blackman_harris() {
    window_blackman_harris(16, 64);
    return 0;
}

fn _bench_window_flattop() {
    window_flattop(16, 64);
    return 0;
}

fn _bench_window_bartlett() {
    window_bartlett(16, 64);
    return 0;
}

fn _bench_window_tukey() {
    window_tukey(5, 64, f64_div(f64_from(1), f64_from(2)));
    return 0;
}

fn _bench_window_gaussian() {
    window_gaussian(16, 64, f64_from(8));
    return 0;
}

var _bench_win = 0;
var _bench_bq = 0;
var _bench_bq_state = 0;
var _bench_bq_buf = 0;
var _bench_bq_out = 0;

fn _bench_dsp_setup() {
    _bench_win = alloc(1024 * 8);
    var i = 0;
    while (i < 1024) {
        store64(_bench_win + i * 8, window_blackman_harris_periodic(i, 1024));
        i = i + 1;
    }
    _bench_bq = alloc(40);
    biquad_design(_bench_bq, DSP_BQ_PEAK, f64_from(1000), f64_from(48000), f64_from(2), f64_from(6));
    _bench_bq_state = alloc(16);
    store64(_bench_bq_state, 0);
    store64(_bench_bq_state + 8, 0);
    _bench_bq_buf = alloc(256 * 8);
    _bench_bq_out = alloc(256 * 8);
    i = 0;
    while (i < 256) {
        store64(_bench_bq_buf + i * 8, f64_div(f64_from((i % 17) - 8), f64_from(8)));
        i = i + 1;
    }
    return 0;
}

fn _bench_window_enbw_1024() {
    window_enbw(_bench_win, 1024);
    return 0;
}

fn _bench_window_scalloping_1024() {
    window_scalloping_loss(_bench_win, 1024);
    return 0;
}

fn _bench_biquad_design_peak() {
    var c = alloc(40);
    biquad_design(c, DSP_BQ_PEAK, f64_from(1000), f64_from(48000), f64_from(2), f64_from(6));
    return 0;
}

fn _bench_biquad_response() {
    biquad_response(_bench_bq, f64_from(20), f64_from(48000));
    return 0;
}

fn _bench_biquad_process_256() {
    biquad_process(_bench_bq, _bench_bq_state, _bench_bq_buf, _bench_bq_out, 256);
    return 0;
}

# 2.8.0: the FFT at 1024 points (complex forward / inverse, real forward /
# inverse, one Hann-windowed STFT frame), the twiddle table, and the two
# spectra over the 513 bins of a 1024-point real transform.
var _bench_fft_tw = 0;
var _bench_fft_re = 0;
var _bench_fft_im = 0;
var _bench_fft_x = 0;
var _bench_fft_w = 0;
var _bench_fft_out = 0;

fn _bench_fft_setup() {
    _bench_fft_tw = alloc(1024 * 8);
    fft_twiddles(_bench_fft_tw, 1024);
    _bench_fft_re = alloc(1024 * 8);
    _bench_fft_im = alloc(1024 * 8);
    _bench_fft_x = alloc(1024 * 8);
    _bench_fft_w = alloc(1024 * 8);
    _bench_fft_out = alloc(1024 * 8);
    var i = 0;
    while (i < 1024) {
        var v = f64_div(f64_from((i * 37) % 101 - 50), f64_from(50));
        store64(_bench_fft_re + i * 8, v);
        store64(_bench_fft_im + i * 8, f64_neg(v));
        store64(_bench_fft_x + i * 8, v);
        store64(_bench_fft_w + i * 8, window_hann_periodic(i, 1024));
        i = i + 1;
    }
    return 0;
}

fn _bench_fft_twiddles_1024() {
    fft_twiddles(_bench_fft_tw, 1024);
    return 0;
}

# fft then ifft, so the data stays bounded over the iterations.
fn _bench_fft_ifft_1024() {
    fft(_bench_fft_re, _bench_fft_im, 1024, _bench_fft_tw, 1024);
    ifft(_bench_fft_re, _bench_fft_im, 1024, _bench_fft_tw, 1024);
    return 0;
}

fn _bench_rfft_1024() {
    rfft(_bench_fft_x, _bench_fft_re, _bench_fft_im, 1024, _bench_fft_tw, 1024);
    return 0;
}

fn _bench_stft_frame_1024() {
    stft_frame(_bench_fft_x, 1024, 0, _bench_fft_w, 1024, _bench_fft_re, _bench_fft_im, _bench_fft_tw, 1024);
    return 0;
}

fn _bench_magnitude_spectrum_513() {
    magnitude_spectrum(_bench_fft_re, _bench_fft_im, _bench_fft_out, 513);
    return 0;
}

fn _bench_power_spectrum_513() {
    power_spectrum(_bench_fft_re, _bench_fft_im, _bench_fft_out, 513);
    return 0;
}

