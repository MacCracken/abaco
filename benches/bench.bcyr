# ================================================================
# batch benchmarks (4096 samples)
# ================================================================

var BATCH_SIZE = 4096;
var _batch_buf = 0;

# Pre-fill a buffer of 4096 f64 samples: (i/4096)*2 - 1 => [-1, +1)
fn batch_init() {
    _batch_buf = alloc(BATCH_SIZE * 8);
    var denom = f64_from(BATCH_SIZE);
    var two = f64_from(2);
    var one = f64_from(1);
    var i = 0;
    while (i < BATCH_SIZE) {
        var v = f64_sub(f64_mul(f64_div(f64_from(i), denom), two), one);
        store64(_batch_buf + i * 8, v);
        i = i + 1;
    }
    return 0;
}

fn _bench_batch_sanitize() {
    var i = 0;
    while (i < BATCH_SIZE) {
        sanitize_sample(load64(_batch_buf + i * 8));
        i = i + 1;
    }
    return 0;
}

fn _bench_batch_poly_blep() {
    var dt = f64_div(f64_from(1), f64_from(100));
    var i = 0;
    while (i < BATCH_SIZE) {
        var v = f64_abs(load64(_batch_buf + i * 8));
        poly_blep(v, dt);
        i = i + 1;
    }
    return 0;
}

fn _bench_batch_hypot() {
    var i = 0;
    while (i < BATCH_SIZE - 1) {
        var a = load64(_batch_buf + i * 8);
        var b = load64(_batch_buf + (i + 1) * 8);
        f64_hypot(a, b);
        i = i + 2;
    }
    return 0;
}

fn _bench_batch_sqrt() {
    var r = 0;
    var i = 0;
    while (i < BATCH_SIZE) {
        r = f64_sqrt(f64_abs(load64(_batch_buf + i * 8)));
        i = i + 1;
    }
    return r;
}

fn _bench_batch_round() {
    var i = 0;
    while (i < BATCH_SIZE) {
        var v = f64_mul(load64(_batch_buf + i * 8), f64_from(100));
        f64_round_half_away(v);
        i = i + 1;
    }
    return 0;
}

var _batch_buf2 = 0;
var _batch_dst = 0;

fn batch2_init() {
    _batch_buf2 = alloc(BATCH_SIZE * 8);
    _batch_dst = alloc(BATCH_SIZE * 8);
    var denom = f64_from(BATCH_SIZE);
    var i = 0;
    while (i < BATCH_SIZE) {
        store64(_batch_buf2 + i * 8, f64_div(f64_from(i + 1), denom));
        i = i + 1;
    }
    return 0;
}

# SIMD batch benchmarks
fn _bench_simd_add_4096() {
    f64v_add(_batch_dst, _batch_buf, _batch_buf2, BATCH_SIZE);
    return 0;
}

fn _bench_simd_mul_4096() {
    f64v_mul(_batch_dst, _batch_buf, _batch_buf2, BATCH_SIZE);
    return 0;
}

fn _bench_simd_sub_4096() {
    f64v_sub(_batch_dst, _batch_buf, _batch_buf2, BATCH_SIZE);
    return 0;
}

fn _bench_batch_mac_4096() {
    var i = 0;
    while (i < BATCH_SIZE) { store64(_batch_dst + i * 8, f64_from(0)); i = i + 1; }
    batch_mac(_batch_dst, _batch_buf, _batch_buf2, BATCH_SIZE);
    return 0;
}

fn _bench_simd_div_4096() {
    f64v_div(_batch_dst, _batch_buf, _batch_buf2, BATCH_SIZE);
    return 0;
}

fn _bench_simd_sqrt_4096() {
    f64v_sqrt(_batch_dst, _batch_buf, BATCH_SIZE);
    return 0;
}

fn _bench_simd_abs_4096() {
    f64v_abs(_batch_dst, _batch_buf, BATCH_SIZE);
    return 0;
}

# Whole 1024-sample Kaiser windows (beta 8), I0(beta) hoisted.
fn _bench_kaiser_fill_1024() {
    window_kaiser_fill(_batch_dst, 1024, f64_from(8));
    return 0;
}

fn _bench_kaiser_periodic_fill_1024() {
    window_kaiser_periodic_fill(_batch_dst, 1024, f64_from(8));
    return 0;
}

var BATCH_ITERS = 1000;

fn run_batch_benches() {
    println("--- batch scalar (4096 samples) ---");
    batch_init();

    var b = bench_new("sanitize_4096");
    bench_run(b, &_bench_batch_sanitize, BATCH_ITERS);
    bench_report(b);

    b = bench_new("poly_blep_4096");
    bench_run(b, &_bench_batch_poly_blep, BATCH_ITERS);
    bench_report(b);

    b = bench_new("hypot_4096");
    bench_run(b, &_bench_batch_hypot, BATCH_ITERS);
    bench_report(b);

    b = bench_new("sqrt_4096");
    bench_run(b, &_bench_batch_sqrt, BATCH_ITERS);
    bench_report(b);

    b = bench_new("round_4096");
    bench_run(b, &_bench_batch_round, BATCH_ITERS);
    bench_report(b);

    println("--- batch SIMD (4096 samples) ---");
    batch2_init();

    b = bench_new("simd_add_4096");
    bench_run(b, &_bench_simd_add_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_mul_4096");
    bench_run(b, &_bench_simd_mul_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_sub_4096");
    bench_run(b, &_bench_simd_sub_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_mac_4096");
    bench_run(b, &_bench_batch_mac_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_div_4096");
    bench_run(b, &_bench_simd_div_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_sqrt_4096");
    bench_run(b, &_bench_simd_sqrt_4096, BATCH_ITERS);
    bench_report(b);

    b = bench_new("simd_abs_4096");
    bench_run(b, &_bench_simd_abs_4096, BATCH_ITERS);
    bench_report(b);

    println("--- windows (1024 samples) ---");

    b = bench_new("kaiser_fill_1024");
    bench_run(b, &_bench_kaiser_fill_1024, BATCH_ITERS);
    bench_report(b);

    b = bench_new("kaiser_periodic_fill_1024");
    bench_run(b, &_bench_kaiser_periodic_fill_1024, BATCH_ITERS);
    bench_report(b);

    return 0;
}

# ================================================================
# main
# ================================================================

fn main() {
    alloc_init();
    println("=== abaco benchmarks ===");
    run_ntheory_benches();
    run_dsp_benches();
    run_core_benches();
    run_batch_benches();
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
