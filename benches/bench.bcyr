fn _bench_poly_blep_mid() {
    var half = f64_div(f64_from(1), f64_from(2));
    var dt = f64_div(f64_from(1), f64_from(100));
    poly_blep(half, dt);
    return 0;
}

fn _bench_poly_blep_edge() {
    var t = f64_div(f64_from(5), f64_from(1000));
    var dt = f64_div(f64_from(1), f64_from(100));
    poly_blep(t, dt);
    return 0;
}

fn _bench_angular_freq() {
    angular_frequency(f64_from(1000), f64_from(44100));
    return 0;
}

fn _bench_sanitize_finite() {
    sanitize_sample(f64_from(42));
    return 0;
}

fn _bench_sanitize_nan() {
    sanitize_sample(0x7FF8000000000000);
    return 0;
}

fn _bench_hypot() {
    f64_hypot(f64_from(3), f64_from(4));
    return 0;
}

fn _bench_lerp() {
    var half = f64_div(f64_from(1), f64_from(2));
    f64_lerp(f64_from(0), f64_from(100), half);
    return 0;
}

fn _bench_clamp() {
    f64_clamp(f64_from(5), f64_from(0), f64_from(10));
    return 0;
}

# Not `_bench_round`: lib/bench.cyr took that name at Cyrius 6.6.5 for its own
# `_bench_round(ps)`, and a same-name fn of a different arity is a compile
# error, so this file stopped building at the 6.6.12 pin (CHANGELOG 2.4.7).
fn _bench_round_half_away() {
    f64_round_half_away(f64_div(f64_from(37), f64_from(10)));
    return 0;
}

# The builtins' values are returned, not dropped: from Cyrius 6.7.17 a statement
# that discards a value builtin's result (`f64_sqrt(x);`) is a compile error.
fn _bench_sqrt() {
    return f64_sqrt(f64_from(2));
}

fn _bench_abs() {
    return f64_abs(f64_neg(f64_from(42)));
}

fn _bench_amp_to_db() {
    amplitude_to_db(f64_div(f64_from(1), f64_from(2)));
    return 0;
}

fn _bench_db_to_amp() {
    db_to_amplitude(f64_neg(f64_from(6)));
    return 0;
}

fn _bench_db_gain() {
    db_gain_factor(f64_from(12));
    return 0;
}

fn _bench_midi_to_freq() {
    midi_to_freq(f64_from(69));
    return 0;
}

fn _bench_freq_to_midi() {
    freq_to_midi(f64_from(440));
    return 0;
}

fn _bench_pitch_class() {
    freq_to_pitch_class(f64_from(435));
    return 0;
}

fn _bench_time_const() {
    time_constant(f64_from(10), f64_from(44100));
    return 0;
}

fn _bench_pan_center() {
    var l = alloc(8);
    var r = alloc(8);
    constant_power_pan(f64_from(0), l, r);
