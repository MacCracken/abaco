[package]
name = "abaco"
version = "${file:VERSION}"
description = "Math engine — expression evaluation, unit conversion, DSP math"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/abaco"
language = "cyrius"
cyrius = "6.6.12"

[build]
entry = "src/main.cyr"
output = "build/abaco"

[lib]
modules = [
    "src/core.cyr",
    "src/ntheory.cyr",
    "src/dsp.cyr",
    "src/eval.cyr",
    "src/units.cyr",
    "src/ai.cyr",
]

[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "tagged",
    "hashmap",
    "fnptr",
    "math",
    "ganita",
    "io",
    "net",
    "http",
    "bayan",
]
