# abaco::core — Core types: Value, Unit, UnitCategory, conversion results.

# ASCII case helpers — thin aliases onto stdlib (Cyrius 4.8.5+).
# Kept under the short `str_lower` / `str_upper` names for backwards
# compatibility with pre-4.8.5 abaco call sites; new code can call the
# stdlib forms directly.
fn str_lower(s) { return str_lower_cstr(s); }
fn str_upper(s) { return str_upper_cstr(s); }

# --- Value tags ---
# Value is a tagged struct: { tag, data1, data2 }
#   INTEGER:  tag=0, data1=i64 value,           data2=unused
#   FLOAT:    tag=1, data1=f64 (as bits),        data2=unused
#   FRACTION: tag=2, data1=numerator (i64),      data2=denominator (i64)
#   COMPLEX:  tag=3, data1=real (f64 bits),      data2=imag (f64 bits)
#   TEXT:     tag=4, data1=Str pointer,           data2=unused

enum ValueTag { INTEGER; FLOAT; FRACTION; COMPLEX; TEXT; }

struct Value { tag; data1; data2; }

# --- Value constructors ---

# Build a Value wrapping an i64 integer.
fn Value_integer(n) {
    var v = alloc(24);
    store64(v, INTEGER);
    store64(v + 8, n);
    store64(v + 16, 0);
    return v;
}

# Build a Value wrapping an f64 (bit pattern).
fn Value_float(f) {
    var v = alloc(24);
    store64(v, FLOAT);
    store64(v + 8, f);
    store64(v + 16, 0);
    return v;
}

# Build a Value as the exact fraction num/den (both i64).
fn Value_fraction(num, den) {
    var v = alloc(24);
    store64(v, FRACTION);
    store64(v + 8, num);
    store64(v + 16, den);
    return v;
}

# Build a Value as a complex number re + im*i (both f64 bit patterns).
fn Value_complex(re, im) {
    var v = alloc(24);
    store64(v, COMPLEX);
    store64(v + 8, re);
    store64(v + 16, im);
    return v;
}

# Build a Value wrapping a text cstring (caller owns the string).
fn Value_text(s) {
    var v = alloc(24);
    store64(v, TEXT);
    store64(v + 8, s);
    store64(v + 16, 0);
    return v;
}

# --- Value accessors ---

fn Value_tag(self) { return load64(self); }
fn Value_data1(self) { return load64(self + 8); }
fn Value_data2(self) { return load64(self + 16); }

# Convert to f64 bits, returning Ok(bits) or Err(0).
# INTEGER / FLOAT / FRACTION succeed; COMPLEX and TEXT cannot convert.
fn Value_as_f64(self) {
    var t = load64(self);
    var d1 = load64(self + 8);
    var d2 = load64(self + 16);

    if (t == INTEGER) {
        return Ok(f64_from(d1));
    }
    if (t == FLOAT) {
        return Ok(d1);
    }
    if (t == FRACTION) {
        if (d2 == 0) { return Err(0); }
        var num_f = f64_from(d1);
        var den_f = f64_from(d2);
        return Ok(f64_div(num_f, den_f));
    }
    # Complex and Text cannot convert
    return Err(0);
}

# Render the value as a LaTeX cstring. `\frac{n}{d}` for fractions,
# `a + bi` for complex, `\text{...}` for text.
# Value_to_latex's output buffer. The widest numeric output is COMPLEX with both
# parts in SCIENTIFIC notation and a 4-digit negative exponent — e.g.
# Value_complex(-1e-300, -1e-300) renders 55 bytes, 56 with the NUL: 26 for the
# signed real part (sign + "1" + "." + 6 decimals + " \\times 10^{" + 4 + "}"),
# 3 for the separator, 25 for the imaginary part (unsigned, since it is
# f64_abs'd), and 1 for the trailing "i". The fixed pair is SHORTER at 51 — the
# 1e16 cutoff caps that path at 16 integer digits, which is why the scientific
# path wins. 128 leaves better than 2x headroom.
#
# ⚠ The WRITE high-water is above the output length: fmt_int_buf renders
# backward from a 23-byte scratch base, so a COMPLEX render touches ~72 bytes.
# Still inside the allocation, but that 72 — not the 56 — is the figure to size
# against if this buffer is ever shrunk.
#
# TEXT is bounded against this same allocation below; it is the only branch
# whose output length the caller controls.
var ABACO_LATEX_BUF = 128;

# Decimal places Value_to_latex renders a non-whole float with. Six matches
# lib/fmt.cyr's own fmt_float default and keeps the 128-byte buffer safe: the
# widest output is sign + 19 integer digits + '.' + 6 = 27 bytes.
var ABACO_LATEX_DECIMALS = 6;

# Non-finite tests on the raw f64 bit pattern — exponent field all ones.
# Same idiom as dsp.cyr's is_finite / ai.cyr's exp_mask check.
fn _val_nonfinite(bits) {
    if (((bits >> 52) & 0x7FF) == 0x7FF) { return 1; }
    return 0;
}

fn _val_is_nan(bits) {
    if (_val_nonfinite(bits) == 0) { return 0; }
    if ((bits & 0x000FFFFFFFFFFFFF) != 0) { return 1; }
    return 0;
}

# Fixed-decimal rendering has two blind spots, and LaTeX has a good answer for
# both. lib/fmt.cyr's fmt_float_buf guards Inf/NaN but still does
# f64_to(f64_floor(val)) for finite input, which saturates to i64_MIN once
# |x| >= 2^63 — so delegating to it unguarded would render 1e300 as
# "-9223372036854775808.000000". (2.4.3 did not even reach fmt_float_buf; its
# general path printed the bare integer "-9223372036854775808".) At the other
# end, six decimals turn every |x| < 1e-6 into "0.000000", which reads as zero
# for a value that is not.
#
# Both switch to m x 10^{e}: e = floor(log10|x|), m = x / 10^e, so 1 <= |m| < 10.
# Rounding m to 6 places can carry it to 10.0 (e.g. 9.9999999e20), which is why
# the renormalisation below is not optional.
var ABACO_LATEX_SCI_HI = 0x4341C37937E08000;   # 1e16 — fixed notation past here is unwieldy
var ABACO_LATEX_SCI_LO = 0x3EB0C6F7A0B5ED8D;   # 1e-6 — below this, 6 decimals show nothing
var ABACO_LATEX_SCALE_UP = 0x7E37E43C8800759C;   # 1e300 — pre-scale for subnormals, see _val_sci_at

fn _val_needs_sci(bits) {
    if (f64_eq(bits, f64_from(0)) == 1) { return 0; }
    var m = f64_abs(bits);
    if (f64_ge(m, ABACO_LATEX_SCI_HI) == 1) { return 1; }
    if (f64_lt(m, ABACO_LATEX_SCI_LO) == 1) { return 1; }
    return 0;
}

fn _val_sci_at(buf, v) {
    # log10 via ln(x)/ln(10) — the same idiom src/eval.cyr uses for the
    # evaluator's own log10(), since the toolchain has no f64_log10 builtin.
    var e = f64_to(f64_floor(f64_div(f64_ln(f64_abs(v)), f64_ln(f64_from(10)))));
    var p10 = f64_pow(f64_from(10), f64_from(e));
    var m = f64_div(v, p10);
    # 10^e itself underflows to +0 for e <= -324, and dividing by it gives Inf —
    # so the two smallest subnormals rendered as "inf \\times 10^{-323}", a
    # finite number printed as infinity, in the very function this release
    # rewrote to stop printing garbage for finite floats. Scale the value up by
    # 10^300 first (any subnormal lands well inside normal range) and divide by
    # 10^(e+300), which is representable. Same trick src/eval.cyr's _div_pow10
    # uses one module away.
    if (f64_eq(p10, f64_from(0)) == 1) {
        m = f64_div(f64_mul(v, ABACO_LATEX_SCALE_UP),
          f64_pow(f64_from(10), f64_from(e + 300)));
    }
    # Renormalise if the mantissa fell outside [1, 10). Two error sources land
    # here: floor(ln|x|/ln 10) can be off by one near a power of ten, and
    # f64_pow(10, e) is inexact for large e, so v/10^e can come back a hair off.
    # Both bounds are DISPLAY-aware, and that is the load-bearing part. Exact
    # [1, 10) bounds do not work: for 1e300 the ln-based log10 undershoots, so
    # e comes back as 299 and m as 9.99999999999900528 — which satisfies
    # NEITHER |m| >= 10 nor |m| < 1, so no exact-bounds version fires at all and
    # the mantissa prints as "10.000000" beside an exponent of 299. The margin
    # is half an ulp of the last displayed digit (5e-7 at six decimals): a
    # mantissa that RENDERS as 10.000000 must carry, and one that renders as
    # 1.000000 must not. The arms are mutually exclusive so a carry cannot be
    # undone by the arm below it.
    var margin = f64_div(f64_from(5), f64_from(10000000));
    var mag_m = f64_abs(m);
    if (f64_ge(mag_m, f64_sub(f64_from(10), margin)) == 1) {
        m = f64_div(m, f64_from(10));
        e = e + 1;
    } else {
        if (f64_lt(mag_m, f64_sub(f64_from(1), margin)) == 1) {
            m = f64_mul(m, f64_from(10));
            e = e - 1;
        }
    }
    var pos = fmt_float_buf(m, buf, ABACO_LATEX_DECIMALS);
    memcpy(buf + pos, " \\times 10^{", 12);
    pos = pos + 12;
    pos = pos + fmt_int_buf(e, buf + pos);
    store8(buf + pos, 125);
    return pos + 1;
}

# Render one f64 at buf and return the length written: LaTeX symbols for the
# non-finite rows, m x 10^{e} for magnitudes fixed notation cannot show, plain
# fixed decimals otherwise. FLOAT and COMPLEX both go through this — at 2.4.4's
# first cut only FLOAT did, which left COMPLEX still printing i64_MIN for a
# 1e300 part and 0.000000 for a 1e-9 one, exactly the bug being fixed.
fn _val_num_at(buf, v) {
    if (_val_nonfinite(v) == 1) {
        if (_val_is_nan(v) == 1) { memcpy(buf, "\\mathrm{NaN}", 12); return 12; }
        # BRACED, not bare. TeX scans a control word greedily over letters, so a
        # bare \infty followed by the COMPLEX branch's "i" becomes the single
        # undefined macro \inftyi and the document fails to typeset. The
        # \mathrm{NaN} row is already safe — its closing brace terminates it.
        if ((v >> 63) & 1 == 1) { memcpy(buf, "{-\\infty}", 9); return 9; }
        memcpy(buf, "{\\infty}", 8);
        return 8;
    }
    if (_val_needs_sci(v) == 1) { return _val_sci_at(buf, v); }
    return fmt_float_buf(v, buf, ABACO_LATEX_DECIMALS);
}

fn Value_to_latex(self) {
    var t = load64(self);
    var d1 = load64(self + 8);
    var d2 = load64(self + 16);
    var buf = alloc(ABACO_LATEX_BUF);
    if (t == INTEGER) {
        var len = fmt_int_buf(d1, buf);
        store8(buf + len, 0);
        return buf;
    }
    if (t == FLOAT) {
        # Non-finite first. f64_to saturates to i64_MIN for +Inf, -Inf and NaN
        # alike, and fmt_int_buf then renders that literally as
        # -9223372036854775808 — through 2.4.3 every infinity and NaN came out
        # as that number. LaTeX has real symbols, so emit them.
        if (_val_nonfinite(d1) == 1) {
            var nfl = _val_num_at(buf, d1);
            store8(buf + nfl, 0);
            return buf;
        }
        # Magnitudes fixed notation cannot show sensibly go to m x 10^{e}. This
        # sits AHEAD of the whole-number branch: 1e17 round-trips through i64
        # perfectly well and would otherwise print as 18 digits and a ".0".
        if (_val_needs_sci(d1) == 1) {
            var scl = _val_sci_at(buf, d1);
            store8(buf + scl, 0);
            return buf;
        }
        # Whole numbers keep the N.0 form.
        var i = f64_to(d1);
        if (f64_eq(d1, f64_from(i)) == 1) {
            var len = fmt_int_buf(i, buf);
            store8(buf + len, 46);
            store8(buf + len + 1, 48);
            store8(buf + len + 2, 0);
            return buf;
        }
        # General float. Through 2.4.3 this printed fmt_int_buf(f64_to(d1)) —
        # the integer part ONLY, so 0.25 rendered as "0", -0.25 as "0" (losing
        # the sign as well as the fraction) and 3.75 as "3". Delegate to
        # fmt_float_buf, which is sign-correct and, since Cyrius 6.5.30,
        # carry-correct when the rounded fraction reaches a full unit.
        var flen = _val_num_at(buf, d1);
        store8(buf + flen, 0);
        return buf;
    }
    if (t == FRACTION) {
        # \frac{num}{den}
        memcpy(buf, "\\frac{", 6);
        var pos = 6;
        pos = pos + fmt_int_buf(d1, buf + pos);
        memcpy(buf + pos, "}{", 2);
        pos = pos + 2;
        pos = pos + fmt_int_buf(d2, buf + pos);
        store8(buf + pos, 125);
        store8(buf + pos + 1, 0);
        return buf;
    }
    if (t == COMPLEX) {
        # Same defect as the FLOAT branch above, and fixed the same way: both
        # parts went through f64_to and printed their integer part only, so
        # 1.5 + 2.5i rendered as "1 + 2i". The sign test now reads the f64
        # directly rather than a truncated i64 — f64_to(-0.5) is 0, which took
        # the "+" arm and printed "0 + 0i" for a negative imaginary part.
        var pos = _val_num_at(buf, d1);
        var im = d2;
        # Sign BIT, not f64_lt: f64_lt(-0, 0) is 0, so a negative-zero imaginary
        # part took the "+" arm while keeping its sign bit, and fmt_float_buf
        # then emitted its own "-" — printing "1.000000 + -0.000000i". Same
        # idiom _val_nonfinite and lib/fmt.cyr use.
        if (((d2 >> 63) & 1) == 1) {
            memcpy(buf + pos, " - ", 3);
            im = f64_abs(d2);
        } else {
            memcpy(buf + pos, " + ", 3);
        }
        pos = pos + 3;
        pos = pos + _val_num_at(buf + pos, im);
        store8(buf + pos, 105);
        store8(buf + pos + 1, 0);
        return buf;
    }
    if (t == TEXT) {
        memcpy(buf, "\\text{", 6);
        var slen = strlen(d1);
        # Bound the copy. This wrote the caller's string into a 128-byte buffer
        # with no length check, so any TEXT value longer than 120 bytes ran off
        # the end of the allocation — the caller controls that string. Pre-dates
        # 2.4.4; found while rewriting the numeric branches, and fixed here
        # rather than left in a function this release rewrites. Truncation, not
        # rejection: this is a display helper, and the 8 bytes reserved are
        # "\\text{" (6) + "}" + NUL.
        var room = ABACO_LATEX_BUF - 8;
        if (slen > room) { slen = room; }
        memcpy(buf + 6, d1, slen);
        store8(buf + 6 + slen, 125);
        store8(buf + 6 + slen + 1, 0);
        return buf;
    }
    store8(buf, 0);
    return buf;
}

# --- UnitCategory ---
# Represented as integer constants

enum UnitCategory {
    CAT_LENGTH;
    CAT_MASS;
    CAT_TEMPERATURE;
    CAT_TIME;
    CAT_DATASIZE;
    CAT_SPEED;
    CAT_AREA;
    CAT_VOLUME;
    CAT_ENERGY;
    CAT_PRESSURE;
    CAT_ANGLE;
    CAT_FREQUENCY;
    CAT_FORCE;
    CAT_POWER;
    CAT_FUELECONOMY;
    CAT_DENSITY;
    CAT_LUMINOSITY;
    CAT_VISCOSITY;
    CAT_PITCH;
}

var UNIT_CATEGORY_COUNT = 19;

# Returns category name as a string pointer
# Dense switch: 18 cases (0-17), jump table on 1.7.7+
fn category_name(cat) {
    switch (cat) {
        case 0: return "Length";
        case 1: return "Mass";
        case 2: return "Temperature";
        case 3: return "Time";
        case 4: return "Data Size";
        case 5: return "Speed";
        case 6: return "Area";
        case 7: return "Volume";
        case 8: return "Energy";
        case 9: return "Pressure";
        case 10: return "Angle";
        case 11: return "Frequency";
        case 12: return "Force";
        case 13: return "Power";
        case 14: return "Fuel Economy";
        case 15: return "Density";
        case 16: return "Luminosity";
        case 17: return "Viscosity";
        case 18: return "Pitch";
        default: return "Unknown";
    }
}

# Parse category from string, returns category id or -1 on error
fn category_from_str(s) {
    if (streq(s, "length") == 1) { return CAT_LENGTH; }
    if (streq(s, "mass") == 1) { return CAT_MASS; }
    if (streq(s, "weight") == 1) { return CAT_MASS; }
    if (streq(s, "temperature") == 1) { return CAT_TEMPERATURE; }
    if (streq(s, "temp") == 1) { return CAT_TEMPERATURE; }
    if (streq(s, "time") == 1) { return CAT_TIME; }
    if (streq(s, "datasize") == 1) { return CAT_DATASIZE; }
    if (streq(s, "data_size") == 1) { return CAT_DATASIZE; }
    if (streq(s, "data") == 1) { return CAT_DATASIZE; }
    if (streq(s, "speed") == 1) { return CAT_SPEED; }
    if (streq(s, "velocity") == 1) { return CAT_SPEED; }
    if (streq(s, "area") == 1) { return CAT_AREA; }
    if (streq(s, "volume") == 1) { return CAT_VOLUME; }
    if (streq(s, "energy") == 1) { return CAT_ENERGY; }
    if (streq(s, "pressure") == 1) { return CAT_PRESSURE; }
    if (streq(s, "angle") == 1) { return CAT_ANGLE; }
    if (streq(s, "frequency") == 1) { return CAT_FREQUENCY; }
    if (streq(s, "freq") == 1) { return CAT_FREQUENCY; }
    if (streq(s, "force") == 1) { return CAT_FORCE; }
    if (streq(s, "power") == 1) { return CAT_POWER; }
    if (streq(s, "wattage") == 1) { return CAT_POWER; }
    if (streq(s, "fueleconomy") == 1) { return CAT_FUELECONOMY; }
    if (streq(s, "fuel_economy") == 1) { return CAT_FUELECONOMY; }
    if (streq(s, "fuel") == 1) { return CAT_FUELECONOMY; }
    if (streq(s, "mpg") == 1) { return CAT_FUELECONOMY; }
    if (streq(s, "density") == 1) { return CAT_DENSITY; }
    if (streq(s, "luminosity") == 1) { return CAT_LUMINOSITY; }
    if (streq(s, "light") == 1) { return CAT_LUMINOSITY; }
    if (streq(s, "illuminance") == 1) { return CAT_LUMINOSITY; }
    if (streq(s, "viscosity") == 1) { return CAT_VISCOSITY; }
    if (streq(s, "pitch") == 1) { return CAT_PITCH; }
    if (streq(s, "semitones") == 1) { return CAT_PITCH; }
    if (streq(s, "cents") == 1) { return CAT_PITCH; }
    return 0 - 1;
}

# --- Unit struct ---
# Unit { name (Str), symbol (Str), category (i64), to_base_factor (f64),
#        to_base_offset (f64), to_base_inverse (i64 bool) }

struct Unit { name; symbol; category; to_base_factor; to_base_offset; to_base_inverse; }

# Build a linear unit: base_val = (value + offset) * factor.
# Temperature uses a non-zero offset (°C ↔ K); most units use offset 0.
fn Unit_new(name, symbol, category, to_base_factor, to_base_offset) {
    var u = alloc(48);
    store64(u, name);
    store64(u + 8, symbol);
    store64(u + 16, category);
    store64(u + 24, to_base_factor);
    store64(u + 32, to_base_offset);
    store64(u + 40, 0);
    return u;
}

# Build a reciprocal unit: base_val = factor / value (e.g. L/100km).
fn Unit_new_inverse(name, symbol, category, to_base_factor) {
    var u = alloc(48);
    store64(u, name);
    store64(u + 8, symbol);
    store64(u + 16, category);
    store64(u + 24, to_base_factor);
    store64(u + 32, 0);
    store64(u + 40, 1);
    return u;
}

# Unit accessors
fn Unit_name(self) { return load64(self); }
fn Unit_symbol(self) { return load64(self + 8); }
fn Unit_category(self) { return load64(self + 16); }
fn Unit_factor(self) { return load64(self + 24); }
fn Unit_offset(self) { return load64(self + 32); }
fn Unit_inverse(self) { return load64(self + 40); }

# --- ConversionResult ---
# { from_value (f64), from_unit (Str), to_value (f64), to_unit (Str) }

struct ConversionResult { from_value; from_unit; to_value; to_unit; }

# Build a conversion result pairing input value+unit with output value+unit.
fn ConversionResult_new(from_value, from_unit, to_value, to_unit) {
    var r = alloc(32);
    store64(r, from_value);
    store64(r + 8, from_unit);
    store64(r + 16, to_value);
    store64(r + 24, to_unit);
    return r;
}

fn ConversionResult_from_value(self) { return load64(self); }
fn ConversionResult_from_unit(self) { return load64(self + 8); }
fn ConversionResult_to_value(self) { return load64(self + 16); }
fn ConversionResult_to_unit(self) { return load64(self + 24); }

# --- Currency ---
# { code (Str), name (Str), symbol (Str) }

struct Currency { code; name; symbol; }

# Build a Currency record (ISO code, full name, display symbol).
fn Currency_new(code, name, symbol) {
    var c = alloc(24);
    store64(c, code);
    store64(c + 8, name);
    store64(c + 16, symbol);
    return c;
}

fn Currency_code(self) { return load64(self); }
fn Currency_name(self) { return load64(self + 8); }
fn Currency_symbol(self) { return load64(self + 16); }
