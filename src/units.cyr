    reg_alias(r, "lb/ft3", "lb/ft3");
    reg_alias(r, "fc", "fc");
    reg_alias(r, "semi", "semi");
    reg_alias(r, "oct", "oct");
    # Lowercase spellings of SI symbols, exact case only. Left out because
    # the spelling is another unit: b, kb, mb, gb, ... (bits), mhz (mHz),
    # mj (mJ), mw (MW or mW), kn (knot), p (pico), t (tesla).
    reg_spelling(r, "c", "C");
    reg_spelling(r, "f", "F");
    reg_spelling(r, "k", "K");
    reg_spelling(r, "l", "L");
    reg_spelling(r, "ml", "mL");
    reg_spelling(r, "j", "J");
    reg_spelling(r, "kj", "kJ");
    reg_spelling(r, "wh", "Wh");
    reg_spelling(r, "kwh", "kWh");
    reg_spelling(r, "pa", "Pa");
    reg_spelling(r, "kpa", "kPa");
    reg_spelling(r, "hz", "Hz");
    reg_spelling(r, "khz", "kHz");
    reg_spelling(r, "ghz", "GHz");
    reg_spelling(r, "n", "N");
    reg_spelling(r, "w", "W");
    reg_spelling(r, "kw", "kW");
    reg_spelling(r, "km/l", "km/L");
    reg_spelling(r, "l/100km", "L/100km");
    reg_spelling(r, "g/ml", "g/mL");
    reg_spelling(r, "kg/l", "kg/L");
    reg_spelling(r, "cp", "cP");
    reg_spelling(r, "pas", "Pas");
    reg_spelling(r, "mpas", "mPas");
    # Tempo / audio
    reg_alias(r, "bpm", "bpm");
    reg_alias(r, "bpms", "bpm");
    reg_alias(r, "beats_per_min", "bpm");
    # Pitch
    reg_alias(r, "semitones", "semi");
    reg_alias(r, "cents", "cent");
    reg_alias(r, "octaves", "oct");
    # Temperature
    reg_alias(r, "degc", "C");
    reg_alias(r, "degf", "F");
    reg_alias(r, "centigrade", "C");
    # Length (British singulars; the plural strip covers "metres" etc.)
    reg_alias(r, "metre", "m");
    reg_alias(r, "kilometre", "km");
    reg_alias(r, "centimetre", "cm");
    reg_alias(r, "millimetre", "mm");
    reg_alias(r, "feet", "ft");
    reg_alias(r, "inches", "in");
    # Mass
    reg_alias(r, "kilogramme", "kg");
    reg_alias(r, "gramme", "g");
    reg_alias(r, "lbs", "lb");
    reg_alias(r, "pounds", "lb");
    reg_alias(r, "ounces", "oz");
    reg_alias(r, "tonne", "t");
    # Speed
    reg_alias(r, "kph", "km/h");
    reg_alias(r, "kmh", "km/h");
    reg_alias(r, "kmph", "km/h");
    reg_alias(r, "knots", "kn");
    # Time
    reg_alias(r, "seconds", "s");
    reg_alias(r, "sec", "s");
    reg_alias(r, "minutes", "min");
    reg_alias(r, "hours", "hr");
    reg_alias(r, "hrs", "hr");
    reg_alias(r, "days", "d");
    reg_alias(r, "weeks", "wk");
    reg_alias(r, "years", "yr");
    reg_alias(r, "yrs", "yr");
    # Volume
    reg_alias(r, "litre", "L");
    reg_alias(r, "litres", "L");
    reg_alias(r, "millilitre", "mL");
    reg_alias(r, "millilitres", "mL");
