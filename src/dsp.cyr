# abaco::dsp — DSP math primitives: windows, interpolation, dB/MIDI, SIMD batch ops.
# Requires Cyrius 4.10.2+ (transcendentals, SIMD, stdlib math utilities).

# -- Constants (as f64 bit patterns) --
# TAU = 2 * pi = 6.283185307179586
# Mathematical constants — alias onto stdlib `lib/math.cyr`.
# Kept under the `DSP_*` names so existing call sites don't churn; new code
# can use the stdlib names directly.
var DSP_TAU          = F64_TAU;
var DSP_PI           = F64_PI;
var DSP_PI_4         = F64_PI_4;
var DSP_PI_2         = F64_PI_2;
var DSP_FRAC_1_SQRT2 = F64_FRAC_1_SQRT2;
# Domain-specific constants (not in stdlib).
var DSP_A4_FREQ      = 0x407B_8000_0000_0000;   # 440.0 Hz
var DSP_A4_MIDI      = 0x4051_4000_0000_0000;   # 69.0
var DSP_SEMITONES    = 0x4028_0000_0000_0000;   # 12.0

# -- Angular frequency --
# w0 = 2*pi * freq_hz / sample_rate
# Used in biquad filter coefficient design
fn angular_frequency(freq_hz, sample_rate) {
    return f64_div(f64_mul(DSP_TAU, freq_hz), sample_rate);
}

# -- PolyBLEP correction --
# Reduces aliasing in saw/square/pulse waveforms
# t = normalized phase (0.0-1.0), dt = phase increment (freq/sample_rate)
# All values are f64 bit patterns
fn poly_blep(t, dt) {
    var zero = f64_from(0);
    var one = f64_from(1);
    var two = f64_from(2);
    if (f64_gt(dt, zero) == 0) { return zero; }
    if (f64_lt(t, dt) == 1) {
        # Just past discontinuity: 2*t/dt - (t/dt)^2 - 1
        var td = f64_div(t, dt);
        return f64_sub(f64_sub(f64_mul(two, td), f64_mul(td, td)), one);
    }
    var threshold = f64_sub(one, dt);
    if (f64_gt(t, threshold) == 1) {
        # Just before discontinuity: (t-1)/dt)^2 + 2*(t-1)/dt + 1
        var td = f64_div(f64_sub(t, one), dt);
        return f64_add(f64_add(f64_mul(td, td), f64_mul(two, td)), one);
    }
    return zero;
}

# -- Sanitize sample --
# Replace NaN or Inf with 0.0
# Check: (bits & 0x7FF0_0000_0000_0000) == 0x7FF0_0000_0000_0000
fn sanitize_sample(s) {
    var exp_mask = 0x7FF0_0000_0000_0000;
    if ((s & exp_mask) == exp_mask) {
        return f64_from(0);
    }
    return s;
}

# f64_clamp, f64_max, f64_min, f64_lerp — now provided by stdlib math.cyr
# (Cyrius 4.10.2+). Removed hand-rolled duplicates.

# -- RMS of two values --
# rms(a, b) = sqrt((a^2 + b^2) / 2) = hypot(a, b) / sqrt(2). Through 2.4.8 this
# squared first, so it overflowed to +Inf above ~1.3e154 and flushed to 0 below
# ~1e-154; hypot scales by the larger leg first (CHANGELOG 2.4.9).
fn f64_rms2(a, b) {
    return f64_mul(f64_hypot(a, b), DSP_FRAC_1_SQRT2);
}

# f64_hypot, f64_trunc, f64_fract, f64_sign — now provided by stdlib math.cyr
# (Cyrius 4.10.2+). Removed hand-rolled duplicates.

# -- Round to nearest, ties away from zero --
# C99 round(): the nearest integer, halfway cases away from zero, sign kept
# (round(-0.3) = -0). Through 2.4.8 this was floor(x + 0.5), and that addition
# rounds: 0.49999999999999994 + 0.5 is 1.0, so round(0.49999999999999994) = 1,
# and every odd integer in [2^52, 2^53) moved to the next even one —
# round(4503599627370497) = 4503599627370498 (CHANGELOG 2.4.9). Now an f64 of
# magnitude >= 2^52 is already an integer and comes back unchanged, and below
# that |x| - trunc(|x|) is exact, so the half test is exact too.
#
# Cyrius 6.5.x made `f64_round` a compiler builtin, and the builtin rounds
# ties to EVEN (round(2.5) = 2, round(-2.5) = -2) per the IEEE-754 default.
# abaco keeps ties-away-from-zero (round(2.5) = 3) because that is what the
# expression evaluator's user-facing `round()` has always done and what a
# desk calculator is expected to do; the name carries the tie rule so the two
# can never be confused. See test_round_ties_away.
var DSP_TWO_POW_52 = 0x4330_0000_0000_0000;   # 2^52

fn f64_round_half_away(x) {
    var ax = f64_abs(x);
    # NaN fails the comparison too, so NaN and +/-Inf come back as they are.
    if (f64_lt(ax, DSP_TWO_POW_52) == 0) { return x; }
    # ax >= 0, so floor is trunc; builtins only (the stdlib f64_trunc / f64_ge
    # are calls, which doubled the cost of this hot path).
    var t = f64_floor(ax);
    if (f64_lt(f64_sub(ax, t), DSP_HALF) == 0) { t = f64_add(t, DSP_ONE); }
    # Copy the sign bit back on; t is >= +0, so this also gives round(-0.3) = -0.
    return t | (x & 0x8000_0000_0000_0000);
}

# ================================================================
# Decibel conversions
# ================================================================

# Precomputed reciprocals of ln(10). These MUST be the correctly-rounded f64
# encodings: DB_SCALE * DB_EXP has to round to ~1.0 or amplitude_to_db and
# db_to_amplitude stop being inverses and the round trip drifts ~0.081% of |db|
# (blows a 0.01 dB tolerance for |db| >= 20). See test_db_roundtrip.
# ⚠ Through 2.4.8 each of the three was still 1 ulp off its correctly rounded
# value despite this comment — amplitude_to_db(1000) was 59.999999999999986.
# Re-derived at 80 digits for 2.4.9; test_db_constants_exact pins the bits.
var DB_SCALE    = 0x4021_5F2C_ED38_4F29;   # 20/ln(10)  = 8.685889638065037
var DB_EXP      = 0x3FBD_791C_5F88_8822;   # ln(10)/20  = 0.11512925464970228
var DB_GAIN_EXP = 0x3FAD_791C_5F88_8822;   # ln(10)/40  = 0.05756462732485114

# amplitude_to_db: 20/ln(10) * ln(amp); -Inf for amp <= 0, NaN for NaN. Through
# 2.4.8 a NaN amplitude answered -Inf — silence — so a NaN-poisoned signal's
# level read as quiet instead of broken (CHANGELOG 2.4.9).
fn amplitude_to_db(amp) {
    # amp <= 0, written with the comparison builtins (stdlib f64_le is a call);
    # NaN fails both, so it reaches f64_ln and comes back NaN.
    var zero = f64_from(0);
    if (f64_lt(amp, zero) == 1 || f64_eq(amp, zero) == 1) { return 0xFFF0_0000_0000_0000; }
    return f64_mul(DB_SCALE, f64_ln(amp));
}

# db_to_amplitude: exp(db * ln(10)/20)
fn db_to_amplitude(db) {
    return f64_exp(f64_mul(db, DB_EXP));
}

# db_gain_factor: exp(db * ln(10)/40) -- for filter coefficient design
fn db_gain_factor(db) {
    return f64_exp(f64_mul(db, DB_GAIN_EXP));
}

# dBFS (dB full-scale) — digital audio convention where 0 dBFS corresponds
# to an amplitude of 1.0. Formally dBFS(a) = 20 * log10(|a| / 1.0), so the
# conversion is identical to amplitude_to_db/db_to_amplitude when the
# reference level is unity (the universal case for floating-point audio).
# Exposing the pair as an explicit alias removes the need for every
# caller to remember that "dBFS" and "dB relative to 1.0" are the same
# thing in the float-audio world, and keeps call sites self-documenting.
# Takes |a| as the formula says: a negative sample of the same magnitude has the
# same level (through 2.4.8 it answered -Inf).
fn amplitude_to_dbfs(amp) { return amplitude_to_db(f64_abs(amp)); }
fn dbfs_to_amplitude(dbfs) { return db_to_amplitude(dbfs); }

# ================================================================
# MIDI <-> Frequency (12-TET, A4 = 440 Hz)
# ================================================================

# midi_to_freq: 440 * 2^((note - 69) / 12)
fn midi_to_freq(note) {
    var exponent = f64_div(f64_sub(note, DSP_A4_MIDI), DSP_SEMITONES);
    return f64_mul(DSP_A4_FREQ, f64_exp2(exponent));
}

# freq_to_midi: 69 + 12 * log2(freq / 440); -Inf if freq <= 0, NaN for NaN
# (through 2.4.8 NaN answered -Inf, like amplitude_to_db).
fn freq_to_midi(freq) {
    var zero = f64_from(0);
    if (f64_lt(freq, zero) == 1 || f64_eq(freq, zero) == 1) { return 0xFFF0_0000_0000_0000; }
    return f64_add(DSP_A4_MIDI, f64_mul(DSP_SEMITONES, f64_log2(f64_div(freq, DSP_A4_FREQ))));
}

# ================================================================
# Envelope / dynamics
# ================================================================

# time_constant: one-pole smoothing coefficient from time in ms
# c = exp(-1 / (time_ms * 0.001 * sample_rate)); a time under one sample clamps
# to one sample.
#
# Both arguments are f64 BIT PATTERNS, like every DSP argument here —
# sample_rate is f64_from(48000), not 48000. An integer passed straight in is a
# subnormal f64 of ~1e-319 Hz, which made every attack/release collapse to the
# one-sample exp(-1) with no sign of trouble (dhvani's compressor and limiter at
# 2.4.6). Through 2.4.8 NaN did the same. A sample rate that is not a finite
# value >= 1 Hz, or a NaN / negative / infinite time, now answers NaN so the
# mistake shows instead of sounding plausible (CHANGELOG 2.4.9).
fn time_constant(time_ms, sample_rate) {
    var one = f64_from(1);
    var thousand = f64_from(1000);
    var zero = f64_from(0);
    # x - x == 0 exactly when x is finite (NaN and +/-Inf give NaN).
    if (f64_lt(sample_rate, one) == 1) { return 0x7FF8_0000_0000_0000; }
    if (f64_eq(f64_sub(sample_rate, sample_rate), zero) == 0) { return 0x7FF8_0000_0000_0000; }
    if (f64_lt(time_ms, zero) == 1) { return 0x7FF8_0000_0000_0000; }
    if (f64_eq(f64_sub(time_ms, time_ms), zero) == 0) { return 0x7FF8_0000_0000_0000; }
    var samples = f64_mul(f64_div(time_ms, thousand), sample_rate);
    samples = f64_max(samples, one);
    return f64_exp(f64_neg(f64_div(one, samples)));
}

# ================================================================
# Panning / crossfade
# ================================================================

# constant_power_pan: sin/cos law stereo panning
# pan in [-1, +1], returns (left, right) via output pointers
# theta = (pan + 1) * PI/4, left = cos(theta), right = sin(theta)
fn constant_power_pan(pan, out_left, out_right) {
    var neg1 = f64_neg(f64_from(1));
    var pos1 = f64_from(1);
    pan = f64_clamp(pan, neg1, pos1);
    var theta = f64_mul(f64_add(pan, pos1), DSP_PI_4);
    store64(out_left, f64_cos(theta));
    store64(out_right, f64_sin(theta));
    return 0;
}

# equal_power_crossfade: smooth crossfade at position t in [0, 1]
# returns (gain_a, gain_b) via output pointers
# angle = t * PI/2, gain_a = cos(angle), gain_b = sin(angle)
fn equal_power_crossfade(t, out_a, out_b) {
    var zero = f64_from(0);
    var one = f64_from(1);
    t = f64_clamp(t, zero, one);
    var angle = f64_mul(t, DSP_PI_2);
    store64(out_a, f64_cos(angle));
    store64(out_b, f64_sin(angle));
    return 0;
}

# ================================================================
# SIMD batch operations over flat f64 arrays
# ================================================================
#
# The f64v_* builtins step two lanes at a time with no scalar tail, so for an
# odd n they read one element past every input and WRITE one past dst (Cyrius
# 6.6.12, x86 and aarch64 alike). Through 2.4.8 every wrapper passed n straight
# through: heap corruption from a valid call — a 441-sample buffer is 10 ms at
# 44.1 kHz — and SIGSEGV when the buffer ended at a page boundary. Each wrapper
# now runs the builtin on the even prefix, finishes an odd last element in
# scalar code with the same rounding, and returns at once for n <= 0. None of
# them allocates (batch_scale and batch_mac did, n * 8 bytes per call, never
# freed). Aliasing dst with an input is fine: every element is read before it
# is written. (CHANGELOG 2.4.9.)

# Batch add: dst[i] = a[i] + b[i] for n elements
fn batch_add(dst, a, b, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_add(dst, a, b, m); }
    if (m < n) { store64(dst + m * 8, f64_add(load64(a + m * 8), load64(b + m * 8))); }
    return 0;
}

# Batch subtract: dst[i] = a[i] - b[i] for n elements
fn batch_sub(dst, a, b, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_sub(dst, a, b, m); }
    if (m < n) { store64(dst + m * 8, f64_sub(load64(a + m * 8), load64(b + m * 8))); }
    return 0;
}

# Batch multiply: dst[i] = a[i] * b[i] for n elements
fn batch_mul(dst, a, b, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_mul(dst, a, b, m); }
    if (m < n) { store64(dst + m * 8, f64_mul(load64(a + m * 8), load64(b + m * 8))); }
    return 0;
}

# Batch scale: dst[i] = src[i] * scalar for n elements
fn batch_scale(dst, src, scalar, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_scale(dst, src, scalar, m); }
    if (m < n) { store64(dst + m * 8, f64_mul(load64(src + m * 8), scalar)); }
    return 0;
}

# Batch multiply-accumulate: dst[i] = dst[i] + a[i] * b[i]
fn batch_mac(dst, a, b, n) {
    return batch_fmadd(dst, a, b, dst, n);
}

# Batch divide: dst[i] = a[i] / b[i] for n elements
fn batch_div(dst, a, b, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_div(dst, a, b, m); }
    if (m < n) { store64(dst + m * 8, f64_div(load64(a + m * 8), load64(b + m * 8))); }
    return 0;
}

# Batch sqrt: dst[i] = sqrt(src[i]) for n elements
fn batch_sqrt(dst, src, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_sqrt(dst, src, m); }
    if (m < n) { store64(dst + m * 8, f64_sqrt(load64(src + m * 8))); }
    return 0;
}

# Batch abs: dst[i] = |src[i]| for n elements
fn batch_abs(dst, src, n) {
    if (n <= 0) { return 0; }
    var m = n & (0 - 2);
    if (m > 0) { f64v_abs(dst, src, m); }
    if (m < n) { store64(dst + m * 8, f64_abs(load64(src + m * 8))); }
    return 0;
}

# Batch multiply-add: dst[i] = a[i]*b[i] + c[i], rounded TWICE (product, then
# sum) on every target. f64v_fmadd lowers to an unfused mul+add on x86 but to a
# fused FMLA on aarch64, so through 2.4.8 the same inputs gave different bits on
# the two (a*b - fl(a*b) is 0 on x86 and the exact residue on aarch64), and the
# odd tail would have mixed both in one call. The product goes through a 64-lane
# stack chunk instead, which keeps it allocation-free.
fn batch_fmadd(dst, a, b, c, n) {
    if (n <= 0) { return 0; }
    var prod[512];   # 64 f64 — one chunk of products
    var off = 0;
    while (off < n) {
        var cnt = n - off;
        if (cnt > 64) { cnt = 64; }
        var m = cnt & (0 - 2);
        var p = off * 8;
        if (m > 0) {
            f64v_mul(&prod, a + p, b + p, m);
            f64v_add(dst + p, &prod, c + p, m);
        }
        if (m < cnt) {
            var q = p + m * 8;
            store64(dst + q, f64_add(f64_mul(load64(a + q), load64(b + q)), load64(c + q)));
        }
        off = off + cnt;
    }
    return 0;
}

# Batch sum: the sum of n f64 values, compensated (Neumaier 1974). Plain
# left-to-right summation was ~92,000 ulp off on a million 0.1s and returned 0
# for [1e16, 1, -1e16] (through 2.4.8); the compensation term carries what each
# addition rounded away. A non-finite running sum is returned as it is — the
# compensation of an infinity is NaN, and Inf / NaN are already the answer.
fn batch_sum(src, n) {
    var sum = f64_from(0);
    var comp = f64_from(0);
    var i = 0;
    while (i < n) {
        var x = load64(src + i * 8);
        var t = f64_add(sum, x);
        # |sum| >= |x|, as a builtin (stdlib f64_ge is a call, once per sample
        # here). A NaN takes this branch; either branch gives NaN.
        if (f64_lt(f64_abs(sum), f64_abs(x)) == 0) {
            comp = f64_add(comp, f64_add(f64_sub(sum, t), x));
        } else {
            comp = f64_add(comp, f64_add(f64_sub(x, t), sum));
        }
        sum = t;
        i = i + 1;
    }
    if (f64_eq(f64_sub(sum, sum), f64_from(0)) == 0) { return sum; }
    return f64_add(sum, comp);
}

# ================================================================
# Audio: samples <-> milliseconds (sample-rate aware)
# ================================================================

# Duration of n samples in milliseconds, at the given sample rate.
fn samples_to_ms(n_samples, sample_rate) {
    return f64_div(f64_mul(n_samples, f64_from(1000)), sample_rate);
}

# Sample count for a given duration (ms) at the given sample rate.
fn ms_to_samples(ms, sample_rate) {
    return f64_div(f64_mul(ms, sample_rate), f64_from(1000));
}

# Tempo (beats per minute) → frequency (Hz). 120 bpm = 2 Hz.
fn bpm_to_hz(bpm) { return f64_div(bpm, f64_from(60)); }

# Frequency (Hz) → tempo (beats per minute).
fn hz_to_bpm(hz)  { return f64_mul(hz, f64_from(60)); }

# ================================================================
# Window functions — single-sample generators
# All accept (n, size) where n is the sample index and size is window length,
# and return the coefficient at that sample as an f64: 0 for n outside
# [0, size), 1 for the one sample of a size-1 window.
#
# window_hann / _hamming / _blackman / _kaiser are the SYMMETRIC forms
# (denominator size - 1, w(0) = w(size-1)), the right shape for FIR design and
# for analysing one frame. The *_periodic variants are the DFT-even form Harris
# 1978 tabulates for spectral analysis and STFT overlap-add: the symmetric
# window of size + 1 with its last sample dropped (denominator size), so
# w(n) = w(size-n) for 1 <= n < size — scipy's fftbins=True, and MATLAB's
# 'periodic' for Hann / Hamming / Blackman (MATLAB's kaiser has no such flag).
# At 50% overlap the periodic Hann sums to 1 where the symmetric one ripples
# by about pi / (2 (size - 1)): ~2.5% at size 64, 0.6% at 256.
# ================================================================

# 1 when n is outside the window [0, size). Through 2.4.8 the generators took
# any n: out-of-range samples wrapped onto the cosine (window_hann(64, 64) =
# 0.0025, window_hann(3, 3) = 1.0) or went NaN in Kaiser (CHANGELOG 2.4.9).
fn _win_outside(n, size) {
    if (n < 0) { return 1; }
    if (n >= size) { return 1; }
    return 0;
}

var WIN_HAMM_A = 0x3FE1_47AE_147A_E148;   # 0.54
var WIN_HAMM_B = 0x3FDD_70A3_D70A_3D71;   # 0.46
var WIN_BLK_A  = 0x3FDA_E147_AE14_7AE1;   # 0.42
var WIN_BLK_C  = 0x3FB4_7AE1_47AE_147B;   # 0.08

# The cosine windows are evaluated on the CENTRED phase over a denominator d,
#   phi = pi * (2n - d) / d  in [-pi, pi],
# not on 2*pi*n/d; d is size - 1 for the symmetric windows and size for the
# periodic ones. 2n - d is an exact integer and changes sign between n and
# d - n, so phi is exactly negated, and cos is even bit for bit: every window is
# exactly symmetric about d/2 — w(n) == w(N-1-n) symmetric, w(n) == w(N-n)
# periodic — which is what makes an FIR designed with it exactly linear-phase.
# Through 2.4.9 the two halves were separate roundings, up to ~3 ulp apart
# (2.4.9 audit). With theta = phi + pi, cos(theta) = -cos(phi) and
# cos(2 theta) = cos(2 phi), so the formulas below are the textbook ones
# rewritten in phi. The two forms evaluate the same expressions, d aside, so
# a periodic window of size N is bit for bit the symmetric one of size N + 1.
# The integer is formed as n + (n - d), which stays within [-d, d] for
# 0 <= n <= d, and size + 1 is never formed, so no size overflows.
fn _win_phi_d(n, d) {
    return f64_div(f64_mul(DSP_PI, f64_from(n + (n - d))), f64_from(d));
}

# Hann: 0.5 * (1 - cos(2π n / (N-1))) = 0.5 * (1 + cos(phi))
fn window_hann(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_mul(DSP_HALF, f64_add(DSP_ONE, f64_cos(_win_phi_d(n, size - 1))));
}

# Hamming: 0.54 - 0.46 * cos(2π n / (N-1)) = 0.54 + 0.46 * cos(phi)
fn window_hamming(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_add(WIN_HAMM_A, f64_mul(WIN_HAMM_B, f64_cos(_win_phi_d(n, size - 1))));
}

# Blackman: 0.42 - 0.5*cos(2π n/(N-1)) + 0.08*cos(4π n/(N-1))
#         = 0.42 + 0.5*cos(phi) + 0.08*cos(2 phi)
fn window_blackman(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    var phase = _win_phi_d(n, size - 1);
    var t1 = f64_mul(DSP_HALF, f64_cos(phase));
    var t2 = f64_mul(WIN_BLK_C, f64_cos(f64_add(phase, phase)));
    return f64_add(f64_add(WIN_BLK_A, t1), t2);
}

# Periodic (DFT-even) windows, denominator size: the same expressions with
# d = size, so window_hann_periodic(n, N) is window_hann(n, N + 1) bit for bit
# for N >= 2 and every n in [0, N). Same conventions as the symmetric ones: 0
# for n outside [0, size), so size <= 0 is an empty window, and a size-1
# window is [1] — scipy and MATLAB's choice too, where the size + 1 recipe
# would give the first sample of a 2-point symmetric window (0 for Hann, 0.08
# for Hamming).
# Hann, periodic: 0.5 * (1 - cos(2π n / N)) = 0.5 * (1 + cos(phi))
fn window_hann_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_mul(DSP_HALF, f64_add(DSP_ONE, f64_cos(_win_phi_d(n, size))));
}

# Hamming, periodic: 0.54 - 0.46 * cos(2π n / N); see window_hann_periodic.
fn window_hamming_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_add(WIN_HAMM_A, f64_mul(WIN_HAMM_B, f64_cos(_win_phi_d(n, size))));
}

# Blackman, periodic: 0.42 - 0.5*cos(2π n/N) + 0.08*cos(4π n/N); see
# window_hann_periodic.
fn window_blackman_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    var phase = _win_phi_d(n, size);
    var t1 = f64_mul(DSP_HALF, f64_cos(phase));
    var t2 = f64_mul(WIN_BLK_C, f64_cos(f64_add(phase, phase)));
    return f64_add(f64_add(WIN_BLK_A, t1), t2);
}

# Modified Bessel I0 by its power series, sum over k of ((x/2)^k / k!)^2
# (Abramowitz & Stegun 9.6.12), summed until a term no longer moves the sum.
# Through 2.4.8 it stopped after a fixed 29 terms, which is only enough for
# |x| below ~17: I0(50) came out 9% low and I0(100) five orders of magnitude
# low, so every Kaiser window with beta past ~20 was wrong — and Kaiser's own
# design rule gives beta ~21 for 60 dB of stop-band (CHANGELOG 2.4.9). The
# terms peak near k = |x|/2 and then fall geometrically; the cap is far above
# the ~360 terms the overflow point (|x| ~ 713) needs. Past that I0 is +Inf, so
# a Kaiser beta above ~700 gives Inf / Inf = NaN.
fn _bessel_i0(x) {
    if (f64_eq(x, x) == 0) { return x; }
    var sum = f64_from(1);
    var term = f64_from(1);
    var half_x = f64_div(x, f64_from(2));
    var hx2 = f64_mul(half_x, half_x);
    var k = 1;
    while (k < 2000) {
        var kf = f64_from(k);
        term = f64_mul(term, f64_div(hx2, f64_mul(kf, kf)));
        var next = f64_add(sum, term);
        if (f64_eq(next, sum) == 1) { break; }
        sum = next;
        k = k + 1;
    }
    return sum;
}

# Kaiser numerator I0(β * sqrt(1 - x^2)) at x = (2n - d) / d, i.e. 2n/d - 1 as
# one exact-integer ratio, so x is exactly negated at d - n and the window is
# bit-exact symmetric (see _win_phi_d). d is size - 1 symmetric, size periodic.
fn _win_kaiser_num_d(n, d, beta) {
    var x = f64_div(f64_from(n + (n - d)), f64_from(d));
    return _bessel_i0(f64_mul(beta, f64_sqrt(f64_sub(DSP_ONE, f64_mul(x, x)))));
}

# Fill dst[0..size] with w(i) = num(i) * (1 / I0(β)), I0(β) computed once.
# The single-sample generators divide by I0(β) instead, so a fill and its
# generator agree to 1 ulp, not always bit for bit.
fn _win_kaiser_fill_d(dst, size, d, beta) {
    if (size <= 0) { return 0; }
    if (size == 1) { store64(dst, DSP_ONE); return 0; }
    var inv_denom = f64_div(DSP_ONE, _bessel_i0(beta));
    var df = f64_from(d);
    var i = 0;
    while (i < size) {
        # _win_kaiser_num_d inlined, with f64(d) hoisted: the same arithmetic.
        var x = f64_div(f64_from(i + (i - d)), df);
        var arg = f64_mul(beta, f64_sqrt(f64_sub(DSP_ONE, f64_mul(x, x))));
        store64(dst + i * 8, f64_mul(_bessel_i0(arg), inv_denom));
        i = i + 1;
    }
    return 0;
}

# Kaiser: I0(β * sqrt(1 - (2n/(N-1) - 1)^2)) / I0(β)
# beta controls side-lobe attenuation (common values: 5, 8, 14).
# For whole-window fills prefer window_kaiser_fill — it hoists the I0(β) denom.
fn window_kaiser(n, size, beta) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_div(_win_kaiser_num_d(n, size - 1, beta), _bessel_i0(beta));
}

# Fill dst[0..size] with a Kaiser window — computes I0(β) once.
fn window_kaiser_fill(dst, size, beta) {
    return _win_kaiser_fill_d(dst, size, size - 1, beta);
}

# Periodic (DFT-even) Kaiser, I0(β * sqrt(1 - (2n/N - 1)^2)) / I0(β): the
# symmetric window of size N + 1 without its last sample, bit for bit, for
# N >= 2. Conventions as window_hann_periodic (size 1 is [1]).
fn window_kaiser_periodic(n, size, beta) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return f64_div(_win_kaiser_num_d(n, size, beta), _bessel_i0(beta));
}

# Fill dst[0..size] with a periodic Kaiser window — computes I0(β) once; for
# size >= 2 the first size samples of window_kaiser_fill(dst, size + 1, beta),
# bit for bit (size 1 is [1]).
fn window_kaiser_periodic_fill(dst, size, beta) {
    return _win_kaiser_fill_d(dst, size, size, beta);
}

# ---- Windows added in 2.7.0 ----------------------------------------------
# The same conventions as above: 0 for n outside [0, size), [1] for size 1, the
# symmetric form on d = size - 1 and the periodic one on d = size, each built
# on the exact integer 2n - d. So every window is bit-exact symmetric, and a
# periodic window of size N is the symmetric one of size N + 1, bit for bit.

# Cosine-sum coefficients, the correctly rounded encodings of the published
# decimals. The textbook form a0 - a1 cos(theta) + a2 cos(2 theta) - ...,
# theta = 2 pi n / d, is written in the centred phase phi = theta - pi, where
# cos(k theta) = (-1)^k cos(k phi), so every term is added.
enum WinCosSum {
    # Nuttall, 4 terms, continuous first derivative: -93 dB side lobes, falling
    # 18 dB/octave (Nuttall 1981; scipy.signal.windows.nuttall).
    WIN_NUTTALL_A0 = 0x3FD7_44ED_047A_B904;   # 0.3635819
    WIN_NUTTALL_A1 = 0x3FDF_4EAF_251C_193B;   # 0.4891775
    WIN_NUTTALL_A2 = 0x3FC1_7C17_A893_31A1;   # 0.1365995
    WIN_NUTTALL_A3 = 0x3F85_CB00_43F2_9E18;   # 0.0106411
    # Blackman-Harris, 4 terms, -92 dB side lobes (Harris 1978, Table I).
    WIN_BH4_A0 = 0x3FD6_F5C2_8F5C_28F6;   # 0.35875
    WIN_BH4_A1 = 0x3FDF_4024_B33D_AF8E;   # 0.48829
    WIN_BH4_A2 = 0x3FC2_1576_89CA_18BD;   # 0.14128
    WIN_BH4_A3 = 0x3F87_EBAF_1023_63B2;   # 0.01168
    # Flat-top, 5 terms: under 0.01 dB of scalloping, for amplitude readings
    # (D'Antona & Ferrero 2006; MATLAB flattopwin, scipy.signal.windows.flattop).
    WIN_FLATTOP_A0 = 0x3FCB_9817_4DFA_5ED6;   # 0.21557895
    WIN_FLATTOP_A1 = 0x3FDA_AA17_80A5_2BF4;   # 0.41663158
    WIN_FLATTOP_A2 = 0x3FD1_BEAD_F8FF_B93C;   # 0.277263158
    WIN_FLATTOP_A3 = 0x3FB5_656E_0BFF_C627;   # 0.083578947
    WIN_FLATTOP_A4 = 0x3F7C_74D7_E5A7_05B5;   # 0.006947368
}

# a0 + a1 cos(phi) + a2 cos(2 phi) + a3 cos(3 phi) + a4 cos(4 phi) at the
# centred phase of n over d. k phi rounds the same way for phi and -phi, so the
# sum stays exactly symmetric. Near the ends the terms cancel to ~1e-4 (Nuttall,
# Blackman-Harris) or below 0 (flat-top), and the error there is ~1 ulp of the
# peak, as for Hann.
fn _win_cos_sum(n, d, a0, a1, a2, a3, a4) {
    var phi = _win_phi_d(n, d);
    var s = f64_add(a0, f64_mul(a1, f64_cos(phi)));
    s = f64_add(s, f64_mul(a2, f64_cos(f64_add(phi, phi))));
    s = f64_add(s, f64_mul(a3, f64_cos(f64_mul(f64_from(3), phi))));
    if (a4 != 0) { s = f64_add(s, f64_mul(a4, f64_cos(f64_mul(f64_from(4), phi)))); }
    return s;
}

# Nuttall (4-term, continuous first derivative), symmetric and periodic.
fn window_nuttall(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size - 1, WIN_NUTTALL_A0, WIN_NUTTALL_A1, WIN_NUTTALL_A2, WIN_NUTTALL_A3, 0);
}
fn window_nuttall_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size, WIN_NUTTALL_A0, WIN_NUTTALL_A1, WIN_NUTTALL_A2, WIN_NUTTALL_A3, 0);
}

# Blackman-Harris (4-term, -92 dB), symmetric and periodic.
fn window_blackman_harris(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size - 1, WIN_BH4_A0, WIN_BH4_A1, WIN_BH4_A2, WIN_BH4_A3, 0);
}
fn window_blackman_harris_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size, WIN_BH4_A0, WIN_BH4_A1, WIN_BH4_A2, WIN_BH4_A3, 0);
}

# Flat-top (5-term), symmetric and periodic. Its ends dip just below 0
# (-0.000421), as the published coefficients do.
fn window_flattop(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size - 1, WIN_FLATTOP_A0, WIN_FLATTOP_A1, WIN_FLATTOP_A2, WIN_FLATTOP_A3,
      WIN_FLATTOP_A4);
}
fn window_flattop_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_cos_sum(n, size, WIN_FLATTOP_A0, WIN_FLATTOP_A1, WIN_FLATTOP_A2, WIN_FLATTOP_A3,
      WIN_FLATTOP_A4);
}

# (d - |2n - d|) / d: the distance from the nearer end as a fraction of d/2, in
# [0, 1]. The numerator is an exact integer, so this is one rounding: correctly
# rounded while d < 2^53.
fn _win_edge_d(n, d) {
    var k = n + (n - d);
    if (k < 0) { k = 0 - k; }
    return f64_div(f64_from(d - k), f64_from(d));
}

# Bartlett (triangular, 0 at both ends): 1 - |2n - d| / d, correctly rounded.
# scipy.signal.windows.bartlett; Harris 1978. (scipy's `triang` is a different
# window, nonzero at the ends.)
fn window_bartlett(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_edge_d(n, size - 1);
}
fn window_bartlett_periodic(n, size) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_edge_d(n, size);
}

# Tukey (tapered cosine), taper fraction alpha: flat at 1 over the middle
# 1 - alpha of the window, a Hann half over alpha / 2 at each end. With u the
# edge distance above, w = 1 for u >= alpha, else 0.5 (1 + cos(pi (u / alpha - 1))).
# As scipy defines the ends, alpha <= 0 is the rectangular window and
# alpha >= 1 is Hann, here window_hann / window_hann_periodic bit for bit. A
# NaN alpha gives NaN (size 1 aside, which is [1] as for Kaiser). Bingham,
# Godfrey & Tukey 1967; Harris 1978; scipy.signal.windows.tukey.
fn _win_tukey_d(n, d, alpha) {
    var u = _win_edge_d(n, d);
    if (f64_lt(u, alpha) == 0) { return DSP_ONE; }
    var t = f64_mul(DSP_PI, f64_sub(f64_div(u, alpha), DSP_ONE));
    return f64_mul(DSP_HALF, f64_add(DSP_ONE, f64_cos(t)));
}
fn window_tukey(n, size, alpha) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    if (f64_eq(alpha, alpha) == 0) { return alpha; }
    if (f64_gt(alpha, f64_from(0)) == 0) { return DSP_ONE; }
    if (f64_lt(alpha, DSP_ONE) == 0) { return window_hann(n, size); }
    return _win_tukey_d(n, size - 1, alpha);
}
fn window_tukey_periodic(n, size, alpha) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    if (f64_eq(alpha, alpha) == 0) { return alpha; }
    if (f64_gt(alpha, f64_from(0)) == 0) { return DSP_ONE; }
    if (f64_lt(alpha, DSP_ONE) == 0) { return window_hann_periodic(n, size); }
    return _win_tukey_d(n, size, alpha);
}

# Gaussian, standard deviation sigma in samples: exp(-t^2 / 2) with
# t = (n - d/2) / sigma, the offset formed as the exact (2n - d) * 0.5
# (scipy.signal.windows.gaussian's std; Harris 1978, in his
# alpha = d / (2 sigma)). +Inf is the rectangular window; 0 is the limit, 1 at
# the centre sample and 0 elsewhere (all 0 when d is odd); a negative sigma
# acts as its magnitude, as t^2 does; NaN gives NaN (size 1 aside).
fn _win_gaussian_d(n, d, sigma) {
    if (f64_eq(sigma, sigma) == 0) { return sigma; }
    var k = n + (n - d);
    if (k == 0) { return DSP_ONE; }
    var t = f64_div(f64_mul(f64_from(k), DSP_HALF), sigma);
    return f64_exp(f64_mul(f64_neg(DSP_HALF), f64_mul(t, t)));
}
fn window_gaussian(n, size, sigma) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_gaussian_d(n, size - 1, sigma);
}
fn window_gaussian_periodic(n, size, sigma) {
    if (_win_outside(n, size) == 1) { return f64_from(0); }
    if (size == 1) { return DSP_ONE; }
    return _win_gaussian_d(n, size, sigma);
}

# ---- Window metrics (Harris 1978, Table I) ---------------------------------
# For a window already in w[0..n). Sums are compensated (Neumaier, as
# batch_sum), so a long window loses nothing to accumulation. n < 1 gives NaN.
# Harris tabulates the periodic (DFT-even) windows; the same definitions apply
# to any buffer.

# s + x as a compensated (sum, compensation) pair; batch_sum's step.
fn _win_kadd(s, c, x): (f64, f64) {
    var t = f64_add(s, x);
    if (f64_lt(f64_abs(s), f64_abs(x)) == 0) {
        c = f64_add(c, f64_add(f64_sub(s, t), x));
    } else {
        c = f64_add(c, f64_add(f64_sub(x, t), s));
    }
    return (t, c);
}

# Coherent gain: sum(w) / n, the window's gain for a tone on a bin centre.
# 1 for the rectangular window, 0.5 for periodic Hann.
fn window_coherent_gain(w, n) {
    if (n < 1) { return 0x7FF8_0000_0000_0000; }
    return f64_div(batch_sum(w, n), f64_from(n));
}

# Equivalent noise bandwidth, in bins: n * sum(w^2) / sum(w)^2. 1 for the
# rectangular window, 1.5 for periodic Hann.
fn window_enbw(w, n) {
    if (n < 1) { return 0x7FF8_0000_0000_0000; }
    var s = f64_from(0);
    var c = f64_from(0);
    var q = f64_from(0);
    var qc = f64_from(0);
    var i = 0;
    while (i < n) {
        var x = load64(w + i * 8);
        s, c = _win_kadd(s, c, x);
        q, qc = _win_kadd(q, qc, f64_mul(x, x));
        i = i + 1;
    }
    var sw = f64_add(s, c);
    return f64_div(f64_mul(f64_from(n), f64_add(q, qc)), f64_mul(sw, sw));
}

# Scalloping loss, in dB (positive): how far a tone half a bin off centre falls
# below one on it, -20 log10(|sum w(k) e^(-i pi k / n)| / sum w(k)). 3.92 dB for
# the rectangular window, 1.42 for periodic Hann.
fn window_scalloping_loss(w, n) {
    if (n < 1) { return 0x7FF8_0000_0000_0000; }
    var s = f64_from(0);
    var c = f64_from(0);
    var re = f64_from(0);
    var rc = f64_from(0);
    var im = f64_from(0);
    var ic = f64_from(0);
    var nf = f64_from(n);
    var i = 0;
    while (i < n) {
        var x = load64(w + i * 8);
        var th = f64_div(f64_mul(DSP_PI, f64_from(i)), nf);
        s, c = _win_kadd(s, c, x);
        re, rc = _win_kadd(re, rc, f64_mul(x, f64_cos(th)));
        im, ic = _win_kadd(im, ic, f64_mul(x, f64_sin(th)));
        i = i + 1;
    }
    var half = ganita_f64_hypot(f64_add(re, rc), f64_add(im, ic));
    return f64_neg(amplitude_to_db(f64_div(half, f64_add(s, c))));
}

# ================================================================
# Biquad filters (2.7.0)
# ================================================================
# Second-order IIR sections designed from the RBJ Audio EQ Cookbook
# (Bristow-Johnson; W3C Working Group Note, 2021). A section is 5 f64s (40
# bytes) normalised by a0:
#   c[0..5) = b0, b1, b2, a1, a2,
#   H(z) = (b0 + b1 z^-1 + b2 z^-2) / (1 + a1 z^-1 + a2 z^-2),
# with w0 = 2 pi f0 / fs (angular_frequency), A = 10^(gain_db / 40)
# (db_gain_factor) and alpha = sin(w0) / (2 Q). The shelves take Q as well, the
# cookbook's alternative to its slope S; S = 1 is Q = 1/sqrt(2).
enum DspBiquad {
    DSP_BQ_LOWPASS = 0;
    DSP_BQ_HIGHPASS = 1;
    DSP_BQ_BANDPASS = 2;          # 0 dB at f0
    DSP_BQ_BANDPASS_SKIRT = 3;    # constant skirt gain, Q at f0
    DSP_BQ_NOTCH = 4;
    DSP_BQ_ALLPASS = 5;
    DSP_BQ_PEAK = 6;              # peaking EQ, gain_db at f0
    DSP_BQ_LOWSHELF = 7;          # gain_db below f0
    DSP_BQ_HIGHSHELF = 8;         # gain_db above f0
}

# 1 for a finite x > 0; NaN fails both comparisons.
fn _bq_pos(x) {
    if (f64_gt(x, f64_from(0)) == 1 && f64_lt(x, 0x7FF0_0000_0000_0000) == 1) { return 1; }
    return 0;
}

# 1 for a finite x.
fn _bq_finite(x) {
    if (f64_eq(f64_sub(x, x), f64_from(0)) == 1) { return 1; }
    return 0;
}

# Design a `kind` section into out[0..5) (40 bytes): corner or centre frequency
# f0 and sample rate fs in Hz, quality q, and gain_db for the peak and the
# shelves (the others ignore it). Ok(0); Err(0), with out untouched, for an
# unknown kind, fs or q not finite and positive, f0 outside (0, fs/2), a gain
# that is not finite where it is used, or a design that overflows (gains past
# ~12,000 dB).
# 1 - cos(w0) and 1 + cos(w0) are formed as 2 sin^2(w0/2) and 2 cos^2(w0/2),
# which do not cancel when f0 is near 0 or near fs/2. The poles still sit near
# z = 1 for f0 << fs, so a1 and a2 carry the usual direct-form sensitivity
# there: the DC gain of a 20 Hz low-pass at 48 kHz is 1 within ~1e-10.
fn biquad_design(out, kind, f0, fs, q, gain_db) {
    if (kind < DSP_BQ_LOWPASS || kind > DSP_BQ_HIGHSHELF) { return Err(0); }
    if (_bq_pos(fs) == 0 || _bq_pos(q) == 0 || _bq_pos(f0) == 0) { return Err(0); }
    if (f64_lt(f0, f64_mul(fs, DSP_HALF)) == 0) { return Err(0); }
    if (kind >= DSP_BQ_PEAK && _bq_finite(gain_db) == 0) { return Err(0); }
    var w0 = angular_frequency(f0, fs);
    var cw = f64_cos(w0);
    var sw = f64_sin(w0);
    var alpha = f64_div(sw, f64_mul(DSP_TWO, q));
    var b0 = f64_from(0);
    var b1 = f64_from(0);
    var b2 = f64_from(0);
    var a0 = f64_add(DSP_ONE, alpha);
    var a1 = f64_mul(f64_neg(DSP_TWO), cw);
    var a2 = f64_sub(DSP_ONE, alpha);
    if (kind == DSP_BQ_LOWPASS) {
        # (1 - cos w0) / 2 = sin^2(w0 / 2)
        var sh = f64_sin(f64_mul(w0, DSP_HALF));
        b0 = f64_mul(sh, sh);
        b1 = f64_add(b0, b0);
        b2 = b0;
    } elif (kind == DSP_BQ_HIGHPASS) {
        # (1 + cos w0) / 2 = cos^2(w0 / 2)
        var ch = f64_cos(f64_mul(w0, DSP_HALF));
        b0 = f64_mul(ch, ch);
        b1 = f64_neg(f64_add(b0, b0));
        b2 = b0;
    } elif (kind == DSP_BQ_BANDPASS) {
        b0 = alpha;
        b2 = f64_neg(alpha);
    } elif (kind == DSP_BQ_BANDPASS_SKIRT) {
        b0 = f64_mul(sw, DSP_HALF);
        b2 = f64_neg(b0);
    } elif (kind == DSP_BQ_NOTCH) {
        b0 = DSP_ONE;
        b1 = a1;
        b2 = DSP_ONE;
    } elif (kind == DSP_BQ_ALLPASS) {
        b0 = a2;
        b1 = a1;
        b2 = a0;
    } elif (kind == DSP_BQ_PEAK) {
        var ag = db_gain_factor(gain_db);
        b0 = f64_add(DSP_ONE, f64_mul(alpha, ag));
        b1 = a1;
        b2 = f64_sub(DSP_ONE, f64_mul(alpha, ag));
        a0 = f64_add(DSP_ONE, f64_div(alpha, ag));
        a2 = f64_sub(DSP_ONE, f64_div(alpha, ag));
    } else {
        # The shelves, on A + 1, A - 1 and 2 sqrt(A) alpha.
        var ag = db_gain_factor(gain_db);
        var ap1 = f64_add(ag, DSP_ONE);
        var am1 = f64_sub(ag, DSP_ONE);
        var k2 = f64_mul(f64_mul(DSP_TWO, f64_sqrt(ag)), alpha);
        var am1c = f64_mul(am1, cw);
        var ap1c = f64_mul(ap1, cw);
        if (kind == DSP_BQ_LOWSHELF) {
            b0 = f64_mul(ag, f64_add(f64_sub(ap1, am1c), k2));
            b1 = f64_mul(f64_mul(DSP_TWO, ag), f64_sub(am1, ap1c));
            b2 = f64_mul(ag, f64_sub(f64_sub(ap1, am1c), k2));
            a0 = f64_add(f64_add(ap1, am1c), k2);
            a1 = f64_mul(f64_neg(DSP_TWO), f64_add(am1, ap1c));
            a2 = f64_sub(f64_add(ap1, am1c), k2);
        } else {
            b0 = f64_mul(ag, f64_add(f64_add(ap1, am1c), k2));
            b1 = f64_mul(f64_mul(f64_neg(DSP_TWO), ag), f64_add(am1, ap1c));
            b2 = f64_mul(ag, f64_sub(f64_add(ap1, am1c), k2));
            a0 = f64_add(f64_sub(ap1, am1c), k2);
            a1 = f64_mul(DSP_TWO, f64_sub(am1, ap1c));
            a2 = f64_sub(f64_sub(ap1, am1c), k2);
        }
    }
    var nb0 = f64_div(b0, a0);
    var nb1 = f64_div(b1, a0);
    var nb2 = f64_div(b2, a0);
    var na1 = f64_div(a1, a0);
    var na2 = f64_div(a2, a0);
    var fin = _bq_finite(nb0) & _bq_finite(nb1) & _bq_finite(nb2) & _bq_finite(na1) & _bq_finite(na2);
    if (fin == 0) { return Err(0); }
    store64(out, nb0);
    store64(out + 8, nb1);
    store64(out + 16, nb2);
    store64(out + 24, na1);
    store64(out + 32, na2);
    return Ok(0);
}

# The section's response at frequency f (Hz) for sample rate fs: the magnitude
# |H(e^jw)| and the phase arg H(e^jw) in (-pi, pi], w = 2 pi f / fs.
# Each of N and D is expanded about the nearer of DC and Nyquist in
# e = sin^2(w/2) (cos w = 1 - 2e) or e = cos^2(w/2) (cos w = 2e - 1), with
# sin 2w = 2 sin w cos w and cos 2w = 2 cos^2 w - 1. Near DC, for example,
#   Re D = (1 + a1 + a2) - 2e ((a1 + 4 a2) - 4 a2 e),
#   Im D = -sin w ((a1 + 2 a2) - 4 a2 e),
# and when the poles sit near z = 1 (a1 ~ -2, a2 ~ 1) the sums 1 + a1 + a2 and
# a1 + 2 a2 are exact (Sterbenz), where 1 + a1 cos w + a2 cos 2w and
# a1 sin w + a2 sin 2w cancel: for a 20 Hz, Q 20 section at 48 kHz they lose
# ~4 digits at f0. The magnitude is a ratio of hypots, so nothing overflows.
fn biquad_response(c, f, fs): (f64, f64) {
    var w = angular_frequency(f, fs);
    var s1 = f64_from(0);
    var b0 = load64(c);
    var b1 = load64(c + 8);
    var b2 = load64(c + 16);
    var a1 = load64(c + 24);
    var a2 = load64(c + 32);
    var four = f64_from(4);
    var nr = f64_from(0);
    var ni = f64_from(0);
    var dr = f64_from(0);
    var di = f64_from(0);
    var cw = f64_cos(w);
    if (f64_gt(cw, DSP_HALF) == 1) {
        s1 = f64_sin(w);
        var hs = f64_sin(f64_mul(w, DSP_HALF));
        var e = f64_mul(hs, hs);
        var e2 = f64_add(e, e);
        var b4 = f64_mul(f64_mul(four, b2), e);
        var a4 = f64_mul(f64_mul(four, a2), e);
        nr = f64_sub(f64_add(f64_add(b0, b1), b2), f64_mul(e2, f64_sub(f64_add(b1, f64_mul(four, b2)), b4)));
        ni = f64_neg(f64_mul(s1, f64_sub(f64_add(b1, f64_add(b2, b2)), b4)));
        dr = f64_sub(f64_add(f64_add(DSP_ONE, a1), a2), f64_mul(e2, f64_sub(f64_add(a1, f64_mul(four, a2)), a4)));
        di = f64_neg(f64_mul(s1, f64_sub(f64_add(a1, f64_add(a2, a2)), a4)));
    } elif (f64_lt(cw, f64_neg(DSP_HALF)) == 1) {
        # On pi - w, from fs/2 - f (exact for f in [fs/4, fs]): sin w = sin(pi - w)
        # and cos(w/2) = sin((pi - w)/2) keep their relative accuracy next to
        # Nyquist, where sin(w) of the rounded w would not.
        var dn = angular_frequency(f64_sub(f64_mul(fs, DSP_HALF), f), fs);
        s1 = f64_sin(dn);
        var hc = f64_sin(f64_mul(dn, DSP_HALF));
        var e = f64_mul(hc, hc);
        var e2 = f64_add(e, e);
        var b4 = f64_mul(f64_mul(four, b2), e);
        var a4 = f64_mul(f64_mul(four, a2), e);
        nr = f64_add(f64_add(f64_sub(b0, b1), b2), f64_mul(e2, f64_add(f64_sub(b1, f64_mul(four, b2)), b4)));
        ni = f64_neg(f64_mul(s1, f64_add(f64_sub(b1, f64_add(b2, b2)), b4)));
        dr = f64_add(f64_add(f64_sub(DSP_ONE, a1), a2), f64_mul(e2, f64_add(f64_sub(a1, f64_mul(four, a2)), a4)));
        di = f64_neg(f64_mul(s1, f64_add(f64_sub(a1, f64_add(a2, a2)), a4)));
    } else {
        # Mid-band the expansions only add roundings: the direct form.
        s1 = f64_sin(w);
        var w2 = f64_add(w, w);
        var c2 = f64_cos(w2);
        var s2 = f64_sin(w2);
        nr = f64_add(f64_add(b0, f64_mul(b1, cw)), f64_mul(b2, c2));
        ni = f64_neg(f64_add(f64_mul(b1, s1), f64_mul(b2, s2)));
        dr = f64_add(f64_add(DSP_ONE, f64_mul(a1, cw)), f64_mul(a2, c2));
        di = f64_neg(f64_add(f64_mul(a1, s1), f64_mul(a2, s2)));
    }
    var mag = f64_div(ganita_f64_hypot(nr, ni), ganita_f64_hypot(dr, di));
    var ph = f64_sub(ganita_f64_atan2(ni, nr), ganita_f64_atan2(di, dr));
    if (f64_gt(ph, DSP_PI) == 1) { ph = f64_sub(ph, DSP_TAU); }
    if (f64_gt(ph, f64_neg(DSP_PI)) == 0) { ph = f64_add(ph, DSP_TAU); }
    return (mag, ph);
}

# Filter src[0..n) into dst[0..n) through the section c, in transposed direct
# form II (the usual structure for floating point; Smith, "Introduction to
# Digital Filters", 2007):
#   y = b0 x + s1;  s1 = b1 x - a1 y + s2;  s2 = b2 x - a2 y.
# state[0..2) (16 bytes) holds (s1, s2) and is updated, so consecutive blocks
# chain; zero it to start. dst may be src. Returns 0. A decaying tail runs the
# state into subnormals, which are slow on some CPUs.
fn biquad_process(c, state, src, dst, n) {
    var b0 = load64(c);
    var b1 = load64(c + 8);
    var b2 = load64(c + 16);
    var a1 = load64(c + 24);
    var a2 = load64(c + 32);
    var z1 = load64(state);
    var z2 = load64(state + 8);
    var i = 0;
    while (i < n) {
        var x = load64(src + i * 8);
        var y = f64_add(f64_mul(b0, x), z1);
        z1 = f64_add(f64_sub(f64_mul(b1, x), f64_mul(a1, y)), z2);
        z2 = f64_sub(f64_mul(b2, x), f64_mul(a2, y));
        store64(dst + i * 8, y);
        i = i + 1;
    }
    store64(state, z1);
    store64(state + 8, z2);
    return 0;
}

# ================================================================
# Interpolation
# ================================================================

# Module-level f64 constants for per-sample hot paths.
var DSP_HALF     = F64_HALF;
var DSP_ONE      = F64_ONE;
var DSP_TWO      = F64_TWO;
var DSP_TWO_HALF = F64_TWO_HALF;
var DSP_ONE_HALF = F64_ONE_HALF;

# Cubic (Catmull-Rom) interpolation between b and c, using neighbors a and d.
# t in [0, 1]. Smooth and passes through control points.
fn f64_cubic(a, b, c, d, t) {
    var t2 = f64_mul(t, t);
    var t3 = f64_mul(t2, t);
    var c1 = f64_mul(DSP_HALF, f64_sub(c, a));
    # c2 = a - 2.5b + 2c - 0.5d  (split to stay under the 120-col lint limit)
    var c2_abc = f64_sub(f64_sub(a, f64_mul(DSP_TWO_HALF, b)), f64_mul(f64_neg(DSP_TWO), c));
    var c2 = f64_add(c2_abc, f64_mul(f64_neg(DSP_HALF), d));
    var c3 = f64_add(f64_mul(DSP_HALF, f64_sub(d, a)), f64_mul(DSP_ONE_HALF, f64_sub(b, c)));
    return f64_add(b, f64_add(f64_mul(c1, t), f64_add(f64_mul(c2, t2), f64_mul(c3, t3))));
}

# Normalized sinc: sinc(x) = sin(pi x)/(pi x), sinc(0) = 1. Every f64 of
# magnitude >= 2^52 is an integer, where sinc is 0, and 0 is also its limit at
# +/-Inf; through 2.4.8 both answered NaN (CHANGELOG 2.4.9).
fn f64_sinc(x) {
    if (f64_eq(x, f64_from(0)) == 1) { return DSP_ONE; }
    var ax = f64_abs(x);
    if (f64_gt(ax, DSP_TWO_POW_52) == 1 || f64_eq(ax, DSP_TWO_POW_52) == 1) { return f64_from(0); }
    var px = f64_mul(DSP_PI, x);
    return f64_div(f64_sin(px), px);
}

# Windowed sinc kernel sample at offset x (in samples), Hann-windowed,
# clipped to +-half_width. Used as a resampling kernel. half_width must be
# positive: 0, a negative value or NaN gives a zero kernel (through 2.4.8 they
# gave NaN at x = 0, or silent zeros), and +Inf is the unwindowed sinc
# (through 2.4.8, NaN everywhere).
fn sinc_kernel(x, half_width) {
    if (f64_gt(half_width, f64_from(0)) == 0) { return f64_from(0); }
    if (f64_eq(half_width, 0x7FF0_0000_0000_0000) == 1) { return f64_sinc(x); }
    var ax = x;
    if (f64_lt(ax, f64_from(0)) == 1) { ax = f64_neg(ax); }
    if (f64_gt(ax, half_width) == 1) { return f64_from(0); }
    # Hann envelope 0.5 * (1 - cos(pi (x + hw) / hw)) = 0.5 * (1 + cos(pi |x| / hw)),
    # on |x| so k(x) == k(-x) bit for bit (through 2.4.9 it was built from the
    # signed x + hw, a few ulp asymmetric). The ratio |x| / hw comes first: it
    # lies in [0, 1] and is exactly 1 at the edge. Through 2.5.2 the product
    # pi |x| came first, which rounds to a few ulp for a subnormal hw
    # (sinc_kernel(5e-324, 5e-324) was 0.005, not 0) and overflows past
    # |x| ~ 5.7e307 (NaN) (2.6.0 P(-1) review).
    var env = f64_mul(DSP_HALF, f64_add(DSP_ONE, f64_cos(f64_mul(DSP_PI, f64_div(ax, half_width)))));
    return f64_mul(f64_sinc(x), env);
}

# ================================================================
# Chromagram helpers — pitch class mapping
# ================================================================

# C0 = 440 / 2^(57/12) Hz (MIDI note 12), the reference for pitch class
# computation. Through 2.4.7 this was 0x4030_B400_0000_0000 — 16.703125 Hz, 2%
# sharp — so every pitch class and octave came out 0.368 semitone flat, and a
# tone more than ~0.13 semitone flat of a note (435 Hz for A4) read as the note
# below. Same failure class as the 2.3.2 dB constants (CHANGELOG 2.4.8).
var DSP_C0_FREQ = 0x4030_5A02_50C2_B956;   # 16.351597831287414 Hz — MIDI 12

# Internal: round(12 * log2(freq / C0)) — semitones above C0 as an integer.
# Returns -1 unless freq is positive and finite (NaN fails the > 0 test); a
# note below C0 comes back negative, which the callers treat the same way.
fn _freq_semis_from_c0(freq) {
    if (f64_gt(freq, f64_from(0)) == 0) { return 0 - 1; }
    var semis = f64_mul(DSP_SEMITONES, f64_log2(f64_div(freq, DSP_C0_FREQ)));
    # Only freq = +Inf leaves i64 range (DBL_MAX is ~12,240 semitones up).
    # Checked because Cyrius 6.6.8+ saturates it to i64_MAX — pitch class 7,
    # octave 768614336404564650 — where x86 before it gave i64_MIN, so -1.
    var st, n = abaco_f64_to_i64(f64_round_half_away(semis));
    if (is_ok(st) == 0) { return 0 - 1; }
    return n;
}

# freq_to_pitch_class: 0..11 for C..B, or -1 when freq is not a positive finite
# number or rounds to a note below C0.
fn freq_to_pitch_class(freq) {
    var n = _freq_semis_from_c0(freq);
    if (n < 0) { return 0 - 1; }
    var pc = n % 12;
    if (pc < 0) { pc = pc + 12; }
    return pc;
}

# freq_to_octave: 0..N indicating which octave above C0 the freq falls in, or
# -1 when freq is not a positive finite number or rounds to a note below C0.
fn freq_to_octave(freq) {
    var n = _freq_semis_from_c0(freq);
    if (n < 0) { return 0 - 1; }
    return n / 12;
}

# Pitch-class name for 0..11 (12-TET, C..B). Returns "?" out of range.
fn pitch_class_name(pc) {
    switch (pc) {
        case 0:  return "C";
        case 1:  return "C#";
        case 2:  return "D";
        case 3:  return "D#";
        case 4:  return "E";
        case 5:  return "F";
        case 6:  return "F#";
        case 7:  return "G";
        case 8:  return "G#";
        case 9:  return "A";
        case 10: return "A#";
        case 11: return "B";
        default: return "?";
    }
}
