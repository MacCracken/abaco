# abaco::ai — natural-language parsing, calculation history, currency conversion.
#
# The currency converter is a rates cache (`set_rates` + `convert`) plus a
# live fetch (`CurrencyCache_fetch`). Two transports:
#   - http://localhost / http://127.0.0.1 (whole host): plaintext, lib/http.cyr,
#     for a local rates server. Always compiled.
#   - https://: lib/tls.cyr's native backend, OPT-IN. A build without
#     `-D ABACO_TLS` refuses https:// with AI_ERR_TLS ("built without TLS"),
#     so a DSP-only consumer never links the TLS stack. With the define the
#     consumer adds "tls" to its own [deps].stdlib and calls abaco_tls_init()
#     once on the main thread before any thread fetches (see that fn). Each
#     fetch runs under a whole-fetch deadline (CCY_TLS_DEADLINE_MS, a
#     per-fetch watchdog thread on Linux).
# The URL / request / response parsers of the HTTPS path, and the certificate
# and CA-bundle checks it adds to lib/tls.cyr's, are always compiled (pure
# functions; DCE drops them when unused), so fuzz/fuzz_ai.fcyr covers them
# without the TLS stack. Sources: docs/sources.md (RFC 8446, 5246, 9525, 5280,
# 9110, 1945; X.690).

enum AiError {
    AI_OK;
    AI_ERR_PARSE;
    AI_ERR_UNSUPPORTED;
    AI_ERR_CURRENCY;
    AI_ERR_HTTP;
    # 2.4.12: the HTTPS path's TLS layer refused, or HTTPS is not available —
    # certificate chain or name, a malformed or undecryptable record, an
    # alert in the handshake, the CA file (unreadable, no certificate, over
    # 300), or no HTTPS in this run (built without -D ABACO_TLS,
    # abaco_tls_init() not run, the libssl backend selected). A socket
    # failure, timeout or the deadline, at any stage, is AI_ERR_HTTP.
    # Appended: earlier values unchanged.
    AI_ERR_TLS;
}

# ================================================================
# ParsedQuery — tagged union
# Layout: { kind (i64), value (f64 bits), s1 (cstr*), s2 (cstr*) }
#   kind=0  Calculation(expr=s1)
#   kind=1  Conversion(value, from=s1, to=s2)
#   kind=2  CurrencyConversion(value, from=s1, to=s2)
# ================================================================
enum ParsedQueryKind {
    PQ_CALCULATION;
    PQ_CONVERSION;
    PQ_CURRENCY;
}

# Build a ParsedQuery tagged with one of PQ_CALCULATION / PQ_CONVERSION /
# PQ_CURRENCY. Field meaning depends on kind (see the layout comment above).
fn ParsedQuery_new(kind, value, s1, s2) {
    var p = alloc(32);
    store64(p, kind);
    store64(p + 8, value);
    store64(p + 16, s1);
    store64(p + 24, s2);
    return p;
}

fn pq_kind(p) { return load64(p); }
fn pq_value(p) { return load64(p + 8); }
fn pq_s1(p) { return load64(p + 16); }
fn pq_s2(p) { return load64(p + 24); }

# ================================================================
# NlParser — pure string parsing. No state.
# ================================================================

# Split on whitespace runs. Returns a vec of cstrings.
fn _nl_split_ws(s) {
    var parts = vec_new();
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        while (i < len) {
            if (is_space(load8(s + i)) == 0) { break; }
            i = i + 1;
        }
        var start = i;
        while (i < len) {
            if (is_space(load8(s + i)) == 1) { break; }
            i = i + 1;
        }
        if (i > start) {
            var n = i - start;
            var buf = alloc(n + 1);
            memcpy(buf, s + start, n);
            store8(buf + n, 0);
            vec_push(parts, buf);
        }
    }
    return parts;
}

# Return 1 if haystack starts with prefix, else 0.
fn _nl_starts_with(s, prefix) {
    var pl = strlen(prefix);
    var sl = strlen(s);
    if (sl < pl) { return 0; }
    var i = 0;
    while (i < pl) {
        if (load8(s + i) != load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Parse the whole cstring as one decimal literal. Returns Ok(value) or Err(0).
# Grammar: optional blanks, optional sign, digits with at most one '.' and at
# least one digit, an optional e/E exponent with optional sign and 1+ digits,
# then the end of the string. The value comes from the evaluator's
# parse_number, so a literal means the same here as inside an expression
# (correctly rounded); one that overflows to Inf is refused. The strictness is
# load-bearing for the CWE-917 guard in _nl_try_percent_of.
fn _nl_parse_f64(s) {
    if (s == 0) { return Err(0); }
    var len = strlen(s);
    var i = 0;
    while (i < len && (load8(s + i) == 32 || load8(s + i) == 9)) { i = i + 1; }
    var neg = 0;
    if (i < len && (load8(s + i) == 45 || load8(s + i) == 43)) {
        if (load8(s + i) == 45) { neg = 1; }
        i = i + 1;
    }
    var start = i;
    var digits = 0;
    var dots = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c >= 48 && c <= 57) { digits = digits + 1; }
        elif (c == 46) { dots = dots + 1; }
        else { break; }
        i = i + 1;
    }
    if (digits == 0 || dots > 1) { return Err(0); }
    if (i < len && (load8(s + i) == 101 || load8(s + i) == 69)) {
        i = i + 1;
        if (i < len && (load8(s + i) == 43 || load8(s + i) == 45)) { i = i + 1; }
        var edigits = 0;
        while (i < len && load8(s + i) >= 48 && load8(s + i) <= 57) {
            edigits = edigits + 1;
            i = i + 1;
        }
        if (edigits == 0) { return Err(0); }
    }
    if (i != len) { return Err(0); }
    var v, end = parse_number(s, start, len);
    if (end != len) { return Err(0); }
    if (_f64_is_finite(v) == 0) { return Err(0); }
    if (neg == 1) { v = f64_neg(v); }
    return Ok(v);
}

# Known ISO currency codes (lowercase). Returns 1 if w matches any.
fn _nl_is_currency(w) {
    if (streq(w, "usd") == 1) { return 1; }
    if (streq(w, "eur") == 1) { return 1; }
    if (streq(w, "gbp") == 1) { return 1; }
    if (streq(w, "jpy") == 1) { return 1; }
    if (streq(w, "cad") == 1) { return 1; }
    if (streq(w, "aud") == 1) { return 1; }
    if (streq(w, "chf") == 1) { return 1; }
    if (streq(w, "cny") == 1) { return 1; }
    if (streq(w, "inr") == 1) { return 1; }
    if (streq(w, "krw") == 1) { return 1; }
    if (streq(w, "brl") == 1) { return 1; }
    if (streq(w, "mxn") == 1) { return 1; }
    if (streq(w, "sek") == 1) { return 1; }
    if (streq(w, "nok") == 1) { return 1; }
    if (streq(w, "dkk") == 1) { return 1; }
    if (streq(w, "nzd") == 1) { return 1; }
    if (streq(w, "sgd") == 1) { return 1; }
    if (streq(w, "hkd") == 1) { return 1; }
    if (streq(w, "try") == 1) { return 1; }
    if (streq(w, "rub") == 1) { return 1; }
    if (streq(w, "zar") == 1) { return 1; }
    if (streq(w, "pln") == 1) { return 1; }
    if (streq(w, "thb") == 1) { return 1; }
    if (streq(w, "twd") == 1) { return 1; }
    return 0;
}

# ---- NlParser entry points ----------------------------------------------

# The word vecs below come in pairs: `words` from the text as typed and
# `lwords` from its lowercased copy. str_lower keeps every byte position, so
# the two split identically; keywords are matched on `lwords` and payloads
# (unit names, which are case-significant) taken from `words`.

# Try "<number> <ccy> to/in <ccy>", exactly four words.
fn _nl_try_currency(words, lwords) {
    if (vec_len(words) != 4) { return 0; }
    var valt, v = _nl_parse_f64(vec_get(words, 0));
    if (is_ok(valt) != 1) { return 0; }
    var from = vec_get(lwords, 1);
    var conn = vec_get(lwords, 2);
    var to = vec_get(lwords, 3);
    if (streq(conn, "to") == 0 && streq(conn, "in") == 0) { return 0; }
    if (_nl_is_currency(from) == 0) { return 0; }
    if (_nl_is_currency(to) == 0) { return 0; }
    return ParsedQuery_new(PQ_CURRENCY, v, str_upper(from), str_upper(to));
}

# Try "<number> <unit...> to/in <unit...>".
fn _nl_try_conversion(words, lwords) {
    var wn = vec_len(words);
    if (wn < 4) { return 0; }
    var valt, v = _nl_parse_f64(vec_get(words, 0));
    if (is_ok(valt) != 1) { return 0; }
    # Find "to" or "in" separator at position i >= 2.
    var i = 2;
    while (i < wn) {
        var w = vec_get(lwords, i);
        if (streq(w, "to") == 1) { break; }
        if (streq(w, "in") == 1) { break; }
        i = i + 1;
    }
    if (i >= wn) { return 0; }
    # from words [1..i], to words [i+1..wn].
    var from_parts = vec_new();
    var k = 1;
    while (k < i) { vec_push(from_parts, vec_get(words, k)); k = k + 1; }
    var to_parts = vec_new();
    k = i + 1;
    while (k < wn) { vec_push(to_parts, vec_get(words, k)); k = k + 1; }
    if (vec_len(from_parts) == 0) { return 0; }
    if (vec_len(to_parts) == 0) { return 0; }
    var from = _nl_join_space(from_parts);
    var to = _nl_join_space(to_parts);
    return ParsedQuery_new(PQ_CONVERSION, v, from, to);
}

# Join a vec of cstrings with a single space; returns a fresh cstring.
fn _nl_join_space(parts) {
    var n = vec_len(parts);
    if (n == 0) {
        var empty = alloc(1);
        store8(empty, 0);
        return empty;
    }
    var total = 0;
    var i = 0;
    while (i < n) {
        total = total + strlen(vec_get(parts, i));
        i = i + 1;
    }
    total = total + (n - 1);   # separators
    var buf = alloc(total + 1);
    var off = 0;
    i = 0;
    while (i < n) {
        if (i > 0) { store8(buf + off, 32); off = off + 1; }
        var p = vec_get(parts, i);
        var pl = strlen(p);
        memcpy(buf + off, p, pl);
        off = off + pl;
        i = i + 1;
    }
    store8(buf + total, 0);
    return buf;
}

# "<pct>% of <base>" -> "<base> * <pct> / 100", else 0. The needle is found
# in `lower` (so "% OF " counts); the operands are sliced from `s`.
fn _nl_try_percent_of(s, lower) {
    var needle = "% of ";
    var len = strlen(s);
    var nlen = strlen(needle);
    # find needle in lower
    var pos = 0 - 1;
    var i = 0;
    while (i + nlen <= len) {
        var j = 0;
        var ok = 1;
        while (j < nlen) {
            if (load8(lower + i + j) != load8(needle + j)) { ok = 0; break; }
            j = j + 1;
        }
        if (ok == 1) { pos = i; break; }
        i = i + 1;
    }
    if (pos < 0) { return 0; }
    # pct = s[0..pos], base = s[pos+nlen..]
    var pct_buf = alloc(pos + 1);
    memcpy(pct_buf, s, pos);
    store8(pct_buf + pos, 0);
    var pct = _nl_trim_simple(pct_buf);
    var brest_len = len - (pos + nlen);
    var base_buf = alloc(brest_len + 1);
    memcpy(base_buf, s + pos + nlen, brest_len);
    store8(base_buf + brest_len, 0);
    var base = _nl_trim_simple(base_buf);
    # CWE-917 hardening: both pct *and* base must be strict numeric
    # literals. Without this, an input like "2+3% of 4" gets expanded to
    # "4 * 2+3 / 100" and parses as (4*2) + (3/100) — a silently wrong
    # number for a financial/calc tool. Rejecting the phrase is safer
    # than eagerly rewriting it.
    if (is_ok(_nl_parse_f64(pct)) != 1) { return 0; }
    if (is_ok(_nl_parse_f64(base)) != 1) { return 0; }
    # Compose "<base> * <pct> / 100".
    var bl = strlen(base);
    var pl = strlen(pct);
    var out_len = bl + 3 + pl + 6;
    var out = alloc(out_len + 1);
    var off = 0;
    memcpy(out + off, base, bl); off = off + bl;
    store8(out + off, 32); off = off + 1;
    store8(out + off, 42); off = off + 1;
    store8(out + off, 32); off = off + 1;
    memcpy(out + off, pct, pl); off = off + pl;
    store8(out + off, 32); off = off + 1;
    store8(out + off, 47); off = off + 1;
    store8(out + off, 32); off = off + 1;
    store8(out + off, 49); off = off + 1;
    store8(out + off, 48); off = off + 1;
    store8(out + off, 48); off = off + 1;
    store8(out + off, 0);
    return out;
}

# Simple trim (no-mutation variant of _nl_trim used above to avoid control flow issues).
fn _nl_trim_simple(s) {
    var len = strlen(s);
    var start = 0;
    while (start < len) {
        if (is_space(load8(s + start)) == 0) { break; }
        start = start + 1;
    }
    var end = len;
    while (end > start) {
        if (is_space(load8(s + end - 1)) == 0) { break; }
        end = end - 1;
    }
    var n = end - start;
    var buf = alloc(n + 1);
    memcpy(buf, s + start, n);
    store8(buf + n, 0);
    return buf;
}

# Length of the leading verb phrase of lowercased text, or 0. Keywords end in
# a space so "evaluate" is not "eval" + "uate".
fn _nl_verb_len(lower) {
    if (_nl_starts_with(lower, "convert ") == 1) { return 8; }
    if (_nl_starts_with(lower, "what is ") == 1) { return 8; }
    if (_nl_starts_with(lower, "what's ") == 1) { return 7; }
    if (_nl_starts_with(lower, "calculate ") == 1) { return 10; }
    if (_nl_starts_with(lower, "compute ") == 1) { return 8; }
    if (_nl_starts_with(lower, "eval ") == 1) { return 5; }
    if (_nl_starts_with(lower, "how much is ") == 1) { return 12; }
    return 0;
}

# Copy of s with each U+2212 MINUS SIGN (E2 88 92), the minus of typeset and
# pasted text, replaced by '-'. The evaluator rejects non-ASCII bytes, so
# without this a pasted "3 − 2" is a parse error. Returns s if none.
fn _nl_ascii_minus(s) {
    var len = strlen(s);
    var i = 0;
    while (i + 2 < len) {
        if (load8(s + i) == 226 && load8(s + i + 1) == 136 && load8(s + i + 2) == 146) { break; }
        i = i + 1;
    }
    if (i + 2 >= len) { return s; }
    var buf = alloc(len + 1);
    var o = 0;
    i = 0;
    while (i < len) {
        if (i + 2 < len && load8(s + i) == 226 && load8(s + i + 1) == 136 && load8(s + i + 2) == 146) {
            store8(buf + o, 45);
            o = o + 1;
            i = i + 3;
        } else {
            store8(buf + o, load8(s + i));
            o = o + 1;
            i = i + 1;
        }
    }
    store8(buf + o, 0);
    return buf;
}

# s without one final '?' or '.' ("what is 2 + 3?", "5 km to mi."), trimmed.
fn _nl_drop_final_punct(s) {
    var len = strlen(s);
    if (len == 0) { return s; }
    var c = load8(s + len - 1);
    if (c != 63 && c != 46) { return s; }
    var buf = alloc(len);
    memcpy(buf, s, len - 1);
    store8(buf + len - 1, 0);
    return _nl_trim_simple(buf);
}

# Does s contain any char that hints at arithmetic?
fn _nl_looks_numeric(s) {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (is_digit(c) == 1) { return 1; }
        if (c == 43) { return 1; }  # +
        if (c == 45) { return 1; }  # -
        if (c == 42) { return 1; }  # *
        if (c == 47) { return 1; }  # /
        if (c == 94) { return 1; }  # ^
        if (c == 37) { return 1; }  # %
        if (c == 40) { return 1; }  # (
        if (c == 41) { return 1; }  # )
        if (c == 46) { return 1; }  # .
        i = i + 1;
    }
    return 0;
}

# Parse natural language input into a ParsedQuery ptr, or 0 on parse failure.
#
# Keywords ("convert", "what is", "to", "in", "% of", currency codes) match in
# any case; everything handed on — unit names, the expression — keeps the
# case it was typed in, because SI symbols (MW vs mW) and evaluator names are
# case-sensitive. One leading verb is stripped before every form is tried, so
# "convert 100 usd to eur" is a currency query and "what is 5 km in mi" a
# conversion.
fn nl_parse(input) {
    if (input == 0) { return 0; }
    var text = _nl_drop_final_punct(_nl_trim_simple(_nl_ascii_minus(input)));
    var lower = str_lower(text);
    var vl = _nl_verb_len(lower);
    var body = text;
    var lbody = lower;
    if (vl > 0) {
        body = _nl_trim_simple(text + vl);
        lbody = str_lower(body);
    }
    var words = _nl_split_ws(body);
    var lwords = _nl_split_ws(lbody);
    var q = _nl_try_currency(words, lwords);
    if (q != 0) { return q; }
    q = _nl_try_conversion(words, lwords);
    if (q != 0) { return q; }
    var pct = _nl_try_percent_of(body, lbody);
    if (pct != 0) { return ParsedQuery_new(PQ_CALCULATION, 0, pct, 0); }
    # A calculation verb hands on whatever follows it; "convert" does not.
    if (vl > 0 && _nl_starts_with(lower, "convert ") == 0) {
        return ParsedQuery_new(PQ_CALCULATION, 0, body, 0);
    }
    if (_nl_looks_numeric(text) == 1) {
        return ParsedQuery_new(PQ_CALCULATION, 0, text, 0);
    }
    return 0;
}

# ================================================================
# CalculationHistory — bounded ring buffer of (input, result, timestamp) entries.
# Layout: { slots_vec, max_entries, head }
#   Until slots_vec holds max_entries entries, a push appends and head stays 0.
#   From then on a push overwrites the oldest slot (head) and advances head, so
#   entry i (0 = oldest) is slot (head + i) % len. O(1) per push, no copying.
# Entry layout: { input_cstr, result_cstr, timestamp_cstr }
# The history keeps the caller's string pointers; it does not copy them.
# ================================================================

# Build a single history entry: input expression, formatted result, RFC-3339
# timestamp cstring supplied by the caller (decoupled from any time API).
fn HistoryEntry_new(input, result, timestamp) {
    var e = alloc(24);
    store64(e, input);
    store64(e + 8, result);
    store64(e + 16, timestamp);
    return e;
}

fn he_input(e) { return load64(e); }
fn he_result(e) { return load64(e + 8); }
fn he_timestamp(e) { return load64(e + 16); }

# Build a bounded history buffer holding up to `max_entries` entries.
# Push is FIFO: the oldest entry is dropped when at capacity. A history made
# with max_entries <= 0 stores nothing.
fn CalcHistory_new(max_entries) {
    var h = alloc(24);
    store64(h, vec_new());        # slots
    store64(h + 8, max_entries);
    store64(h + 16, 0);           # head
    return h;
}

# Raw slot storage, in ring order (not oldest-first once the ring has
# wrapped). Use CalcHistory_get to read entries in order.
fn history_entries(h) { return load64(h); }
fn history_max(h) { return load64(h + 8); }

# Number of history entries currently held.
fn CalcHistory_len(h) {
    return vec_len(load64(h));
}

# Return 1 if the history holds zero entries.
fn CalcHistory_is_empty(h) {
    if (vec_len(load64(h)) == 0) { return 1; }
    return 0;
}

# Discard all entries; the buffer remains usable with the same capacity.
fn CalcHistory_clear(h) {
    store64(h, vec_new());
    store64(h + 16, 0);
    return 0;
}

# Store entry `e`, overwriting the oldest one when at capacity.
fn _history_put(h, e) {
    var max_n = load64(h + 8);
    if (max_n <= 0) { return 0; }
    var slots = load64(h);
    if (vec_len(slots) < max_n) {
        vec_push(slots, e);
        return 0;
    }
    var head = load64(h + 16);
    vec_set(slots, head, e);
    head = head + 1;
    if (head >= vec_len(slots)) { head = 0; }
    store64(h + 16, head);
    return 0;
}

# Push a new entry. If at capacity, drop the oldest.
# The caller supplies the timestamp so we don't couple to a Cyrius time API.
fn CalcHistory_push(h, input, result, timestamp) {
    return _history_put(h, HistoryEntry_new(input, result, timestamp));
}

# Return the i-th entry (0 is oldest), or 0 when i is out of range.
fn CalcHistory_get(h, i) {
    var slots = load64(h);
    var n = vec_len(slots);
    if (i < 0 || i >= n) { return 0; }
    var k = load64(h + 16) + i;
    if (k >= n) { k = k - n; }
    return vec_get(slots, k);
}

# Append cstring `s` to string builder `sb` as a JSON string. Escapes every
# byte RFC 8259 requires (quote, backslash and all of U+0000-U+001F); other
# bytes pass through, so the output is UTF-8 when the input is.
fn _he_json_escape(sb, s) {
    str_builder_add_json_str(sb, str_new(s, strlen(s)));
    return 0;
}

# Serialise the whole history as a JSON array of `{input, result, timestamp}`
# objects, oldest first. Returns a fresh Str.
fn CalcHistory_to_json(h) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var n = CalcHistory_len(h);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var e = CalcHistory_get(h, i);
        str_builder_add_cstr(sb, "{\"input\":");
        _he_json_escape(sb, he_input(e));
        str_builder_add_cstr(sb, ",\"result\":");
        _he_json_escape(sb, he_result(e));
        str_builder_add_cstr(sb, ",\"timestamp\":");
        _he_json_escape(sb, he_timestamp(e));
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# Value of hex digit byte c, or -1.
fn _jf_hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

# The four hex digits after body[off] (the 'u' of a \u escape) as a UTF-16
# code unit, or -1 if they are missing or not hex.
fn _jf_u16(body, len, off) {
    if (off + 4 >= len) { return 0 - 1; }
    var v = 0;
    var k = 1;
    while (k <= 4) {
        var d = _jf_hexval(load8(body + off + k));
        if (d < 0) { return 0 - 1; }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

# Append code point cp (1..0x10FFFF, not a surrogate) to sb as UTF-8.
fn _jf_put_utf8(sb, cp) {
    if (cp < 128) {
        str_builder_add_byte(sb, cp);
    } elif (cp < 2048) {
        str_builder_add_byte(sb, 192 | (cp >> 6));
        str_builder_add_byte(sb, 128 | (cp & 63));
    } elif (cp < 65536) {
        str_builder_add_byte(sb, 224 | (cp >> 12));
        str_builder_add_byte(sb, 128 | ((cp >> 6) & 63));
        str_builder_add_byte(sb, 128 | (cp & 63));
    } else {
        str_builder_add_byte(sb, 240 | (cp >> 18));
        str_builder_add_byte(sb, 128 | ((cp >> 12) & 63));
        str_builder_add_byte(sb, 128 | ((cp >> 6) & 63));
        str_builder_add_byte(sb, 128 | (cp & 63));
    }
    return 0;
}

# Extract a string-valued field `key` from a JSON object-slice at
# `body[..len]` and decode its escapes (RFC 8259 §7: \" \\ \/ \b \f \n \r
# \t and \u plus four hex digits, surrogate pairs included, to UTF-8). Returns a fresh
# cstring, or 0 when the key is missing, the value is not a string, the
# string is unterminated, or an escape is unknown, malformed, a lone
# surrogate or \u0000 (which a cstring cannot hold). Raw bytes, control
# bytes included, are kept: files written before 2.4.9 carry them.
fn _jfa_get_string(body, len, key) {
    var off = _jf_find_value(body, len, key);
    if (off < 0) { return 0; }
    if (load8(body + off) != 34) { return 0; }
    off = off + 1;
    var out_sb = str_builder_new();
    var closed = 0;
    while (off < len) {
        var c = load8(body + off);
        if (c == 34) { closed = 1; break; }
        if (c == 92) {
            off = off + 1;
            if (off >= len) { return 0; }
            var esc = load8(body + off);
            if (esc == 110)      { str_builder_add_byte(out_sb, 10); }
            elif (esc == 114)    { str_builder_add_byte(out_sb, 13); }
            elif (esc == 116)    { str_builder_add_byte(out_sb, 9); }
            elif (esc == 98)     { str_builder_add_byte(out_sb, 8); }
            elif (esc == 102)    { str_builder_add_byte(out_sb, 12); }
            elif (esc == 34)     { str_builder_add_byte(out_sb, 34); }
            elif (esc == 92)     { str_builder_add_byte(out_sb, 92); }
            elif (esc == 47)     { str_builder_add_byte(out_sb, 47); }
            elif (esc == 117) {
                var cp = _jf_u16(body, len, off);
                if (cp <= 0) { return 0; }
                off = off + 4;
                if (cp >= 56320 && cp <= 57343) { return 0; }      # lone low surrogate
                if (cp >= 55296 && cp <= 56319) {
                    # High surrogate: a \uDC00-\uDFFF must follow.
                    if (off + 2 >= len) { return 0; }
                    if (load8(body + off + 1) != 92 || load8(body + off + 2) != 117) { return 0; }
                    var lo = _jf_u16(body, len, off + 2);
                    if (lo < 56320 || lo > 57343) { return 0; }
                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                    off = off + 6;
                }
                _jf_put_utf8(out_sb, cp);
            }
            else { return 0; }
        } else {
            str_builder_add_byte(out_sb, c);
        }
        off = off + 1;
    }
    if (closed == 0) { return 0; }
    var built = str_builder_build(out_sb);
    # Convert Str -> fresh cstring so the rest of the ai module can use it.
    var slen = str_len(built);
    var buf = alloc(slen + 1);
    memcpy(buf, str_data(built), slen);
    store8(buf + slen, 0);
    return buf;
}

# Index of the first byte at or after i in data[..len] that is not JSON
# whitespace (space, tab, CR, LF); len if there is none.
fn _jf_skip_ws(data, len, i) {
    while (i < len) {
        var c = load8(data + i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return i; }
        i = i + 1;
    }
    return len;
}

# Index just past the JSON string whose opening quote is d[i], or -1 when it
# is unterminated or holds an escape RFC 8259 does not define. Raw bytes are
# accepted, control bytes included: history files written before 2.4.9 carry
# them unescaped.
fn _json_string_end(d, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(d + i);
        if (c == 34) { return i + 1; }
        if (c == 92) {
            if (i + 1 >= len) { return 0 - 1; }
            var esc = load8(d + i + 1);
            if (esc == 117) {
                if (_jf_u16(d, len, i + 1) < 0) { return 0 - 1; }
                i = i + 6;
            } elif (esc == 34 || esc == 92 || esc == 47 || esc == 98 || esc == 102
              || esc == 110 || esc == 114 || esc == 116) {
                i = i + 2;
            } else {
                return 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

# Index just past the JSON number at d[i] (RFC 8259 §6: -?(0|[1-9]digits)
# (.digits)?([eE][+-]?digits)?), or -1.
fn _json_number_end(d, len, i) {
    if (i < len && load8(d + i) == 45) { i = i + 1; }
    if (i >= len) { return 0 - 1; }
    var c = load8(d + i);
    if (c == 48) { i = i + 1; }
    elif (c >= 49 && c <= 57) {
        while (i < len && load8(d + i) >= 48 && load8(d + i) <= 57) { i = i + 1; }
    } else {
        return 0 - 1;
    }
    if (i < len && load8(d + i) == 46) {
        i = i + 1;
        var fd = 0;
        while (i < len && load8(d + i) >= 48 && load8(d + i) <= 57) { i = i + 1; fd = fd + 1; }
        if (fd == 0) { return 0 - 1; }
    }
    if (i < len && (load8(d + i) == 101 || load8(d + i) == 69)) {
        i = i + 1;
        if (i < len && (load8(d + i) == 43 || load8(d + i) == 45)) { i = i + 1; }
        var ed = 0;
        while (i < len && load8(d + i) >= 48 && load8(d + i) <= 57) { i = i + 1; ed = ed + 1; }
        if (ed == 0) { return 0 - 1; }
    }
    return i;
}

# Index just past the JSON value that starts at d[i] (after whitespace), or
# -1 when it is not one well-formed RFC 8259 value or nests deeper than
# `depth` objects/arrays. The structural scans in this module find what they
# need inside a document; this decides whether the document is JSON at all,
# so they never read a malformed one (2.4.9 final review: a missing ':' or
# comma inside an object slid through, and the rates loader then read the
# next key's value as this one's).
fn _json_value_end(d, len, i, depth) {
    i = _jf_skip_ws(d, len, i);
    if (i >= len) { return 0 - 1; }
    var c = load8(d + i);
    if (c == 34) { return _json_string_end(d, len, i); }
    if (c == 116) { if (i + 4 <= len && memeq(d + i, "true", 4) == 1) { return i + 4; } return 0 - 1; }
    if (c == 102) { if (i + 5 <= len && memeq(d + i, "false", 5) == 1) { return i + 5; } return 0 - 1; }
    if (c == 110) { if (i + 4 <= len && memeq(d + i, "null", 4) == 1) { return i + 4; } return 0 - 1; }
    if (c != 123 && c != 91) { return _json_number_end(d, len, i); }
    if (depth <= 0) { return 0 - 1; }
    var close = 125;
    if (c == 91) { close = 93; }
    i = _jf_skip_ws(d, len, i + 1);
    if (i < len && load8(d + i) == close) { return i + 1; }
    while (i < len) {
        if (c == 123) {
            if (load8(d + i) != 34) { return 0 - 1; }
            i = _json_string_end(d, len, i);
            if (i < 0) { return 0 - 1; }
            i = _jf_skip_ws(d, len, i);
            if (i >= len || load8(d + i) != 58) { return 0 - 1; }
            i = i + 1;
        }
        i = _json_value_end(d, len, i, depth - 1);
        if (i < 0) { return 0 - 1; }
        i = _jf_skip_ws(d, len, i);
        if (i >= len) { return 0 - 1; }
        var sep = load8(d + i);
        if (sep == close) { return i + 1; }
        if (sep != 44) { return 0 - 1; }
        i = _jf_skip_ws(d, len, i + 1);
    }
    return 0 - 1;
}

# 1 when d[0..len) is exactly one JSON value (whitespace around it allowed)
# nesting at most `depth` deep.
fn _json_doc_ok(d, len, depth) {
    var end = _json_value_end(d, len, 0, depth);
    if (end < 0) { return 0; }
    if (_jf_skip_ws(d, len, end) != len) { return 0; }
    return 1;
}

# Nesting limit for a history document: an array of flat objects needs 2.
enum HistoryJson { AI_HISTORY_JSON_DEPTH = 64; }

# Parse a JSON array of `{input, result, timestamp}` objects and append each
# entry to `h` (oldest first; at capacity the oldest are dropped). Returns 0
# on success and AI_ERR_PARSE on anything else: no leading '[', a missing ','
# or closing ']', bytes after it, an object without the three string fields
# or with a bad escape. The whole array is checked before the first entry is
# stored, so an error leaves `h` as it was.
fn CalcHistory_from_json(h, json_cstr) {
    if (json_cstr == 0) { return AI_ERR_PARSE; }
    var data = json_cstr;
    var dlen = strlen(json_cstr);
    if (_json_doc_ok(data, dlen, AI_HISTORY_JSON_DEPTH) == 0) { return AI_ERR_PARSE; }
    var i = _jf_skip_ws(data, dlen, 0);
    if (i >= dlen || load8(data + i) != 91) { return AI_ERR_PARSE; }
    i = _jf_skip_ws(data, dlen, i + 1);
    var staged = vec_new();
    var c = 0;
    var start = 0;
    var depth = 0;
    if (i < dlen && load8(data + i) == 93) {
        i = i + 1;                                  # []
    } else {
        var more = 1;
        while (more == 1) {
            if (i >= dlen || load8(data + i) != 123) { return AI_ERR_PARSE; }
            # Find the matching close-brace, skipping over string contents.
            #
            # This scan used to count raw braces (2.3.4 fix): a single '{' or
            # '}' inside any field — legal JSON needing no escape, and
            # something `to_json` emits verbatim — moved the object boundary
            # and made the whole remaining array unparseable.
            start = i;
            depth = 1;
            i = i + 1;
            while (i < dlen) {
                c = load8(data + i);
                if (c == 34) { i = _jf_skip_string(data, dlen, i); }
                elif (c == 123) { depth = depth + 1; i = i + 1; }
                elif (c == 125) {
                    depth = depth - 1;
                    if (depth == 0) { break; }
                    i = i + 1;
                }
                else { i = i + 1; }
            }
            if (depth != 0) { return AI_ERR_PARSE; }
            var obj = data + start;
            var olen = i - start + 1;
            var inp = _jfa_get_string(obj, olen, "input");
            var res = _jfa_get_string(obj, olen, "result");
            var ts  = _jfa_get_string(obj, olen, "timestamp");
            if (inp == 0) { return AI_ERR_PARSE; }
            if (res == 0) { return AI_ERR_PARSE; }
            if (ts == 0)  { return AI_ERR_PARSE; }
            vec_push(staged, HistoryEntry_new(inp, res, ts));
            i = _jf_skip_ws(data, dlen, i + 1);
            if (i >= dlen) { return AI_ERR_PARSE; }
            c = load8(data + i);
            if (c == 44) { i = _jf_skip_ws(data, dlen, i + 1); }
            elif (c == 93) { i = i + 1; more = 0; }
            else { return AI_ERR_PARSE; }
        }
    }
    if (_jf_skip_ws(data, dlen, i) != dlen) { return AI_ERR_PARSE; }
    var k = 0;
    while (k < vec_len(staged)) {
        _history_put(h, vec_get(staged, k));
        k = k + 1;
    }
    return 0;
}

# Largest history file save_to_file writes and load_from_file reads (16 MiB),
# so whatever one saves the other can load.
var AI_HISTORY_MAX_BYTES = 16777216;

# Save the history to a JSON file at `path`. Returns 0 on success,
# AI_ERR_HTTP when the write fails or the JSON is over AI_HISTORY_MAX_BYTES
# (the code is reused as "I/O error"). The write is atomic: a temp file is
# renamed over `path`, so a failed save leaves the previous file intact.
fn CalcHistory_save_to_file(h, path) {
    var s = CalcHistory_to_json(h);
    if (str_len(s) > AI_HISTORY_MAX_BYTES) { return AI_ERR_HTTP; }
    if (file_write_atomic(path, str_data(s), str_len(s)) != 0) { return AI_ERR_HTTP; }
    return 0;
}

# Load a history from a JSON file, appending entries to an existing `h`.
# Pass a freshly-constructed history to get a clean load. Returns 0 on
# success (an empty file is an empty history), AI_ERR_PARSE on malformed JSON
# or a file over AI_HISTORY_MAX_BYTES, AI_ERR_HTTP when the file cannot be
# read. Through 2.4.8 the read cap was 64 KiB while save had none, so a
# history of a few hundred entries saved fine and then failed to load.
fn CalcHistory_load_from_file(h, path) {
    var nb[8];
    var buf = file_read_whole_max(path, AI_HISTORY_MAX_BYTES, &nb);
    var n = load64(&nb);
    if (buf == 0) {
        if (n == 0 - 27) { return AI_ERR_PARSE; }   # -EFBIG
        return AI_ERR_HTTP;
    }
    if (n == 0) { return 0; }
    # JSON text holds no NUL; one here would hide the rest of the file from
    # from_json, which reads a cstring.
    if (strlen(buf) != n) { return AI_ERR_PARSE; }
    return CalcHistory_from_json(h, buf);
}

# ================================================================
# CurrencyConverter — rates cache + conversion, and the live fetch
# described at the top of this file.
# Layout: { base_cstr, rates_map, base_url_cstr, ca_file_cstr, ca_buf, ca_cap,
#           deadline_ms }
# rates_map is a hashmap<cstr, f64_bits>; ca_file_cstr 0 = system trust store.
# ca_buf / ca_cap: the { ptr, cap } read buffer the CA file is re-read into at
# each HTTPS fetch (file_read_whole_into), so a cache that fetches again
# allocates nothing for the read. deadline_ms: the whole-fetch HTTPS deadline,
# 0 = CCY_TLS_DEADLINE_MS (only tests change it, through _ccy_set_deadline_ms).
# ================================================================

# Build an empty rate cache pointing at `base_url` (a `/rates` endpoint).
# Call CurrencyCache_fetch to populate live rates, or CurrencyCache_set_rates
# to install a fixed map for offline/test use.
fn CurrencyCache_new(base_url) {
    var c = alloc(56);
    store64(c, 0);                 # base (unset)
    store64(c + 8, map_new());     # rates map
    # Copied, so a caller reusing its buffer cannot change the URL later.
    var url = 0;
    if (base_url != 0) {
        var n = strlen(base_url);
        url = alloc(n + 1);
        memcpy(url, base_url, n + 1);
    }
    store64(c + 16, url);
    store64(c + 24, 0);            # CA bundle path (0 = system trust store)
    store64(c + 32, 0);            # CA read buffer { ptr, cap }: none yet
    store64(c + 40, 0);
    store64(c + 48, 0);            # HTTPS deadline (0 = CCY_TLS_DEADLINE_MS)
    return c;
}

fn ccy_base(c) { return load64(c); }
fn ccy_rates(c) { return load64(c + 8); }
fn ccy_base_url(c) { return load64(c + 16); }
fn ccy_ca_file(c) { return load64(c + 24); }

# Test hook: this cache's whole-fetch HTTPS deadline in ms (0 restores the
# default, CCY_TLS_DEADLINE_MS). tests/test_ccy_tls.tcyr shortens it so the
# stall cases finish in seconds; consumers get the fixed default.
fn _ccy_set_deadline_ms(c, ms) {
    store64(c + 48, ms);
    return 0;
}

# Trust only the PEM bundle at `path` for this cache's HTTPS fetch, in place of
# the system trust store (path 0 restores the system store). The path is copied,
# like the base URL. It is read at each fetch, into a buffer the cache keeps
# (so a later fetch that fits allocates nothing for it); a missing, unreadable
# or empty file, one with no PEM certificate, or one with more than
# TLS_CA_MAX_ROOTS (300) certificates fails before any socket, and one whose
# certificates do not parse fails at the handshake — AI_ERR_TLS either way,
# never a fallback to the system store. Per object, so caches on two threads
# do not interact (one cache must not fetch on two threads at once). Returns 0,
# or AI_ERR_TLS (setting unchanged) if the copy cannot be allocated.
fn CurrencyCache_set_ca_file(c, path) {
    var copy = 0;
    if (path != 0) {
        var n = strlen(path);
        copy = alloc(n + 1);
        if (copy == 0) { return AI_ERR_TLS; }
        memcpy(copy, path, n + 1);
    }
    store64(c + 24, copy);
    return 0;
}

# Manually install rates. base is the reference currency (uppercase).
# rates is a map<cstr_upper, f64_bits>: 1 base == rate target.
fn CurrencyCache_set_rates(c, base, rates) {
    store64(c, base);
    store64(c + 8, rates);
    return 0;
}

# Convert value from -> to via cached rates. Returns a CurrencyResult ptr
# or 0 on failure (check ai_err for reason).
# Layout of CurrencyResult: { from_val, from_cstr, to_val, to_cstr, rate_bits }
fn CurrencyResult_new(from_val, from_s, to_val, to_s, rate) {
    var r = alloc(40);
    store64(r, from_val);
    store64(r + 8, from_s);
    store64(r + 16, to_val);
    store64(r + 24, to_s);
    store64(r + 32, rate);
    return r;
}

fn cr_from_value(r) { return load64(r); }
fn cr_from_currency(r) { return load64(r + 8); }
fn cr_to_value(r) { return load64(r + 16); }
fn cr_to_currency(r) { return load64(r + 24); }
fn cr_rate(r) { return load64(r + 32); }

# Last-error slot for the currency module (simple, avoids threading Result).
var AI_LAST_ERR = 0;

# Return the last AI_ERR_* code set by an ai fn (0 = no error).
fn ai_last_err() { return AI_LAST_ERR; }

# Reset the module-level last-error slot to AI_OK.
fn ai_clear_err() { AI_LAST_ERR = AI_OK; return 0; }

# Scan body[..len] for `"key"` followed by `:` and return the offset of the
# first non-space byte after the colon, or -1 if not found.
# Advance past a JSON string. `i` must index the opening quote. Honours
# backslash escapes, so an escaped quote does not end the string. Returns the
# index just past the closing quote, or `len` if the string is unterminated.
#
# Every structural scan in this module goes through this: JSON only has
# structure *outside* strings, so a scanner that counts braces, brackets or
# quotes without skipping string contents is reading user data as syntax.
fn _jf_skip_string(body, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(body + i);
        if (c == 92) { i = i + 2; }
        elif (c == 34) { return i + 1; }
        else { i = i + 1; }
    }
    return len;
}

# Find the offset of the value for `key` among the keys of the outermost
# object in `body[..len]`, or -1. Returns the index of the value's first byte.
#
# Depth-aware (2.4.9): only a key at nesting depth 1 matches. A "base" key
# inside "rates", or an "input" key inside a nested value, used to win over
# the real one, so every rate could be read against the wrong base.
#
# String-aware (2.3.4): the previous version matched `"key"` anywhere in the
# slice, so a *value* that happened to contain the text of a key name could be
# mistaken for that key. It only stayed benign because `CalcHistory_to_json`
# always writes input/result/timestamp in that order, putting the genuine key
# first — a hand-written or attacker-supplied file has no such guarantee.
fn _jf_find_value(body, len, key) {
    var klen = strlen(key);
    var i = 0;
    var send = 0;
    var k = 0;
    var j = 0;
    var ok = 0;
    var c = 0;
    var depth = 0;
    while (i < len) {
        c = load8(body + i);
        if (c == 123 || c == 91) { depth = depth + 1; i = i + 1; }
        elif (c == 125 || c == 93) { depth = depth - 1; i = i + 1; }
        elif (c == 34) {
            send = _jf_skip_string(body, len, i);
            # A string is a KEY only if the next non-space byte is ':'.
            k = send;
            while (k < len) {
                c = load8(body + k);
                if (c == 32 || c == 9 || c == 10 || c == 13) { k = k + 1; }
                else { break; }
            }
            if (k < len && load8(body + k) == 58) {
                ok = 0;
                # send - i - 2 is the raw byte length between the quotes.
                if (depth == 1 && send - i - 2 == klen) {
                    ok = 1;
                    j = 0;
                    while (j < klen) {
                        if (load8(body + i + 1 + j) != load8(key + j)) { ok = 0; break; }
                        j = j + 1;
                    }
                }
                k = k + 1;                     # step past ':'
                if (ok == 1) {
                    while (k < len) {
                        c = load8(body + k);
                        if (c == 32 || c == 9 || c == 10 || c == 13) { k = k + 1; }
                        else { return k; }
                    }
                    return 0 - 1;
                }
                i = k;                         # wrong key — resume at its value
            } else {
                i = send;                      # a value string — skip it whole
            }
        }
        else { i = i + 1; }
    }
    return 0 - 1;
}

# Extract a top-level string field. Returns a fresh cstring or 0 if not found.
fn _jf_get_string(body, len, key) {
    var off = _jf_find_value(body, len, key);
    if (off < 0) { return 0; }
    if (load8(body + off) != 34) { return 0; }
    off = off + 1;
    var start = off;
    while (off < len) {
        if (load8(body + off) == 34) { break; }
        off = off + 1;
    }
    var n = off - start;
    var buf = alloc(n + 1);
    memcpy(buf, body + start, n);
    store8(buf + n, 0);
    return buf;
}

# Extract a top-level nested object `"key":{...}` as a Str including braces, or 0.
# Extract an object-valued field. String-aware: a '}' inside a rates KEY or
# value used to end the extraction early, and because `_ccy_load_body`'s only
# completeness check is `kept == 0`, a truncated object that still yielded one
# valid pair was accepted as success with a silently incomplete rate table.
# Same defect class as the 2.3.4 H-4 fix, in the module's only network-facing
# parser — missed because that fix rewrote CalcHistory_from_json and
# _jf_find_value but not this scan.
fn _jf_get_object(body, len, key) {
    var off = _jf_find_value(body, len, key);
    if (off < 0) { return 0; }
    if (load8(body + off) != 123) { return 0; }
    var depth = 1;
    var i = off + 1;
    while (i < len) {
        var c = load8(body + i);
        if (c == 34) { i = _jf_skip_string(body, len, i); }
        elif (c == 123) { depth = depth + 1; i = i + 1; }
        elif (c == 125) {
            depth = depth - 1;
            if (depth == 0) { return str_new(body + off, i - off + 1); }
            i = i + 1;
        }
        else { i = i + 1; }
    }
    return 0;
}

# Is the f64 bit pattern finite (not NaN, not +/-inf)?
# IEEE 754 exponent bits all-1 means NaN or Inf.
fn _f64_is_finite(bits) {
    var exp_mask = 0x7FF0_0000_0000_0000;
    if ((bits & exp_mask) == exp_mask) { return 0; }
    return 1;
}

# 1 if a rate can be divided by and multiplied with: finite and > 0.
fn _ccy_rate_usable(bits) {
    if (_f64_is_finite(bits) == 0) { return 0; }
    if (f64_gt(bits, 0) == 0) { return 0; }
    return 1;
}

# Sanity-check a rate: finite, strictly positive, and <= 10^6.
# Closes the audit MED-7 rate-poisoning detection.
# Magnitudes > 10^6 are implausible for fiat currency exchange rates;
# rejecting them turns silent poisoning into an explicit AI_ERR_CURRENCY.
fn _ccy_rate_plausible(bits) {
    if (_f64_is_finite(bits) == 0) { return 0; }
    var zero = f64_from(0);
    if (f64_gt(bits, zero) == 0) { return 0; }
    var cap = f64_from(1000000);
    if (f64_gt(bits, cap) == 1) { return 0; }
    return 1;
}

# MED-4 guard: a SHAPE check on the rates object, run before any parsing.
#
# ⚠ Corrected at 2.4.4 — the rationale here was wrong for as long as it stood.
# It claimed bayan_json_parse "recurses once per nesting level with no depth
# cap" and that deep nesting could exhaust the native stack. It cannot:
# bayan_json_parse is a FLAT single-pass scanner (five while loops, no
# self-call, no call into the recursive parser), and it always has been. The
# recursive JSON parser in that module is _jp_parse_value_a, which abaco never
# calls and which has carried its own _JP_MAX_DEPTH = 128 cap since before
# 6.5.27. Verified against both the 6.5.27 and 6.5.35 stdlib.
#
# The guard stays, because what it actually buys is real and cheap: a
# legitimate fiat-rate map is FLAT (depth 1), so a payload nested past 8 is not
# a rates object at all, whatever it is. Rejecting it up front is O(n) input
# validation on the only data in this crate that arrives off the network, and
# it bounds the work the loop below does on a hostile body. It is not, and
# should not be described as, a stack-exhaustion guard.
#
# The scan counts raw braces / brackets (it does not skip string contents) —
# that only ever rejects *more* aggressively, the safe direction here, and the
# cap of 8 leaves ample headroom over the depth-1 real shape. Since 2.3.5 it
# also cannot be talked into a false ACCEPT by ']' padding.
var CCY_MAX_JSON_DEPTH = 8;
fn _ccy_json_depth_ok(s) {
    var data = str_data(s);
    var n = str_len(s);
    var depth = 0;
    var maxd = 0;
    var i = 0;
    while (i < n) {
        var ch = load8(data + i);
        if (ch == 123) { depth = depth + 1; if (depth > maxd) { maxd = depth; } }
        elif (ch == 91) { depth = depth + 1; if (depth > maxd) { maxd = depth; } }
        elif (ch == 125) { depth = depth - 1; }
        elif (ch == 93) { depth = depth - 1; }
        # Floor the counter at zero. Unbalanced CLOSERS (typically inside a
        # string, which this scan deliberately does not skip) otherwise drive
        # `depth` negative and mask that much genuine nesting from `maxd` — a
        # key padded with N ']' bytes bought N free levels. That is a FALSE
        # ACCEPT, the one direction a DoS guard must never fail in, and it
        # contradicted this function's own "only ever rejects more
        # aggressively" claim. Clamping restores that property in one line.
        if (depth < 0) { depth = 0; }
        i = i + 1;
    }
    if (maxd > CCY_MAX_JSON_DEPTH) { return 0; }
    return 1;
}

# 1 when the object Str `s` has no object or array inside it (outside
# strings): its own '{' is the only one.
fn _ccy_rates_flat(s) {
    var data = str_data(s);
    var n = str_len(s);
    var opens = 0;
    var i = 0;
    while (i < n) {
        var ch = load8(data + i);
        if (ch == 34) { i = _jf_skip_string(data, n, i); }
        else {
            if (ch == 123 || ch == 91) { opens = opens + 1; }
            i = i + 1;
        }
    }
    if (opens == 1) { return 1; }
    return 0;
}

# Parse body into the cache: expected shape {"base":"USD","rates":{"EUR":0.92,...}}.
# Returns 0 on success, AI_ERR_* on failure.
fn _ccy_load_body(c, body, len) {
    # The body must be one well-formed JSON document before any key is read:
    # bayan_json_parse skips to the next ':' after a key, so "GBP" 0.79 (no
    # colon) took the NEXT pair's value as GBP's rate.
    if (_json_doc_ok(body, len, CCY_MAX_JSON_DEPTH) == 0) { return AI_ERR_CURRENCY; }
    var base = _jf_get_string(body, len, "base");
    if (base == 0) { return AI_ERR_CURRENCY; }
    var rates_obj = _jf_get_object(body, len, "rates");
    if (rates_obj == 0) { return AI_ERR_CURRENCY; }
    # MED-4: reject a payload too deeply nested to be a rates map, before the
    # scan below walks it. (Not a recursion guard — see the note on the cap.)
    if (_ccy_json_depth_ok(rates_obj) == 0) { return AI_ERR_CURRENCY; }
    # A rates map is flat. bayan_json_parse stops at the first '}' it meets,
    # so a nested value would silently drop every pair after it.
    if (_ccy_rates_flat(rates_obj) == 0) { return AI_ERR_CURRENCY; }
    var pairs = bayan_json_parse(rates_obj);
    var rates = map_new();
    var i = 0;
    var kept = 0;
    while (i < vec_len(pairs)) {
        var p = vec_get(pairs, i);
        # bayan_json_parse returns key and value as Str — convert to cstring, parse f64.
        var kstr = bayan_json_key(p);
        var vstr = bayan_json_value(p);
        var kbuf = alloc(str_len(kstr) + 1);
        memcpy(kbuf, str_data(kstr), str_len(kstr));
        store8(kbuf + str_len(kstr), 0);
        # Trim JSON whitespace: bayan_json_parse ends a bare value only at
        # ',', '}', ' ' or LF, so a CRLF body hands over "0.79\r".
        var vd = str_data(vstr);
        var vn = str_len(vstr);
        var vs = _jf_skip_ws(vd, vn, 0);
        while (vn > vs) {
            var tc = load8(vd + vn - 1);
            if (tc != 32 && tc != 9 && tc != 10 && tc != 13) { break; }
            vn = vn - 1;
        }
        var vbuf = alloc(vn - vs + 1);
        memcpy(vbuf, vd + vs, vn - vs);
        store8(vbuf + vn - vs, 0);
        var vt, rate_bits = _nl_parse_f64(vbuf);
        if (is_ok(vt) == 1) {
            if (_ccy_rate_plausible(rate_bits) == 1) {
                map_set(rates, str_upper(kbuf), rate_bits);
                kept = kept + 1;
            }
        }
        i = i + 1;
    }
    # Reject responses where nothing passed sanity — prevents a poisoned
    # server from producing an empty cache that silently resolves to an
    # error-free but useless state.
    if (kept == 0) { return AI_ERR_CURRENCY; }
    CurrencyCache_set_rates(c, str_upper(base), rates);
    return 0;
}

# Validate a base URL. Enforces two invariants from the 2026-04-14 audit:
#   (a) HTTPS required — a plaintext HTTP/1.0 fetch is MITM-rewritable and
#       would silently poison rates (audit §4.3). Exception: http://localhost
#       and http://127.0.0.1 are accepted for local hoosh dev / testing, as
#       the whole host only.
#   (b) No control bytes — `lib/http.cyr::_http_build_request` splices the
#       URL straight into the wire format, so CR/LF or other < 0x20 bytes
#       would land as header injection (CVE-2019-9741 pattern, audit §4.1).
# Returns 0 on ok, AI_ERR_HTTP on rejection.
fn _ccy_validate_url(url) {
    if (url == 0) { return AI_ERR_HTTP; }
    var len = strlen(url);
    if (len == 0) { return AI_ERR_HTTP; }
    # Reject control bytes anywhere in the URL.
    var i = 0;
    while (i < len) {
        var c = load8(url + i);
        if (c < 32) { return AI_ERR_HTTP; }
        if (c == 127) { return AI_ERR_HTTP; }
        i = i + 1;
    }
    # Accept https://
    if (_nl_starts_with(url, "https://") == 1) { return 0; }
    # Accept http://localhost, http://127.0.0.1 for local development — as the
    # WHOLE host. Through 2.4.6 this was a bare prefix test, so remote names
    # that merely start with a loopback one passed too: http://localhost.<any
    # domain>, http://127.0.0.1.<any domain>. That was inert while lib/http.cyr
    # could reach no host at all; from Cyrius 6.6.9 http_get resolves names and
    # connects, which made it a plaintext fetch from a remote server — exactly
    # the rate poisoning (a) is here to stop (CHANGELOG 2.4.7).
    if (_ccy_is_host(url, "http://localhost") == 1) { return 0; }
    if (_ccy_is_host(url, "http://127.0.0.1") == 1) { return 0; }
    return AI_ERR_HTTP;
}

# 1 when `url` is `prefix` followed by the end, a port (`:`) or a path (`/`) —
# that is, when `prefix` names the whole host rather than the start of one.
fn _ccy_is_host(url, prefix) {
    if (_nl_starts_with(url, prefix) == 0) { return 0; }
    var c = load8(url + strlen(prefix));
    if (c == 0) { return 1; }
    if (c == 58) { return 1; }   # ':' — a port
    if (c == 47) { return 1; }   # '/' — a path
    return 0;
}

# ================================================================
# HTTPS — URL, request and response parsers. Always compiled: they are pure,
# fuzz/fuzz_ai.fcyr drives them without the TLS stack, and DCE drops them
# from any binary that never calls CurrencyCache_fetch.
# ================================================================

enum CcyTls {
    CCY_TLS_RESP_CAP = 65536;      # response bound — lib/http.cyr's plaintext cap
    CCY_TLS_REQ_CAP = 2048;        # request bound — lib/http.cyr's _HTTP_REQ_CAP (CVE-50)
    CCY_TLS_HOST_MAX = 253;        # longest DNS name (RFC 1035 §2.3.4)
    CCY_TLS_CA_MAX = 1048576;      # largest CA bundle read — lib/tls.cyr's own bound
    CCY_TLS_TIMEOUT_S = 10;        # SO_RCVTIMEO / SO_SNDTIMEO, per socket operation
    CCY_TLS_DEADLINE_MS = 30000;   # whole fetch: connect + handshake + response
    CCY_TLS_MAX_READS = 32;        # tls_read calls per fetch (see _ccy_tls_exchange)
    CCY_TLS_LEAF_MAX = 16384;      # leaf certificate read for the IP-literal check
}

# 1 for a byte allowed in an https host: a DNS name or an IPv4 literal (ASCII
# letters, digits, '-', '.'). Everything else — '@' (userinfo), '[' (IPv6;
# net_resolve_ipv4 is IPv4-only), '%', '\', '_', '?', '#', a control or a high
# byte — is refused rather than interpreted.
fn _ccy_host_byte(b) {
    if (b >= 97 && b <= 122) { return 1; }   # a-z
    if (b >= 65 && b <= 90) { return 1; }    # A-Z
    if (b >= 48 && b <= 57) { return 1; }    # 0-9
    if (b == 45 || b == 46) { return 1; }    # '-' '.'
    return 0;
}

# Split "https://host[:port][/path]" into out[0] = host (a fresh cstr),
# out[8] = port and out[16] = path (pointing into `url`; "/" when absent).
# Strict, because it is the only parser between the configured URL and the
# wire: the host is 1..253 bytes of _ccy_host_byte; a port is 1..5 digits in
# 1..65535; the path is visible ASCII with no SP (it would split the request
# line) and no '#' (a fragment is never sent, RFC 9110 §4.2.4). Anything else
# after the host is refused. Returns 0 or AI_ERR_HTTP.
fn _ccy_https_split(url, out) {
    if (url == 0) { return AI_ERR_HTTP; }
    if (_nl_starts_with(url, "https://") == 0) { return AI_ERR_HTTP; }
    var p = 8;
    while (_ccy_host_byte(load8(url + p)) == 1) {
        p = p + 1;
        if (p - 8 > CCY_TLS_HOST_MAX) { return AI_ERR_HTTP; }
    }
    var hl = p - 8;
    if (hl == 0) { return AI_ERR_HTTP; }
    var port = 443;
    if (load8(url + p) == 58) {
        p = p + 1;
        port = 0;
        var nd = 0;
        while (load8(url + p) >= 48 && load8(url + p) <= 57) {
            nd = nd + 1;
            if (nd > 5) { return AI_ERR_HTTP; }
            port = port * 10 + load8(url + p) - 48;
            p = p + 1;
        }
        if (nd == 0 || port < 1 || port > 65535) { return AI_ERR_HTTP; }
    }
    var path = "/";
    var nb = load8(url + p);
    if (nb == 47) {
        path = url + p;
        var q = p;
        while (load8(url + q) != 0) {
            var pc = load8(url + q);
            if (pc <= 32 || pc >= 127 || pc == 35) { return AI_ERR_HTTP; }
            q = q + 1;
        }
    }
    elif (nb != 0) { return AI_ERR_HTTP; }
    var host = alloc(hl + 1);
    if (host == 0) { return AI_ERR_HTTP; }
    memcpy(host, url + 8, hl);
    store8(host + hl, 0);
    store64(out, host);
    store64(out + 8, port);
    store64(out + 16, path);
    return 0;
}

# "GET <path> HTTP/1.0" with Host (":port" unless 443, RFC 9110 §7.2) and
# Connection: close — the request lib/http.cyr sends on the plaintext path.
# HTTP/1.0, so the server may not answer with chunked framing (RFC 9112 §6.1).
# NUL-terminated in a buffer of exactly its size, or 0 when it would exceed
# CCY_TLS_REQ_CAP (decided before anything is allocated). The inputs come from
# _ccy_https_split, which has refused SP, CR, LF and every other control byte.
fn _ccy_https_request(host, port, path) {
    var hl = strlen(host);
    var pl = strlen(path);
    var ptxt[8];
    var pd = 0;
    if (port != 443) {
        var pv = port;
        while (pv > 0 && pd < 6) { pd = pd + 1; pv = pv / 10; }
        pv = port;
        var pi = pd;
        while (pi > 0) { pi = pi - 1; store8(&ptxt + pi, 48 + pv % 10); pv = pv / 10; }
    }
    var pn = 0;
    if (pd > 0) { pn = 1 + pd; }
    # "GET " path " HTTP/1.0\r\nHost: " host [":" port] "\r\nConnection: close\r\n\r\n" NUL
    var need = 4 + pl + 17 + hl + pn + 23 + 1;
    if (need > CCY_TLS_REQ_CAP) { return 0; }
    var buf = alloc(need);
    if (buf == 0) { return 0; }
    memcpy(buf, "GET ", 4);
    var pos = 4;
    memcpy(buf + pos, path, pl);
    pos = pos + pl;
    memcpy(buf + pos, " HTTP/1.0\r\nHost: ", 17);
    pos = pos + 17;
    memcpy(buf + pos, host, hl);
    pos = pos + hl;
    if (pd > 0) {
        store8(buf + pos, 58);
        memcpy(buf + pos + 1, &ptxt, pd);
        pos = pos + pn;
    }
    memcpy(buf + pos, "\r\nConnection: close\r\n\r\n", 23);
    pos = pos + 23;
    store8(buf + pos, 0);
    return buf;
}

# 1 when buf[s..e) spells `name` (given in lowercase), ASCII case-insensitive.
fn _ccy_field_is(buf, s, e, name) {
    var n = strlen(name);
    if (e - s != n) { return 0; }
    var i = 0;
    while (i < n) {
        var b = load8(buf + s + i);
        if (b >= 65 && b <= 90) { b = b + 32; }
        if (b != load8(name + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Parse the head of an HTTP/1.x response in buf[0..len). Returns the length
# the whole message must have (head + Content-Length), 0 while the head has
# not all arrived, or -1 when it is malformed or its framing is refused. On a
# positive return: out[0] = status (100..999), out[8] = body offset and
# out[16] = Content-Length.
#
# Framing is by Content-Length only, and Content-Length is REQUIRED: the
# native lib/tls.cyr read reports ANY alert, a fatal one included, as end of
# stream — the same 0 as close_notify (cyrius issue
# 2026-09-30-tls-client-memory-and-alert-gaps.md (c)) — and a TCP close needs
# no key at all, so "read until EOF" cannot tell a whole body from a cut one.
# Refused: no Content-Length; one that is not 1*DIGIT (a "42, 42" list too) or
# two that differ (RFC 9110 §8.6); any Transfer-Encoding (the request is
# HTTP/1.0, which a server must not answer chunked, RFC 9112 §6.1); obs-fold
# continuation lines (RFC 9112 §5.2); a bare CR or LF, NUL or other control
# byte in the head (RFC 9112 §2.2, RFC 9110 §5.5); a field line without ':' or
# with whitespace in its name (RFC 9112 §5.1); a status not 3 digits >= 100.
fn _ccy_http_head(buf, len, out) {
    var hend = 0 - 1;
    var i = 0;
    while (i + 3 < len && hend < 0) {
        if (load8(buf + i) == 13 && load8(buf + i + 1) == 10) {
            if (load8(buf + i + 2) == 13 && load8(buf + i + 3) == 10) { hend = i; }
        }
        i = i + 1;
    }
    if (hend < 0) { return 0; }
    # Status line: "HTTP/1." DIGIT SP 3DIGIT, then SP (a reason) or the CRLF.
    if (hend < 12) { return 0 - 1; }
    if (memeq(buf, "HTTP/1.", 7) == 0) { return 0 - 1; }
    var v = load8(buf + 7);
    if (v < 48 || v > 57 || load8(buf + 8) != 32) { return 0 - 1; }
    var code = 0;
    var k = 9;
    while (k < 12) {
        var dc = load8(buf + k);
        if (dc < 48 || dc > 57) { return 0 - 1; }
        code = code * 10 + dc - 48;
        k = k + 1;
    }
    if (code < 100) { return 0 - 1; }
    if (load8(buf + 12) != 32 && load8(buf + 12) != 13) { return 0 - 1; }
    # Every CR in the head starts a CRLF and every LF ends one; no other
    # control byte but HTAB. buf[hend] is the final CRLFCRLF, already matched.
    var j = 0;
    while (j < hend) {
        var b = load8(buf + j);
        if (b == 13) {
            if (load8(buf + j + 1) != 10) { return 0 - 1; }
        }
        elif (b == 10) {
            if (load8(buf + j - 1) != 13) { return 0 - 1; }
        }
        elif ((b < 32 && b != 9) || b == 127) { return 0 - 1; }
        j = j + 1;
    }
    # Field lines: each starts after a CRLF and ends at the next CR (or hend).
    var cl = 0 - 1;
    var s = 0;
    while (s < hend && load8(buf + s) != 13) { s = s + 1; }
    s = s + 2;
    while (s < hend) {
        var e = s;
        while (e < hend && load8(buf + e) != 13) { e = e + 1; }
        var f = load8(buf + s);
        if (f == 32 || f == 9) { return 0 - 1; }              # obs-fold
        var c = s;
        while (c < e && load8(buf + c) != 58) {
            var nc = load8(buf + c);
            if (nc == 32 || nc == 9) { return 0 - 1; }       # whitespace in the name
            c = c + 1;
        }
        if (c == e || c == s) { return 0 - 1; }               # no ':' / empty name
        if (_ccy_field_is(buf, s, c, "transfer-encoding") == 1) { return 0 - 1; }
        if (_ccy_field_is(buf, s, c, "content-length") == 1) {
            var q = c + 1;
            while (q < e && (load8(buf + q) == 32 || load8(buf + q) == 9)) { q = q + 1; }
            var nd = 0;
            var val = 0;
            while (q < e && load8(buf + q) >= 48 && load8(buf + q) <= 57) {
                val = val * 10 + load8(buf + q) - 48;
                if (val > CCY_TLS_RESP_CAP) { return 0 - 1; }   # past the response cap
                nd = nd + 1;
                q = q + 1;
            }
            while (q < e && (load8(buf + q) == 32 || load8(buf + q) == 9)) { q = q + 1; }
            if (nd == 0 || q != e) { return 0 - 1; }
            if (cl >= 0 && val != cl) { return 0 - 1; }
            cl = val;
        }
        s = e + 2;
    }
    if (cl < 0) { return 0 - 1; }
    store64(out, code);
    store64(out + 8, hend + 4);
    store64(out + 16, cl);
    return hend + 4 + cl;
}

# Status and body of a complete HTTPS response buf[0..len): out[0] = status,
# out[8] = body pointer, out[16] = body length. _ccy_http_head's framing rules,
# and the bytes given must be EXACTLY the head plus Content-Length — fewer is a
# truncated body, more is data the length does not cover. The transport
# (_ccy_tls_exchange) stops reading once Content-Length bytes are in, so the
# extra bytes this refuses are those that arrive in the same read as the body's
# end; bytes a server sends in a later record are never read. Returns 0 or
# AI_ERR_HTTP.
fn _ccy_http_split(buf, len, out) {
    if (buf == 0 || len <= 0) { return AI_ERR_HTTP; }
    var h[24];
    var need = _ccy_http_head(buf, len, &h);
    if (need <= 0 || need != len) { return AI_ERR_HTTP; }
    store64(out, load64(&h));
    store64(out + 8, buf + load64(&h + 8));
    store64(out + 16, load64(&h + 16));
    return 0;
}

# One DER TLV at buf[pos..end): returns its tag (0..255) with out[0] = the
# content's offset and out[8] = its length, or -1 when it does not fit before
# `end` or is one this walk does not read: a high tag number (low 5 bits all
# set), the indefinite length (0x80, BER only) or a length in more than 3 bytes
# (16 MiB; a certificate is far smaller). A long-form length need not be
# minimal, as sigil's der_walk allows (X.690 §8.1.3, §10.1).
fn _ccy_der_tlv(buf, end, pos, out) {
    if (pos < 0 || pos + 2 > end) { return 0 - 1; }
    var tag = load8(buf + pos) & 255;
    if ((tag & 31) == 31) { return 0 - 1; }
    var lb = load8(buf + pos + 1) & 255;
    var p = pos + 2;
    var len = lb;
    if (lb >= 128) {
        var nb = lb - 128;
        if (nb < 1 || nb > 3 || p + nb > end) { return 0 - 1; }
        len = 0;
        var i = 0;
        while (i < nb) {
            len = len * 256 + (load8(buf + p + i) & 255);
            i = i + 1;
        }
        p = p + nb;
    }
    if (len > end - p) { return 0 - 1; }
    store64(out, p);
    store64(out + 8, len);
    return tag;
}

# 1 when the certificate der[0..dl) lists, in its first subjectAltName
# extension, an iPAddress entry of exactly the 4 bytes at `ip` (an IPv4
# address in network order); 0 otherwise — no SAN, no such entry, or DER that
# _ccy_der_tlv refuses. RFC 9525 §6.3 (RFC 6125 §6.2.1 before it): an IP
# address matches an iPAddress entry only, never a dNSName, wildcard or not.
# The path (RFC 5280 §4.1, §4.2.1.6): Certificate SEQUENCE > tbsCertificate
# SEQUENCE > [3] > SEQUENCE OF Extension > Extension SEQUENCE { extnID
# 2.5.29.17 (55 1D 11), critical BOOLEAN OPTIONAL, extnValue OCTET STRING >
# GeneralNames SEQUENCE > [7] iPAddress }. Each element must lie inside its
# parent, so nothing at or past der + dl is read.
fn _ccy_cert_ip_san(der, dl, ip) {
    if (der == 0 || dl <= 0) { return 0; }
    var t[16];
    if (_ccy_der_tlv(der, dl, 0, &t) != 48) { return 0; }                    # Certificate
    var cend = load64(&t) + load64(&t + 8);
    if (_ccy_der_tlv(der, cend, load64(&t), &t) != 48) { return 0; }         # tbsCertificate
    var pos = load64(&t);
    var tend = pos + load64(&t + 8);
    var xs = 0 - 1;
    var xe = 0;
    while (pos < tend && xs < 0) {
        var tag = _ccy_der_tlv(der, tend, pos, &t);
        if (tag < 0) { return 0; }
        if (tag == 163) { xs = load64(&t); xe = xs + load64(&t + 8); }        # [3] extensions
        pos = load64(&t) + load64(&t + 8);
    }
    if (xs < 0) { return 0; }
    if (_ccy_der_tlv(der, xe, xs, &t) != 48) { return 0; }                   # SEQUENCE OF
    pos = load64(&t);
    var send = pos + load64(&t + 8);
    while (pos < send) {
        if (_ccy_der_tlv(der, send, pos, &t) != 48) { return 0; }            # Extension
        var ep = load64(&t);
        var eend = ep + load64(&t + 8);
        pos = eend;
        if (_ccy_der_tlv(der, eend, ep, &t) != 6) { return 0; }              # extnID
        var op = load64(&t);
        if (load64(&t + 8) == 3 && (load8(der + op) & 255) == 85 && (load8(der + op + 1) & 255) == 29
          && (load8(der + op + 2) & 255) == 17) {
            var vp = op + 3;
            var vt = _ccy_der_tlv(der, eend, vp, &t);
            if (vt == 1) {                                                   # critical
                vp = load64(&t) + load64(&t + 8);
                vt = _ccy_der_tlv(der, eend, vp, &t);
            }
            if (vt != 4) { return 0; }                                       # extnValue
            var oend = load64(&t) + load64(&t + 8);
            if (_ccy_der_tlv(der, oend, load64(&t), &t) != 48) { return 0; } # GeneralNames
            var gp = load64(&t);
            var gend = gp + load64(&t + 8);
            while (gp < gend) {
                var gt = _ccy_der_tlv(der, gend, gp, &t);
                if (gt < 0) { return 0; }
                if (gt == 135 && load64(&t + 8) == 4 && memeq(der + load64(&t), ip, 4) == 1) { return 1; }
                gp = load64(&t) + load64(&t + 8);
            }
            return 0;
        }
    }
    return 0;
}

# The number of "-----BEGIN CERTIFICATE-----" markers in buf[0..len): the
# blocks lib/tls.cyr's PEM decoder (sigil's pem_decode_certs) reads. Nothing
# at or past buf + len is read.
fn _ccy_pem_cert_count(buf, len) {
    var n = 0;
    var i = 0;
    while (i + 27 <= len) {
        if (load8(buf + i) == 45 && memeq(buf + i, "-----BEGIN CERTIFICATE-----", 27) == 1) {
            n = n + 1;
            i = i + 27;
        } else {
            i = i + 1;
        }
    }
    return n;
}

#ifdef ABACO_TLS
#ifndef CYRIUS_TLS_LIBSSL
# ================================================================
# HTTPS transport — compiled only with -D ABACO_TLS, against the consumer's
# lib/tls.cyr ("tls" in ITS [deps].stdlib; src/ never includes it).
# ================================================================

# Write-once, process-wide: 1 once abaco_tls_init() has warmed the TLS stack.
# Written only by that fn, on the main thread; the one global this path adds.
var _abaco_tls_ready = 0;

# 1 on the process's initial thread (Linux: tid == pid). A target that has no
# thread id (sys_gettid < 0) cannot tell, and is trusted.
fn _abaco_on_main_thread() {
    var tid = sys_gettid();
    if (tid < 0) { return 1; }
    if (tid == sys_getpid()) { return 1; }
    return 0;
}

# Warm, on the CALLING thread, every lazy initialiser the native TLS client
# reaches. The calling thread must be the process's main thread. Call it once
# at startup, before any thread runs CurrencyCache_fetch over https:// — or
# uses lib/tls.cyr in any other way — until it has run, the fetch refuses
# with AI_ERR_TLS rather than race.
#
# Why: sigil's table builders (lib/sigil.cyr) are check-then-set and the
# native system-CA cache is unsynchronised, so two threads whose FIRST
# handshakes overlap corrupt the shared tables and every later handshake in
# the process fails; and a first handshake on a worker installs sigil's thread
# block for that worker only, so the main thread's next one SIGSEGVs (cyrius
# issue 2026-09-30-tls-first-use-thread-race.md). Warmed here, as of Cyrius
# 6.6.12:
#   - crypto_tls_main_init: the main thread's block and crypto lane 0
#   - ecdsa_p256_warm / ecdsa_p384_warm (sigil's public prewarm verbs, ADR
#     0007): the P-256 / P-384 field, inversion, point, G-table, sign and
#     verify inits — ECDSA chains and CertificateVerify, ECDHE
#   - sha256 / sha384: SHA-256's K table (and the SHA-NI tables) and the
#     SHA-512 family — the transcript hash, HKDF, HMAC
#   - aes_gcm_global_init, ed25519_init: race-safe already; warmed so no
#     handshake pays for them on a worker
#   - the system CA bundle cache, through tls_native_set_ca_system on a
#     throwaway ctx, which parses every root: PEM, X.509 and RSA / EC keys
#   - _pem_init, _xp_init, _x509_oids_init, _x509_init_mdays directly too:
#     a host with no system bundle reaches them first through the cache's CA
#     file, and no public verb reaches them without a certificate in hand
# RSA verification and the bignum engine keep no lazy state (stack-local since
# sigil 3.12.9), nor do X25519 and ChaCha20-Poly1305. tests/test_ccy_tls.tcyr
# checks that fetches over an ECDSA and an RSA-signed chain flip no lazy-init
# flag after this has run, and runs concurrent threads over both.
#
# Returns 0 once warmed (idempotent), or AI_ERR_TLS — nothing touched — when
# called off the main thread, or when this build cannot do HTTPS (no
# -D ABACO_TLS, or a -D CYRIUS_TLS_LIBSSL build).
fn abaco_tls_init() {
    if (atomic_load(&_abaco_tls_ready) == 1) { return 0; }
    if (_abaco_on_main_thread() == 0) { return AI_ERR_TLS; }
    crypto_tls_main_init();
    ecdsa_p256_warm();
    ecdsa_p384_warm();
    var dg[64];
    sha256("abaco", 5, &dg);
    sha384("abaco", 5, &dg);
    aes_gcm_global_init();
    ed25519_init();
    _pem_init();
    _xp_init();
    _x509_oids_init();
    _x509_init_mdays();
    var wc = tls_native_new_client("localhost", 9);
    if (wc != 0) { tls_native_set_ca_system(wc); }
    atomic_fence();
    atomic_store(&_abaco_tls_ready, 1);
    return 0;
}

# 1 once abaco_tls_init() has run; the fence orders the warmed tables' reads
# after the flag's (aarch64 may reorder loads).
fn _ccy_tls_ready() {
    if (atomic_load(&_abaco_tls_ready) != 1) { return 0; }
    atomic_fence();
    return 1;
}

# tls_connect_alloc hook, run on the bare ctx before the handshake; non-zero
# aborts the connect. Re-checks the backend: a libssl SSL_CTX must never be
# handled as a native ctx, and refusing here means a libssl connect — which
# never checks the host name — cannot complete even if the backend flipped
# after _ccy_https_get looked. With a CA file, its roots REPLACE the system
# store (tls_native_set_ca_bundle installs the set), parsed from the cache's
# own read buffer rather than lib/tls.cyr's 1 MiB per call.
fn _ccy_tls_hook(hk, handle) {
    if (tls_get_backend() != TLS_BACKEND_NATIVE) { return 1; }
    var cab = load64(hk);
    if (cab == 0) { return 0; }
    if (tls_native_set_ca_bundle(handle, cab, load64(hk + 8), 0) != TLS_OK) { return 1; }
    return 0;
}

# TCP_NODELAY on the client socket, best effort. The client sends its Finished
# and then the request back to back; Nagle holds the request until the server
# ACKs the Finished, which a delayed ACK postpones (measured: 77 -> 46 ms per
# loopback fetch). Linux only: agnos has no setsockopt (its number is another
# call there, lib/net.cyr).
fn _ccy_nodelay(fd) {
    #ifdef CYRIUS_TARGET_LINUX
    var one[8];
    store64(&one, 1);
    sys_setsockopt(fd, 6, 1, &one, 4);       # IPPROTO_TCP, TCP_NODELAY
    #endif
    return 0;
}

# A TLS_ERR_* from the native client as an AiError: TLS_ERR_IO — the socket
# failed, timed out (SO_RCVTIMEO), reached end of stream or was cut by the
# deadline, at any stage of the handshake or the exchange — is a network
# failure, AI_ERR_HTTP; every other code (a certificate or name refused, a
# malformed or undecryptable record, an alert in place of a handshake message)
# is the TLS layer refusing, AI_ERR_TLS. lib/tls.cyr reports a record it could
# not read as TLS_ERR_IO whatever the cause, so a record longer than TLS allows
# lands on the network side too.
fn _ccy_tls_err(code) {
    if (code == TLS_ERR_IO) { return AI_ERR_HTTP; }
    return AI_ERR_TLS;
}

# ---------------------------------------------------------------- deadline
# SO_RCVTIMEO / SO_SNDTIMEO bound each socket operation, not the fetch: a peer
# that sends one byte every few seconds, or a plaintext ChangeCipherSpec record
# every second (lib/tls.cyr skips those without a limit, during the handshake
# and after it — cyrius issue 2026-10-01-tls-native-no-deadline.md), keeps
# every read under the timeout forever, and neither needs a key or a
# certificate: any on-path box can do it. So each fetch runs under a watchdog:
# a detached thread that, at the deadline, cuts the socket (below) unless the
# fetch has finished first. Its state is one heap block per fetch, { state,
# fd, ms } — nothing global, so fetches on many threads do not interact. Linux
# only (futex, and thread_create_detached is serial elsewhere): on other
# targets a fetch has the per-operation timeouts alone.
enum CcyWd {
    CCY_WD_RUN = 0;        # the fetch is running
    CCY_WD_DONE = 1;       # the fetch finished first; the watchdog leaves
    CCY_WD_FIRING = 2;     # the deadline passed; the watchdog is cutting the fd
    CCY_WD_FIRED = 3;      # cut; the fetch may close the fd now
}

# Cut `fd` at the deadline. shutdown(SHUT_RD) wakes a read blocked on it (it
# returns 0, end of stream) and aborts a connect still in progress. After it,
# Linux still hands out what is already queued — up to the receive buffer,
# megabytes with autotuning, i.e. hundreds of thousands of 6-byte records —
# so the socket is then replaced in the fd table by /dev/null (dup2): every
# later read on `fd` is end of stream at once, and a later write (the
# close_notify) goes nowhere. SHUT_RD rather than SHUT_RDWR because a write
# after SHUT_WR raises SIGPIPE, which would kill a consumer that does not
# ignore it. The socket itself closes when the last read using it returns. If
# /dev/null cannot be opened, the shutdown alone still ends the fetch.
fn _ccy_wd_cut(fd) {
    sock_shutdown(fd, 0);
    var nf = file_open("/dev/null", O_RDWR | O_CLOEXEC, 0);
    if (nf >= 0) {
        sys_dup2(nf, fd);
        sys_close(nf);
    }
    return 0;
}

# The watchdog thread: wait on w[0] until the fetch finishes (DONE) or w[16]
# ms pass; at the deadline, claim the block (RUN -> FIRING), cut the socket,
# publish FIRED and wake the fetch if it is waiting in _ccy_wd_stop.
fn _ccy_wd_main(w) {
    #ifdef CYRIUS_TARGET_LINUX
    var end = clock_now_ns() + load64(w + 16) * 1000000;
    var ts[16];
    var waiting = 1;
    while (waiting == 1) {
        if (atomic_load(w) != CCY_WD_RUN) { return 0; }
        var left = end - clock_now_ns();
        if (left <= 0) { waiting = 0; }
        else {
            store64(&ts, left / 1000000000);
            store64(&ts + 8, left % 1000000000);
            syscall(SYS_FUTEX, w, FUTEX_WAIT, CCY_WD_RUN, &ts, 0, 0);
        }
    }
    if (atomic_cas(w, CCY_WD_RUN, CCY_WD_FIRING) == 0) { return 0; }   # the fetch won
    _ccy_wd_cut(load64(w + 8));
    atomic_store(w, CCY_WD_FIRED);
    syscall(SYS_FUTEX, w, FUTEX_WAKE, 1, 0, 0, 0);
    #endif
    return 0;
}

# Start the watchdog over `fd` for `ms` milliseconds. Returns its block, or 0
# when it cannot start (no memory, no thread): the fetch is then refused rather
# than run without its bound. On a non-Linux target the block has no thread.
fn _ccy_wd_start(fd, ms) {
    var w = alloc(24);
    if (w == 0) { return 0; }
    store64(w, CCY_WD_RUN);
    store64(w + 8, fd);
    store64(w + 16, ms);
    #ifdef CYRIUS_TARGET_LINUX
    if (thread_create_detached(&_ccy_wd_main, w) != 1) { return 0; }
    #endif
    return w;
}

# End the watchdog. Returns 0 when the fetch finished first, or 1 when the
# deadline cut it — and then only once the cut is complete, so the caller may
# close `fd` without the watchdog ever touching a number that has been reused.
fn _ccy_wd_stop(w) {
    if (atomic_cas(w, CCY_WD_RUN, CCY_WD_DONE) == 1) {
        #ifdef CYRIUS_TARGET_LINUX
        syscall(SYS_FUTEX, w, FUTEX_WAKE, 1, 0, 0, 0);
        #endif
        return 0;
    }
    var st = atomic_load(w);
    while (st != CCY_WD_FIRED) {
        #ifdef CYRIUS_TARGET_LINUX
        syscall(SYS_FUTEX, w, FUTEX_WAIT, st, 0, 0, 0);
        #endif
        st = atomic_load(w);
    }
    return 1;
}

# ---------------------------------------------------------------- exchange
# 1 when `host` is not an IPv4 literal, or when the verified leaf lists it as
# an iPAddress (_ccy_cert_ip_san). lib/tls.cyr also matches an IP-literal host
# against dNSName entries, wildcards included — a certificate for DNS:127.0.0.1
# or DNS:*.0.0.1 passes its check for https://127.0.0.1 — which RFC 9525 §6.3
# forbids (cyrius issue 2026-10-01-tls-ip-literal-dnsname.md); this holds the
# fetch to the RFC. "IPv4 literal" is net_parse_ipv4's strict dotted quad, the
# form net_resolve_ipv4 connects to without a lookup.
fn _ccy_ip_host_ok(tc, host) {
    var ip = net_parse_ipv4(host);
    if (ip == 0 - 1) { return 1; }
    var ipb[8];
    store64(&ipb, ip);                       # first octet in the low byte
    var der[16384];
    var dl = tls_native_get_peer_cert_der(load64(tc), &der, CCY_TLS_LEAF_MAX);
    if (dl <= 0) { return 0; }
    return _ccy_cert_ip_san(&der, dl, &ipb);
}

# Send `req` on the connected `tc` and read the response, framed by
# Content-Length (_ccy_http_head) — reading stops once that many bytes are in,
# so the fetch never waits on the server's close (and never reads what a
# server sends past it). Bounded four ways: 64 KB, CCY_TLS_MAX_READS calls
# (each native tls_read that reaches the socket allocates ~33 KB of record
# buffers on the no-free heap, so a server dribbling 1-byte records would
# otherwise cost 64 Ki x 33 KB), the socket timeouts and the fetch's deadline.
# Returns 0 (out as _ccy_http_split), AI_ERR_HTTP or AI_ERR_TLS.
fn _ccy_tls_exchange(tc, req, out) {
    var rl = strlen(req);
    var w = tls_write(tc, req, rl);
    if (w < 0) { return _ccy_tls_err(w); }
    if (w != rl) { return AI_ERR_HTTP; }
    var buf = alloc(CCY_TLS_RESP_CAP + 1);
    if (buf == 0) { return AI_ERR_HTTP; }
    var h[24];
    var total = 0;
    var need = 0;
    var reads = 0;
    while (need == 0 || total < need) {
        if (total >= CCY_TLS_RESP_CAP) { return AI_ERR_HTTP; }      # head past 64 KB
        if (reads >= CCY_TLS_MAX_READS) { return AI_ERR_HTTP; }     # too fragmented
        var n = tls_read(tc, buf + total, CCY_TLS_RESP_CAP - total);
        reads = reads + 1;
        if (n < 0) { return _ccy_tls_err(n); }
        if (n == 0) { break; }       # end of stream: close_notify — or any alert
        total = total + n;
        if (need == 0) {
            need = _ccy_http_head(buf, total, &h);
            if (need < 0) { return AI_ERR_HTTP; }
            if (need > CCY_TLS_RESP_CAP) { return AI_ERR_HTTP; }   # over the cap
        }
    }
    store8(buf + total, 0);
    return _ccy_http_split(buf, total, out);
}

# Everything that runs under the watchdog: connect, handshake, the IP-literal
# check, the exchange. The handshake is staged (tls_connect_alloc, then
# tls_connect_complete) so its TLS_ERR_* can be read off the ctx before it
# closes. Closes the TLS ctx it opens; never the socket.
fn _ccy_tls_session(fd, host, port, addr, hk, req, out) {
    var ct, cv = sock_connect(fd, addr, port);
    if (is_err_result(ct) == 1) { return AI_ERR_HTTP; }
    var tc = tls_connect_alloc(fd, host, &_ccy_tls_hook, hk);
    if (tc == 0) { return AI_ERR_TLS; }      # the hook refused (CA file), or no memory
    var err = 0;
    if (tls_connect_complete(tc) != 1) { err = _ccy_tls_err(tls_native_get_last_error(load64(tc))); }
    elif (_ccy_ip_host_ok(tc, host) == 0) { err = AI_ERR_TLS; }
    else { err = _ccy_tls_exchange(tc, req, out); }
    tls_close(tc);
    return err;
}

# GET `req` from host:port over TLS (out as _ccy_http_split). Verification is
# lib/tls.cyr's native default and fails closed: the chain must reach a trusted
# root (the system store, or the cache's CA file instead) AND the leaf's SAN
# must match `host` (dNSName or iPAddress; an IPv4 literal must be an
# iPAddress, _ccy_ip_host_ok — RFC 9525; SNI is set from it). Refused before
# any socket exists: abaco_tls_init() not run, a backend other than native, a
# CA file that is unreadable, empty, holds no PEM certificate or more than
# TLS_CA_MAX_ROOTS (lib/tls.cyr refuses such a bundle whole). No redirect is
# followed — a 3xx is a non-200. Connect, handshake and response run under a
# CCY_TLS_DEADLINE_MS watchdog (above); a fetch it cuts is AI_ERR_HTTP. Every
# exit after the socket opens closes the TLS ctx (when one exists) and the
# socket. Returns 0, AI_ERR_HTTP or AI_ERR_TLS.
fn _ccy_https_get(c, host, port, req, out) {
    if (_ccy_tls_ready() == 0) { return AI_ERR_TLS; }
    if (tls_get_backend() != TLS_BACKEND_NATIVE) { return AI_ERR_TLS; }
    var hk[16];
    store64(&hk, 0);
    store64(&hk + 8, 0);
    var cafile = ccy_ca_file(c);
    if (cafile != 0) {
        var cn = file_read_whole_into(c + 32, cafile, CCY_TLS_CA_MAX);
        if (cn <= 0) { return AI_ERR_TLS; }
        var ncert = _ccy_pem_cert_count(load64(c + 32), cn);
        if (ncert < 1 || ncert > TLS_CA_MAX_ROOTS) { return AI_ERR_TLS; }
        store64(&hk, load64(c + 32));
        store64(&hk + 8, cn);
    }
    var ms = load64(c + 48);
    if (ms <= 0) { ms = CCY_TLS_DEADLINE_MS; }
    var addr = net_resolve_ipv4(host);
    if (addr == 0 - 1) { return AI_ERR_HTTP; }
    var st, fd = tcp_socket();
    if (is_err_result(st) == 1) { return AI_ERR_HTTP; }
    if (sock_set_recv_timeout(fd, CCY_TLS_TIMEOUT_S, 0) != 0) { sock_close(fd); return AI_ERR_HTTP; }
    if (sock_set_send_timeout(fd, CCY_TLS_TIMEOUT_S, 0) != 0) { sock_close(fd); return AI_ERR_HTTP; }
    _ccy_nodelay(fd);
    var wd = _ccy_wd_start(fd, ms);
    if (wd == 0) { sock_close(fd); return AI_ERR_HTTP; }
    var err = _ccy_tls_session(fd, host, port, addr, &hk, req, out);
    if (_ccy_wd_stop(wd) == 1 && err != 0) { err = AI_ERR_HTTP; }   # cut at the deadline
    sock_close(fd);
    return err;
}
#endif
#ifdef CYRIUS_TLS_LIBSSL
# A libssl-only build (-D CYRIUS_TLS_LIBSSL) is refused: lib/tls.cyr's libssl
# backend checks the chain but never the host name, so any certificate for any
# name that chains to a trusted root would be accepted (cyrius issue
# 2026-09-30-tls-libssl-backend-no-hostname-verification.md).
fn abaco_tls_init() { return AI_ERR_TLS; }
fn _ccy_https_get(c, host, port, req, out) { return AI_ERR_TLS; }
#endif
#endif
#ifndef ABACO_TLS
# Built without -D ABACO_TLS: no TLS stack is linked and https:// is refused.
fn abaco_tls_init() { return AI_ERR_TLS; }
fn _ccy_https_get(c, host, port, req, out) { return AI_ERR_TLS; }
#endif

# Fetch live rates from the cache's base URL. Hits <base_url>/rates and parses
# the {"base","rates":{...}} payload. Returns 0 on success, AI_ERR_* on failure.
#
# Safety invariants (enforced by this function + `_ccy_validate_url` +
# `_ccy_rate_plausible`; see `docs/audit/2026-04-14.md`):
#   - `base_url` must be HTTPS or point at localhost (rate-poisoning
#     defence). Plaintext HTTP to a remote host is rejected.
#   - The URL must not contain control bytes (CRLF-injection defence;
#     `lib/http.cyr` inlines the host into the wire format without
#     sanitising). An https:// URL also passes `_ccy_https_split`'s
#     stricter host / port / path grammar.
#   - `base_url` is treated as trusted configuration, not user input.
#     A consumer that exposes the base URL to untrusted input becomes
#     SSRF-adjacent (audit §4.4).
#   - Responses are capped at 64 KB on both transports — an adversarial
#     server cannot force unbounded memory growth here. HTTPS responses
#     must carry a Content-Length the body matches exactly
#     (`_ccy_http_head`), and no redirect is followed on either.
#   - https:// needs a build with `-D ABACO_TLS` and `abaco_tls_init()` run
#     on the main thread first; otherwise AI_ERR_TLS before any socket.
#     Chain + host name are verified fail-closed (lib/tls.cyr native, plus
#     abaco's iPAddress-only rule for an IPv4 literal); the libssl backend,
#     which skips the name check, is refused. Connect, handshake and
#     response must finish within CCY_TLS_DEADLINE_MS (30 s) — a peer that
#     keeps each read under the 10 s socket timeout is cut there.
#   - Rate values are sanity-checked (finite, > 0, < 10^6). Poisoned
#     responses that try to survive validation by smuggling NaN/inf/zero
#     rates get dropped silently; an all-bad response is rejected entirely.
fn CurrencyCache_fetch(c) {
    AI_LAST_ERR = AI_OK;
    var base_url = ccy_base_url(c);
    var verr = _ccy_validate_url(base_url);
    if (verr != 0) { AI_LAST_ERR = verr; return verr; }
    var bl = strlen(base_url);
    var suffix = "/rates";
    var sl = strlen(suffix);
    var url = alloc(bl + sl + 1);
    memcpy(url, base_url, bl);
    memcpy(url + bl, suffix, sl);
    store8(url + bl + sl, 0);

    var body = 0;
    var blen = 0;
    if (_nl_starts_with(url, "https://") == 1) {
        # The URL and the request are checked whether or not this build has
        # TLS, so a malformed https:// URL is AI_ERR_HTTP in every build and
        # only a well-formed one reaches the transport (AI_ERR_TLS without it).
        var parts[24];
        if (_ccy_https_split(url, &parts) != 0) { AI_LAST_ERR = AI_ERR_HTTP; return AI_ERR_HTTP; }
        var host = load64(&parts);
        var port = load64(&parts + 8);
        var req = _ccy_https_request(host, port, load64(&parts + 16));
        if (req == 0) { AI_LAST_ERR = AI_ERR_HTTP; return AI_ERR_HTTP; }
        var hr[24];
        var herr = _ccy_https_get(c, host, port, req, &hr);
        if (herr != 0) { AI_LAST_ERR = herr; return herr; }
        if (load64(&hr) != 200) { AI_LAST_ERR = AI_ERR_HTTP; return AI_ERR_HTTP; }
        body = load64(&hr + 8);
        blen = load64(&hr + 16);
    } else {
        var resp = http_get(url);
        # http_get returns 0 when it cannot allocate its response struct.
        if (resp == 0) { AI_LAST_ERR = AI_ERR_HTTP; return AI_ERR_HTTP; }
        if (http_status(resp) != 200) { AI_LAST_ERR = AI_ERR_HTTP; return AI_ERR_HTTP; }
        body = http_body(resp);
        blen = http_body_len(resp);
    }
    var err = _ccy_load_body(c, body, blen);
    if (err != 0) { AI_LAST_ERR = err; return err; }
    return 0;
}

# Convert `value` from currency `from_raw` to `to_raw` using cached rates.
# `from_raw` / `to_raw` are accepted in any case; the result uses uppercase
# ISO codes. Returns a CurrencyResult ptr, or 0 on failure (see ai_last_err).
fn CurrencyCache_convert(c, value, from_raw, to_raw) {
    AI_LAST_ERR = AI_OK;
    var from = str_upper(from_raw);
    var to = str_upper(to_raw);
    var base = ccy_base(c);
    if (base == 0) { AI_LAST_ERR = AI_ERR_CURRENCY; return 0; }
    var rates = ccy_rates(c);
    var from_rate = 0;
    if (streq(from, base) == 1) {
        from_rate = f64_from(1);
    } else {
        if (map_has(rates, from) == 0) { AI_LAST_ERR = AI_ERR_CURRENCY; return 0; }
        from_rate = map_get(rates, from);
    }
    var to_rate = 0;
    if (streq(to, base) == 1) {
        to_rate = f64_from(1);
    } else {
        if (map_has(rates, to) == 0) { AI_LAST_ERR = AI_ERR_CURRENCY; return 0; }
        to_rate = map_get(rates, to);
    }
    # Rates installed with set_rates are not vetted, and a tiny accepted rate
    # makes a huge cross-rate: refuse any rate or result that is not finite,
    # and any rate that is not > 0, rather than return Inf as a success.
    if (_ccy_rate_usable(from_rate) == 0 || _ccy_rate_usable(to_rate) == 0) {
        AI_LAST_ERR = AI_ERR_CURRENCY;
        return 0;
    }
    var rate = f64_div(to_rate, from_rate);
    var result = f64_mul(value, rate);
    if (_ccy_rate_usable(rate) == 0 || _f64_is_finite(result) == 0) {
        AI_LAST_ERR = AI_ERR_CURRENCY;
        return 0;
    }
    return CurrencyResult_new(value, from, result, to, rate);
}
