# abaco::eval - Expression evaluator
# Ported from rust-old/src/eval.rs (1562 lines)
# Recursive descent parser with 43+ math functions

# -- Token types --
enum TokType {
    TOK_NUMBER;
    TOK_PLUS;
    TOK_MINUS;
    TOK_STAR;
    TOK_SLASH;
    TOK_PERCENT;
    TOK_POWER;
    TOK_LPAREN;
    TOK_RPAREN;
    TOK_IDENT;
    TOK_COMMA;
    TOK_BANG;
}

# -- Error codes --
enum EvalErr {
    ABACO_ERR_NONE;
    ABACO_ERR_DIV_ZERO;
    ABACO_ERR_UNKNOWN_FN;
    ABACO_ERR_UNKNOWN_VAR;
    ABACO_ERR_PARSE;
    ABACO_ERR_MATH;
    ABACO_ERR_INVALID;
}

# -- Token storage --
# Tokens stored as array of { type, value_or_ptr }
# For NUMBER: value is f64 bits
# For IDENT: value is pointer to null-terminated string

var ABACO_MAX_TOKENS = 512;

# tokenize() sentinel: input needs more than ABACO_MAX_TOKENS tokens. Negative so it
# can never collide with a real token count; callers map it to ABACO_ERR_PARSE.
var ABACO_TOK_OVERFLOW = (0 - 1);

# Significant digits `parse_number` accumulates into an i64 mantissa without
# wrapping. i64 tops out at 9.22e18 (19 digits), so 18 is the largest count for
# which `mant * 10 + digit` can never overflow.
#
# This bounds the *accumulator*, not the result: f64 holds integers exactly only
# to 2^53 (~9.007e15, 16 digits), so converting an 18-digit mantissa still
# rounds. Carrying the full 18 keeps that rounding to a single correctly-rounded
# step at the end instead of compounding it per digit.
var ABACO_MANT_DIGITS = 18;

# Clamp on a literal's own decimal exponent, applied while scanning so the
# counter cannot wrap on a pathological run of digits. Deliberately far larger
# than ABACO_POW10_MAX: the scientific exponent is added afterwards, and
# clamping tight here would let the two cancel into the wrong magnitude.
var ABACO_DEC_EXP_MAX = 1000000000;

# Final decimal-exponent clamp. 10^309 is already +Inf and 10^-324 is already
# below the smallest subnormal, so nothing representable survives past this —
# it bounds `_pow10` without changing any answer.
var ABACO_POW10_MAX = 340;

# Domain cap for the evaluator's `totient(n)`. The ntheory implementation
# trial-divides to sqrt(n), so this bounds that loop at ~10^6 iterations.
var ABACO_TOTIENT_MAX = 1000000000000;

# i64 minimum. Written as a subtraction because Cyrius has no negative literals
# and `0 - 9223372036854775808` would not parse. eval_pow needs it to recognise
# the one magnitude that cannot be negated without overflowing.
var ABACO_I64_MIN = (0 - 9223372036854775807) - 1;

# Token array: each token is 16 bytes (type + value)
fn tok_alloc() { return alloc(ABACO_MAX_TOKENS * 16); }
fn tok_type(toks, i) { return load64(toks + i * 16); }
fn tok_val(toks, i) { return load64(toks + i * 16 + 8); }
fn tok_set(toks, i, typ, val) {
    store64(toks + i * 16, typ);
    store64(toks + i * 16 + 8, val);
    return 0;
}

# -- Evaluator state --
# { variables_map, tokens, token_count, pos, error, depth }
struct Evaluator { vars; toks; ntoks; pos; err; depth; }

# Build a fresh evaluator with empty variable map and no pending expression.
# Call Evaluator_set_variable to install user vars, then Evaluator_eval.
fn Evaluator_new() {
    var e = alloc(48);
    store64(e, map_new());
    store64(e + 8, 0);
    store64(e + 16, 0);
    store64(e + 24, 0);
    store64(e + 32, ABACO_ERR_NONE);
    store64(e + 40, 0);
    return e;
}

fn eval_vars(e) { return load64(e); }
fn eval_toks(e) { return load64(e + 8); }
fn eval_ntoks(e) { return load64(e + 16); }
fn eval_pos(e) { return load64(e + 24); }
fn eval_err(e) { return load64(e + 32); }
fn eval_depth(e) { return load64(e + 40); }

fn eval_set_toks(e, t) { store64(e + 8, t); return 0; }
fn eval_set_ntoks(e, n) { store64(e + 16, n); return 0; }
fn eval_set_pos(e, p) { store64(e + 24, p); return 0; }
fn eval_set_err(e, err) { store64(e + 32, err); return 0; }
fn eval_set_depth(e, d) { store64(e + 40, d); return 0; }
fn eval_advance(e) { store64(e + 24, load64(e + 24) + 1); return 0; }

# Bind `name` (cstring) to an f64 bit-pattern value. Later expressions that
# reference this identifier resolve to `val`.
fn Evaluator_set_variable(e, name, val) {
    map_set(load64(e), name, val);
    return 0;
}

# Look up a previously-bound variable. Returns 0 if unbound.
fn Evaluator_get_variable(e, name) {
    return map_get(load64(e), name);
}

# ================================================================
# Tokenizer
# ================================================================

fn is_digit(c) {
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}
fn is_alpha(c) {
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}
fn is_alnum(c) {
    if (is_digit(c) == 1) { return 1; }
    return is_alpha(c);
}
fn is_space(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# 10^k for k >= 0. f64 represents 10^0..10^22 EXACTLY; those are produced by a
# single multiplication chain of at most 22 exact steps, so the result is exact.
# Above 22 the value is split as 10^k = 10^22 * 10^22 * ... * 10^r, which keeps
# the multiplication count (and therefore the accumulated rounding) to ceil(k/22)
# instead of k.
#
# Measured against the correctly-rounded reference across the range, the split
# holds the parse to 1-3 ulp (`1e307`, `1e308`, `1.7e308` are all 1 ulp; 15- and
# 16-digit near-max literals are 2-3). The 2.3.3 parser averaged ~73000 ulp, so
# this is the accuracy the mantissa/exponent split exists to buy.
#
# KNOWN RESIDUAL: literals within ~2 ulp of DBL_MAX still saturate to +Inf,
# because 1 ulp of upward error at the very top of the range IS +Inf.
# `1.7976931348623157e308` (the canonical shortest round-trip decimal for
# DBL_MAX) is the case that matters. Closing it needs a two-term double-double
# scale factor rather than a single f64; tracked in
# docs/development/roadmap.md — 2.3.x "Still open", pinned by
# test_top_of_range_literals so it cannot silently widen.
#
# Callers clamp k, so the loop is bounded.
fn _pow10(k) {
    var r = f64_from(1);
    var ten = f64_from(10);
    var i = 0;
    # Exact block: 10^22 is the largest power of ten f64 holds exactly.
    var e22 = f64_from(1);
    while (i < 22) { e22 = f64_mul(e22, ten); i = i + 1; }
    var rem = k;
    while (rem >= 22) {
        r = f64_mul(r, e22);
        rem = rem - 22;
    }
    i = 0;
    while (i < rem) {
        r = f64_mul(r, ten);
        i = i + 1;
    }
    return r;
}

# Parse a number from input bytes, return f64 bits.
# Sets *out_end to the position after the number.
#
# Significant digits accumulate into an exact i64 mantissa plus a decimal
# exponent. The previous form kept `int_part`, `frac_part` and `frac_div` and
# multiplied each by 10 per digit with no guard (2026-08-13 audit, M-3):
# a ~19-digit integer literal wrapped i64 to a NEGATIVE value, and a ~19-digit
# fraction wrapped `frac_div` into a nonsense divisor, so both silently
# returned garbage. Splitting mantissa from exponent removes the wrap point
# entirely — the mantissa stops at ABACO_MANT_DIGITS and every further digit
# only moves the exponent.
#
# This form is also more accurate for fractions: "3.14" is one correctly-rounded
# 314/100 rather than an accumulation of inexact tenths, and it keeps whole
# numbers bit-exact, which `eval_pow`'s integer fast path depends on.
fn parse_number(input, start, len, out_end) {
    var i = start;
    var mant = 0;
    var mdigits = 0;
    var dec_exp = 0;
    var has_dot = 0;
    var seen_sig = 0;

    # Integer/fractional part
    var pgo = 1;
    while (pgo == 1) {
        if (i >= len) { pgo = 0; }
        else {
            var c = load8(input + i);
            if (is_digit(c) == 1) {
                if (mdigits < ABACO_MANT_DIGITS) {
                    # Leading zeros carry no significance — skip them so
                    # "0.0000001" spends none of the mantissa's 18 digits.
                    if (c != 48 || seen_sig == 1) {
                        mant = mant * 10 + (c - 48);
                        mdigits = mdigits + 1;
                        seen_sig = 1;
                    }
                    # A fractional digit shifts the point regardless of whether
                    # it was significant enough to accumulate.
                    if (has_dot == 1) {
                        if (dec_exp > (0 - ABACO_DEC_EXP_MAX)) { dec_exp = dec_exp - 1; }
                    }
                }
                else {
                    # Mantissa full. Integer digits still scale the value;
                    # fractional digits are below f64 resolution, so drop them.
                    if (has_dot == 0) {
                        if (dec_exp < ABACO_DEC_EXP_MAX) { dec_exp = dec_exp + 1; }
                    }
                }
                i = i + 1;
            }
            elif (c == 46) {
                has_dot = 1;
                i = i + 1;
            }
            else { pgo = 0; }
        }
    }

    # Scientific notation: e/E followed by optional +/- and digits
    var sci = 0;
    if (i < len) {
        var c = load8(input + i);
        var is_exp = 0;
        if (c == 101) { is_exp = 1; }
        if (c == 69) { is_exp = 1; }
        if (is_exp == 1) {
            i = i + 1;
            var exp_sign = 1;
            if (i < len) {
                c = load8(input + i);
                if (c == 43) { i = i + 1; }
                elif (c == 45) { exp_sign = 0 - 1; i = i + 1; }
            }
            var exp_val = 0;
            var ego = 1;
            while (ego == 1) {
                if (i >= len) { ego = 0; }
                else {
                    c = load8(input + i);
                    if (is_digit(c) == 0) { ego = 0; }
                    else {
                        exp_val = exp_val * 10 + (c - 48);
                        # Saturate per digit so "1e9999999999..." cannot
                        # overflow exp_val; bounded work regardless of input
                        # length. The bound is deliberately far above the f64
                        # range: `total = dec_exp + sci` below is the ONLY
                        # place magnitude may be clamped. Saturating here at,
                        # say, 400 would discard the information that addition
                        # needs, and a literal like `0.` + 93 zeros + `1e401`
                        # (true value 1e307) would come out wrong.
                        if (exp_val > ABACO_DEC_EXP_MAX) { exp_val = ABACO_DEC_EXP_MAX; }
                        i = i + 1;
                    }
                }
            }
            sci = exp_sign * exp_val;
        }
    }

    # A zero significand is zero at every exponent. Settle it before scaling:
    # `_pow10` saturates to +Inf at k >= 309, and `0.0 * +Inf` is NaN, so
    # `0e400` used to parse as NaN with no error set (2.3.4 regression — 2.3.3
    # returned 0.0 because its exponent clamp kept the factor finite).
    if (mant == 0) {
        store64(out_end, i);
        return f64_from(0);
    }

    # Combine the literal's own decimal exponent with the scientific one, THEN
    # clamp. Clamping the two separately lets a long fraction and a large
    # positive exponent cancel into a wrong magnitude — which is why `sci` is
    # saturated at ABACO_DEC_EXP_MAX rather than at a value near the f64 range:
    # a tight per-digit clamp on the written exponent would destroy the
    # information this addition needs.
    var total = dec_exp + sci;

    # Upper bound: 10^309 is already +Inf, so clamping there changes no
    # representable value. Lower bound needs ABACO_MANT_DIGITS of headroom —
    # the mantissa carries up to ~1e18, so `mant * 10^-340` still lands around
    # 1e-322, inside the subnormal range. Clamping at -340 would round genuine
    # subnormals up and turn true underflows into nonzero values.
    if (total > ABACO_POW10_MAX) { total = ABACO_POW10_MAX; }
    if (total < (0 - (ABACO_POW10_MAX + ABACO_MANT_DIGITS))) {
        total = 0 - (ABACO_POW10_MAX + ABACO_MANT_DIGITS);
    }

    var result = f64_from(mant);
    if (total > 0) {
        result = f64_mul(result, _pow10(total));
    }
    elif (total < 0) {
        # Divide rather than multiply by 10^-k: one correctly-rounded division
        # beats a reciprocal that is itself inexact. Step the divisor so it
        # never reaches +Inf before the value has legitimately underflowed,
        # which would collapse representable subnormals (e.g. 1e-320) to 0.
        var k = 0 - total;
        while (k > 200) {
            result = f64_div(result, _pow10(200));
            k = k - 200;
        }
        result = f64_div(result, _pow10(k));
    }

    store64(out_end, i);
    return result;
}

# Tokenize input string into token array.
# Returns the token count, or ABACO_TOK_OVERFLOW when the input needs more than
# ABACO_MAX_TOKENS tokens. tok_alloc() reserves exactly ABACO_MAX_TOKENS * 16 bytes, so
# writing token ABACO_MAX_TOKENS would run off the end of the allocation and corrupt
# whatever the bump allocator handed out next (in practice the per-number
# `nend` scratch cells, which silently changed results from ~343 terms on).
# Callers map ABACO_TOK_OVERFLOW to ABACO_ERR_PARSE.
fn tokenize(input, toks) {
    var len = strlen(input);
    var i = 0;
    var nt = 0;

    while (i < len) {
        var c = load8(input + i);
        # Bound EVERY write: one loop pass appends at most one token. The check
        # sits after whitespace is classified, not before — a pass that emits
        # no token must not be rejected, or an expression with exactly
        # ABACO_MAX_TOKENS tokens plus a trailing space would be a false
        # ABACO_ERR_PARSE.
        if (is_space(c) == 1) { i = i + 1; }
        elif (nt >= ABACO_MAX_TOKENS) { return ABACO_TOK_OVERFLOW; }
        elif (c == 43) { tok_set(toks, nt, TOK_PLUS, 0); nt = nt + 1; i = i + 1; }
        elif (c == 45) { tok_set(toks, nt, TOK_MINUS, 0); nt = nt + 1; i = i + 1; }
        elif (c == 42) {
            # * or **
            var is_pow = 0;
            if (i + 1 < len) { if (load8(input + i + 1) == 42) { is_pow = 1; } }
            if (is_pow == 1) {
                tok_set(toks, nt, TOK_POWER, 0); nt = nt + 1; i = i + 2;
            } else {
                tok_set(toks, nt, TOK_STAR, 0); nt = nt + 1; i = i + 1;
            }
        }
        elif (c == 47) { tok_set(toks, nt, TOK_SLASH, 0); nt = nt + 1; i = i + 1; }
        elif (c == 37) { tok_set(toks, nt, TOK_PERCENT, 0); nt = nt + 1; i = i + 1; }
        elif (c == 94) { tok_set(toks, nt, TOK_POWER, 0); nt = nt + 1; i = i + 1; }
        elif (c == 40) { tok_set(toks, nt, TOK_LPAREN, 0); nt = nt + 1; i = i + 1; }
        elif (c == 41) { tok_set(toks, nt, TOK_RPAREN, 0); nt = nt + 1; i = i + 1; }
        elif (c == 44) { tok_set(toks, nt, TOK_COMMA, 0); nt = nt + 1; i = i + 1; }
        elif (c == 33) { tok_set(toks, nt, TOK_BANG, 0); nt = nt + 1; i = i + 1; }
        elif (is_digit(c) == 1) {
            var nend = alloc(8);
            var num = parse_number(input, i, len, nend);
            tok_set(toks, nt, TOK_NUMBER, num);
            nt = nt + 1;
            i = load64(nend);
        }
        elif (c == 46) {
            var dend = alloc(8);
            var dnum = parse_number(input, i, len, dend);
            tok_set(toks, nt, TOK_NUMBER, dnum);
            nt = nt + 1;
            i = load64(dend);
        }
        elif (is_alpha(c) == 1) {
            var start = i;
            var igo = 1;
            while (igo == 1) {
                if (i >= len) { igo = 0; }
                elif (is_alnum(load8(input + i)) == 0) { igo = 0; }
                else { i = i + 1; }
            }
            var ident_len = i - start;
            var ident = alloc(ident_len + 1);
            memcpy(ident, input + start, ident_len);
            store8(ident + ident_len, 0);
            tok_set(toks, nt, TOK_IDENT, ident);
            nt = nt + 1;
        }
        else {
            i = i + 1;
        }
    }

    # Insert implicit multiplication
    nt = implicit_mul(toks, nt);
    return nt;
}

# Check if implicit * needed after token i
fn needs_star(toks, nt, i) {
    if (i + 1 >= nt) { return 0; }
    var t1 = tok_type(toks, i);
    var t2 = tok_type(toks, i + 1);
    # Number followed by LParen or Ident
    if (t1 == TOK_NUMBER) {
        if (t2 == TOK_LPAREN) { return 1; }
        if (t2 == TOK_IDENT) { return 1; }
    }
    # RParen followed by LParen, Number, or Ident
    if (t1 == TOK_RPAREN) {
        if (t2 == TOK_LPAREN) { return 1; }
        if (t2 == TOK_NUMBER) { return 1; }
        if (t2 == TOK_IDENT) { return 1; }
    }
    return 0;
}

# Insert implicit * tokens in-place (shifts tokens right)
fn implicit_mul(toks, nt) {
    # Check if any insertion needed
    var need = 0;
    var i = 0;
    while (i < nt - 1) {
        if (needs_star(toks, nt, i) == 1) { need = need + 1; }
        i = i + 1;
    }
    if (need == 0) { return nt; }

    # Build new array. Insertion can add up to one star per token, so `ni` can
    # outrun ABACO_MAX_TOKENS even when `nt` did not — this needs its own bound, not
    # the caller's. Overflowing here would both write past newtoks and make the
    # memcpy below copy an oversized run back over `toks`.
    var newtoks = tok_alloc();
    var ni = 0;
    i = 0;
    while (i < nt) {
        if (ni >= ABACO_MAX_TOKENS) { return ABACO_TOK_OVERFLOW; }
        tok_set(newtoks, ni, tok_type(toks, i), tok_val(toks, i));
        ni = ni + 1;
        if (i + 1 < nt) {
            if (needs_star(toks, nt, i) == 1) {
                if (ni >= ABACO_MAX_TOKENS) { return ABACO_TOK_OVERFLOW; }
                tok_set(newtoks, ni, TOK_STAR, 0);
                ni = ni + 1;
            }
        }
        i = i + 1;
    }
    # Copy back
    memcpy(toks, newtoks, ni * 16);
    return ni;
}

# ================================================================
# Parser - recursive descent
# ================================================================

# Parser-recursion cap. `(((...)))` or `f(f(f(...)))` past this depth sets
# ABACO_ERR_PARSE rather than recursing further and risking a native stack overflow
# (SandboxJS GHSA-8pfc-jjgw-6g26, CPython #32758 / #95185 class).
# 256 levels is ~64 KB of C stack frames at ~256 bytes/frame — well below
# any platform's default limit while still comfortable for human input.
var ABACO_MAX_DEPTH = 256;

# Helper: check if current token matches type
fn eval_at(e, typ) {
    if (eval_pos(e) >= eval_ntoks(e)) { return 0; }
    if (tok_type(eval_toks(e), eval_pos(e)) == typ) { return 1; }
    return 0;
}
fn eval_not_at(e, typ) {
    if (eval_pos(e) >= eval_ntoks(e)) { return 1; }
    if (tok_type(eval_toks(e), eval_pos(e)) != typ) { return 1; }
    return 0;
}
# Constants — alias onto stdlib math.cyr (Cyrius 4.10.2+).
var CONST_PI = F64_PI;
var CONST_E = F64_E;
var CONST_TAU = F64_TAU;

# Forward declarations handled by Cyrius's forward-call support

fn parse_expr(e) {
    if (eval_depth(e) >= ABACO_MAX_DEPTH) { eval_set_err(e, ABACO_ERR_PARSE); return f64_from(0); }
    var left = parse_term(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return left; }
    while (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_PLUS) {
            eval_advance(e);
            var right = parse_term(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_add(left, right);
        }
        elif (t == TOK_MINUS) {
            eval_advance(e);
            var right = parse_term(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_sub(left, right);
        }
        else { return left; }
    }
    return left;
}

fn parse_term(e) {
    var left = parse_power(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return left; }
    while (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_STAR) {
            eval_advance(e);
            var right = parse_power(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_mul(left, right);
        }
        elif (t == TOK_SLASH) {
            eval_advance(e);
            var right = parse_power(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            if (f64_eq(right, f64_from(0)) == 1) {
                eval_set_err(e, ABACO_ERR_DIV_ZERO);
                return left;
            }
            left = f64_div(left, right);
        }
        elif (t == TOK_PERCENT) {
            # Postfix percent or binary modulo
            var nxt = eval_pos(e) + 1;
            var is_postfix = 0;
            if (nxt >= eval_ntoks(e)) { is_postfix = 1; }
            else {
                var nt = tok_type(eval_toks(e), nxt);
                if (nt == TOK_RPAREN) { is_postfix = 1; }
                if (nt == TOK_COMMA) { is_postfix = 1; }
                if (nt == TOK_PLUS) { is_postfix = 1; }
                if (nt == TOK_MINUS) { is_postfix = 1; }
                if (nt == TOK_STAR) { is_postfix = 1; }
                if (nt == TOK_SLASH) { is_postfix = 1; }
                if (nt == TOK_PERCENT) { is_postfix = 1; }
                if (nt == TOK_POWER) { is_postfix = 1; }
            }
            eval_advance(e);
            if (is_postfix == 1) {
                left = f64_div(left, f64_from(100));
            } else {
                var right = parse_power(e);
                if (eval_err(e) != ABACO_ERR_NONE) { return left; }
                if (f64_eq(right, f64_from(0)) == 1) {
                    eval_set_err(e, ABACO_ERR_DIV_ZERO);
                    return left;
                }
                # Modulo: a - floor(a/b)*b
                var quot = f64_floor(f64_div(left, right));
                left = f64_sub(left, f64_mul(quot, right));
            }
        }
        else { return left; }
    }
    return left;
}

# f64 power: a^b. Named `eval_pow` (not the stdlib `f64_pow` in lib/math.cyr)
# because it resolves INTEGER exponents exactly, so `2^10` returns 1024 rather
# than a log/exp round-trip approximation. See docs/adr/0002.
#
# Integer exponents use binary exponentiation (square-and-multiply), which is
# O(log |exp|): at most 63 multiplications for any i64 exponent. That matters
# three ways, and replaces the ABACO_POW_EXACT_MAX cap 2.3.4 used:
#
#   - No DoS. The 2.3.3 linear loop ran `exp` times with the count taken from
#     user text, so `2^1000000000000000000` was ~10^18 multiplications (~81
#     years). 2.3.4 capped that at 1024 — but a cap is the wrong instrument.
#   - No accuracy cliff. The 2.3.4 cap handed every exponent above 1024 to the
#     exp2/log2 path, which is 30-60x less accurate, and it did so across the
#     whole band 0.5 < |base| < 2 where results are still genuinely changing
#     (1.001^1024 and 1.001^1025 differ). Squaring keeps the exact path for
#     every integer exponent, and its shorter multiplication chain is more
#     accurate than the 2.3.3 linear loop as well.
#   - No non-finite hole. The 2.3.4 cap sent (+Inf)^n for n > 1024 into
#     `exp2(log2(+Inf))` = `exp2(+Inf)`, which returns NaN — a silent wrong
#     answer where 2.3.3 correctly gave +Inf. Squaring propagates Inf and 0
#     the way IEEE-754 requires, with no special case needed.
#
# See docs/audit/2026-08-13-fix-audit.md.
fn eval_pow(base, exp) {
    var zero = f64_from(0);
    var one = f64_from(1);
    if (f64_eq(exp, zero) == 1) { return one; }
    if (f64_eq(base, zero) == 1) { return zero; }

    var exp_i = f64_to(exp);
    var exp_back = f64_from(exp_i);
    var is_int = f64_eq(exp, exp_back);

    # |base| == 1 is exact for every exponent and sidesteps the i64-minimum
    # magnitude question below, so settle it first.
    if (is_int == 1) {
        if (f64_eq(base, one) == 1) { return one; }
        if (f64_eq(base, f64_neg(one)) == 1) {
            if (exp_i % 2 == 0) { return one; }
            return f64_neg(one);
        }
    }

    if (is_int == 1) {
        var n = exp_i;
        var neg = 0;
        # (0 - i64_MIN) overflows back to i64_MIN, so peel one off the
        # magnitude. |base| == 1 is already handled above, and at |exp| ~9.2e18
        # every other base has saturated to 0 or +/-Inf long before, so the
        # peeled factor cannot change the result.
        if (n == ABACO_I64_MIN) { n = n + 1; }
        if (n < 0) { neg = 1; n = 0 - n; }
        var result = one;
        var b = base;
        while (n > 0) {
            if (n % 2 == 1) { result = f64_mul(result, b); }
            b = f64_mul(b, b);
            n = n / 2;
        }
        if (neg == 1) { return f64_div(one, result); }
        return result;
    }

    # Non-integer exponent: exp2(exp * log2(|base|)). A negative base with a
    # fractional exponent has no real result; the sign correction below only
    # applies to integer exponents, which never reach here.
    return f64_exp2(f64_mul(exp, f64_log2(f64_abs(base))));
}

fn parse_power(e) {
    var base = parse_unary(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return base; }
    # Postfix factorial
    while (eval_at(e, TOK_BANG) == 1) {
        eval_advance(e);
        var n = f64_to(base);
        if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
        if (n > 170) {
            eval_set_err(e, ABACO_ERR_MATH);
            return base;
        }
        var result = f64_from(1);
        var fi = 1;
        while (fi <= n) {
            result = f64_mul(result, f64_from(fi));
            fi = fi + 1;
        }
        base = result;
    }
    # `^` is right-associative, so a^b^c^... recurses once per operator and
    # needs depth accounting for the same reason parse_unary does.
    if (eval_at(e, TOK_POWER) == 1) {
        if (eval_depth(e) >= ABACO_MAX_DEPTH) {
            eval_set_err(e, ABACO_ERR_PARSE);
            return f64_from(0);
        }
        eval_advance(e);
        eval_set_depth(e, eval_depth(e) + 1);
        var exp = parse_power(e);
        eval_set_depth(e, eval_depth(e) - 1);
        if (eval_err(e) != ABACO_ERR_NONE) { return base; }
        return eval_pow(base, exp);
    }
    return base;
}

# Unary +/- chains recurse once per sign, so they need the same ABACO_MAX_DEPTH
# accounting parse_expr does. Without it `----...--1` recursed unbounded and
# overflowed the native stack — the paren/arg sites were the only places
# charging depth, which left `-` and `^` chains entirely unbounded.
fn parse_unary(e) {
    if (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_MINUS || t == TOK_PLUS) {
            if (eval_depth(e) >= ABACO_MAX_DEPTH) {
                eval_set_err(e, ABACO_ERR_PARSE);
                return f64_from(0);
            }
            eval_advance(e);
            eval_set_depth(e, eval_depth(e) + 1);
            var inner = parse_unary(e);
            eval_set_depth(e, eval_depth(e) - 1);
            if (t == TOK_MINUS) { return f64_neg(inner); }
            return inner;
        }
    }
    return parse_primary(e);
}

# ================================================================
# Function dispatch
# ================================================================

fn parse_primary(e) {
    if (eval_pos(e) >= eval_ntoks(e)) {
        eval_set_err(e, ABACO_ERR_INVALID);
        return f64_from(0);
    }
    var toks = eval_toks(e);
    var pos = eval_pos(e);
    var t = tok_type(toks, pos);

    if (t == TOK_NUMBER) {
        eval_advance(e);
        return tok_val(toks, pos);
    }
    if (t == TOK_LPAREN) {
        eval_advance(e);
        eval_set_depth(e, eval_depth(e) + 1);
        var val = parse_expr(e);
        eval_set_depth(e, eval_depth(e) - 1);
        if (eval_not_at(e, TOK_RPAREN) == 1) {
            eval_set_err(e, ABACO_ERR_PARSE);
            return val;
        }
        eval_advance(e);
        return val;
    }
    if (t == TOK_IDENT) {
        var name = tok_val(toks, pos);
        eval_advance(e);
        # Function call?
        if (eval_at(e, TOK_LPAREN) == 1) {
            eval_advance(e);
            # Audit MED-6: cap argument arity. `args` is a fixed-size
            # buffer; variadic stat fns (mean/median/stddev) are the only
            # legitimate users of large-arity calls, and 32 is generous.
            # Without this cap an adversarial `mean(0,0,0,...)` with 10^5
            # commas would overflow the 32-slot buffer.
            var args = alloc(32 * 8);
            var nargs = 0;
            if (eval_not_at(e, TOK_RPAREN) == 1) {
                eval_set_depth(e, eval_depth(e) + 1);
                store64(args + nargs * 8, parse_expr(e));
                eval_set_depth(e, eval_depth(e) - 1);
                nargs = nargs + 1;
                while (eval_at(e, TOK_COMMA) == 1) {
                    eval_advance(e);
                    if (nargs >= 32) {
                        eval_set_err(e, ABACO_ERR_PARSE);
                        return f64_from(0);
                    }
                    eval_set_depth(e, eval_depth(e) + 1);
                    store64(args + nargs * 8, parse_expr(e));
                    eval_set_depth(e, eval_depth(e) - 1);
                    nargs = nargs + 1;
                }
            }
            if (eval_not_at(e, TOK_RPAREN) == 1) {
                eval_set_err(e, ABACO_ERR_PARSE);
                return f64_from(0);
            }
            eval_advance(e);
            return call_function(e, name, args, nargs);
        }
        # Constants
        if (streq(name, "pi") == 1) { return CONST_PI; }
        if (streq(name, "PI") == 1) { return CONST_PI; }
        if (streq(name, "e") == 1) { return CONST_E; }
        if (streq(name, "E") == 1) { return CONST_E; }
        if (streq(name, "tau") == 1) { return CONST_TAU; }
        if (streq(name, "TAU") == 1) { return CONST_TAU; }
        # Variable lookup
        if (map_has(eval_vars(e), name) == 1) {
            return map_get(eval_vars(e), name);
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_VAR);
        return f64_from(0);
    }
    eval_set_err(e, ABACO_ERR_PARSE);
    return f64_from(0);
}

# ================================================================
# Function dispatch (43+ functions)
# ================================================================

# gcd_int — now delegated to stdlib gcd() from math.cyr (Cyrius 4.10.2+).
fn gcd_int(a, b) {
    return gcd(a, b);
}

fn call_function(e, name, args, nargs) {
    var a = load64(args);
    var b = load64(args + 8);

    # Variable-arity functions first (they can have any nargs >= 1)
    if (nargs >= 1) {
        var is_mean = 0;
        if (streq(name, "mean") == 1) { is_mean = 1; }
        if (streq(name, "avg") == 1) { is_mean = 1; }
        if (is_mean == 1) {
            var sum = f64_from(0);
            var mi = 0;
            while (mi < nargs) { sum = f64_add(sum, load64(args + mi * 8)); mi = mi + 1; }
            return f64_div(sum, f64_from(nargs));
        }
        if (streq(name, "median") == 1) {
            var mi = 0;
            while (mi < nargs - 1) {
                var mj = 0;
                while (mj < nargs - 1 - mi) {
                    var va = load64(args + mj * 8);
                    var vb = load64(args + (mj + 1) * 8);
                    if (f64_gt(va, vb) == 1) {
                        store64(args + mj * 8, vb);
                        store64(args + (mj + 1) * 8, va);
                    }
                    mj = mj + 1;
                }
                mi = mi + 1;
            }
            if (nargs % 2 == 1) {
                return load64(args + (nargs / 2) * 8);
            }
            var mid1 = load64(args + (nargs / 2 - 1) * 8);
            var mid2 = load64(args + (nargs / 2) * 8);
            return f64_div(f64_add(mid1, mid2), f64_from(2));
        }
        var is_std = 0;
        if (streq(name, "stddev") == 1) { is_std = 1; }
        if (streq(name, "stdev") == 1) { is_std = 1; }
        if (is_std == 1) {
            var sum = f64_from(0);
            var si = 0;
            while (si < nargs) { sum = f64_add(sum, load64(args + si * 8)); si = si + 1; }
            var smean = f64_div(sum, f64_from(nargs));
            var vsum = f64_from(0);
            si = 0;
            while (si < nargs) {
                var diff = f64_sub(load64(args + si * 8), smean);
                vsum = f64_add(vsum, f64_mul(diff, diff));
                si = si + 1;
            }
            return f64_sqrt(f64_div(vsum, f64_from(nargs)));
        }
    }

    # 1-arg functions
    if (nargs == 1) {
        if (streq(name, "sqrt") == 1) { return f64_sqrt(a); }
        if (streq(name, "sin") == 1) { return f64_sin(a); }
        if (streq(name, "cos") == 1) { return f64_cos(a); }
        if (streq(name, "tan") == 1) { return f64_div(f64_sin(a), f64_cos(a)); }
        if (streq(name, "log") == 1) { return f64_div(f64_ln(a), f64_ln(f64_from(10))); }
        if (streq(name, "log10") == 1) { return f64_div(f64_ln(a), f64_ln(f64_from(10))); }
        if (streq(name, "ln") == 1) { return f64_ln(a); }
        if (streq(name, "log2") == 1) { return f64_log2(a); }
        if (streq(name, "abs") == 1) { return f64_abs(a); }
        if (streq(name, "ceil") == 1) { return f64_ceil(a); }
        if (streq(name, "floor") == 1) { return f64_floor(a); }
        if (streq(name, "round") == 1) { return f64_round_half_away(a); }
        if (streq(name, "exp") == 1) { return f64_exp(a); }
        # Inverse trig — stdlib math.cyr (Cyrius 4.8.5+).
        if (streq(name, "asin") == 1) { return f64_asin(a); }
        if (streq(name, "acos") == 1) { return f64_acos(a); }
        if (streq(name, "atan") == 1) { return f64_atan(a); }
        # Hyperbolic + inverse hyperbolic — stdlib math.cyr.
        if (streq(name, "sinh") == 1) { return f64_sinh(a); }
        if (streq(name, "cosh") == 1) { return f64_cosh(a); }
        if (streq(name, "tanh") == 1) { return f64_tanh(a); }
        if (streq(name, "asinh") == 1) { return f64_asinh(a); }
        if (streq(name, "acosh") == 1) { return f64_acosh(a); }
        if (streq(name, "atanh") == 1) { return f64_atanh(a); }
        if (streq(name, "trunc") == 1) { return f64_trunc(a); }
        if (streq(name, "fract") == 1) { return f64_fract(a); }
        if (streq(name, "sign") == 1) { return f64_sign(a); }
        if (streq(name, "sgn") == 1) { return f64_sign(a); }
        if (streq(name, "deg") == 1) {
            # radians to degrees: a * 180/pi
            return f64_mul(a, f64_div(f64_from(180), CONST_PI));
        }
        if (streq(name, "rad") == 1) {
            # degrees to radians: a * pi/180
            return f64_mul(a, f64_div(CONST_PI, f64_from(180)));
        }
        if (streq(name, "factorial") == 1) {
            var n = f64_to(a);
            if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            if (n > 170) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            var result = f64_from(1);
            var fi = 1;
            while (fi <= n) { result = f64_mul(result, f64_from(fi)); fi = fi + 1; }
            return result;
        }
        if (streq(name, "isprime") == 1) {
            var n = f64_to(a);
            if (n < 0) { return f64_from(0); }
            return f64_from(is_prime(n));
        }
        if (streq(name, "nextprime") == 1) {
            var n = f64_to(a);
            if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(next_prime(n));
        }
        if (streq(name, "prevprime") == 1) {
            var n = f64_to(a);
            if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            var r = prev_prime(n);
            if (is_ok(r) == 1) { return f64_from(payload(r)); }
            eval_set_err(e, ABACO_ERR_MATH);
            return f64_from(0);
        }
        if (streq(name, "totient") == 1) {
            var n = f64_to(a);
            if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            # totient() trial-divides to sqrt(n), so an unbounded n is an
            # attacker-controlled O(sqrt(n)) loop. Cap the domain the way
            # `factorial` (n > 170) and `fibonacci` (n > 92) already do; 10^12
            # keeps the loop under ~10^6 iterations and covers any realistic
            # calculator input.
            if (n > ABACO_TOTIENT_MAX) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(totient(n));
        }
        var is_fib = 0;
        if (streq(name, "fibonacci") == 1) { is_fib = 1; }
        if (streq(name, "fib") == 1) { is_fib = 1; }
        if (is_fib == 1) {
            var n = f64_to(a);
            if (n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            if (n > 92) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(fibonacci(n));
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
        return f64_from(0);
    }

    # 2-arg functions
    if (nargs == 2) {
        if (streq(name, "min") == 1) { return f64_min(a, b); }
        if (streq(name, "max") == 1) { return f64_max(a, b); }
        if (streq(name, "pow") == 1) { return eval_pow(a, b); }
        if (streq(name, "atan2") == 1) {
            # Quadrant-correct two-arg arctangent (stdlib math.cyr, 4.8.5+).
            # Closes the pre-4.8.5 Q2/Q3 bug where we returned atan(y/x)
            # without quadrant fix.
            return f64_atan2(a, b);
        }
        if (streq(name, "gcd") == 1) {
            return f64_from(gcd_int(f64_to(f64_abs(a)), f64_to(f64_abs(b))));
        }
        if (streq(name, "lcm") == 1) {
            return f64_from(lcm(f64_to(a), f64_to(b)));
        }
        var is_binom = 0;
        if (streq(name, "binomial") == 1) { is_binom = 1; }
        if (streq(name, "choose") == 1) { is_binom = 1; }
        if (is_binom == 1) {
            return f64_from(binomial(f64_to(a), f64_to(b)));
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
        return f64_from(0);
    }

    eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
    return f64_from(0);
}

# ================================================================
# Public API
# ================================================================

# Evaluate expression string, return f64 bits
# Sets eval_err on the evaluator if error
fn Evaluator_eval(e, expr) {
    var toks = tok_alloc();
    eval_set_toks(e, toks);
    eval_set_pos(e, 0);
    eval_set_err(e, ABACO_ERR_NONE);
    eval_set_depth(e, 0);
    var nt = tokenize(expr, toks);
    if (nt == ABACO_TOK_OVERFLOW) {
        eval_set_ntoks(e, 0);
        eval_set_err(e, ABACO_ERR_PARSE);
        return f64_from(0);
    }
    eval_set_ntoks(e, nt);
    if (nt == 0) { eval_set_err(e, ABACO_ERR_INVALID); return f64_from(0); }
    var result = parse_expr(e);
    if (eval_err(e) == ABACO_ERR_NONE) { if (eval_pos(e) < eval_ntoks(e)) {
            eval_set_err(e, ABACO_ERR_PARSE);
        } }
    return result;
}

# Evaluate partial/incomplete expression for live-as-you-type feedback.
# Strips trailing operators until a valid parse is found.
fn Evaluator_eval_partial(e, expr) {
    var toks = tok_alloc();
    eval_set_toks(e, toks);
    eval_set_err(e, ABACO_ERR_NONE);
    eval_set_depth(e, 0);
    var nt = tokenize(expr, toks);
    if (nt == ABACO_TOK_OVERFLOW) {
        eval_set_ntoks(e, 0);
        eval_set_err(e, ABACO_ERR_PARSE);
        return f64_from(0);
    }
    if (nt == 0) { eval_set_err(e, ABACO_ERR_INVALID); return f64_from(0); }

    # Try full expression first
    eval_set_ntoks(e, nt);
    eval_set_pos(e, 0);
    var result = parse_expr(e);
    if (eval_err(e) == ABACO_ERR_NONE) { return result; }

    # Progressively strip trailing tokens
    var try_nt = nt - 1;
    while (try_nt > 0) {
        eval_set_ntoks(e, try_nt);
        eval_set_pos(e, 0);
        eval_set_err(e, ABACO_ERR_NONE);
        eval_set_depth(e, 0);
        result = parse_expr(e);
        if (eval_err(e) == ABACO_ERR_NONE) {
            if (eval_pos(e) == try_nt) {
                return result;
            }
        }
        try_nt = try_nt - 1;
    }
    eval_set_err(e, ABACO_ERR_INVALID);
    return f64_from(0);
}

# Evaluate and return as Value (Integer if whole, Float otherwise)
fn Evaluator_eval_value(e, expr) {
    var result = Evaluator_eval(e, expr);
    if (eval_err(e) != ABACO_ERR_NONE) { return Value_float(result); }
    var i = f64_to(result);
    var back = f64_from(i);
    if (f64_eq(result, back) == 1) {
        return Value_integer(i);
    }
    return Value_float(result);
}
