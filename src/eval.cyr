# abaco::eval - Expression evaluator
# Ported from rust-old/src/eval.rs (1562 lines)
# Recursive descent parser with 43+ math functions

# -- Token types --
enum TokType {
    TOK_NUMBER;
    TOK_PLUS;
    TOK_MINUS;
    TOK_STAR;
    TOK_SLASH;
    TOK_PERCENT;
    TOK_POWER;
    TOK_LPAREN;
    TOK_RPAREN;
    TOK_IDENT;
    TOK_COMMA;
    TOK_BANG;
}

# -- Error codes --
enum EvalErr {
    ABACO_ERR_NONE;
    ABACO_ERR_DIV_ZERO;
    ABACO_ERR_UNKNOWN_FN;
    ABACO_ERR_UNKNOWN_VAR;
    ABACO_ERR_PARSE;
    ABACO_ERR_MATH;
    ABACO_ERR_INVALID;
}

# -- Token storage --
# Tokens stored as array of { type, value_or_ptr }
# For NUMBER: value is f64 bits
# For IDENT: value is pointer to null-terminated string

# Per-expression token cap. Raised 512 -> 1024 at 2.4.0: at 512, reaching
# ABACO_MAX_DEPTH through a right-associative '^' chain needed >= 256 operators
# at 2 tokens each = >= 513 tokens, so the token cap always fired first and
# parse_power's depth guard was structurally UNREACHABLE (fix-audit T-1). 1024
# makes it reachable — and accepting longer expressions is a user-visible
# improvement, which is why 2.4.0 is a minor rather than a patch. Costs 16 KB
# per tok_alloc.
var ABACO_MAX_TOKENS = 1024;

# Significant digits `parse_number` accumulates into an i64 mantissa without
# wrapping. i64 tops out at 9.22e18 (19 digits), so 18 is the largest count for
# which `mant * 10 + digit` can never overflow.
#
# This bounds the *accumulator*, not the result: f64 holds integers exactly only
# to 2^53 (~9.007e15, 16 digits), so converting an 18-digit mantissa still
# rounds. Carrying the full 18 keeps that rounding to a single correctly-rounded
# step at the end instead of compounding it per digit.
var ABACO_MANT_DIGITS = 18;

# Clamp on a literal's own decimal exponent, applied while scanning so the
# counter cannot wrap on a pathological run of digits. Deliberately far larger
# than ABACO_POW10_MAX: the scientific exponent is added afterwards, and
# clamping tight here would let the two cancel into the wrong magnitude.
var ABACO_DEC_EXP_MAX = 1000000000;

# Final decimal-exponent clamp. 10^309 is already +Inf and 10^-324 is already
# below the smallest subnormal, so nothing representable survives past this —
# it bounds the scaling loops without changing any answer. The negative side
# additionally carries ABACO_MANT_DIGITS of headroom (see the clamp below):
# the mantissa reaches ~1e18, so `mant * 10^-340` still lands near 1e-322,
# inside the subnormal range.
var ABACO_POW10_MAX = 340;

# Domain cap for the evaluator's `totient(n)`. The ntheory implementation
# trial-divides to sqrt(n), so this bounds that loop at ~10^6 iterations.
var ABACO_TOTIENT_MAX = 1000000000000;

# i64 minimum. Written as a subtraction because Cyrius has no negative literals
# and `0 - 9223372036854775808` would not parse. eval_pow needs it to recognise
# the one magnitude that cannot be negated without overflowing.
var ABACO_I64_MIN = (0 - 9223372036854775807) - 1;

# Token array: each token is 16 bytes (type + value)
fn tok_alloc() { return alloc(ABACO_MAX_TOKENS * 16); }
fn _tok_alloc_a(a) { return _eval_alloc(a, ABACO_MAX_TOKENS * 16); }

# Per-evaluation scratch — token arrays, identifier strings, argument buffers.
# Through 2.4.8 every Evaluator_eval took them straight from the never-freeing
# bump allocator: 16-33 KB per evaluation, 827 MB after 30,000, which a
# calculator that previews on every keystroke reaches in an afternoon (2.4.9
# audit). Each Evaluator now owns a growable arena that is rewound at the start
# of every evaluation, so memory settles at the high-water mark of the largest
# expression it has seen and stops growing. Nothing allocated here outlives the
# evaluation: results are f64 values, and Evaluator_eval_value builds its Value
# on the ordinary heap.
#
# The arena is passed down explicitly (`a`, 0 = plain alloc), never through a
# global: the first cut parked it in one, and two Evaluators on two threads then
# allocated from each other's arena and crashed (2.4.9 final review). Every
# request is bounded (tokens 16 KB, arguments 256 B, identifiers
# ABACO_MAX_IDENT), so none exceeds a chunk and the arena never chains an
# oversize one per evaluation.
enum EvalArena { ABACO_EVAL_ARENA_CHUNK = 65536; ABACO_MAX_IDENT = 4096; }

fn _eval_alloc(a, size) {
    if (a != 0) { return arena_alloc(a, size); }
    return alloc(size);
}
fn tok_type(toks, i) { return load64(toks + i * 16); }
fn tok_val(toks, i) { return load64(toks + i * 16 + 8); }
fn tok_set(toks, i, typ, val) {
    store64(toks + i * 16, typ);
    store64(toks + i * 16 + 8, val);
    return 0;
}

# -- Evaluator state --
# { variables_map, tokens, token_count, pos, error, depth, arena }
struct Evaluator { vars; toks; ntoks; pos; err; depth; arena; }

# Build a fresh evaluator with empty variable map and no pending expression.
# Call Evaluator_set_variable to install user vars, then Evaluator_eval.
fn Evaluator_new() {
    var e = alloc(56);
    store64(e, map_new());
    store64(e + 8, 0);
    store64(e + 16, 0);
    store64(e + 24, 0);
    store64(e + 32, ABACO_ERR_NONE);
    store64(e + 40, 0);
    store64(e + 48, 0);   # arena, created on first evaluation
    return e;
}

# Start an evaluation: rewind this evaluator's arena (creating it on first
# use) and return it.
fn _eval_begin(e) {
    var a = load64(e + 48);
    if (a == 0) {
        a = arena_new_growable(ABACO_EVAL_ARENA_CHUNK);
        store64(e + 48, a);
    }
    arena_reset(a);
    return a;
}

fn eval_arena(e) { return load64(e + 48); }

fn eval_vars(e) { return load64(e); }
fn eval_toks(e) { return load64(e + 8); }
fn eval_ntoks(e) { return load64(e + 16); }
fn eval_pos(e) { return load64(e + 24); }
fn eval_err(e) { return load64(e + 32); }
fn eval_depth(e) { return load64(e + 40); }

fn eval_set_toks(e, t) { store64(e + 8, t); return 0; }
fn eval_set_ntoks(e, n) { store64(e + 16, n); return 0; }
fn eval_set_pos(e, p) { store64(e + 24, p); return 0; }
fn eval_set_err(e, err) { store64(e + 32, err); return 0; }
fn eval_set_depth(e, d) { store64(e + 40, d); return 0; }
fn eval_advance(e) { store64(e + 24, load64(e + 24) + 1); return 0; }

# Bind `name` (cstring) to an f64 bit-pattern value. Later expressions that
# reference this identifier resolve to `val`. The name is copied: through 2.4.8
# the map kept the caller's pointer, so reusing that buffer renamed or lost the
# variable (2.4.9 audit).
fn Evaluator_set_variable(e, name, val) {
    # Rebinding updates the entry in place and keeps the copy made at the first
    # binding; copying on every call leaked 8+ bytes per call in a plot loop.
    var ep = _map_lookup(load64(e), name);
    if (ep != 0) {
        store64(ep + 8, val);
        return 0;
    }
    var n = strlen(name);
    var own = alloc(n + 1);
    memcpy(own, name, n);
    store8(own + n, 0);
    map_set(load64(e), own, val);
    return 0;
}

# Look up a previously-bound variable. Returns 0 if unbound.
fn Evaluator_get_variable(e, name) {
    return map_get(load64(e), name);
}

# ================================================================
# Tokenizer
# ================================================================

fn is_digit(c) {
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}
fn is_alpha(c) {
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}
fn is_alnum(c) {
    if (is_digit(c) == 1) { return 1; }
    return is_alpha(c);
}
fn is_space(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# ================================================================
# Decimal scaling — error-compensated (double-double)
# ================================================================
#
# `mant * 10^k` has to be correctly rounded, and a single f64 cannot hold 10^k
# accurately enough to get there. Building it by repeated multiplication (2.3.4)
# or through the exact 10^22 block (2.3.5) left 1-3 ulp of error, and at the very
# top of the f64 range 1 ulp of UPWARD error is +Inf — so the canonical DBL_MAX
# literal `1.7976931348623157e308` parsed as infinity.
#
# 2.4.0 carries the scale factor as a two-term (hi, lo) pair with ~106 bits of
# significand, using Dekker's error-compensated product. The residual `lo` is
# exactly the bits a single f64 drops, so the final rounding sees them.
#
# At 2.4.0 the pair travelled in a 3-word heap buffer, on the belief that Cyrius
# had no multi-value return. That belief was WRONG — the 2-value form had shipped
# at v3.7.2 and this crate tested the wrong syntax (`var (x, y) = f()` rather
# than `var x, y = f()`). Cyrius 6.5.21 added what was genuinely missing: arity 3,
# declared return types, and a destructure contract. As of 2.4.1 these are real
# `: (f64, f64)` / `: (f64, f64, i64)` functions with no buffer.
# Implementing that upstream surfaced three silent miscompiles in multi-value
# return — one corrupting this exact `: f64`-with-tuple-body signature on
# x86/PE — which is why test_two_product_exact verifies the slots rather than
# assuming them.

var _DD_SPLIT = 0;      # 2^27 + 1, Dekker's splitting constant
var _DD_E22 = 0;        # 10^22 — the largest power of ten f64 holds exactly
var _DD_UP = 0;         # 2^256
var _DD_DOWN = 0;       # 2^-256
var _DD_THRESH = 0;     # ~10^200, the rescale trigger
var _DD_P10 = 0;        # &_DD_P10_TAB once built: 10^0 .. 10^22, each EXACT
# Static storage (a top-level `var x[N]` is N * 8 bytes). Through 2.4.8 the table
# came from alloc() and its pointer was cached here, so a consumer that called
# alloc_reset() left it dangling and every decimal literal parsed as +Inf with no
# error (2.4.9 audit).
var _DD_P10_TAB[23];
var _DD_READY = 0;

# f64 holds every integer below 2^53 exactly, and every power of ten up to
# 10^22 exactly. When both hold, `mant * 10^k` (or the matching division) is a
# SINGLE correctly-rounded operation — no compensation needed. That is Clinger's
# fast path, and it covers essentially every literal a human writes.
var ABACO_EXACT_INT_MAX = 9007199254740992;   # 2^53
# 2^63 as an f64 bit pattern — the i64 bound, past which abaco_f64_to_i64
# refuses and eval_pow's is_int test cannot classify an exponent. Every f64 at
# or above it is an even integer (ulp >= 2 from 2^53 up), which is what makes
# the shortcut sound.
var ABACO_POW_INT_HUGE = 0x43E0_0000_0000_0000;
var ABACO_EXACT_P10_MAX = 22;

fn _dd_init() {
    if (_DD_READY == 1) { return 0; }
    _DD_SPLIT = f64_from(134217729);
    var ten = f64_from(10);
    var acc = f64_from(1);
    var i = 0;
    while (i < 22) { acc = f64_mul(acc, ten); i = i + 1; }
    _DD_E22 = acc;
    var two = f64_from(2);
    acc = f64_from(1);
    i = 0;
    while (i < 256) { acc = f64_mul(acc, two); i = i + 1; }
    _DD_UP = acc;
    _DD_DOWN = f64_div(f64_from(1), acc);
    acc = f64_from(1);
    i = 0;
    while (i < 200) { acc = f64_mul(acc, ten); i = i + 1; }
    _DD_THRESH = acc;
    # Exact powers of ten, built once. Rebuilding these per literal is what made
    # the 2.3.5 parser slow: every call re-ran the 10^22 chain from scratch.
    _DD_P10 = &_DD_P10_TAB;
    acc = f64_from(1);
    i = 0;
    while (i <= ABACO_EXACT_P10_MAX) {
        store64(_DD_P10 + i * 8, acc);
        acc = f64_mul(acc, ten);
        i = i + 1;
    }
    _DD_READY = 1;
    return 0;
}

# 10^k, exactly, for 0 <= k <= ABACO_EXACT_P10_MAX.
fn _p10_exact(k) {
    _dd_init();
    return load64(_DD_P10 + k * 8);
}

# Dekker split: the high half of `a`, carrying ~26 significant bits, such that
# a = hi + (a - hi) EXACTLY. Requires |a| < DBL_MAX / 2^27 (~1.3e300) or the
# scaled product overflows — every caller below keeps values under ~1e250.
fn _dd_hi(a) {
    var c = f64_mul(_DD_SPLIT, a);
    return f64_sub(c, f64_sub(c, a));
}

# Dekker's error-compensated product: returns fl(a*b) AND the exact rounding
# error a*b - fl(a*b), which is the residual a single f64 cannot hold.
#
# This is the canonical two-valued primitive, and as of Cyrius 6.5.21 it is
# written as one — `: (f64, f64)` rather than an out-parameter. Cyrius shipped
# tuples in response to the proposal abaco filed for exactly this shape
# (cyrius/docs/development/proposals/2026-08-13-tuple-multi-value-returns.md),
# and implementing it surfaced three silent miscompiles in multi-value return —
# one of which corrupted precisely this signature, `: f64` with a tuple body,
# on x86/PE. Hence test_two_product_exact below: this crate is the reason that
# path is now covered, so it verifies it rather than assuming it.
fn _two_product(a, b): (f64, f64) {
    var p = f64_mul(a, b);
    var ah = _dd_hi(a);
    var al = f64_sub(a, ah);
    var bh = _dd_hi(b);
    var bl = f64_sub(b, bh);
    var err = f64_sub(f64_mul(ah, bh), p);
    err = f64_add(err, f64_mul(ah, bl));
    err = f64_add(err, f64_mul(al, bh));
    err = f64_add(err, f64_mul(al, bl));
    return (p, err);
}

# (hi, lo) * d, renormalised so hi carries the leading bits. `d` must be exact.
fn _dd_mul_d(hi, lo, d): (f64, f64) {
    var p, e = _two_product(hi, d);
    e = f64_add(e, f64_mul(lo, d));
    var s = f64_add(p, e);
    return (s, f64_sub(e, f64_sub(s, p)));
}

# Keep the pair inside the range where _dd_hi's split cannot overflow, moving
# the excess into a binary exponent. Scaling by a power of two is exact, so this
# costs no accuracy.
fn _dd_renorm(hi, lo, bexp): (f64, f64, i64) {
    if (f64_gt(hi, _DD_THRESH) == 1) {
        return (f64_mul(hi, _DD_DOWN), f64_mul(lo, _DD_DOWN), bexp + 256);
    }
    return (hi, lo, bexp);
}

# 10^k as (hi, lo) * 2^bexp. k >= 0; callers clamp it, so the loop is bounded.
#
# The 3-valued shape here is what motivated arity-3 support in Cyrius 6.5.21 —
# their `crossos/multi_return.tcyr` names this function.
fn _dd_pow10(k): (f64, f64, i64) {
    _dd_init();
    var hi = f64_from(1);
    var lo = f64_from(0);
    var bexp = 0;
    var rem = k;
    while (rem >= 22) {
        # Destructuring declares; it cannot re-bind, so the carried values are
        # assigned across from fresh names.
        var bh, bl = _dd_mul_d(hi, lo, _DD_E22);
        var rh, rl, rb = _dd_renorm(bh, bl, bexp);
        hi = rh;
        lo = rl;
        bexp = rb;
        rem = rem - 22;
    }
    if (rem > 0) {
        # One exact factor rather than `rem` separate multiplications.
        var th, tl = _dd_mul_d(hi, lo, load64(_DD_P10 + rem * 8));
        var sh, sl, sb = _dd_renorm(th, tl, bexp);
        hi = sh;
        lo = sl;
        bexp = sb;
    }
    return (hi, lo, bexp);
}

# x * 2^n, exactly, in chunks that cannot overflow an intermediate. Underflow to
# a subnormal (or to zero) is the correct IEEE outcome and is left to happen.
fn _dd_scale_pow2(x, n) {
    var r = x;
    var k = n;
    while (k >= 256) { r = f64_mul(r, _DD_UP); k = k - 256; }
    while (k <= (0 - 256)) { r = f64_mul(r, _DD_DOWN); k = k + 256; }
    var two = f64_from(2);
    var half = f64_div(f64_from(1), two);
    while (k > 0) { r = f64_mul(r, two); k = k - 1; }
    while (k < 0) { r = f64_mul(r, half); k = k + 1; }
    return r;
}

# The mantissa carries up to 18 digits (~1e18), past f64's exact-integer limit
# of 2^53, so `f64_from(mant)` ALREADY rounds before any scaling happens. Split
# it into a two-term pair as well, or that lost bit caps the whole computation
# at 1 ulp no matter how accurate the scale factor is — it is what kept the
# DBL_MAX literal 1 ulp low even after the scale went double-double.
fn _dd_split_mant(mant): (f64, f64) {
    var m_hi = f64_from(mant);
    return (m_hi, f64_from(mant - f64_to(m_hi)));
}

# mant * 10^k for k >= 0, error-compensated on both factors.
fn _mul_pow10(mant, k) {
    var hi, lo, bexp = _dd_pow10(k);
    var m_hi, m_lo = _dd_split_mant(mant);
    var p, e = _two_product(m_hi, hi);
    e = f64_add(e, f64_mul(m_hi, lo));
    e = f64_add(e, f64_mul(m_lo, hi));
    e = f64_add(e, f64_mul(m_lo, lo));
    return _dd_scale_pow2(f64_add(p, e), bexp);
}

# mant / 10^k for k >= 0, error-compensated. One Newton refinement against the
# double-double divisor turns the quotient's ~1 ulp into ~0.5.
fn _div_pow10(mant, k) {
    var hi, lo, bexp = _dd_pow10(k);
    var m_hi, m_lo = _dd_split_mant(mant);
    var q = f64_div(m_hi, hi);
    var p, e = _two_product(q, hi);
    e = f64_add(e, f64_mul(q, lo));
    var rem = f64_sub(f64_sub(m_hi, p), e);
    rem = f64_add(rem, m_lo);
    q = f64_add(q, f64_div(rem, hi));
    return _dd_scale_pow2(q, 0 - bexp);
}

# Parse a number from input bytes. Returns (value, index_after_the_number).
#
# The end index used to travel through an out-parameter, which cost the
# tokenizer an `alloc(8)` PER NUMERIC LITERAL from a bump allocator with no free
# — a 500-literal expression leaked a few hundred bytes of scratch per parse.
# Cyrius 6.5.21 tuples removed both the allocation and the positional contract;
# this call site is one of the cases the proposal cited.
#
# Significant digits accumulate into an exact i64 mantissa plus a decimal
# exponent. The previous form kept `int_part`, `frac_part` and `frac_div` and
# multiplied each by 10 per digit with no guard (2026-08-13 audit, M-3):
# a ~19-digit integer literal wrapped i64 to a NEGATIVE value, and a ~19-digit
# fraction wrapped `frac_div` into a nonsense divisor, so both silently
# returned garbage. Splitting mantissa from exponent removes the wrap point
# entirely — the mantissa stops at ABACO_MANT_DIGITS and every further digit
# only moves the exponent.
#
# This form is also more accurate for fractions: "3.14" is one correctly-rounded
# 314/100 rather than an accumulation of inexact tenths, and it keeps whole
# numbers bit-exact, which `eval_pow`'s integer fast path depends on.
#
# Strict since 2.4.9, as the Rust original was: a second '.' ENDS the literal
# (so "1.2.3" is two numbers side by side, a parse error, not 1.23), and e/E
# starts an exponent only when a digit follows, optionally after one sign — so
# "2e" is 2 times the constant e, as "2pi" and "2 e" already were, where it used
# to be 2, and "1e-pi" is 1*e - pi rather than pi. A literal with no digit at
# all ("." or ".e5") returns end == start, which the tokenizer reports as
# ABACO_ERR_PARSE; through 2.4.8 it was the number 0.
fn parse_number(input, start, len): (f64, i64) {
    var i = start;
    var mant = 0;
    var mdigits = 0;
    var any_digit = 0;
    var dec_exp = 0;
    var has_dot = 0;
    var seen_sig = 0;

    # Integer/fractional part
    var pgo = 1;
    while (pgo == 1) {
        if (i >= len) { pgo = 0; }
        else {
            var c = load8(input + i);
            if (is_digit(c) == 1) {
                any_digit = 1;
                if (mdigits < ABACO_MANT_DIGITS) {
                    # Leading zeros carry no significance — skip them so
                    # "0.0000001" spends none of the mantissa's 18 digits.
                    if (c != 48 || seen_sig == 1) {
                        mant = mant * 10 + (c - 48);
                        mdigits = mdigits + 1;
                        seen_sig = 1;
                    }
                    # A fractional digit shifts the point regardless of whether
                    # it was significant enough to accumulate.
                    if (has_dot == 1) {
                        if (dec_exp > (0 - ABACO_DEC_EXP_MAX)) { dec_exp = dec_exp - 1; }
                    }
                }
                else {
                    # Mantissa full. Integer digits still scale the value;
                    # fractional digits are below f64 resolution, so drop them.
                    if (has_dot == 0) {
                        if (dec_exp < ABACO_DEC_EXP_MAX) { dec_exp = dec_exp + 1; }
                    }
                }
                i = i + 1;
            }
            elif (c == 46) {
                if (has_dot == 1) { pgo = 0; }
                else {
                    has_dot = 1;
                    i = i + 1;
                }
            }
            else { pgo = 0; }
        }
    }

    if (any_digit == 0) { return (f64_from(0), start); }

    # Scientific notation: e/E, an optional +/-, then AT LEAST ONE digit. Without
    # the digit the e/E is not part of the number at all.
    var sci = 0;
    if (i < len) {
        var c = load8(input + i);
        var is_exp = 0;
        if (c == 101) { is_exp = 1; }
        if (c == 69) { is_exp = 1; }
        if (is_exp == 1) {
            var di = i + 1;
            if (di < len) {
                var sc = load8(input + di);
                if (sc == 43 || sc == 45) { di = di + 1; }
            }
            if (di >= len) { is_exp = 0; }
            elif (is_digit(load8(input + di)) == 0) { is_exp = 0; }
        }
        if (is_exp == 1) {
            i = i + 1;
            var exp_sign = 1;
            if (i < len) {
                c = load8(input + i);
                if (c == 43) { i = i + 1; }
                elif (c == 45) { exp_sign = 0 - 1; i = i + 1; }
            }
            var exp_val = 0;
            var ego = 1;
            while (ego == 1) {
                if (i >= len) { ego = 0; }
                else {
                    c = load8(input + i);
                    if (is_digit(c) == 0) { ego = 0; }
                    else {
                        exp_val = exp_val * 10 + (c - 48);
                        # Saturate per digit so "1e9999999999..." cannot
                        # overflow exp_val; bounded work regardless of input
                        # length. The bound is deliberately far above the f64
                        # range: `total = dec_exp + sci` below is the ONLY
                        # place magnitude may be clamped. Saturating here at,
                        # say, 400 would discard the information that addition
                        # needs, and a literal like `0.` + 93 zeros + `1e401`
                        # (true value 1e307) would come out wrong.
                        if (exp_val > ABACO_DEC_EXP_MAX) { exp_val = ABACO_DEC_EXP_MAX; }
                        i = i + 1;
                    }
                }
            }
            sci = exp_sign * exp_val;
        }
    }

    # A zero significand is zero at every exponent. Settle it before scaling:
    # `_pow10` saturates to +Inf at k >= 309, and `0.0 * +Inf` is NaN, so
    # `0e400` used to parse as NaN with no error set (2.3.4 regression — 2.3.3
    # returned 0.0 because its exponent clamp kept the factor finite).
    if (mant == 0) { return (f64_from(0), i); }

    # Combine the literal's own decimal exponent with the scientific one, THEN
    # clamp. Clamping the two separately lets a long fraction and a large
    # positive exponent cancel into a wrong magnitude — which is why `sci` is
    # saturated at ABACO_DEC_EXP_MAX rather than at a value near the f64 range:
    # a tight per-digit clamp on the written exponent would destroy the
    # information this addition needs.
    var total = dec_exp + sci;

    # Upper bound: 10^309 is already +Inf, so clamping there changes no
    # representable value. Lower bound needs ABACO_MANT_DIGITS of headroom —
    # the mantissa carries up to ~1e18, so `mant * 10^-340` still lands around
    # 1e-322, inside the subnormal range. Clamping at -340 would round genuine
    # subnormals up and turn true underflows into nonzero values.
    if (total > ABACO_POW10_MAX) { total = ABACO_POW10_MAX; }
    if (total < (0 - (ABACO_POW10_MAX + ABACO_MANT_DIGITS))) {
        total = 0 - (ABACO_POW10_MAX + ABACO_MANT_DIGITS);
    }

    var result = f64_from(mant);

    # Fast path: both operands exact => one rounding, provably correct. This is
    # the overwhelmingly common case (3.14, 1.5e3, 0.1), and routing it through
    # the compensated path costs ~40% on literal-heavy parsing for no accuracy.
    if (mant < ABACO_EXACT_INT_MAX) {
        if (total >= 0 && total <= ABACO_EXACT_P10_MAX) {
            return (f64_mul(result, _p10_exact(total)), i);
        }
        if (total < 0 && total >= (0 - ABACO_EXACT_P10_MAX)) {
            return (f64_div(result, _p10_exact(0 - total)), i);
        }
    }

    if (total > 0) {
        result = _mul_pow10(mant, total);
    }
    elif (total < 0) {
        # Divide rather than multiply by a reciprocal: the reciprocal is itself
        # inexact, and _div_pow10's Newton step against the double-double
        # divisor lands within half an ulp. The binary-exponent split also means
        # the divisor never reaches +Inf before the value has legitimately
        # underflowed, so representable subnormals (1e-320) survive.
        result = _div_pow10(mant, 0 - total);
    }

    return (result, i);
}

# Tokenize input string into token array.
# tok_alloc() reserves exactly ABACO_MAX_TOKENS * 16 bytes, so writing token
# ABACO_MAX_TOKENS would run off the end of the allocation and corrupt whatever
# the bump allocator handed out next (pre-2.4.1 that was the per-number scratch
# cells, which silently changed results from ~343 terms on).
# Returns (token_count, ok). `ok` is 0 when the input needed more than
# ABACO_MAX_TOKENS tokens, held a malformed literal, or held a byte outside the
# grammar; callers map all three to ABACO_ERR_PARSE. Through 2.4.8 an unknown
# byte was silently skipped, so a Unicode minus, a superscript, brackets or a
# stray symbol changed the answer with no error: "−5+3" (U+2212) was 8, "3² +
# 4²" was 7, "[2+3]*2" was 8 (2.4.9 audit; the Rust original rejected them).
#
# Until 2.4.1 the overflow condition was smuggled back as a NEGATIVE count
# (`ABACO_TOK_OVERFLOW = -1`), because there was no way to return "count AND
# did-it-overflow". A caller that forgot the sentinel check would have used -1
# as a length. Cyrius 6.5.21 tuples made the honest shape expressible; abaco
# cited this exact site in the proposal that asked for them.
fn tokenize(input, toks): (i64, i64) {
    var n, ok = _tokenize_a(0, input, toks);
    return (n, ok);
}

# tokenize with its scratch drawn from arena `a` (0 = alloc).
fn _tokenize_a(a, input, toks): (i64, i64) {
    var len = strlen(input);
    var i = 0;
    var nt = 0;

    while (i < len) {
        var c = load8(input + i);
        # Bound EVERY write: one loop pass appends at most one token. The check
        # sits after whitespace is classified, not before — a pass that emits
        # no token must not be rejected, or an expression with exactly
        # ABACO_MAX_TOKENS tokens plus a trailing space would be a false
        # ABACO_ERR_PARSE.
        if (is_space(c) == 1) { i = i + 1; }
        elif (nt >= ABACO_MAX_TOKENS) { return (0, 0); }
        elif (c == 43) { tok_set(toks, nt, TOK_PLUS, 0); nt = nt + 1; i = i + 1; }
        elif (c == 45) { tok_set(toks, nt, TOK_MINUS, 0); nt = nt + 1; i = i + 1; }
        elif (c == 42) {
            # * or **
            var is_pow = 0;
            if (i + 1 < len) { if (load8(input + i + 1) == 42) { is_pow = 1; } }
            if (is_pow == 1) {
                tok_set(toks, nt, TOK_POWER, 0); nt = nt + 1; i = i + 2;
            } else {
                tok_set(toks, nt, TOK_STAR, 0); nt = nt + 1; i = i + 1;
            }
        }
        elif (c == 47) { tok_set(toks, nt, TOK_SLASH, 0); nt = nt + 1; i = i + 1; }
        elif (c == 37) { tok_set(toks, nt, TOK_PERCENT, 0); nt = nt + 1; i = i + 1; }
        elif (c == 94) { tok_set(toks, nt, TOK_POWER, 0); nt = nt + 1; i = i + 1; }
        elif (c == 40) { tok_set(toks, nt, TOK_LPAREN, 0); nt = nt + 1; i = i + 1; }
        elif (c == 41) { tok_set(toks, nt, TOK_RPAREN, 0); nt = nt + 1; i = i + 1; }
        elif (c == 44) { tok_set(toks, nt, TOK_COMMA, 0); nt = nt + 1; i = i + 1; }
        elif (c == 33) { tok_set(toks, nt, TOK_BANG, 0); nt = nt + 1; i = i + 1; }
        elif (is_digit(c) == 1) {
            var num, nend = parse_number(input, i, len);
            tok_set(toks, nt, TOK_NUMBER, num);
            nt = nt + 1;
            i = nend;
        }
        elif (c == 46) {
            var dnum, dend = parse_number(input, i, len);
            if (dend == i) { return (0, 0); }
            tok_set(toks, nt, TOK_NUMBER, dnum);
            nt = nt + 1;
            i = dend;
        }
        elif (is_alpha(c) == 1) {
            var start = i;
            var igo = 1;
            while (igo == 1) {
                if (i >= len) { igo = 0; }
                elif (is_alnum(load8(input + i)) == 0) { igo = 0; }
                else { i = i + 1; }
            }
            var ident_len = i - start;
            # No builtin name is longer than 9 bytes; a longer identifier is a
            # variable at most, and past ABACO_MAX_IDENT it is refused so no
            # single request outgrows an arena chunk.
            if (ident_len > ABACO_MAX_IDENT) { return (0, 0); }
            var ident = _eval_alloc(a, ident_len + 1);
            memcpy(ident, input + start, ident_len);
            store8(ident + ident_len, 0);
            tok_set(toks, nt, TOK_IDENT, ident);
            nt = nt + 1;
        }
        else { return (0, 0); }
    }

    # Insert implicit multiplication
    var mt, mok = _implicit_mul_a(a, toks, nt);
    if (mok == 0) { return (0, 0); }
    return (mt, 1);
}

# Check if implicit * needed after token i
fn needs_star(toks, nt, i) {
    if (i + 1 >= nt) { return 0; }
    var t1 = tok_type(toks, i);
    var t2 = tok_type(toks, i + 1);
    # Number followed by LParen or Ident
    if (t1 == TOK_NUMBER) {
        if (t2 == TOK_LPAREN) { return 1; }
        if (t2 == TOK_IDENT) { return 1; }
    }
    # RParen followed by LParen, Number, or Ident
    if (t1 == TOK_RPAREN) {
        if (t2 == TOK_LPAREN) { return 1; }
        if (t2 == TOK_NUMBER) { return 1; }
        if (t2 == TOK_IDENT) { return 1; }
    }
    return 0;
}

# Insert implicit * tokens in-place (shifts tokens right)
fn implicit_mul(toks, nt): (i64, i64) {
    var n, ok = _implicit_mul_a(0, toks, nt);
    return (n, ok);
}

fn _implicit_mul_a(a, toks, nt): (i64, i64) {
    # Check if any insertion needed
    var need = 0;
    var i = 0;
    while (i < nt - 1) {
        if (needs_star(toks, nt, i) == 1) { need = need + 1; }
        i = i + 1;
    }
    if (need == 0) { return (nt, 1); }

    # Build new array. Insertion can add up to one star per token, so `ni` can
    # outrun ABACO_MAX_TOKENS even when `nt` did not — this needs its own bound, not
    # the caller's. Overflowing here would both write past newtoks and make the
    # memcpy below copy an oversized run back over `toks`.
    var newtoks = _tok_alloc_a(a);
    var ni = 0;
    i = 0;
    while (i < nt) {
        if (ni >= ABACO_MAX_TOKENS) { return (0, 0); }
        tok_set(newtoks, ni, tok_type(toks, i), tok_val(toks, i));
        ni = ni + 1;
        if (i + 1 < nt) {
            if (needs_star(toks, nt, i) == 1) {
                if (ni >= ABACO_MAX_TOKENS) { return (0, 0); }
                tok_set(newtoks, ni, TOK_STAR, 0);
                ni = ni + 1;
            }
        }
        i = i + 1;
    }
    # Copy back
    memcpy(toks, newtoks, ni * 16);
    return (ni, 1);
}

# ================================================================
# Parser - recursive descent
# ================================================================

# Parser-recursion cap. `(((...)))` or `f(f(f(...)))` past this depth sets
# ABACO_ERR_PARSE rather than recursing further and risking a native stack overflow
# (SandboxJS GHSA-8pfc-jjgw-6g26, CPython #32758 / #95185 class).
# At the cap a parse uses roughly 130-160 KB of native stack on x86_64 (~500 B
# per level) and ~90 KB on aarch64, as measured by the 2.4.9 audit (this said
# ~64 KB). Far below the default 8 MB main and 2 MB Cyrius thread stacks; a
# consumer evaluating on a smaller worker stack should give it 256 KB or more.
var ABACO_MAX_DEPTH = 256;

# Helper: check if current token matches type
fn eval_at(e, typ) {
    if (eval_pos(e) >= eval_ntoks(e)) { return 0; }
    if (tok_type(eval_toks(e), eval_pos(e)) == typ) { return 1; }
    return 0;
}
fn eval_not_at(e, typ) {
    if (eval_pos(e) >= eval_ntoks(e)) { return 1; }
    if (tok_type(eval_toks(e), eval_pos(e)) != typ) { return 1; }
    return 0;
}
# Constants — alias onto stdlib math.cyr (Cyrius 4.10.2+).
var CONST_PI = F64_PI;
var CONST_E = F64_E;
var CONST_TAU = F64_TAU;

# Forward declarations handled by Cyrius's forward-call support

fn parse_expr(e) {
    if (eval_depth(e) >= ABACO_MAX_DEPTH) { eval_set_err(e, ABACO_ERR_PARSE); return f64_from(0); }
    var left = parse_term(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return left; }
    while (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_PLUS) {
            eval_advance(e);
            var right = parse_term(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_add(left, right);
        }
        elif (t == TOK_MINUS) {
            eval_advance(e);
            var right = parse_term(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_sub(left, right);
        }
        else { return left; }
    }
    return left;
}

fn parse_term(e) {
    var left = parse_power(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return left; }
    while (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_STAR) {
            eval_advance(e);
            var right = parse_power(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            left = f64_mul(left, right);
        }
        elif (t == TOK_SLASH) {
            eval_advance(e);
            var right = parse_power(e);
            if (eval_err(e) != ABACO_ERR_NONE) { return left; }
            if (f64_eq(right, f64_from(0)) == 1) {
                eval_set_err(e, ABACO_ERR_DIV_ZERO);
                return left;
            }
            left = f64_div(left, right);
        }
        elif (t == TOK_PERCENT) {
            # Postfix percent or binary modulo
            var nxt = eval_pos(e) + 1;
            var is_postfix = 0;
            if (nxt >= eval_ntoks(e)) { is_postfix = 1; }
            else {
                var nt = tok_type(eval_toks(e), nxt);
                if (nt == TOK_RPAREN) { is_postfix = 1; }
                if (nt == TOK_COMMA) { is_postfix = 1; }
                if (nt == TOK_PLUS) { is_postfix = 1; }
                if (nt == TOK_MINUS) { is_postfix = 1; }
                if (nt == TOK_STAR) { is_postfix = 1; }
                if (nt == TOK_SLASH) { is_postfix = 1; }
                if (nt == TOK_PERCENT) { is_postfix = 1; }
                if (nt == TOK_POWER) { is_postfix = 1; }
            }
            eval_advance(e);
            if (is_postfix == 1) {
                left = f64_div(left, f64_from(100));
            } else {
                var right = parse_power(e);
                if (eval_err(e) != ABACO_ERR_NONE) { return left; }
                if (f64_eq(right, f64_from(0)) == 1) {
                    eval_set_err(e, ABACO_ERR_DIV_ZERO);
                    return left;
                }
                # Modulo, floored and exact (see _eval_mod).
                left = _eval_mod(left, right);
            }
        }
        else { return left; }
    }
    return left;
}

# ---- Integer powers in double-double ----
#
# x^n by square-and-multiply on a (hi, lo) pair with ~106 bits of significand,
# the binary exponent carried apart so nothing overflows or underflows mid-chain,
# rounded ONCE at the end (Dekker 1971 for the pair arithmetic; Graillat 2009,
# "Accurate floating-point product and exponentiation", for compensated
# powering). Through 2.4.8 this ran in plain f64: each squaring roughly doubles
# the relative error already carried, so the error grew like n/2 ulp —
# 1.0000001^10000000 was 341,619 ulp off and 1.0000000001^1099511627776 2.7e9 —
# and a negative exponent took 1/(x^|n|), which flushed representable subnormals
# to 0 (10^(0-310), 2^(0-1074)) once x^|n| overflowed; 10^k disagreed with the
# literal 1ek for 268 of k = 1..324 (2.4.9 audit). Results are correctly rounded
# in the normal range; in the subnormal range the final scaling can add one more
# rounding, so they are within 1 ulp there.

# 2^k as an f64, exactly, for -1022 <= k <= 1023.
fn _f64_pow2i(k) {
    return (k + 1023) << 52;
}

# (m, e) with x = m * 2^e and 1 <= m < 2, for positive finite x (subnormals too).
fn _frexp1(x): (f64, i64) {
    var v = x;
    var adj = 0;
    if (((v >> 52) & 0x7FF) == 0) {
        v = f64_mul(v, _f64_pow2i(64));
        adj = 64;
    }
    var be = ((v >> 52) & 0x7FF) - 1023;
    return ((v & 0x000F_FFFF_FFFF_FFFF) | 0x3FF0_0000_0000_0000, be - adj);
}

# Rescale (hi, lo) * 2^ex so that 1 <= hi < 2. hi is positive and within a factor
# of 4 of that interval here, so the rescale is an exact power-of-two multiply.
fn _dd_norm1(hi, lo, ex): (f64, f64, i64) {
    var k = ((hi >> 52) & 0x7FF) - 1023;
    if (k == 0) { return (hi, lo, ex); }
    var sc = _f64_pow2i(0 - k);
    return (f64_mul(hi, sc), f64_mul(lo, sc), ex + k);
}

# (ah, al) * (bh, bl), renormalised; al * bl is below the pair's precision.
fn _dd_mul_dd(ah, al, bh, bl): (f64, f64) {
    var p, e = _two_product(ah, bh);
    e = f64_add(e, f64_add(f64_mul(ah, bl), f64_mul(al, bh)));
    var s = f64_add(p, e);
    return (s, f64_sub(e, f64_sub(s, p)));
}

# 1 / (hi, lo) as a pair: one Newton step on the f64 reciprocal. 1 - p is exact
# because p = fl(q * hi) is within an ulp of 1.
fn _dd_recip(hi, lo): (f64, f64) {
    var q = f64_div(f64_from(1), hi);
    var p, pe = _two_product(q, hi);
    var r = f64_sub(f64_sub(f64_sub(f64_from(1), p), pe), f64_mul(q, lo));
    var c = f64_mul(q, r);
    var s = f64_add(q, c);
    return (s, f64_sub(c, f64_sub(s, q)));
}

# x * 2^k for 1 <= x <= 2 and |k| up to ~1200: at most two exact power-of-two
# factors, so a normal result is exact and a subnormal one rounds once more.
fn _pow_scale(x, k) {
    if (k > 1023) { return f64_mul(f64_mul(x, _f64_pow2i(1023)), _f64_pow2i(k - 1023)); }
    if (k < (0 - 1022)) { return f64_mul(f64_mul(x, _f64_pow2i(0 - 1022)), _f64_pow2i(k + 1022)); }
    return f64_mul(x, _f64_pow2i(k));
}

# x^n for finite x with x != 0, |x| != 1, and an integer n != 0.
fn _pow_int_dd(x, n) {
    # _two_product's split constant is set lazily by _dd_init. The evaluator
    # always parses a literal first, but eval_pow is public, and called
    # directly it ran with a zero split — plain f64 in disguise.
    _dd_init();
    var sign = 0;
    if (((x >> 63) & 1) == 1) {
        if ((n & 1) != 0) { sign = 0x8000_0000_0000_0000; }
    }
    var ax = f64_abs(x);
    # Results certainly outside the f64 range are settled from the magnitude
    # n * log2|x| before any exponent bookkeeping: |n| near 2^63 reaches here
    # only for |x| within ~2^-52 of 1, and even there the product is past 1474.
    # The margins are wide; everything in between runs the pair.
    var mag = f64_mul(f64_from(n), f64_log2(ax));
    if (f64_gt(mag, f64_from(1100)) == 1) { return 0x7FF0_0000_0000_0000 | sign; }
    if (f64_lt(mag, f64_from(0 - 1100)) == 1) { return sign; }
    var neg = 0;
    var m = n;
    if (m < 0) { neg = 1; m = 0 - m; }
    var bh, be = _frexp1(ax);
    var bl = f64_from(0);
    var rh = f64_from(1);
    var rl = f64_from(0);
    var re = 0;
    while (m > 0) {
        if ((m & 1) == 1) {
            var ph, pl = _dd_mul_dd(rh, rl, bh, bl);
            var nh, nl, ne = _dd_norm1(ph, pl, re + be);
            rh = nh;
            rl = nl;
            re = ne;
        }
        m = m >> 1;
        if (m > 0) {
            var sh, sl = _dd_mul_dd(bh, bl, bh, bl);
            var qh, ql, qe = _dd_norm1(sh, sl, be + be);
            bh = qh;
            bl = ql;
            be = qe;
        }
    }
    if (neg == 1) {
        var ih, il = _dd_recip(rh, rl);
        var jh, jl, je = _dd_norm1(ih, il, 0 - re);
        rh = jh;
        rl = jl;
        re = je;
    }
    return _pow_scale(f64_add(rh, rl), re) | sign;
}

# Ok(n) when x is an integer inside i64 — the domain of the evaluator's integer
# functions; Err(0) for a fraction, NaN, +/-Inf or |x| >= 2^63. Through 2.4.8 a
# fraction was truncated without a word: factorial(2.5) = 2, 3.9! = 6,
# isprime(2.9) = 1, gcd(7.5, 5) = 1 (2.4.9 audit).
fn _int_arg(x) {
    var t, n = abaco_f64_to_i64(x);
    if (is_ok(t) == 0) { return Err(0); }
    if (f64_eq(x, f64_from(n)) == 0) { return Err(0); }
    return Ok(n);
}

# log10(x). ln(x) / ln(10) carries three roundings, so through 2.4.8 it missed
# exactly where calculator users look: log(1000) was 2.9999999999999996 (and
# typed FLOAT, not the INTEGER 3), log(1e-3) -2.9999999999999996, 18 of the 43
# powers 1e-20..1e22 wrong (2.4.9 audit). When x is exactly the double the
# literal 1ek reads as — _pow_int_dd(10, k) is correctly rounded — the answer is
# k. Elsewhere the quotient stays, within ~2 ulp.
fn _eval_log10(x) {
    var y = f64_div(f64_ln(x), f64_ln(f64_from(10)));
    if (f64_gt(x, f64_from(0)) == 1 && f64_eq(f64_sub(x, x), f64_from(0)) == 1) {
        var r = f64_round_half_away(y);
        var kt, k = abaco_f64_to_i64(r);
        if (is_ok(kt) == 1 && k >= (0 - 323) && k <= 308) {
            var pk = f64_from(1);
            if (k != 0) { pk = _pow_int_dd(f64_from(10), k); }
            if (pk == x) { return r; }
        }
    }
    return y;
}

# a mod b, floored (the result takes b's sign, as a - floor(a/b)*b would),
# computed EXACTLY by binary long division: each step subtracts the largest
# |b| * 2^k <= r, and that subtraction is exact (Sterbenz). Through 2.4.8 this
# WAS a - floor(a/b)*b, whose quotient rounds once both operands pass 2^53 — and
# a finite a % +/-Inf was NaN (2.4.9 audit). Here a % +/-Inf is a when a is 0
# or shares b's sign, else b (the floored limit; Python agrees), and NaN or an
# infinite a give NaN. b == 0 is the caller's ABACO_ERR_DIV_ZERO.
fn _eval_mod(a, b) {
    var zero = f64_from(0);
    var signbit = 0x8000_0000_0000_0000;
    if (f64_eq(a, a) == 0 || f64_eq(b, b) == 0) { return 0x7FF8_0000_0000_0000; }
    if (f64_eq(f64_sub(a, a), zero) == 0) { return 0x7FF8_0000_0000_0000; }
    var ab = f64_abs(b);
    if (f64_eq(ab, 0x7FF0_0000_0000_0000) == 1) {
        if (f64_eq(a, zero) == 1) { return a; }
        if ((a & signbit) == (b & signbit)) { return a; }
        return b;
    }
    var r = f64_abs(a);
    var bm, bexp = _frexp1(ab);
    while (f64_ge(r, ab) == 1) {
        var rm, rexp = _frexp1(r);
        var k = rexp - bexp;
        if (f64_lt(rm, bm) == 1) { k = k - 1; }
        # t = |b| * 2^k, scaled in steps of at most 2^1023: with a subnormal b,
        # k reaches ~2097, and _f64_pow2i past 1023 overflows its exponent field
        # (the first cut used two steps, so 1e300 % 5e-324 looped forever and
        # 1.4e293 % 5e-324 gave -Inf — 2.4.9 final review). Every step is exact:
        # t never exceeds r <= DBL_MAX.
        var t = ab;
        var kk = k;
        while (kk > 1023) {
            t = f64_mul(t, _f64_pow2i(1023));
            kk = kk - 1023;
        }
        if (kk > 0) { t = f64_mul(t, _f64_pow2i(kk)); }
        r = f64_sub(r, t);
    }
    if (f64_eq(r, zero) == 1) { return b & signbit; }
    if ((a & signbit) != (b & signbit)) { r = f64_sub(ab, r); }
    return r | (b & signbit);
}

# f64 power: a^b. Named `eval_pow` (not the stdlib `f64_pow` in lib/math.cyr)
# because it resolves INTEGER exponents exactly, so `2^10` returns 1024 rather
# than a log/exp round-trip approximation. See docs/adr/0002.
#
# Integer exponents use binary exponentiation (square-and-multiply), which is
# O(log |exp|): at most 63 multiplications for any i64 exponent. That matters
# three ways, and replaces the ABACO_POW_EXACT_MAX cap 2.3.4 used:
#
#   - No DoS. The 2.3.3 linear loop ran `exp` times with the count taken from
#     user text, so `2^1000000000000000000` was ~10^18 multiplications (~81
#     years). 2.3.4 capped that at 1024 — but a cap is the wrong instrument.
#   - No accuracy cliff. The 2.3.4 cap handed every exponent above 1024 to the
#     exp2/log2 path, which is 30-60x less accurate, and it did so across the
#     whole band 0.5 < |base| < 2 where results are still genuinely changing
#     (1.001^1024 and 1.001^1025 differ). Squaring keeps the exact path for
#     every integer exponent, and its shorter multiplication chain is more
#     accurate than the 2.3.3 linear loop as well.
#   - No non-finite hole. The 2.3.4 cap sent (+Inf)^n for n > 1024 into
#     `exp2(log2(+Inf))` = `exp2(+Inf)`, which returns NaN — a silent wrong
#     answer where 2.3.3 correctly gave +Inf. Squaring propagates Inf and 0
#     the way IEEE-754 requires, with no special case needed.
#
# See docs/audit/2026-08-13-fix-audit.md.
fn eval_pow(base, exp) {
    var zero = f64_from(0);
    var one = f64_from(1);
    # Canonical non-finite patterns, inlined the way dsp.cyr inlines its own.
    # Hoisted to the top at 2.4.4 because the zero-base rows below need them.
    var qnan = 0x7FF8_0000_0000_0000;
    var pos_inf = 0x7FF0_0000_0000_0000;
    var neg_inf = 0xFFF0_0000_0000_0000;
    var neg_zero = 0x8000_0000_0000_0000;

    if (f64_eq(exp, zero) == 1) { return one; }

    # pow(+/-0, y). C99 F.10.4.4 splits on the SIGN of y first. Through 2.4.3
    # this returned +0 for EVERY y, so 0^(0-1) answered +0 where C99, IEEE
    # 754-2019 §9.2 and ganita all say +Inf — with eval_err = NONE, and
    # internally inconsistent besides, since an overflowing 2^10000 already
    # returns +Inf here.
    #   y < 0, odd integer -> +/-Inf carrying the zero's sign
    #   y < 0, otherwise   -> +Inf
    #   y > 0, odd integer -> +/-0  carrying the zero's sign
    #   y > 0, otherwise   -> +0
    # y == 0 returned 1 above, which is the row C99 puts ahead of all of these.
    # -0 is reachable (e.g. (0-1)*0) and f64_eq(-0, +0) is 1, so the sign has
    # to come from the bit pattern rather than a comparison.
    #
    # NOT ABACO_ERR_DIV_ZERO, though `1/0` does raise it: eval_pow takes no
    # evaluator handle to set an error on, and the 2.4.3 precedent for this
    # function is to answer the IEEE value. The asymmetry with `/` is
    # deliberate and pinned by test_pow_zero_base.
    if (f64_eq(base, zero) == 1) {
        # NaN propagates. C99 exempts exactly two rows from that — pow(x, +/-0)
        # = 1 and pow(+1, y) = 1 — and pow(+/-0, NaN) is neither, so it must be
        # NaN. This block returns before the general NaN rows further down, so
        # without this line a NaN exponent fell through every test below (the
        # checked conversion refuses it, so `zodd` stays 0; f64_lt(NaN, 0)
        # is 0 because the comparison is unordered) and landed on `return zero`,
        # silently turning NaN into an exact +0. Reachable from ordinary text:
        # `0^(sqrt(0-1))`. Pre-dates 2.4.4 — 2.4.3's one-line zero-base return
        # did the same — but this release rewrote the block and claims the C99
        # table, so it is closed here.
        if (f64_eq(exp, exp) == 0) { return qnan; }
        var zsign = 0;
        if (base == neg_zero) { zsign = 1; }
        # Checked, not a bare f64_to round-trip: on Cyrius 6.6.8+ that
        # saturates +2^63 to i64_MAX, which is ODD and round-trips, and
        # (-0)^(2^63) answered -0 (see abaco_f64_to_i64).
        var zodd = 0;
        var zt, zei = abaco_f64_to_i64(exp);
        if (is_ok(zt) == 1) {
            if (f64_eq(exp, f64_from(zei)) == 1) {
                if (zei % 2 != 0) { zodd = 1; }
            }
        }
        if (f64_lt(exp, zero) == 1) {
            if (zodd == 1) {
                if (zsign == 1) { return neg_inf; }
            }
            return pos_inf;
        }
        if (zodd == 1) {
            if (zsign == 1) { return neg_zero; }
        }
        return zero;
    }

    # An integral exponent INSIDE i64. Through 2.4.6 this was a bare
    # f64_from(f64_to(exp)) == exp, which relied on f64_to's out-of-range
    # answer to fail it; on Cyrius 6.6.8+ exp = +2^63 saturates to i64_MAX,
    # f64_from rounds that back to 2^63, and the test passed with an ODD
    # exponent — (-2)^(2^63) answered -Inf and (-1)^(2^63) answered -1. The
    # checked conversion refuses +2^63, which sends it to the huge-exponent
    # block below, as x86 did before 6.6.8 (see abaco_f64_to_i64).
    var et, exp_i = abaco_f64_to_i64(exp);
    var is_int = 0;
    if (is_ok(et) == 1) { is_int = f64_eq(exp, f64_from(exp_i)); }

    # |base| == 1 is exact for every exponent and sidesteps the i64-minimum
    # magnitude question below, so settle it first.
    if (is_int == 1) {
        if (f64_eq(base, one) == 1) { return one; }
        if (f64_eq(base, f64_neg(one)) == 1) {
            if (exp_i % 2 == 0) { return one; }
            return f64_neg(one);
        }
    }

    if (is_int == 1) {
        # Finite bases: the double-double chain above. +/-Inf and NaN keep plain
        # square-and-multiply below, which is exact for them — (-Inf)^3 = -Inf
        # and (-Inf)^(0-3) = -0 carry the sign through the multiplications.
        if (f64_eq(f64_sub(base, base), zero) == 1) { return _pow_int_dd(base, exp_i); }
        var n = exp_i;
        var neg = 0;
        # (0 - i64_MIN) overflows back to i64_MIN, so peel off the magnitude.
        # |base| == 1 is already handled above, and at |exp| ~9.2e18 every other
        # base has saturated to 0 or +/-Inf long before, so the peeled factor
        # cannot change the MAGNITUDE.
        #
        # ⚠ Peel TWO, not one — parity is not free. exp = -(2^63) is the single
        # exponent of magnitude >= 2^63 that still round-trips through i64
        # (f64_to gives i64_MIN and f64_from gives it straight back), so it
        # reaches this path instead of the huge-exponent block below. Peeling
        # ONE turned that even exponent odd and square-and-multiply carried the
        # wrong parity into the SIGN: through 2.4.3, (0-2)^(0-2^63) gave -0 for
        # +0 and, worse, (0-0.5)^(0-2^63) gave -Inf where C99 and glibc give
        # +Inf. i64_MIN + 2 is still even and still negatable, and the magnitude
        # argument above covers base^2 exactly as it covers base^1.
        if (n == ABACO_I64_MIN) { n = n + 2; }
        if (n < 0) { neg = 1; n = 0 - n; }
        var result = one;
        var b = base;
        while (n > 0) {
            if (n % 2 == 1) { result = f64_mul(result, b); }
            b = f64_mul(b, b);
            n = n / 2;
        }
        if (neg == 1) { return f64_div(one, result); }
        return result;
    }

    # Non-integer exponent: exp2(exp * log2(|base|)) — but four families of
    # operand have to be answered before that line ever runs. The non-finite
    # patterns are declared at the top of this function.

    # ---- Non-finite operands: C99 F.10.4.4 / IEEE 754-2019 §9.2 ----
    #
    # Every non-finite operand lands in THIS branch, never the integer path
    # above: abaco_f64_to_i64 refuses +Inf, -Inf and NaN alike, so `is_int`
    # stays 0 for all of them. Left to itself the exp2/log2 line answered NaN
    # for all of them — f64_exp2 returned NaN for every non-finite argument
    # through Cyrius 6.6.0, and log2(+Inf) = +Inf hands it one. That is the
    # same fact behind the 2.3.4 (±Inf)^n regression
    # (docs/audit/2026-08-13-fix-audit.md R-1), which binary exponentiation
    # fixed for INTEGER exponents only; the rows below were still NaN through
    # 2.4.2, with eval_err = NONE. (6.6.1 made exp2 IEEE at ±Inf, but +1 and
    # negative bases still go wrong on that line — Inf·0 is NaN, and the
    # negative-base guard claims -x — so every row stays explicit.)
    #
    # pow(+1, y) = 1 for EVERY y, NaN included. The |base| == 1 shortcut near
    # the top of this function sits inside the is_int arm, so +1 with a
    # non-integer exponent falls through to here; it landed on 1 by luck for
    # finite y (exp2(y · 0) = 1) and on NaN for y = ±Inf, where the product is
    # Inf · 0 = NaN. C99 keeps this row ahead of the NaN row.
    if (f64_eq(base, one) == 1) { return one; }

    # Every other NaN operand yields NaN. (pow(x, ±0) = 1 for NaN x too — that
    # is the one row C99 puts ahead of this one, and it returned at the top.)
    if (f64_eq(base, base) == 0) { return qnan; }
    if (f64_eq(exp, exp) == 0) { return qnan; }

    var mag = f64_abs(base);

    # y = ±Inf. |x| == 1 here means x == -1 (+1 returned above), and C99 pins
    # pow(-1, ±Inf) at 1 rather than NaN: the modulus stays 1 for every
    # exponent on the way out, so the limit of the magnitude is unambiguous
    # even though the sign never settles. Otherwise only |x| against 1 and the
    # sign of y decide, and |x| = +Inf falls out of the |x| > 1 rows.
    if (f64_eq(exp, pos_inf) == 1) {
        if (f64_eq(mag, one) == 1) { return one; }
        if (f64_lt(mag, one) == 1) { return zero; }
        return pos_inf;
    }
    if (f64_eq(exp, neg_inf) == 1) {
        if (f64_eq(mag, one) == 1) { return one; }
        if (f64_lt(mag, one) == 1) { return pos_inf; }
        return zero;
    }

    # x = ±Inf with a finite exponent. C99 signs pow(-Inf, y) negative when y
    # is an ODD INTEGER (-Inf for y > 0, -0 for y < 0), and that row cannot
    # reach this line: an odd integer has magnitude below 2^53, because every
    # f64 at or above 2^53 has an ulp of 2 or more and is therefore even; 2^53
    # is far inside i64, so the checked conversion is exact for it and sends it
    # to the integer path, where square-and-multiply carries the sign
    # ((-Inf)^3 = -Inf and (-Inf)^-3 = -0 are pinned by the test). What reaches
    # here is either a non-integer or an even integer too large to round-trip,
    # and both take the unsigned rows.
    if (f64_eq(mag, pos_inf) == 1) {
        if (f64_lt(exp, zero) == 1) { return zero; }
        return pos_inf;
    }

    # ---- Finite exponent too large to round-trip through i64 ----
    #
    # |y| >= 2^63 is refused by abaco_f64_to_i64, so `is_int` is 0 and these
    # land here — yet they are not non-integers. (One exception: exactly
    # -(2^63) converts, because i64_MIN is representable, so it takes the
    # integer path above and never reaches this test. That is the value the peel
    # up there has to keep even.) Every f64 at or above
    # 2^53 has an ulp of 2 or more and is therefore an EVEN INTEGER, so every
    # exponent reaching this test is even, and the negative-base guard below
    # must not claim it. Through 2.4.3 it did: (0-2)^1e300 answered NaN where
    # C99 wants +Inf.
    #
    # The magnitude table is the y = +/-Inf one verbatim, because a result has
    # saturated to 0 or Inf long before |y| reaches 2^63 — for |x| != 1 the
    # nearest f64 to |x|^(2^63) is 0 or +Inf for every representable x. The
    # sign is always positive, the exponent being even. |x| == 1 is settled
    # first: it is exact for every exponent, and x == +1 already returned above,
    # so this row is x == -1 raised to an even power, which is +1.
    if (f64_ge(f64_abs(exp), ABACO_POW_INT_HUGE) == 1) {
        if (f64_eq(mag, one) == 1) { return one; }
        if (f64_lt(mag, one) == 1) {
            if (f64_lt(zero, exp) == 1) { return zero; }
            return pos_inf;
        }
        if (f64_lt(zero, exp) == 1) { return pos_inf; }
        return zero;
    }

    # ---- Finite negative base, non-integer exponent ----
    #
    # log2 needs a positive argument, hence |base| — but a negative base with a
    # fractional exponent has no real result, so discarding the sign and
    # returning the magnitude is a silent wrong answer: through 2.4.2, (-2)^0.5
    # came back as +sqrt(2) = 1.4142135623730951 and (-8)^(1/3) as +2, both
    # with eval_err = NONE. The comment here named the problem and the code
    # then did not act on it.
    #
    # IEEE 754-2019 §9.2 (and C99 F.10.4.4) require a quiet NaN for a negative
    # base with a non-integer exponent, which is what sqrt(-1) already returns
    # here — pow(x, 0.5) and sqrt(x) are the same operation and must not
    # disagree. NaN, not ABACO_ERR_MATH: eval_pow takes no evaluator handle, and
    # ERR_MATH in this file guards INTEGER domains (factorial n<0, totient cap,
    # fib>92), never an f64 one. Integer exponents return above with their sign
    # parity intact and never reach this line.
    #
    # An exponent at or above 2^63 is an even integer, not a non-integer, and
    # is intercepted by the block directly above rather than falling in here
    # (closed at 2.4.4; it answered NaN through 2.4.3).
    if (f64_lt(base, zero) == 1) { return qnan; }
    return f64_exp2(f64_mul(exp, f64_log2(f64_abs(base))));
}

fn parse_power(e) {
    var base = parse_unary(e);
    if (eval_err(e) != ABACO_ERR_NONE) { return base; }
    # Postfix factorial
    while (eval_at(e, TOK_BANG) == 1) {
        eval_advance(e);
        # Checked, like every integer-domain argument in call_function: a bare
        # f64_to gives 0 for NaN on Cyrius 6.6.8+, so (sqrt(0-1))! answered 1.
        var nt, n = _int_arg(base);
        if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
        if (n > 170) {
            eval_set_err(e, ABACO_ERR_MATH);
            return base;
        }
        var result = f64_from(1);
        var fi = 1;
        while (fi <= n) {
            result = f64_mul(result, f64_from(fi));
            fi = fi + 1;
        }
        base = result;
    }
    # `^` is right-associative, so a^b^c^... recurses once per operator and
    # needs depth accounting for the same reason parse_unary does.
    if (eval_at(e, TOK_POWER) == 1) {
        if (eval_depth(e) >= ABACO_MAX_DEPTH) {
            eval_set_err(e, ABACO_ERR_PARSE);
            return f64_from(0);
        }
        eval_advance(e);
        eval_set_depth(e, eval_depth(e) + 1);
        var exp = parse_power(e);
        eval_set_depth(e, eval_depth(e) - 1);
        if (eval_err(e) != ABACO_ERR_NONE) { return base; }
        return eval_pow(base, exp);
    }
    return base;
}

# Unary +/- chains recurse once per sign, so they need the same ABACO_MAX_DEPTH
# accounting parse_expr does. Without it `----...--1` recursed unbounded and
# overflowed the native stack — the paren/arg sites were the only places
# charging depth, which left `-` and `^` chains entirely unbounded.
fn parse_unary(e) {
    if (eval_pos(e) < eval_ntoks(e)) {
        var t = tok_type(eval_toks(e), eval_pos(e));
        if (t == TOK_MINUS || t == TOK_PLUS) {
            if (eval_depth(e) >= ABACO_MAX_DEPTH) {
                eval_set_err(e, ABACO_ERR_PARSE);
                return f64_from(0);
            }
            eval_advance(e);
            eval_set_depth(e, eval_depth(e) + 1);
            var inner = parse_unary(e);
            eval_set_depth(e, eval_depth(e) - 1);
            if (t == TOK_MINUS) { return f64_neg(inner); }
            return inner;
        }
    }
    return parse_primary(e);
}

# ================================================================
# Function dispatch
# ================================================================

fn parse_primary(e) {
    if (eval_pos(e) >= eval_ntoks(e)) {
        eval_set_err(e, ABACO_ERR_INVALID);
        return f64_from(0);
    }
    var toks = eval_toks(e);
    var pos = eval_pos(e);
    var t = tok_type(toks, pos);

    if (t == TOK_NUMBER) {
        eval_advance(e);
        return tok_val(toks, pos);
    }
    if (t == TOK_LPAREN) {
        eval_advance(e);
        eval_set_depth(e, eval_depth(e) + 1);
        var val = parse_expr(e);
        eval_set_depth(e, eval_depth(e) - 1);
        # First error wins. The inner parse stops at the failing operand, so the
        # next token is usually an operator, and through 2.4.8 the ')' check
        # below then overwrote UNKNOWN_VAR / DIV_ZERO / MATH with PARSE:
        # "(x+1)*2" reported a syntax error for an unset x (2.4.9 audit).
        if (eval_err(e) != ABACO_ERR_NONE) { return val; }
        if (eval_not_at(e, TOK_RPAREN) == 1) {
            eval_set_err(e, ABACO_ERR_PARSE);
            return val;
        }
        eval_advance(e);
        return val;
    }
    if (t == TOK_IDENT) {
        var name = tok_val(toks, pos);
        eval_advance(e);
        # Function call?
        if (eval_at(e, TOK_LPAREN) == 1) {
            eval_advance(e);
            # Audit MED-6: cap argument arity. `args` is a fixed-size
            # buffer; variadic stat fns (mean/median/stddev) are the only
            # legitimate users of large-arity calls, and 32 is generous.
            # Without this cap an adversarial `mean(0,0,0,...)` with 10^5
            # commas would overflow the 32-slot buffer.
            var args = _eval_alloc(eval_arena(e), 32 * 8);
            var nargs = 0;
            if (eval_not_at(e, TOK_RPAREN) == 1) {
                eval_set_depth(e, eval_depth(e) + 1);
                store64(args + nargs * 8, parse_expr(e));
                eval_set_depth(e, eval_depth(e) - 1);
                # An argument's error stands: stop here rather than parse the
                # rest, overwrite it, and still run the function (2.4.9 audit).
                if (eval_err(e) != ABACO_ERR_NONE) { return f64_from(0); }
                nargs = nargs + 1;
                while (eval_at(e, TOK_COMMA) == 1) {
                    eval_advance(e);
                    if (nargs >= 32) {
                        eval_set_err(e, ABACO_ERR_PARSE);
                        return f64_from(0);
                    }
                    eval_set_depth(e, eval_depth(e) + 1);
                    store64(args + nargs * 8, parse_expr(e));
                    eval_set_depth(e, eval_depth(e) - 1);
                    if (eval_err(e) != ABACO_ERR_NONE) { return f64_from(0); }
                    nargs = nargs + 1;
                }
            }
            if (eval_not_at(e, TOK_RPAREN) == 1) {
                eval_set_err(e, ABACO_ERR_PARSE);
                return f64_from(0);
            }
            eval_advance(e);
            return call_function(e, name, args, nargs);
        }
        # Constants
        if (streq(name, "pi") == 1) { return CONST_PI; }
        if (streq(name, "PI") == 1) { return CONST_PI; }
        if (streq(name, "e") == 1) { return CONST_E; }
        if (streq(name, "E") == 1) { return CONST_E; }
        if (streq(name, "tau") == 1) { return CONST_TAU; }
        if (streq(name, "TAU") == 1) { return CONST_TAU; }
        # Variable lookup
        if (map_has(eval_vars(e), name) == 1) {
            return map_get(eval_vars(e), name);
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_VAR);
        return f64_from(0);
    }
    eval_set_err(e, ABACO_ERR_PARSE);
    return f64_from(0);
}

# ================================================================
# Function dispatch (43+ functions)
# ================================================================

# gcd_int — now delegated to stdlib gcd() from math.cyr (Cyrius 4.10.2+).
fn gcd_int(a, b) {
    return gcd(a, b);
}

fn call_function(e, name, args, nargs) {
    var a = load64(args);
    var b = load64(args + 8);

    # Variable-arity functions first (they can have any nargs >= 1)
    if (nargs >= 1) {
        var is_mean = 0;
        if (streq(name, "mean") == 1) { is_mean = 1; }
        if (streq(name, "avg") == 1) { is_mean = 1; }
        if (is_mean == 1) {
            var sum = f64_from(0);
            var mi = 0;
            while (mi < nargs) { sum = f64_add(sum, load64(args + mi * 8)); mi = mi + 1; }
            return f64_div(sum, f64_from(nargs));
        }
        if (streq(name, "median") == 1) {
            # A NaN has no place in an order; through 2.4.8 the bubble sort put
            # it wherever the comparisons left it, so the answer depended on the
            # argument order (2.4.9 audit).
            var ni = 0;
            while (ni < nargs) {
                var nv = load64(args + ni * 8);
                if (f64_eq(nv, nv) == 0) { return nv; }
                ni = ni + 1;
            }
            var mi = 0;
            while (mi < nargs - 1) {
                var mj = 0;
                while (mj < nargs - 1 - mi) {
                    var va = load64(args + mj * 8);
                    var vb = load64(args + (mj + 1) * 8);
                    if (f64_gt(va, vb) == 1) {
                        store64(args + mj * 8, vb);
                        store64(args + (mj + 1) * 8, va);
                    }
                    mj = mj + 1;
                }
                mi = mi + 1;
            }
            if (nargs % 2 == 1) {
                return load64(args + (nargs / 2) * 8);
            }
            var mid1 = load64(args + (nargs / 2 - 1) * 8);
            var mid2 = load64(args + (nargs / 2) * 8);
            return f64_div(f64_add(mid1, mid2), f64_from(2));
        }
        var is_std = 0;
        if (streq(name, "stddev") == 1) { is_std = 1; }
        if (streq(name, "stdev") == 1) { is_std = 1; }
        if (is_std == 1) {
            var sum = f64_from(0);
            var si = 0;
            while (si < nargs) { sum = f64_add(sum, load64(args + si * 8)); si = si + 1; }
            var smean = f64_div(sum, f64_from(nargs));
            var vsum = f64_from(0);
            si = 0;
            while (si < nargs) {
                var diff = f64_sub(load64(args + si * 8), smean);
                vsum = f64_add(vsum, f64_mul(diff, diff));
                si = si + 1;
            }
            return f64_sqrt(f64_div(vsum, f64_from(nargs)));
        }
    }

    # 1-arg functions
    if (nargs == 1) {
        if (streq(name, "sqrt") == 1) { return f64_sqrt(a); }
        if (streq(name, "sin") == 1) { return f64_sin(a); }
        if (streq(name, "cos") == 1) { return f64_cos(a); }
        if (streq(name, "tan") == 1) { return f64_div(f64_sin(a), f64_cos(a)); }
        if (streq(name, "log") == 1) { return _eval_log10(a); }
        if (streq(name, "log10") == 1) { return _eval_log10(a); }
        if (streq(name, "ln") == 1) { return f64_ln(a); }
        if (streq(name, "log2") == 1) { return f64_log2(a); }
        if (streq(name, "abs") == 1) { return f64_abs(a); }
        if (streq(name, "ceil") == 1) { return f64_ceil(a); }
        if (streq(name, "floor") == 1) { return f64_floor(a); }
        if (streq(name, "round") == 1) { return f64_round_half_away(a); }
        if (streq(name, "exp") == 1) { return f64_exp(a); }
        # Inverse trig — stdlib math.cyr (Cyrius 4.8.5+).
        if (streq(name, "asin") == 1) { return f64_asin(a); }
        if (streq(name, "acos") == 1) { return f64_acos(a); }
        if (streq(name, "atan") == 1) { return f64_atan(a); }
        # Hyperbolic + inverse hyperbolic — stdlib math.cyr.
        if (streq(name, "sinh") == 1) { return f64_sinh(a); }
        if (streq(name, "cosh") == 1) { return f64_cosh(a); }
        if (streq(name, "tanh") == 1) { return f64_tanh(a); }
        if (streq(name, "asinh") == 1) { return f64_asinh(a); }
        if (streq(name, "acosh") == 1) { return f64_acosh(a); }
        if (streq(name, "atanh") == 1) { return f64_atanh(a); }
        if (streq(name, "trunc") == 1) { return f64_trunc(a); }
        if (streq(name, "fract") == 1) { return f64_fract(a); }
        # NaN stays NaN; the stdlib's f64_sign answered 0 for it (2.4.9 audit).
        if (streq(name, "sign") == 1 || streq(name, "sgn") == 1) {
            if (f64_eq(a, a) == 0) { return a; }
            return f64_sign(a);
        }
        if (streq(name, "deg") == 1) {
            # radians to degrees: a * 180/pi
            return f64_mul(a, f64_div(f64_from(180), CONST_PI));
        }
        if (streq(name, "rad") == 1) {
            # degrees to radians: a * pi/180
            return f64_mul(a, f64_div(CONST_PI, f64_from(180)));
        }
        # Integer-domain functions. Every argument goes through _int_arg
        # (abaco_f64_to_i64 plus an integrality check — a fraction is out of the
        # domain, not something to truncate; 2.4.9). Through 2.4.6 these tested a bare f64_to result for
        # `n < 0`, which caught NaN, +/-Inf and |a| >= 2^63 only because x86
        # answered i64_MIN for all of them before Cyrius 6.6.8. Under 6.6.8's
        # saturation NaN arrived as 0 (factorial(NaN) = 1, nextprime(NaN) = 2)
        # and 1e300 as i64_MAX, which next_prime overflowed into a search that
        # never returned. A refused argument gets exactly what that i64_MIN did.
        if (streq(name, "factorial") == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            if (n > 170) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            var result = f64_from(1);
            var fi = 1;
            while (fi <= n) { result = f64_mul(result, f64_from(fi)); fi = fi + 1; }
            return result;
        }
        if (streq(name, "isprime") == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { return f64_from(0); }
            return f64_from(is_prime(n));
        }
        if (streq(name, "nextprime") == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            # 0 means i64 has no larger prime (n >= 2^63 - 25).
            var np = next_prime(n);
            if (np == 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(np);
        }
        if (streq(name, "prevprime") == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            var rt, rv = prev_prime(n);
            if (is_ok(rt) == 1) { return f64_from(rv); }
            eval_set_err(e, ABACO_ERR_MATH);
            return f64_from(0);
        }
        if (streq(name, "totient") == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            # totient() trial-divides to sqrt(n), so an unbounded n is an
            # attacker-controlled O(sqrt(n)) loop. Cap the domain the way
            # `factorial` (n > 170) and `fibonacci` (n > 92) already do; 10^12
            # keeps the loop under ~10^6 iterations and covers any realistic
            # calculator input.
            if (n > ABACO_TOTIENT_MAX) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(totient(n));
        }
        var is_fib = 0;
        if (streq(name, "fibonacci") == 1) { is_fib = 1; }
        if (streq(name, "fib") == 1) { is_fib = 1; }
        if (is_fib == 1) {
            var nt, n = _int_arg(a);
            if (is_ok(nt) == 0 || n < 0) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            if (n > 92) { eval_set_err(e, ABACO_ERR_MATH); return f64_from(0); }
            return f64_from(fibonacci(n));
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
        return f64_from(0);
    }

    # 2-arg functions
    if (nargs == 2) {
        # NaN in either argument is NaN out. The stdlib min/max drop or keep a
        # NaN depending on argument order, and atan2 turned NaN into -pi/2
        # (2.4.9 audit); the signed-zero and (Inf, Inf) rows of C99 atan2 are
        # ganita's (roadmap).
        if (f64_eq(a, a) == 0) {
            if (streq(name, "min") == 1 || streq(name, "max") == 1 || streq(name, "atan2") == 1) { return a; }
        }
        if (f64_eq(b, b) == 0) {
            if (streq(name, "min") == 1 || streq(name, "max") == 1 || streq(name, "atan2") == 1) { return b; }
        }
        if (streq(name, "min") == 1) { return f64_min(a, b); }
        if (streq(name, "max") == 1) { return f64_max(a, b); }
        if (streq(name, "pow") == 1) { return eval_pow(a, b); }
        if (streq(name, "atan2") == 1) {
            # Quadrant-correct two-arg arctangent (stdlib math.cyr, 4.8.5+).
            # Closes the pre-4.8.5 Q2/Q3 bug where we returned atan(y/x)
            # without quadrant fix.
            return f64_atan2(a, b);
        }
        # gcd / lcm / binomial had no domain check at all through 2.4.6: NaN,
        # +/-Inf and |x| >= 2^63 went straight into i64 arithmetic, answering
        # garbage that moved with the toolchain (gcd(1e300, 6) is -2 on x86
        # through Cyrius 6.6.7 and 1 from 6.6.8, with no error either way) and,
        # from 6.6.8, SIGFPE: lcm(-1e300, 1e300) saturates to i64_MIN and
        # i64_MAX, whose stdlib gcd is -1, and i64_MIN / -1 traps. Now
        # ABACO_ERR_MATH, through the same checked conversion as above.
        #
        # gcd and lcm convert MAGNITUDES (gcd always did), so their domain is
        # |x| < 2^63. The stdlib pair negates negative operands, and 0 - i64_MIN
        # is i64_MIN again, so -(2^63) itself broke lcm on EVERY toolchain:
        # stdlib gcd(i64_MIN, 5) is -1, and lcm(0-9223372036854775808, 5)
        # divided i64_MIN by it and trapped. (gcd of that pair answered -1 on
        # x86 through 6.6.7.) Every other lcm result is unchanged — the stdlib
        # returns |lcm| whatever the operand signs.
        if (streq(name, "gcd") == 1) {
            var gat, ga = _int_arg(f64_abs(a));
            var gbt, gb = _int_arg(f64_abs(b));
            if (is_ok(gat) == 0 || is_ok(gbt) == 0) {
                eval_set_err(e, ABACO_ERR_MATH);
                return f64_from(0);
            }
            return f64_from(gcd_int(ga, gb));
        }
        if (streq(name, "lcm") == 1) {
            var lat, la = _int_arg(f64_abs(a));
            var lbt, lb = _int_arg(f64_abs(b));
            if (is_ok(lat) == 0 || is_ok(lbt) == 0) {
                eval_set_err(e, ABACO_ERR_MATH);
                return f64_from(0);
            }
            # The stdlib lcm is (a / gcd) * b with no overflow check, so a result
            # past i64 wrapped silently: lcm(2^62, 3) answered 2^62 through
            # 2.4.7. For positive a and b the product fits exactly when
            # a / g <= i64_MAX / b in integer division, so test that first.
            if (la != 0 && lb != 0) {
                if (la / gcd_int(la, lb) > ABACO_I64_MAX / lb) {
                    eval_set_err(e, ABACO_ERR_MATH);
                    return f64_from(0);
                }
            }
            return f64_from(lcm(la, lb));
        }
        var is_binom = 0;
        if (streq(name, "binomial") == 1) { is_binom = 1; }
        if (streq(name, "choose") == 1) { is_binom = 1; }
        if (is_binom == 1) {
            var bnt, bn = _int_arg(a);
            var bkt, bk = _int_arg(b);
            if (is_ok(bnt) == 0 || is_ok(bkt) == 0) {
                eval_set_err(e, ABACO_ERR_MATH);
                return f64_from(0);
            }
            # abaco_binomial (src/ntheory.cyr), not ganita's binomial: ganita
            # answered -1 for a negative argument or a result it could not hold
            # (passed through as the answer until 2.4.8), and multiplies before
            # it divides, so it refused results above i64_MAX / k that fit —
            # C(62, 31) was ABACO_ERR_MATH at 2.4.8. Exact iff the result fits.
            var bt, bv = abaco_binomial(bn, bk);
            if (is_ok(bt) == 0) {
                eval_set_err(e, ABACO_ERR_MATH);
                return f64_from(0);
            }
            return f64_from(bv);
        }
        eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
        return f64_from(0);
    }

    eval_set_err(e, ABACO_ERR_UNKNOWN_FN);
    return f64_from(0);
}

# ================================================================
# Public API
# ================================================================

# Evaluate expression string, return f64 bits
# Sets eval_err on the evaluator if error
fn Evaluator_eval(e, expr) {
    _eval_begin(e);
    return _eval_run(e, expr);
}

fn _eval_run(e, expr) {
    var a = eval_arena(e);
    var toks = _tok_alloc_a(a);
    eval_set_toks(e, toks);
    eval_set_pos(e, 0);
    eval_set_err(e, ABACO_ERR_NONE);
    eval_set_depth(e, 0);
    var nt, tok_ok = _tokenize_a(a, expr, toks);
    if (tok_ok == 0) {
        eval_set_ntoks(e, 0);
        eval_set_err(e, ABACO_ERR_PARSE);
        return f64_from(0);
    }
    eval_set_ntoks(e, nt);
    if (nt == 0) { eval_set_err(e, ABACO_ERR_INVALID); return f64_from(0); }
    var result = parse_expr(e);
    if (eval_err(e) == ABACO_ERR_NONE) { if (eval_pos(e) < eval_ntoks(e)) {
            eval_set_err(e, ABACO_ERR_PARSE);
        } }
    return result;
}

# 1 for a token an expression can end on: an operand, or a postfix operator
# ('%' as percent, '!').
fn _tok_can_end(t) {
    if (t == TOK_NUMBER) { return 1; }
    if (t == TOK_IDENT) { return 1; }
    if (t == TOK_RPAREN) { return 1; }
    if (t == TOK_PERCENT) { return 1; }
    if (t == TOK_BANG) { return 1; }
    return 0;
}

# Evaluate a partial/incomplete expression for live-as-you-type feedback.
#
# The whole expression first, and it must use every token. Only when that runs
# out of input (ABACO_ERR_PARSE / ABACO_ERR_INVALID) is the input treated as
# unfinished: the trailing run of tokens that cannot end an expression (binary
# operators, '(' and ',', and the name before a dropped '(') is dropped, any
# parenthesis still open is closed, and the result is parsed again — "2+3*"
# previews 5, "2*(3+4" previews 14, "2+sqrt(" 2. If closing a call still being
# typed produces an unknown-name error ("2+max(7" -> max(7), an arity miss),
# the prefix before that call is tried instead, at most ABACO_PARTIAL_TRIES
# times. Any other semantic error (DIV_ZERO, MATH, an unknown name with no call
# left open) is the answer, not a sign the input is unfinished, and is returned
# as it is.
#
# Through 2.4.8 the fallback re-parsed EVERY shorter prefix: O(tokens^2) work, so
# a pasted 2.7 KB input with a hundred capped totient() calls took 92 s here
# against 0.18 s in Evaluator_eval; and since it dropped any trailing token, a
# complete expression that failed was cut back until something succeeded —
# "1/0" previewed 1, "2+x" 2, "5*171!" 855, all with ABACO_ERR_NONE (2.4.9 audit).
fn Evaluator_eval_partial(e, expr) {
    _eval_begin(e);
    return _eval_partial_run(e, expr);
}

fn _eval_partial_run(e, expr) {
    var a = eval_arena(e);
    var toks = _tok_alloc_a(a);
    eval_set_toks(e, toks);
    eval_set_pos(e, 0);
    eval_set_err(e, ABACO_ERR_NONE);
    eval_set_depth(e, 0);
    var nt, tok_ok = _tokenize_a(a, expr, toks);
    if (tok_ok == 0) {
        eval_set_ntoks(e, 0);
        eval_set_err(e, ABACO_ERR_PARSE);
        return f64_from(0);
    }
    if (nt == 0) { eval_set_err(e, ABACO_ERR_INVALID); return f64_from(0); }

    eval_set_ntoks(e, nt);
    var result = parse_expr(e);
    var err = eval_err(e);
    if (err == ABACO_ERR_NONE) {
        if (eval_pos(e) != nt) { eval_set_err(e, ABACO_ERR_PARSE); }
        return result;
    }
    if (err != ABACO_ERR_PARSE && err != ABACO_ERR_INVALID) { return result; }

    var k = _partial_cut(toks, nt);
    var tries = 0;
    while (tries < ABACO_PARTIAL_TRIES) {
        if (k == 0) { eval_set_err(e, ABACO_ERR_INVALID); return f64_from(0); }
        var open = 0;
        var i = 0;
        while (i < k) {
            var t = tok_type(toks, i);
            if (t == TOK_LPAREN) { open = open + 1; }
            if (t == TOK_RPAREN) { open = open - 1; }
            i = i + 1;
        }
        if (open < 0 || k + open > ABACO_MAX_TOKENS) { eval_set_err(e, ABACO_ERR_PARSE); return f64_from(0); }
        var call_at = _partial_open_call(toks, k);
        i = 0;
        while (i < open) {
            tok_set(toks, k + i, TOK_RPAREN, 0);
            i = i + 1;
        }
        eval_set_ntoks(e, k + open);
        eval_set_pos(e, 0);
        eval_set_err(e, ABACO_ERR_NONE);
        eval_set_depth(e, 0);
        result = parse_expr(e);
        var e2 = eval_err(e);
        if (e2 == ABACO_ERR_NONE && eval_pos(e) != k + open) {
            eval_set_err(e, ABACO_ERR_PARSE);
            return result;
        }
        # Closing a call the user is still typing can invent an error they
        # never typed: "2+max(7" closed is max(7), one argument short. Back off
        # to before that call and try the shorter prefix ("2"). With no call
        # left open, an unknown name is real and stands.
        if ((e2 == ABACO_ERR_UNKNOWN_FN || e2 == ABACO_ERR_UNKNOWN_VAR) && call_at >= 0) {
            k = _partial_cut(toks, call_at);
            tries = tries + 1;
        } else {
            return result;
        }
    }
    eval_set_err(e, err);
    return f64_from(0);
}

# How many prefixes eval_partial tries after the full parse.
enum EvalPartial { ABACO_PARTIAL_TRIES = 4; }

# Length of the prefix of toks[0..n) that ends on a token an expression can
# end on: the trailing operators, '(' and ',' are dropped, and a '(' dropped
# there takes the name before it with it — "2+sqrt(" previews 2, where keeping
# the bare `sqrt` would read as an unknown variable.
fn _partial_cut(toks, n) {
    var k = n;
    var go = 1;
    while (go == 1 && k > 0) {
        var t = tok_type(toks, k - 1);
        if (_tok_can_end(t) == 1) {
            go = 0;
        } else {
            k = k - 1;
            if (t == TOK_LPAREN && k > 0 && tok_type(toks, k - 1) == TOK_IDENT) { k = k - 1; }
        }
    }
    return k;
}

# Index of the name of the innermost call still open in toks[0..k), or -1. A
# name followed by '(' is always a call here: implicit multiplication never
# joins an identifier to a following parenthesis.
fn _partial_open_call(toks, k) {
    var depth = 0;
    var i = k - 1;
    while (i >= 0) {
        var t = tok_type(toks, i);
        if (t == TOK_RPAREN) { depth = depth + 1; }
        elif (t == TOK_LPAREN) {
            if (depth > 0) { depth = depth - 1; }
            elif (i > 0 && tok_type(toks, i - 1) == TOK_IDENT) { return i - 1; }
        }
        i = i - 1;
    }
    return 0 - 1;
}

# Evaluate and return as Value (Integer if whole, Float otherwise)
fn Evaluator_eval_value(e, expr) {
    var result = Evaluator_eval(e, expr);
    if (eval_err(e) != ABACO_ERR_NONE) { return Value_float(result); }
    # Checked, not a bare f64_to round-trip: on Cyrius 6.6.8+ that saturates
    # 2^63 to i64_MAX, which f64_from rounds back to 2^63, so `2^63` came back
    # as the INTEGER 9223372036854775807 — off by one, with no error.
    var it, i = abaco_f64_to_i64(result);
    if (is_ok(it) == 1) {
        if (f64_eq(result, f64_from(i)) == 1) {
            return Value_integer(i);
        }
    }
    return Value_float(result);
}
