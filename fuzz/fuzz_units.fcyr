# Fuzz: unit registry with random lookup queries and conversions.
# Invariants:
#   - UnitRegistry_find never crashes on any string.
#   - UnitRegistry_convert never crashes; sets UERR_UNKNOWN / UERR_INCOMPAT cleanly.
#   - Round-trip within a category: convert(convert(x, a, b), b, a) ≈ x.
#   - Two spellings of one unit (symbol, name, alias, plural) convert as the
#     identity. Through 2.4.8 this used convert(x, a, a), which returns x
#     without looking at a factor and so could never fail.
#   - 1 unit of a sampled unit is exactly its reference factor in the base
#     unit (correctly rounded from the exact definition; an independent
#     oracle, unlike the round trip, which cancels any factor error).
#   - A two-byte query "<letter>s" never resolves: the plural strip must not
#     turn "ms" into metre or "ns" into newton.

include "src/core.cyr"
include "src/ntheory.cyr"
include "src/dsp.cyr"
include "src/eval.cyr"
include "src/units.cyr"

var _fz_state = 998877;

# Newline-free stdout write. Cyrius 6.5.x enforces call arity, and the stdlib
# `print` is `print(msg, len)` — a bare `print(cstr)` no longer compiles.
fn _fz_puts(s) {
    print(s, strlen(s));
    return 0;
}

fn _fz_rand() {
    _fz_state = _fz_state * 6364136223846793005 + 1442695040888963407;
    return _fz_state;
}

fn _fz_u(m) {
    var r = _fz_rand();
    if (r < 0) { r = 0 - r; }
    return r % m;
}

# Build a random-ish unit string — letters, digits, punctuation.
fn _fz_unit() {
    var len = _fz_u(16) + 1;
    var buf = alloc(len + 1);
    var i = 0;
    while (i < len) {
        var kind = _fz_u(10);
        var c = 0;
        if (kind < 6) { c = 97 + _fz_u(26); }       # a-z
        elif (kind < 8) { c = 48 + _fz_u(10); }     # 0-9
        elif (kind == 8) { c = 47; }                # /
        else { c = _fz_u(128); }
        store8(buf + i, c);
        i = i + 1;
    }
    store8(buf + len, 0);
    return buf;
}

# Known-good unit pairs for round-trip testing (same category, linear).
# Temperature offsets are tested separately to avoid the offset cancellation
# edge case at x=0.
var RT_PAIRS_N = 10;
fn _rt_pair(i, out_from, out_to) {
    switch (i) {
        case 0: { store64(out_from, "km");  store64(out_to, "m");     return 0; }
        case 1: { store64(out_from, "mi");  store64(out_to, "ft");    return 0; }
        case 2: { store64(out_from, "kg");  store64(out_to, "g");     return 0; }
        case 3: { store64(out_from, "lb");  store64(out_to, "oz");    return 0; }
        case 4: { store64(out_from, "GB");  store64(out_to, "MB");    return 0; }
        case 5: { store64(out_from, "GiB"); store64(out_to, "MiB");   return 0; }
        case 6: { store64(out_from, "hr");  store64(out_to, "min");   return 0; }
        case 7: { store64(out_from, "Hz");  store64(out_to, "bpm");   return 0; }
        case 8: { store64(out_from, "J");   store64(out_to, "cal");   return 0; }
        case 9: { store64(out_from, "oct"); store64(out_to, "cent");  return 0; }
    }
    return 0;
}

# Pairs of different spellings of the same unit.
var SP_PAIRS_N = 12;
fn _sp_pair(i, out_a, out_b) {
    switch (i) {
        case 0:  { store64(out_a, "lb");    store64(out_b, "pounds");     return 0; }
        case 1:  { store64(out_a, "km");    store64(out_b, "Kilometers"); return 0; }
        case 2:  { store64(out_a, "m");     store64(out_b, "metre");      return 0; }
        case 3:  { store64(out_a, "L");     store64(out_b, "litres");     return 0; }
        case 4:  { store64(out_a, "Hz");    store64(out_b, "hertz");      return 0; }
        case 5:  { store64(out_a, "C");     store64(out_b, "Celsius");    return 0; }
        case 6:  { store64(out_a, "ft");    store64(out_b, "FEET");       return 0; }
        case 7:  { store64(out_a, "kWh");   store64(out_b, "kwh");        return 0; }
        case 8:  { store64(out_a, "t");     store64(out_b, "tonne");      return 0; }
        case 9:  { store64(out_a, "st");    store64(out_b, "Stones");     return 0; }
        case 10: { store64(out_a, "semi");  store64(out_b, "semitones");  return 0; }
    }
    store64(out_a, "km/h");
    store64(out_b, "kph");
    return 0;
}

# (unit, base unit, bits of the correctly rounded exact factor).
var FX_N = 12;
fn _fx(i, out_u, out_b) {
    switch (i) {
        case 0:  { store64(out_u, "lb");   store64(out_b, "kg");   return 0x3FDD07A84AB75E51; }
        case 1:  { store64(out_u, "gal");  store64(out_b, "L");    return 0x400E4885F9316256; }
        case 2:  { store64(out_u, "tsp");  store64(out_b, "L");    return 0x3F74305950CB96E4; }
        case 3:  { store64(out_u, "ac");   store64(out_b, "m2");   return 0x40AF9DB67CFF2F20; }
        case 4:  { store64(out_u, "kn");   store64(out_b, "m/s");  return 0x3FE07654320FEDCC; }
        case 5:  { store64(out_u, "torr"); store64(out_b, "Pa");   return 0x4060AA50D79435E5; }
        case 6:  { store64(out_u, "mmHg"); store64(out_b, "Pa");   return 0x4060AA50FF698225; }
        case 7:  { store64(out_u, "BTU");  store64(out_b, "J");    return 0x40907C39316DE12F; }
        case 8:  { store64(out_u, "psi");  store64(out_b, "Pa");   return 0x40BAEEC1DDF70F99; }
        case 9:  { store64(out_u, "hp");   store64(out_b, "W");    return 0x40874D995645AA01; }
        case 10: { store64(out_u, "mpg");  store64(out_b, "km/L"); return 0x3FDB358DF3E0D871; }
    }
    store64(out_u, "mi");
    store64(out_b, "m");
    return 0x409925604189374C;
}

fn main() {
    alloc_init();
    args_init();

    var iters = 5000;
    if (argc() > 1) {
        var arg = argv(1);
        iters = 0;
        var ai = 0;
        while (load8(arg + ai) != 0) {
            var dig = load8(arg + ai);
            # A typo must not run 0 iterations and report a pass.
            if (dig < 48 || dig > 57 || ai >= 9) {
                println("usage: <harness> [iterations, 1-999999999]");
                sys_exit(2);
            }
            iters = iters * 10 + dig - 48;
            ai = ai + 1;
        }
        if (iters <= 0) {
            println("usage: <harness> [iterations, 1-999999999]");
            sys_exit(2);
        }
    }

    var reg = UnitRegistry_new();
    var from_slot = alloc(8);
    var to_slot = alloc(8);
    var pass = 0;
    var iter = 0;
    while (iter < iters) {
        var q = _fz_unit();
        UnitRegistry_find(reg, q);

        var from = _fz_unit();
        var to = _fz_unit();
        UnitRegistry_convert(reg, f64_from(100), from, to);

        # Round-trip invariant on a known-good pair.
        var idx = _fz_u(RT_PAIRS_N);
        _rt_pair(idx, from_slot, to_slot);
        var a = load64(from_slot);
        var b = load64(to_slot);
        # Use a non-zero input that survives integer truncation.
        var x_i = _fz_u(1000) + 1;
        var x = f64_from(x_i);
        var mid = UnitRegistry_convert(reg, x, a, b);
        if (reg_err(reg) != UERR_NONE) {
            _fz_puts("FAIL: forward convert ");
            _fz_puts(a); _fz_puts(" -> "); println(b);
            sys_exit(1);
        }
        var back = UnitRegistry_convert(reg, mid, b, a);
        if (reg_err(reg) != UERR_NONE) {
            _fz_puts("FAIL: back convert ");
            _fz_puts(b); _fz_puts(" -> "); println(a);
            sys_exit(1);
        }
        # Integer-truncate both sides and allow 1 ulp tolerance.
        var back_i = f64_to(back);
        var diff = back_i - x_i;
        if (diff < 0) { diff = 0 - diff; }
        if (diff > 1) {
            _fz_puts("FAIL: roundtrip ");
            _fz_puts(a); _fz_puts("<->"); _fz_puts(b);
            _fz_puts(" x="); print_num(x_i);
            _fz_puts(" back="); print_num(back_i);
            println("");
            sys_exit(1);
        }

        # Identity across spellings of one unit.
        _sp_pair(_fz_u(SP_PAIRS_N), from_slot, to_slot);
        var sa = load64(from_slot);
        var sb = load64(to_slot);
        var same = UnitRegistry_convert(reg, x, sa, sb);
        if (reg_err(reg) != UERR_NONE || same != x) {
            _fz_puts("FAIL: identity ");
            _fz_puts(sa); _fz_puts(" = "); println(sb);
            sys_exit(1);
        }

        # Factor oracle: x units in the base unit is x * factor, bit for bit
        # (the converter does exactly that multiply, with offset 0).
        var fbits = _fx(_fz_u(FX_N), from_slot, to_slot);
        var fu = load64(from_slot);
        var got = UnitRegistry_convert(reg, x, fu, load64(to_slot));
        if (reg_err(reg) != UERR_NONE || got != f64_mul(x, fbits)) {
            _fz_puts("FAIL: factor ");
            _fz_puts(fu); println("");
            sys_exit(1);
        }

        # "<letter>s" is never a unit.
        var two = alloc(3);
        store8(two, 65 + _fz_u(58));
        store8(two + 1, 115);
        store8(two + 2, 0);
        if (UnitRegistry_find(reg, two) != 0) {
            _fz_puts("FAIL: plural strip resolved ");
            println(two);
            sys_exit(1);
        }

        pass = pass + 1;
        iter = iter + 1;
    }

    print_num(pass);
    println(" units fuzz iterations passed");
    return 0;
}

var r = main();
sys_exit(r);
