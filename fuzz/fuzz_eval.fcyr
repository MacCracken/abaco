# Fuzz: expression evaluator with random input strings.
# Invariants:
#   - Evaluator_eval never crashes on any input.
#   - A byte outside the grammar is never evaluated past: err != NONE (2.4.9 —
#     through 2.4.8 such bytes were skipped silently; this line claimed the
#     invariant and nothing checked it).
#   - Evaluator_eval_partial never crashes, and agrees with Evaluator_eval
#     whenever the full expression succeeds (same bits) or fails semantically
#     (same DIV_ZERO / MATH / UNKNOWN_* error) — 2.4.8 previewed 1/0 as 1.
#   - The domain caps answer ABACO_ERR_MATH past their bound and a value under it.
#   - Any named function with 1-40 adversarial arguments: more than 32 is an
#     error, a wrong count for a fixed-arity builtin is ABACO_ERR_ARITY (2.4.10),
#     an integer function given a fraction, NaN, Inf or |x| >= 2^63 is
#     ABACO_ERR_MATH (isprime: 0); gcd / lcm / binomial / choose on small
#     operands equal an i64 oracle (Euclid, Pascal's triangle); mean / median /
#     stddev with a NaN argument are NaN (2.4.9 — through 2.4.8 no fuzz
#     execution reached any function but four).
#   - Whitespace idempotence: " 2 + 3 " == "2+3".
#   - Commutativity: a + b == b + a, a * b == b * a (on valid expressions).

include "src/core.cyr"
include "src/ntheory.cyr"
include "src/dsp.cyr"
include "src/eval.cyr"

# LCG PRNG
var _fz_state = 42424242;

# Newline-free stdout write. Cyrius 6.5.x enforces call arity, and the stdlib
# `print` is `print(msg, len)` — a bare `print(cstr)` no longer compiles.
fn _fz_puts(s) {
    print(s, strlen(s));
    return 0;
}

fn _fz_fail(msg) {
    _fz_puts("FAIL: ");
    println(msg);
    sys_exit(1);
    return 0;
}

fn _fz_rand() {
    _fz_state = _fz_state * 6364136223846793005 + 1442695040888963407;
    return _fz_state;
}

fn _fz_u(m) {
    var r = _fz_rand();
    if (r < 0) { r = 0 - r; }
    return r % m;
}

# Bias toward expression-relevant bytes — digits, operators, identifiers.
# `^` and `!` are first-class here (2.3.4): the 2026-08-13 audit found the
# old table reached '^' only through the ~0.04%/byte wild-byte path, which is
# why the unbounded eval_pow loop and the unbounded '^'-chain recursion both
# survived every prior fuzz run.
fn _fz_byte() {
    var kind = _fz_u(22);
    if (kind < 6)  { return 48 + _fz_u(10); }     # 0-9
    if (kind < 10) { return 97 + _fz_u(26); }     # a-z
    if (kind == 10) { return 43; }                # +
    if (kind == 11) { return 45; }                # -
    if (kind == 12) { return 42; }                # *
    if (kind == 13) { return 47; }                # /
    if (kind == 14) { return 40; }                # (
    if (kind == 15) { return 41; }                # )
    if (kind == 16) { return 46; }                # .
    if (kind == 17) { return 44; }                # ,
    if (kind == 18) { return 32; }                # space
    if (kind == 19) { return 94; }                # ^
    if (kind == 20) { return 33; }                # !
    return _fz_u(128);                            # wild byte
}

# Length cap must exceed ABACO_MAX_TOKENS * 2 so the corpus can actually cross
# the token-array boundary — at the old 48-byte cap the tokenizer could emit at
# most ~48 tokens against a 512 limit, a 10x margin the fuzzer could never
# close, which is how the out-of-bounds token write went unfound.
fn _fz_expr() {
    var len = _fz_u(1200) + 1;
    var buf = alloc(len + 1);
    var i = 0;
    while (i < len) {
        store8(buf + i, _fz_byte());
        i = i + 1;
    }
    store8(buf + len, 0);
    return buf;
}

# Adversarial shapes the random byte stream will essentially never produce:
# long digit runs as exponents, deep unary-sign chains, deep '^' chains, long
# operator chains that overrun the token array, and function calls.
#
# 2.3.5 fix-audit: these shapes were generated but their results were DISCARDED,
# so the harness could not detect a regression of the very defects it was
# written for — with every ABACO_MAX_TOKENS bound deleted it still passed 50,000
# iterations, because H-1's failure mode is a silently WRONG ANSWER, not a
# crash. Every shape now asserts its contract.
fn _fz_pathological(which, e) {
    var buf = 0;
    var i = 0;
    var pos = 0;
    var n = 0;
    var r = 0;
    if (which == 0) {
        # "2^<up to 19 digits>" — the eval_pow exponent path. Must return
        # promptly; +Inf is the right answer once the exponent is large.
        n = _fz_u(19) + 1;
        buf = alloc(n + 4);
        store8(buf, 50); store8(buf + 1, 94);
        while (i < n) { store8(buf + 2 + i, 49 + _fz_u(9)); i = i + 1; }
        store8(buf + 2 + n, 0);
        r = Evaluator_eval(e, buf);
        if (eval_err(e) != ABACO_ERR_NONE) { _fz_fail("2^N should evaluate"); }
        if (f64_eq(r, r) == 0) { _fz_fail("2^N returned NaN"); }
        return 0;
    }
    if (which == 1) {
        # Unary-sign chain straddling ABACO_MAX_DEPTH (256) and the token cap.
        # Depth is observable for n in [257, 511].
        n = _fz_u(600) + 1;
        buf = alloc(n + 3);
        while (i < n) { store8(buf + i, 45); i = i + 1; }
        store8(buf + n, 49);
        store8(buf + n + 1, 0);
        Evaluator_eval(e, buf);
        if (n <= 256) {
            if (eval_err(e) != ABACO_ERR_NONE) { _fz_fail("unary chain under depth cap rejected"); }
        } else {
            if (eval_err(e) != ABACO_ERR_PARSE) { _fz_fail("over-deep unary chain accepted"); }
        }
        return 0;
    }
    if (which == 2) {
        # Right-associative '^' chain. The depth guard tests before
        # incrementing, so n operators reach depth n-1: n <= 256 evaluates,
        # n >= 257 is a depth rejection. At the pre-2.4.0 token cap of 512 this
        # window did not exist — 257 operators needed 515 tokens — which is why
        # parse_power's guard was structurally untestable.
        n = _fz_u(400) + 1;
        buf = alloc(n * 2 + 4);
        while (i < n) {
            store8(buf + pos, 50); pos = pos + 1;
            store8(buf + pos, 94); pos = pos + 1;
            i = i + 1;
        }
        store8(buf + pos, 49); pos = pos + 1;
        store8(buf + pos, 0);
        Evaluator_eval(e, buf);
        if (n <= 256) {
            if (eval_err(e) != ABACO_ERR_NONE) { _fz_fail("'^' chain under the depth cap rejected"); }
        } else {
            if (eval_err(e) != ABACO_ERR_PARSE) { _fz_fail("over-deep '^' chain accepted"); }
        }
        return 0;
    }
    if (which == 3) {
        # "1+1+1+..." straddling ABACO_MAX_TOKENS. THIS is the H-1 detector:
        # under the cap the sum must be EXACTLY n, which is what the
        # out-of-bounds token write used to corrupt (343 terms -> 342).
        n = _fz_u(700) + 1;
        buf = alloc(n * 2 + 2);
        while (i < n) {
            if (i > 0) { store8(buf + pos, 43); pos = pos + 1; }
            store8(buf + pos, 49); pos = pos + 1;
            i = i + 1;
        }
        store8(buf + pos, 0);
        r = Evaluator_eval(e, buf);
        if (n * 2 - 1 <= ABACO_MAX_TOKENS) {
            if (eval_err(e) != ABACO_ERR_NONE) { _fz_fail("under-cap sum rejected"); }
            if (f64_to(r) != n) { _fz_fail("under-cap sum returned the WRONG VALUE (H-1)"); }
        } else {
            if (eval_err(e) != ABACO_ERR_PARSE) { _fz_fail("over-cap sum accepted"); }
        }
        return 0;
    }
    # Function calls with adversarial arguments — the only shape that reaches
    # the evaluator's domain caps (totient, factorial, fibonacci). The random
    # byte stream cannot produce a 7-letter function name, so M-1 had no fuzz
    # coverage at all before 2.3.5.
    n = _fz_u(4);
    var name = "totient(";
    if (n == 1) { name = "factorial("; }
    if (n == 2) { name = "fib("; }
    if (n == 3) { name = "isprime("; }
    var nl = strlen(name);
    var digits = _fz_u(19) + 1;
    buf = alloc(nl + digits + 4);
    memcpy(buf, name, nl);
    pos = nl;
    while (i < digits) { store8(buf + pos, 48 + _fz_u(10)); pos = pos + 1; i = i + 1; }
    store8(buf + pos, 41); pos = pos + 1;
    store8(buf + pos, 0);
    Evaluator_eval(e, buf);
    # 2.4.9: assert the outcome (through 2.4.8 any outcome passed, so removing
    # the factorial / fib caps kept the gate green). Recompute the argument;
    # past i64 it is out of every domain.
    var val = 0;
    var big = 0;
    var di = nl;
    while (di < nl + digits) {
        if (val > 922337203685477579) { big = 1; }
        val = val * 10 + (load8(buf + di) - 48);
        di = di + 1;
    }
    var want = ABACO_ERR_NONE;
    if (n == 0) { if (big == 1 || val > 1000000000000) { want = ABACO_ERR_MATH; } }
    if (n == 1) { if (big == 1 || val > 170) { want = ABACO_ERR_MATH; } }
    if (n == 2) { if (big == 1 || val > 92) { want = ABACO_ERR_MATH; } }
    if (eval_err(e) != want) { _fz_puts(buf); _fz_fail(" domain cap answered the wrong error"); }
    return 0;
}

# Function table for the call shape: name and arity (-1 = variadic).
var _FZ_FN_N = 19;
fn _fz_fn(i, out_arity) {
    store64(out_arity, 1);
    if (i == 0)  { store64(out_arity, 2); return "gcd"; }
    if (i == 1)  { store64(out_arity, 2); return "lcm"; }
    if (i == 2)  { store64(out_arity, 2); return "binomial"; }
    if (i == 3)  { store64(out_arity, 2); return "choose"; }
    if (i == 4)  { return "nextprime"; }
    if (i == 5)  { return "prevprime"; }
    if (i == 6)  { return "isprime"; }
    if (i == 7)  { return "factorial"; }
    if (i == 8)  { return "fib"; }
    if (i == 9)  { return "totient"; }
    if (i == 10) { store64(out_arity, 0 - 1); return "mean"; }
    if (i == 11) { store64(out_arity, 0 - 1); return "median"; }
    if (i == 12) { store64(out_arity, 0 - 1); return "stddev"; }
    if (i == 13) { store64(out_arity, 2); return "min"; }
    if (i == 14) { store64(out_arity, 2); return "max"; }
    if (i == 15) { store64(out_arity, 2); return "atan2"; }
    if (i == 16) { return "sqrt"; }
    if (i == 17) { return "abs"; }
    store64(out_arity, 2);
    return "pow";
}

# Argument kinds: 0 small integer 0..60, 1 negative integer, 2 fraction,
# 3 +-1e300, 4 2^63, 5 NaN expression, 6 +Inf expression.
var _FZ_ARG_N = 7;
fn _fz_arg_text(kind, small) {
    var b = alloc(32);
    if (kind == 0) { var n0 = fmt_int_buf(small, b); store8(b + n0, 0); return b; }
    if (kind == 1) { store8(b, 48); store8(b + 1, 45); var n1 = fmt_int_buf(small + 1, b + 2); store8(b + 2 + n1, 0); return b; }
    if (kind == 2) { return "2.5"; }
    if (kind == 3) { if (small % 2 == 0) { return "1e300"; } return "0-1e300"; }
    if (kind == 4) { return "9223372036854775808"; }
    if (kind == 5) { return "sqrt(0-1)"; }
    return "1e308*10";
}

# gcd of two non-negative i64, by Euclid.
fn _fz_gcd(a, b) {
    while (b != 0) { var t = a % b; a = b; b = t; }
    return a;
}

# C(n, k) for 0 <= k <= n <= 60 by Pascal's triangle (every entry fits i64).
var _FZ_PASCAL = 0;
fn _fz_choose(n, k) {
    if (_FZ_PASCAL == 0) {
        _FZ_PASCAL = alloc(61 * 61 * 8);
        var r = 0;
        while (r <= 60) {
            var c = 0;
            while (c <= 60) {
                var v = 0;
                if (c == 0 || c == r) { v = 1; }
                elif (c < r) { v = load64(_FZ_PASCAL + ((r - 1) * 61 + c - 1) * 8) + load64(_FZ_PASCAL + ((r - 1) * 61 + c) * 8); }
                store64(_FZ_PASCAL + (r * 61 + c) * 8, v);
                c = c + 1;
            }
            r = r + 1;
        }
    }
    return load64(_FZ_PASCAL + (n * 61 + k) * 8);
}

# One call to a named function with adversarial arguments.
fn _fz_call_shape(e) {
    var arb = alloc(8);
    var fi = _fz_u(_FZ_FN_N);
    var name = _fz_fn(fi, arb);
    var arity = load64(arb);
    var nargs = arity;
    if (arity < 0 || _fz_u(8) == 0) { nargs = _fz_u(40) + 1; }
    var buf = alloc(40 * 24 + 32);
    var nl = strlen(name);
    memcpy(buf, name, nl);
    var pos = nl;
    store8(buf + pos, 40); pos = pos + 1;
    var bad = 0;          # some argument is a fraction, NaN, Inf or |x| >= 2^63
    var nan = 0;
    var allsmall = 1;
    var v0 = 0;
    var v1 = 0;
    var i = 0;
    while (i < nargs) {
        if (i > 0) { store8(buf + pos, 44); pos = pos + 1; }
        var kind = 0;
        if (_fz_u(2) == 0) { kind = _fz_u(_FZ_ARG_N); }
        var small = _fz_u(61);
        var t = _fz_arg_text(kind, small);
        memcpy(buf + pos, t, strlen(t)); pos = pos + strlen(t);
        if (kind >= 2) { bad = 1; }
        if (kind == 5) { nan = 1; }
        if (kind != 0) { allsmall = 0; }
        if (i == 0) { v0 = small; }
        if (i == 1) { v1 = small; }
        i = i + 1;
    }
    store8(buf + pos, 41); pos = pos + 1;
    store8(buf + pos, 0);
    var r = Evaluator_eval(e, buf);
    var err = eval_err(e);
    if (nargs > 32) {
        if (err == ABACO_ERR_NONE) { _fz_puts(buf); _fz_fail(" call with more than 32 arguments accepted"); }
        return 0;
    }
    if (arity >= 0 && nargs != arity) {
        if (err != ABACO_ERR_ARITY) { _fz_puts(buf); _fz_fail(" wrong argument count is not ABACO_ERR_ARITY"); }
        return 0;
    }
    var intfn = 0;
    if (fi <= 9) { intfn = 1; }
    if (intfn == 1 && bad == 1) {
        if (fi == 6) {
            if (err != ABACO_ERR_NONE || r != 0) { _fz_puts(buf); _fz_fail(" isprime of a non-integer is not 0"); }
        } elif (err != ABACO_ERR_MATH) {
            _fz_puts(buf); _fz_fail(" integer function took a non-integer argument");
        }
        return 0;
    }
    if (allsmall == 1 && fi <= 3) {
        var want = 0;
        var ok = 1;
        if (fi == 0) { want = _fz_gcd(v0, v1); }
        if (fi == 1) {
            if (v0 == 0 || v1 == 0) { want = 0; }
            else { want = v0 / _fz_gcd(v0, v1) * v1; }
        }
        if (fi >= 2) {
            if (v1 > v0) { want = 0; }
            else { want = _fz_choose(v0, v1); }
        }
        if (ok == 1 && (err != ABACO_ERR_NONE || r != f64_from(want))) {
            _fz_puts(buf); _fz_fail(" disagrees with the i64 oracle");
        }
        return 0;
    }
    if (nan == 1 && (fi == 10 || fi == 11 || fi == 12)) {
        if (err != ABACO_ERR_NONE || f64_eq(r, r) == 1) { _fz_puts(buf); _fz_fail(" statistic of a NaN argument is not NaN"); }
    }
    return 0;
}

# 1 when s holds a byte outside the evaluator's grammar.
fn _fz_has_foreign(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        var ok = 0;
        if (c == 32 || c == 9 || c == 10 || c == 13) { ok = 1; }
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 95 || c == 46 || c == 43 || c == 45 || c == 42 || c == 47) { ok = 1; }
        if (c == 37 || c == 94 || c == 40 || c == 41 || c == 44 || c == 33) { ok = 1; }
        if (ok == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    args_init();

    var iters = 5000;
    if (argc() > 1) {
        var arg = argv(1);
        iters = 0;
        var ai = 0;
        while (load8(arg + ai) != 0) {
            var dig = load8(arg + ai);
            # A typo must not run 0 iterations and report a pass.
            if (dig < 48 || dig > 57 || ai >= 9) {
                println("usage: <harness> [iterations, 1-999999999]");
                sys_exit(2);
            }
            iters = iters * 10 + dig - 48;
            ai = ai + 1;
        }
        if (iters <= 0) {
            println("usage: <harness> [iterations, 1-999999999]");
            sys_exit(2);
        }
    }
    var ev = Evaluator_new();
    var pass = 0;
    var iter = 0;
    while (iter < iters) {
        var s = _fz_expr();

        # Must not crash.
        var fr = Evaluator_eval(ev, s);
        var ferr = eval_err(ev);
        if (_fz_has_foreign(s) == 1 && ferr == ABACO_ERR_NONE) {
            _fz_fail("an expression with a byte outside the grammar evaluated cleanly");
        }
        # Partial eval must not crash either, and must agree with the full one
        # on a complete expression's success or semantic failure.
        var pr = Evaluator_eval_partial(ev, s);
        var perr = eval_err(ev);
        if (ferr == ABACO_ERR_NONE) {
            if (perr != ABACO_ERR_NONE || pr != fr) { _fz_fail("eval_partial disagrees with a successful eval"); }
        }
        if (ferr == ABACO_ERR_DIV_ZERO || ferr == ABACO_ERR_MATH) {
            if (perr != ferr) { _fz_fail("eval_partial hid a semantic error"); }
        }
        if (ferr == ABACO_ERR_UNKNOWN_VAR || ferr == ABACO_ERR_UNKNOWN_FN || ferr == ABACO_ERR_ARITY) {
            if (perr != ferr) { _fz_fail("eval_partial hid an unknown name"); }
        }

        # Every 4th iteration, run one targeted adversarial shape instead of
        # relying on the random stream to stumble into it.
        if (iter % 4 == 0) { _fz_pathological(_fz_u(5), ev); }
        if (iter % 4 == 1) { _fz_call_shape(ev); }

        # Whitespace idempotence + commutativity on synthesized valid exprs.
        # a in [1..1000), b in [1..1000).
        var a = _fz_u(999) + 1;
        var b = _fz_u(999) + 1;

        # Build "a + b".
        var e1 = alloc(32);
        var p1 = fmt_int_buf(a, e1); store8(e1 + p1, 43); p1 = p1 + 1;
        p1 = p1 + fmt_int_buf(b, e1 + p1); store8(e1 + p1, 0);
        # Build "  a + b  " with surrounding / inner whitespace.
        var e2 = alloc(64);
        store8(e2, 32); store8(e2 + 1, 32);
        var p2 = 2 + fmt_int_buf(a, e2 + 2);
        store8(e2 + p2, 32); p2 = p2 + 1;
        store8(e2 + p2, 43); p2 = p2 + 1;
        store8(e2 + p2, 32); p2 = p2 + 1;
        p2 = p2 + fmt_int_buf(b, e2 + p2);
        store8(e2 + p2, 32); store8(e2 + p2 + 1, 32); store8(e2 + p2 + 2, 0);
        # Build "b + a".
        var e3 = alloc(32);
        var p3 = fmt_int_buf(b, e3); store8(e3 + p3, 43); p3 = p3 + 1;
        p3 = p3 + fmt_int_buf(a, e3 + p3); store8(e3 + p3, 0);

        var r1 = Evaluator_eval(ev, e1);
        var err1 = eval_err(ev);
        var r2 = Evaluator_eval(ev, e2);
        var err2 = eval_err(ev);
        var r3 = Evaluator_eval(ev, e3);
        var err3 = eval_err(ev);

        if (err1 != ABACO_ERR_NONE || err2 != ABACO_ERR_NONE || err3 != ABACO_ERR_NONE) {
            println("FAIL: synthesized expr should parse");
            sys_exit(1);
        }
        if (f64_to(r1) != f64_to(r2)) {
            _fz_puts("FAIL: whitespace idempotence ");
            _fz_puts(e1); _fz_puts(" vs "); println(e2);
            sys_exit(1);
        }
        if (f64_to(r1) != f64_to(r3)) {
            _fz_puts("FAIL: commutativity a+b vs b+a for a=");
            print_num(a);
            _fz_puts(" b=");
            print_num(b);
            println("");
            sys_exit(1);
        }

        pass = pass + 1;
        iter = iter + 1;
    }

    print_num(pass);
    println(" eval fuzz iterations passed");
    return 0;
}

var r = main();
sys_exit(r);
