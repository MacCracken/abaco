# Fuzz: ntheory primitives with random i64 inputs (edges, small, medium, up to
# 2e9, and a band just below 2^63).
# Invariants (each checked on every iteration):
#   - is_prime / next_prime / totient / factor never crash.
#   - is_prime(n) agrees with trial division for n < 10^6.
#   - factor(n): every factor is prime (trial division), the list is
#     non-decreasing, and the product is n — a product-only oracle passed a
#     factor() that stopped one divisor early (2.4.9 audit).
#   - totient(n) equals n * prod(1 - 1/p) over factor(n)'s distinct primes.
#   - next_prime(n) is prime, > n, and minimal (no prime strictly between).
#   - near 2^63, next_prime(n) returns: 0 exactly when n >= 2^63 - 25,
#     otherwise the smallest prime above n.
#   - abaco_binomial obeys Pascal's rule whenever all three terms fit.
#   - 2.5.2: n built from 2-4 known primes (next_prime of random seeds, small,
#     just past ABACO_FACTOR_TRIAL, and up to ~2^31.5, so most products go
#     through Pollard-Brent rho): factor(n) is exactly those primes, sorted,
#     and totient(n) equals the product formula over them. The answer is known
#     by construction, so the oracle never calls factor().
#   - 2.6.0: tau, sigma and mu against brute force for n < 2000; lambda and
#     the least primitive root against element orders for n < 200; tau, mu,
#     sigma and lambda multiplicative on coprime a, b < 2^31; mod_inverse Err
#     exactly when gcd != 1, else a * x = 1 checked by bayan_u64_mulmod; crt
#     recovering a known x, and against brute force on two small moduli;
#     jacobi equal to Euler's criterion at a random prime, and multiplicative in
#     the modulus; r^k <= n < (r+1)^k for iroot; is_perfect_power(m^k) = 1.

include "lib/args.cyr"

include "src/core.cyr"
include "src/ntheory.cyr"

var _fz_state = 1234567;

# Newline-free stdout write. Cyrius 6.5.x enforces call arity, and the stdlib
# `print` is `print(msg, len)` — a bare `print(cstr)` no longer compiles.
fn _fz_puts(s) {
    print(s, strlen(s));
    return 0;
}

fn _fz_rand() {
    _fz_state = _fz_state * 6364136223846793005 + 1442695040888963407;
    return _fz_state;
}

fn _fz_u(m) {
    var r = _fz_rand();
    if (r < 0) { r = 0 - r; }
    return r % m;
}

fn _fz_n() {
    # Bias toward edges: small, large, near u64 boundaries.
    var kind = _fz_u(10);
    if (kind == 0) { return 0; }
    if (kind == 1) { return 1; }
    if (kind == 2) { return 2; }
    if (kind < 5)  { return _fz_u(1000); }              # small
    if (kind < 8)  { return _fz_u(10000000); }          # medium
    if (kind == 8) { return 9223372036854775807 - _fz_u(4096); }   # top of i64
    return _fz_u(2000000000);                           # large but bounded
}

fn trial_prime(n) {
    if (n < 2) { return 0; }
    if (n == 2) { return 1; }
    if ((n % 2) == 0) { return 0; }
    var d = 3;
    while ((d * d) <= n) {
        if ((n % d) == 0) { return 0; }
        d = d + 2;
    }
    return 1;
}

# A prime of a random size class: small (below the trial bound), just past
# it, or large (~2^24 to ~2^31.5).
fn _fz_prime() {
    var k = _fz_u(3);
    if (k == 0) { return next_prime(_fz_u(8191)); }
    if (k == 1) { return next_prime(8191 + _fz_u(2097152)); }
    return next_prime(16777216 + _fz_u(3020000000));
}

# n from 2-4 known primes (while the product fits in i64): factor(n) must be
# exactly those primes sorted, and totient(n) the product formula over them.
fn _fz_check_constructed() {
    var ps[32];
    var k = 2 + _fz_u(3);
    var n = 1;
    var cnt = 0;
    while (cnt < k) {
        var p = _fz_prime();
        if (p > 9223372036854775807 / n) { break; }
        n = n * p;
        store64(&ps + cnt * 8, p);
        cnt = cnt + 1;
    }
    var i = 1;
    while (i < cnt) {
        var v = load64(&ps + i * 8);
        var j = i - 1;
        while (j >= 0 && load64(&ps + j * 8) > v) {
            store64(&ps + j * 8 + 8, load64(&ps + j * 8));
            j = j - 1;
        }
        store64(&ps + j * 8 + 8, v);
        i = i + 1;
    }
    var fs = factor(n);
    var same = 1;
    if (vec_len(fs) != cnt) { same = 0; }
    i = 0;
    while (same == 1 && i < cnt) {
        if (vec_get(fs, i) != load64(&ps + i * 8)) { same = 0; }
        i = i + 1;
    }
    if (same == 0) {
        _fz_puts("FAIL: factor("); print_num(n); _fz_puts(") is not the primes it was built from");
        println(""); sys_exit(1);
    }
    var phi = n;
    var prev = 0;
    i = 0;
    while (i < cnt) {
        var q = load64(&ps + i * 8);
        if (q != prev) { phi = phi / q * (q - 1); }
        prev = q;
        i = i + 1;
    }
    if (totient(n) != phi) {
        _fz_puts("FAIL: totient("); print_num(n); _fz_puts(") = "); print_num(totient(n));
        _fz_puts(" but its primes give "); print_num(phi); println(""); sys_exit(1);
    }
    return 0;
}

# ---- 2.6.0: modular arithmetic, integer roots, multiplicative functions ----

# Brute-force oracles, independent of src/ntheory.cyr's factorisation.
fn _bf_tau(n) {
    var t = 0;
    var d = 1;
    while (d <= n) { if (n % d == 0) { t = t + 1; } d = d + 1; }
    return t;
}
fn _bf_sigma(n) {
    var s = 0;
    var d = 1;
    while (d <= n) { if (n % d == 0) { s = s + d; } d = d + 1; }
    return s;
}
fn _bf_mu(n) {
    var m = n;
    var k = 0;
    var d = 2;
    while (d <= m) {
        if (m % d == 0) {
            m = m / d;
            if (m % d == 0) { return 0; }
            k = k + 1;
        }
        d = d + 1;
    }
    if (k % 2 == 1) { return 0 - 1; }
    return 1;
}
# Multiplicative order of a mod n (gcd(a, n) = 1, n >= 2), by stepping.
fn _bf_order(a, n) {
    var x = a % n;
    var k = 1;
    while (x != 1) { x = x * a % n; k = k + 1; }
    return k;
}
fn _bf_phi(n) {
    var c = 0;
    var a = 1;
    while (a <= n) { if (gcd(a, n) == 1) { c = c + 1; } a = a + 1; }
    return c;
}
# lambda(n) as the lcm of every unit's order (n >= 2).
fn _bf_lambda(n) {
    var l = 1;
    var a = 1;
    while (a < n) {
        if (gcd(a, n) == 1) {
            var o = _bf_order(a, n);
            l = l / gcd(l, o) * o;
        }
        a = a + 1;
    }
    return l;
}
# Least g whose order is phi(n), or 0 when none (n >= 2).
fn _bf_proot(n) {
    var ph = _bf_phi(n);
    var g = 1;
    while (g < n) {
        if (gcd(g, n) == 1 && _bf_order(g, n) == ph) { return g; }
        g = g + 1;
    }
    return 0;
}
# 1 when b^k <= n (b >= 1), overflow-free.
fn _fz_pow_le(b, k, n) {
    var p = 1;
    var i = 0;
    while (i < k) {
        if (p > n / b) { return 0; }
        p = p * b;
        i = i + 1;
    }
    return 1;
}

# Report a failed 2.6.0 check at a (and b) and exit 1.
fn _fz_bad(what, a) {
    _fz_puts("FAIL: ");
    _fz_puts(what);
    _fz_puts(" at ");
    print_num(a);
    println("");
    sys_exit(1);
    return 0;
}
fn _fz_bad2(what, a, b) {
    _fz_puts("FAIL: ");
    _fz_puts(what);
    _fz_puts(" at ");
    print_num(a);
    _fz_puts(", ");
    print_num(b);
    println("");
    sys_exit(1);
    return 0;
}

fn _fz_check_260() {
    # tau, sigma, mu against brute force for n < 2000.
    var n = 1 + _fz_u(1999);
    if (num_divisors(n) != _bf_tau(n)) { _fz_bad("num_divisors", n); }
    var st, sv = sum_divisors(n);
    if (is_ok(st) == 0 || sv != _bf_sigma(n)) { _fz_bad("sum_divisors", n); }
    if (mobius(n) != _bf_mu(n)) { _fz_bad("mobius", n); }
    # lambda and the least primitive root against orders for 2 <= n < 200.
    var s = 2 + _fz_u(198);
    if (carmichael(s) != _bf_lambda(s)) { _fz_bad("carmichael", s); }
    var pt, pv = primitive_root(s);
    var want = _bf_proot(s);
    if ((want == 0 && is_ok(pt) == 1) || (want != 0 && (is_ok(pt) == 0 || pv != want))) {
        _fz_bad("primitive_root", s);
    }
    # Multiplicativity on coprime a, b < 2^31: tau, sigma, mu, lambda.
    var a = 1 + _fz_u(2147483647);
    var b = 1 + _fz_u(2147483647);
    if (gcd(a, b) == 1) {
        var ab = a * b;
        if (num_divisors(ab) != num_divisors(a) * num_divisors(b)) {
            _fz_bad2("tau not multiplicative", a, b);
        }
        if (mobius(ab) != mobius(a) * mobius(b)) {
            _fz_bad2("mu not multiplicative", a, b);
        }
        var sat, sa = sum_divisors(a);
        var sbt, sb = sum_divisors(b);
        var sabt, sab = sum_divisors(ab);
        if (is_ok(sat) == 1 && is_ok(sbt) == 1 && sa <= 9223372036854775807 / sb) {
            if (is_ok(sabt) == 0 || sab != sa * sb) {
                _fz_bad2("sigma not multiplicative", a, b);
            }
        }
        var la = carmichael(a);
        var lb = carmichael(b);
        if (carmichael(ab) != la / gcd(la, lb) * lb) {
            _fz_bad2("lambda(ab) != lcm(lambda(a), lambda(b))", a, b);
        }
    }
    # mod_inverse: Err exactly when gcd != 1, else a * x = 1 (mod m), checked
    # with bayan_u64_mulmod (128-bit), not with mod_inverse's own arithmetic.
    var m = 1 + _fz_u(9223372036854775806);
    var x0 = _fz_rand();
    var it, iv = mod_inverse(x0, m);
    var ar = x0 % m;
    if (ar < 0) { ar = ar + m; }
    if (gcd(ar, m) == 1) {
        if (is_ok(it) == 0 || iv < 0 || iv >= m || bayan_u64_mulmod(ar, iv, m) != 1 % m) {
            _fz_bad2("mod_inverse", x0, m);
        }
    } else {
        if (is_ok(it) == 1) { _fz_bad2("mod_inverse accepted a non-unit", x0, m); }
    }
    # crt: residues of a known x for 2-4 moduli below 2^15 (lcm < 2^60); the
    # answer must be x mod lcm. Brute force decides solvability for random
    # residues on two small moduli.
    var rs[32];
    var ms[32];
    var k = 2 + _fz_u(3);
    var lcmv = 1;
    var i = 0;
    while (i < k) {
        var mi = 1 + _fz_u(32767);
        store64(&ms + i * 8, mi);
        lcmv = lcmv / gcd(lcmv, mi) * mi;
        i = i + 1;
    }
    var x = _fz_u(1152921504606846976);
    i = 0;
    while (i < k) { store64(&rs + i * 8, x % load64(&ms + i * 8)); i = i + 1; }
    var ct, cv = crt(&rs, &ms, k);
    if (is_ok(ct) == 0 || cv != x % lcmv) {
        _fz_bad("crt of the residues of a known x", x);
    }
    var m1 = 2 + _fz_u(60);
    var m2 = 2 + _fz_u(60);
    store64(&ms, m1); store64(&ms + 8, m2);
    store64(&rs, _fz_u(m1)); store64(&rs + 8, _fz_u(m2));
    var c2t, c2v = crt(&rs, &ms, 2);
    var sol = 0 - 1;
    var y = 0;
    var l2 = m1 / gcd(m1, m2) * m2;
    while (y < l2 && sol < 0) {
        if (y % m1 == load64(&rs) && y % m2 == load64(&rs + 8)) { sol = y; }
        y = y + 1;
    }
    if ((sol < 0 && is_ok(c2t) == 1) || (sol >= 0 && (is_ok(c2t) == 0 || c2v != sol))) {
        _fz_bad2("crt against brute force, moduli", m1, m2);
    }
    # jacobi at an odd prime p is Euler's criterion; and it is multiplicative
    # in the modulus.
    var p = next_prime(3 + _fz_u(2000000000));
    var ja = _fz_rand();
    var jt, jv = jacobi(ja, p);
    var e = mod_pow(_mod_floor(ja, p), (p - 1) / 2, p);
    var ew = 0;
    if (e == 1) { ew = 1; }
    if (e == p - 1) { ew = 0 - 1; }
    if (is_ok(jt) == 0 || jv != ew) { _fz_bad2("jacobi against Euler's criterion", ja, p); }
    var n1 = 2 * _fz_u(1000000) + 1;
    var n2 = 2 * _fz_u(1000000) + 1;
    var j1t, j1 = jacobi(ja, n1);
    var j2t, j2 = jacobi(ja, n2);
    var j12t, j12 = jacobi(ja, n1 * n2);
    if (j12 != j1 * j2) { _fz_bad2("jacobi not multiplicative in the modulus", n1, n2); }
    # iroot: r^k <= n < (r+1)^k; is_perfect_power of a constructed m^k is 1.
    var rn = _fz_u(9223372036854775807);
    var rk = 1 + _fz_u(64);
    var rt, rv = iroot(rn, rk);
    if (is_ok(rt) == 0 || rv < 0) { _fz_bad2("iroot refused", rn, rk); }
    if (rn >= 1) {
        if (_fz_pow_le(rv, rk, rn) == 0 || _fz_pow_le(rv + 1, rk, rn) == 1) {
            _fz_bad2("iroot bounds", rn, rk);
        }
    }
    var base = 2 + _fz_u(3037000497);
    var ex = 2;
    var pw = base * base;
    while (_fz_u(2) == 1 && pw <= 9223372036854775807 / base) { pw = pw * base; ex = ex + 1; }
    if (is_perfect_power(pw) != 1) { _fz_bad("is_perfect_power of a constructed power", pw); }
    return 0;
}

fn main() {
    alloc_init();
    args_init();

    var iters = 5000;
    if (argc() > 1) {
        var arg = argv(1);
        iters = 0;
        var ai = 0;
        while (load8(arg + ai) != 0) {
            var dig = load8(arg + ai);
            # A typo must not run 0 iterations and report a pass.
            if (dig < 48 || dig > 57 || ai >= 9) {
                println("usage: <harness> [iterations, 1-999999999]");
                sys_exit(2);
            }
            iters = iters * 10 + dig - 48;
            ai = ai + 1;
        }
        if (iters <= 0) {
            println("usage: <harness> [iterations, 1-999999999]");
            sys_exit(2);
        }
    }

    var pass = 0;
    var iter = 0;
    while (iter < iters) {
        var n = _fz_n();

        var ip = is_prime(n);
        if (n >= 0) {
            if (n < 1000000) {
                var tp = trial_prime(n);
                if (ip != tp) {
                    _fz_puts("DIVERGENCE n="); print_num(n);
                    _fz_puts(" is_prime="); print_num(ip);
                    _fz_puts(" trial="); println(tp);
                    sys_exit(1);
                }
            }
        }

        # factor(n) — product must equal n for small n.
        if (n > 1 && n < 1000000) {
            var fs = factor(n);
            var fl = vec_len(fs);
            if (fl < 0) { println("FAIL: negative factor count"); sys_exit(1); }
            var product = 1;
            var fi = 0;
            while (fi < fl) {
                product = product * vec_get(fs, fi);
                fi = fi + 1;
            }
            if (product != n) {
                _fz_puts("FAIL: product(factor(");
                print_num(n);
                _fz_puts(")) = ");
                print_num(product);
                println("");
                sys_exit(1);
            }
            # Every factor prime, non-decreasing; totient from the factors.
            var phi = n;
            var prev = 0;
            fi = 0;
            while (fi < fl) {
                var fp = vec_get(fs, fi);
                if (trial_prime(fp) != 1 || fp < prev) {
                    _fz_puts("FAIL: factor("); print_num(n); _fz_puts(") has non-prime or unsorted ");
                    print_num(fp); println(""); sys_exit(1);
                }
                if (fp != prev) { phi = phi / fp * (fp - 1); }
                prev = fp;
                fi = fi + 1;
            }
            if (totient(n) != phi) {
                _fz_puts("FAIL: totient("); print_num(n); _fz_puts(") = "); print_num(totient(n));
                _fz_puts(" but the product formula gives "); print_num(phi); println(""); sys_exit(1);
            }
        }

        # next_prime(n) — must be prime, must be > n.
        if (n >= 0 && n < 1000000) {
            var np = next_prime(n);
            if (np <= n) {
                _fz_puts("FAIL: next_prime(");
                print_num(n);
                _fz_puts(") = ");
                print_num(np);
                println(" not > n");
                sys_exit(1);
            }
            if (is_prime(np) != 1) {
                _fz_puts("FAIL: next_prime(");
                print_num(n);
                _fz_puts(") = ");
                print_num(np);
                println(" not actually prime");
                sys_exit(1);
            }
            var between = n + 1;
            while (between < np) {
                if (trial_prime(between) == 1) {
                    _fz_puts("FAIL: next_prime("); print_num(n); _fz_puts(") skipped the prime ");
                    print_num(between); println(""); sys_exit(1);
                }
                between = between + 1;
            }
        }

        # Near 2^63: 0 exactly when n >= 2^63 - 25 (no larger i64 prime), else
        # the smallest prime above n — and it must return at all.
        if (n > 9223372036854771711) {
            var top = next_prime(n);
            var ok = 1;
            if (n >= 9223372036854775783) {
                if (top != 0) { ok = 0; }
            } else {
                if (top <= n || is_prime(top) != 1) { ok = 0; }
                var mid = n + 1;
                while (mid < top) {
                    if (is_prime(mid) == 1) { ok = 0; }
                    mid = mid + 1;
                }
            }
            if (ok == 0) {
                _fz_puts("FAIL: next_prime("); print_num(n); _fz_puts(") = "); print_num(top);
                println(""); sys_exit(1);
            }
        }

        # Pascal's rule for abaco_binomial wherever all three terms fit.
        var bn = _fz_u(80) + 1;
        var bk = _fz_u(bn + 1);
        if (bk >= 1) {
            var t0, c0 = abaco_binomial(bn, bk);
            var t1, c1 = abaco_binomial(bn - 1, bk - 1);
            var t2, c2 = abaco_binomial(bn - 1, bk);
            if (is_ok(t0) == 1 && is_ok(t1) == 1 && is_ok(t2) == 1) {
                if (c0 != c1 + c2) {
                    _fz_puts("FAIL: C("); print_num(bn); _fz_puts(","); print_num(bk);
                    println(") breaks Pascal's rule"); sys_exit(1);
                }
            }
            # Refused only when the result really exceeds i64: both parents fit
            # and their sum does not overflow means C(n, k) fits.
            if (is_ok(t0) == 0 && is_ok(t1) == 1 && is_ok(t2) == 1) {
                if (c1 <= 9223372036854775807 - c2) {
                    _fz_puts("FAIL: C("); print_num(bn); _fz_puts(","); print_num(bk);
                    println(") refused though it fits"); sys_exit(1);
                }
            }
        }

        # Factorisation past the trial bound, against a known answer (2.5.2).
        _fz_check_constructed();

        # Modular arithmetic, roots and multiplicative functions (2.6.0).
        _fz_check_260();

        pass = pass + 1;
        iter = iter + 1;
    }

    print_num(pass);
    println(" ntheory fuzz iterations passed");
    return 0;
}

var r = main();
sys_exit(r);
