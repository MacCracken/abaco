# Build output
/build/

# Resolved deps — `cyrius deps` vendors the pinned stdlib snapshot into
# lib/ from cyrius.cyml [deps].stdlib. It's a build artifact, not source;
# never commit it. (dist/abaco.cyr and dist/abaco.deps ARE committed — the
# consumer bundle and its stdlib sidecar.)
/lib/

# CI bench artifact — the "Bench (non-fatal)" step tees its output to
# bench-results.txt in the repo root. Ephemeral on a runner, but it dirties a
# local tree whenever the step is run by hand and would ride along on a
# `git add -A`. The tracked benchmark trail is bench-history.csv, written by
# scripts/bench-history.sh.
/bench-results.txt

