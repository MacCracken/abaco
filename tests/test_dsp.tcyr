include "src/core.cyr"
include "src/ntheory.cyr"
include "src/dsp.cyr"

# Helper: check f64 value is within tolerance of expected (as integers scaled by 1000)
# Multiply both by scale, convert to int, check abs diff <= tolerance
fn assert_f64_near(val, expected, tol_thousandths, name) {
    # f64_to(NaN) is 0 from Cyrius 6.6.8, so without this a NaN passed every
    # row expecting ~0 (2.4.9 audit); a NaN matches only a NaN expectation.
    if (f64_eq(val, val) == 0) {
        assert(f64_eq(expected, expected) == 0, name);
        return 0;
    }
    var scale = f64_from(1000);
    var vi = f64_to(f64_mul(val, scale));
    var ei = f64_to(f64_mul(expected, scale));
    var diff = vi - ei;
    if (diff < 0) { diff = 0 - diff; }
    assert(diff <= tol_thousandths, name);
    return 0;
}

fn test_angular_frequency() {
    var w0 = angular_frequency(f64_from(1000), f64_from(44100));
    var freq_back = f64_div(f64_mul(w0, f64_from(44100)), DSP_TAU);
    var fb_int = f64_to(freq_back);
    assert(fb_int >= 999, "angular_freq lo");
    assert(fb_int <= 1000, "angular_freq hi");
    assert_eq(f64_to(angular_frequency(f64_from(0), f64_from(44100))), 0, "angular_freq zero");
    return 0;
}

fn test_poly_blep() {
    var zero = f64_from(0);
    var half = f64_div(f64_from(1), f64_from(2));
    var dt = f64_div(f64_from(1), f64_from(100));
    assert_eq(f64_to(poly_blep(half, dt)), 0, "blep mid zero");
    assert_eq(f64_to(poly_blep(half, zero)), 0, "blep zero dt");
    assert(f64_eq(poly_blep(f64_div(dt, f64_from(2)), dt), zero) == 0, "blep near disc");
    return 0;
}

fn test_sanitize() {
    # Bit-exact: through 2.4.8 these compared f64_to(result), and f64_to(NaN)
    # is 0, so a sanitize that returned its NaN input passed "sanitize nan".
    assert_eq(sanitize_sample(f64_from(42)), f64_from(42), "sanitize normal");
    assert_eq(sanitize_sample(0x7FF0000000000000), 0, "sanitize inf");
    assert_eq(sanitize_sample(0xFFF0000000000000), 0, "sanitize neg inf");
    assert_eq(sanitize_sample(0x7FF8000000000000), 0, "sanitize nan");
    assert_eq(sanitize_sample(f64_from(0)), 0, "sanitize zero");
    return 0;
}

fn test_clamp() {
    var lo = f64_from(0);
    var hi = f64_from(10);
    assert_eq(f64_to(f64_clamp(f64_from(5), lo, hi)), 5, "clamp mid");
    assert_eq(f64_to(f64_clamp(f64_neg(f64_from(3)), lo, hi)), 0, "clamp lo");
    assert_eq(f64_to(f64_clamp(f64_from(15), lo, hi)), 10, "clamp hi");
    return 0;
}

fn test_max_min() {
    assert_eq(f64_to(f64_max(f64_from(3), f64_from(7))), 7, "max(3,7)");
    assert_eq(f64_to(f64_min(f64_from(3), f64_from(7))), 3, "min(3,7)");
    assert_eq(f64_to(f64_max(f64_from(3), f64_from(3))), 3, "max(3,3)");
    assert_eq(f64_to(f64_min(f64_from(3), f64_from(3))), 3, "min(3,3)");
    return 0;
}

fn test_lerp() {
    var a = f64_from(0);
    var b = f64_from(100);
    assert_eq(f64_to(f64_lerp(a, b, f64_from(0))), 0, "lerp t=0");
    assert_eq(f64_to(f64_lerp(a, b, f64_from(1))), 100, "lerp t=1");
    assert_eq(f64_to(f64_lerp(a, b, f64_div(f64_from(1), f64_from(2)))), 50, "lerp t=0.5");
    return 0;
}

fn test_hypot() {
    assert_eq(f64_to(f64_hypot(f64_from(3), f64_from(4))), 5, "hypot(3,4)");
    assert_eq(f64_to(f64_hypot(f64_from(0), f64_from(5))), 5, "hypot(0,5)");
    assert_eq(f64_to(f64_hypot(f64_from(0), f64_from(0))), 0, "hypot(0,0)");
    return 0;
}

fn test_trunc_fract_round() {
    var v = f64_div(f64_from(37), f64_from(10));
    assert_eq(f64_to(f64_trunc(v)), 3, "trunc(3.7)");
    assert_eq(f64_to(f64_trunc(f64_neg(v))), 0 - 3, "trunc(-3.7)");
    assert_eq(f64_to(f64_fract(f64_from(5))), 0, "fract(5.0)");
    assert_eq(f64_to(f64_round_half_away(v)), 4, "round(3.7)");
    assert_eq(f64_to(f64_round_half_away(f64_div(f64_from(32), f64_from(10)))), 3, "round(3.2)");
    assert_eq(f64_to(f64_round_half_away(f64_neg(v))), 0 - 4, "round(-3.7)");
    return 0;
}

# Ties: abaco rounds half AWAY FROM ZERO; the Cyrius 6.5.x `f64_round` builtin
# rounds half to EVEN. Both are exercised here so a future toolchain bump can
# never silently swap one for the other (2.3.4 regression guard).
fn test_round_ties_away() {
    var half = f64_div(f64_from(1), f64_from(2));
    assert_eq(f64_to(f64_round_half_away(half)), 1, "round_half_away(0.5)");
    assert_eq(f64_to(f64_round_half_away(f64_add(f64_from(1), half))), 2, "round_half_away(1.5)");
    assert_eq(f64_to(f64_round_half_away(f64_add(f64_from(2), half))), 3, "round_half_away(2.5)");
    assert_eq(f64_to(f64_round_half_away(f64_neg(half))), 0 - 1, "round_half_away(-0.5)");
    assert_eq(f64_to(f64_round_half_away(f64_neg(f64_add(f64_from(2), half)))), 0 - 3, "round_half_away(-2.5)");
    # The builtin, for contrast — ties to even.
    assert_eq(f64_to(f64_round(half)), 0, "builtin f64_round(0.5) ties to even");
    assert_eq(f64_to(f64_round(f64_add(f64_from(2), half))), 2, "builtin f64_round(2.5) ties to even");
    return 0;
}

fn test_sign() {
    assert_eq(f64_to(f64_sign(f64_from(42))), 1, "sign(42)");
    assert_eq(f64_to(f64_sign(f64_neg(f64_from(7)))), 0 - 1, "sign(-7)");
    assert_eq(f64_to(f64_sign(f64_from(0))), 0, "sign(0)");
    return 0;
}

# ================================================================
# dB conversion tests
# ================================================================

fn test_db() {
    # amplitude_to_db(1.0) ~ 0
    assert_f64_near(amplitude_to_db(f64_from(1)), f64_from(0), 10, "db unity");
    # db_to_amplitude(0) ~ 1
    assert_f64_near(db_to_amplitude(f64_from(0)), f64_from(1), 10, "db_to_amp(0)");
    # amplitude_to_db(0.5) ~ -6.02
    var db_half = amplitude_to_db(f64_div(f64_from(1), f64_from(2)));
    var expect_neg6 = f64_neg(f64_div(f64_from(602), f64_from(100)));
    assert_f64_near(db_half, expect_neg6, 100, "db half amp");
    # db_to_amplitude(-6.02) ~ 0.5
    var amp_back = db_to_amplitude(expect_neg6);
    assert_f64_near(amp_back, f64_div(f64_from(1), f64_from(2)), 10, "amp from -6db");
    # amplitude_to_db(0) = NEG_INF
    var db_zero = amplitude_to_db(f64_from(0));
    assert_eq(db_zero, 0xFFF0000000000000, "db zero is neg inf");
    # amplitude_to_db(-1) = NEG_INF
    var db_neg = amplitude_to_db(f64_neg(f64_from(1)));
    assert_eq(db_neg, 0xFFF0000000000000, "db neg is neg inf");
    # db_gain_factor(12) ~ 1.995
    var gf = db_gain_factor(f64_from(12));
    assert_f64_near(gf, f64_div(f64_from(1995), f64_from(1000)), 10, "gain 12db");
    return 0;
}

# Round trip amplitude_to_db(db_to_amplitude(db)) == db within 0.01 dB across a
# wide range. Guards the DB_SCALE/DB_EXP encoding: the pre-2.3.2 constants had a
# product of 0.99919 (not ~1.0), so the round trip drifted ~0.081% of |db| and
# exceeded 0.01 dB for |db| >= 20 -- invisible to the small-|db| checks in
# test_db but a real defect at mixing/mastering levels. |db|=60 is the anchor.
fn test_db_roundtrip() {
    var dbs = vec_new();
    vec_push(dbs, f64_neg(f64_from(60))); vec_push(dbs, f64_neg(f64_from(20)));
    vec_push(dbs, f64_neg(f64_from(6)));  vec_push(dbs, f64_from(0));
    vec_push(dbs, f64_from(6));           vec_push(dbs, f64_from(20));
    vec_push(dbs, f64_from(60));
    var i = 0;
    while (i < vec_len(dbs)) {
        var db = vec_get(dbs, i);
        var back = amplitude_to_db(db_to_amplitude(db));
        # tol 10 thousandths = 0.01 dB (assert_f64_near scales by 1000)
        assert_f64_near(back, db, 10, "db roundtrip");
        i = i + 1;
    }
    return 0;
}

# ================================================================
# MIDI tests
# ================================================================

fn test_midi() {
    # midi_to_freq(69) = 440
    assert_f64_near(midi_to_freq(DSP_A4_MIDI), DSP_A4_FREQ, 10, "midi A4");
    # midi_to_freq(60) ~ 261.63
    var c4 = midi_to_freq(f64_from(60));
    assert_f64_near(c4, f64_div(f64_from(26163), f64_from(100)), 100, "midi C4");
    # freq_to_midi(440) = 69
    assert_f64_near(freq_to_midi(DSP_A4_FREQ), DSP_A4_MIDI, 10, "freq A4");
    # Roundtrip: midi -> freq -> midi
    var note = f64_from(60);
    var freq = midi_to_freq(note);
    var back = freq_to_midi(freq);
    assert_f64_near(back, note, 1, "midi roundtrip");
    # freq_to_midi(0) = NEG_INF
    assert_eq(freq_to_midi(f64_from(0)), 0xFFF0000000000000, "freq zero neg inf");
    # freq_to_midi(-100) = NEG_INF
    assert_eq(freq_to_midi(f64_neg(f64_from(100))), 0xFFF0000000000000, "freq neg neg inf");
    return 0;
}

# ================================================================
# Time constant test
# ================================================================

fn test_time_constant() {
    # Fast attack (0.01ms): coefficient should be small (< 0.5)
    var c_fast = time_constant(f64_div(f64_from(1), f64_from(100)), f64_from(44100));
    var half = f64_div(f64_from(1), f64_from(2));
    assert(f64_lt(c_fast, half) == 1, "tc fast < 0.5");
    # Slow release (1000ms): coefficient should be high (> 0.99)
    var c_slow = time_constant(f64_from(1000), f64_from(44100));
    var high = f64_div(f64_from(99), f64_from(100));
    assert(f64_gt(c_slow, high) == 1, "tc slow > 0.99");
    return 0;
}

# ================================================================
# Panning tests
# ================================================================

fn test_pan() {
    var left = alloc(8);
    var right = alloc(8);
    # Center: L ~ R ~ 0.707
    constant_power_pan(f64_from(0), left, right);
    var l = load64(left);
    var r = load64(right);
    assert_f64_near(l, r, 10, "pan center L~R");
    assert_f64_near(l, DSP_FRAC_1_SQRT2, 10, "pan center ~0.707");
    # Full left: L ~ 1, R ~ 0
    constant_power_pan(f64_neg(f64_from(1)), left, right);
    assert_f64_near(load64(left), f64_from(1), 10, "pan left L~1");
    assert_f64_near(load64(right), f64_from(0), 10, "pan left R~0");
    # Full right: L ~ 0, R ~ 1
    constant_power_pan(f64_from(1), left, right);
    assert_f64_near(load64(left), f64_from(0), 10, "pan right L~0");
    assert_f64_near(load64(right), f64_from(1), 10, "pan right R~1");
    # Constant power: L^2 + R^2 ~ 1
    constant_power_pan(f64_div(f64_from(1), f64_from(2)), left, right);
    l = load64(left);
    r = load64(right);
    var power = f64_add(f64_mul(l, l), f64_mul(r, r));
    assert_f64_near(power, f64_from(1), 10, "pan constant power");
    # Clamp: pan=-2 same as pan=-1
    constant_power_pan(f64_neg(f64_from(2)), left, right);
    var l2 = load64(left);
    constant_power_pan(f64_neg(f64_from(1)), left, right);
    assert(f64_eq(l2, load64(left)) == 1, "pan clamp lo");
    return 0;
}

# ================================================================
# Crossfade tests
# ================================================================

fn test_crossfade() {
    var a = alloc(8);
    var b = alloc(8);
    # t=0: A=1, B=0
    equal_power_crossfade(f64_from(0), a, b);
    assert_f64_near(load64(a), f64_from(1), 10, "xfade t=0 A~1");
    assert_f64_near(load64(b), f64_from(0), 10, "xfade t=0 B~0");
    # t=1: A=0, B=1
    equal_power_crossfade(f64_from(1), a, b);
    assert_f64_near(load64(a), f64_from(0), 10, "xfade t=1 A~0");
    assert_f64_near(load64(b), f64_from(1), 10, "xfade t=1 B~1");
    # t=0.5: constant energy: A^2 + B^2 ~ 1
    equal_power_crossfade(f64_div(f64_from(1), f64_from(2)), a, b);
    var ga = load64(a);
    var gb = load64(b);
    var energy = f64_add(f64_mul(ga, ga), f64_mul(gb, gb));
    assert_f64_near(energy, f64_from(1), 10, "xfade constant energy");
    # Clamp: t=-1 same as t=0
    equal_power_crossfade(f64_neg(f64_from(1)), a, b);
    assert_f64_near(load64(a), f64_from(1), 10, "xfade clamp lo");
    return 0;
}

fn test_windows() {
    # Symmetry: hann(0, N) ~ hann(N-1, N) ~ 0 for odd N, both 0 for any N.
    assert_f64_near(window_hann(0, 64), f64_from(0), 5, "hann start 0");
    assert_f64_near(window_hann(63, 64), f64_from(0), 5, "hann end 0");
    # Peak at middle of Hann is 1.0.
    var mid = window_hann(31, 63);
    assert_f64_near(mid, f64_from(1), 5, "hann mid ~1");
    # Hamming endpoints are 0.08 (non-zero), peak near 1.
    var hstart = window_hamming(0, 64);
    var hmid = window_hamming(31, 63);
    assert(f64_lt(hstart, f64_div(f64_from(1), f64_from(10))) == 1, "hamm start small");
    assert(f64_gt(hmid, f64_div(f64_from(99), f64_from(100))) == 1, "hamm mid ~1");
    # Blackman endpoints are near zero.
    assert_f64_near(window_blackman(0, 64), f64_from(0), 5, "blk start 0");
    # Kaiser(beta=0) reduces to rectangular (all ones).
    var k0 = window_kaiser(10, 64, f64_from(0));
    assert_f64_near(k0, f64_from(1), 5, "kaiser b0 = 1");
    # Kaiser endpoints with beta=8 are small; peak is 1.
    var kstart = window_kaiser(0, 64, f64_from(8));
    var kmid = window_kaiser(31, 63, f64_from(8));
    assert(f64_lt(kstart, f64_div(f64_from(1), f64_from(10))) == 1, "kaiser b8 start small");
    assert_f64_near(kmid, f64_from(1), 10, "kaiser b8 mid ~1");
    return 0;
}

# |actual - expected| <= 1e-12 * |expected|. A NaN never passes (2.4.9 audit:
# the thousandths helper above cannot tell a window from a near miss).
fn near_rel(actual, expected, name) {
    var tol = f64_mul(f64_abs(expected), f64_div(f64_from(1), f64_from(1000000000000)));
    assert(f64_le(f64_abs(f64_sub(actual, expected)), tol) == 1, name);
    return 0;
}

# Reference values from python3 (math, and a 60-digit Decimal I0 series). The
# 2.4.9 audit injected eight bugs into the window / sinc / cubic / PolyBLEP code
# and all passed the old tests; every row here fails on such a change.
fn test_window_values() {
    near_rel(window_hann(16, 64), 0x3FE0661DB99AE82A, "hann(16,64)");
    near_rel(window_hamming(16, 64), 0x3FE1A5A0778E83AC, "hamming(16,64)");
    near_rel(window_blackman(16, 64), 0x3FD6906BEB064127, "blackman(16,64)");
    near_rel(window_kaiser(16, 64, f64_from(8)), 0x3FD86B7F4EC39A7D, "kaiser(16,64,8)");
    # Kaiser past beta ~20 needs more than the 29 I0 terms 2.4.8 summed: these
    # were 10% high at beta 50 and x147 at beta 100.
    near_rel(window_kaiser(0, 64, f64_from(50)), 0x3BB01A6EFF275407, "kaiser(0,64,50) (was +10%)");
    near_rel(window_kaiser(16, 64, f64_from(50)), 0x3F5B28C176E0DC15, "kaiser(16,64,50) (was +9%)");
    near_rel(window_kaiser(16, 64, f64_from(100)), 0x3EC57EAF9C95CF6F, "kaiser(16,64,100) (was x147)");
    # window_kaiser_fill must agree with the per-sample generator.
    var w = alloc(9 * 8);
    store64(w + 8 * 8, 0x7FF4_0000_DEAD_0001);
    window_kaiser_fill(w, 8, f64_from(14));
    var i = 0;
    var bad = 0;
    while (i < 8) {
        if (load64(w + i * 8) != window_kaiser(i, 8, f64_from(14))) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "kaiser_fill == window_kaiser per sample");
    assert_eq(load64(w + 8 * 8), 0x7FF4_0000_DEAD_0001, "kaiser_fill writes exactly size samples");
    return 0;
}

fn test_window_bounds() {
    # Outside [0, size) is 0 (2.4.8: wrapped-around nonzero values, or NaN).
    assert_eq(window_hann(64, 64), 0, "hann n = size is 0 (was 0.0025)");
    assert_eq(window_hann(0 - 1, 64), 0, "hann n = -1 is 0 (was 0.0025)");
    assert_eq(window_hann(3, 3), 0, "hann(3, 3) is 0 (was 1.0)");
    assert_eq(window_hamming(5, 3), 0, "hamming past the end is 0 (was 1.0)");
    assert_eq(window_blackman(65, 64), 0, "blackman past the end is 0");
    assert_eq(window_kaiser(64, 64, f64_from(8)), 0, "kaiser n = size is 0 (was NaN)");
    assert_eq(window_hann(2, 0 - 5), 0, "negative size is empty (was 1.0)");
    assert_eq(window_kaiser(0, 0, f64_from(8)), 0, "size 0 is empty");
    # A one-sample window is [1].
    assert_eq(window_hann(0, 1), f64_from(1), "hann(0,1) = 1");
    assert_eq(window_kaiser(0, 1, f64_from(8)), f64_from(1), "kaiser(0,1) = 1");
    return 0;
}

fn test_interp_values() {
    near_rel(f64_cubic(f64_from(0), f64_from(1), f64_from(4), f64_from(9), f64_div(f64_from(1), f64_from(2))),
      f64_div(f64_from(9), f64_from(4)), "cubic(0,1,4,9,0.5) = 2.25");
    near_rel(f64_cubic(f64_from(1), f64_from(3), f64_from(2), f64_from(5), f64_div(f64_from(1), f64_from(4))),
      0x4006F00000000000, "cubic(1,3,2,5,0.25) = 2.8671875");
    var dt = f64_div(f64_from(1), f64_from(100));
    near_rel(poly_blep(f64_div(f64_from(1), f64_from(200)), dt), f64_neg(f64_div(f64_from(1), f64_from(4))),
      "poly_blep just past the edge = -0.25");
    near_rel(poly_blep(f64_div(f64_from(199), f64_from(200)), dt), 0x3FCFFFFFFFFFFFF0,
      "poly_blep just before the edge = 0.25");
    near_rel(sinc_kernel(f64_div(f64_from(3), f64_from(2)), f64_from(4)), 0xBFC2C74DC47E428F,
      "sinc_kernel(1.5, 4)");
    # Degenerate kernels and huge arguments (2.4.8: NaN).
    assert_eq(sinc_kernel(f64_from(0), f64_from(0)), 0, "sinc_kernel half_width 0 is 0 (was NaN)");
    assert_eq(sinc_kernel(f64_from(0), f64_from(0 - 4)), 0, "sinc_kernel negative half_width is 0");
    assert_eq(sinc_kernel(f64_from(0), 0x7FF0000000000000), f64_from(1), "sinc_kernel(0, +Inf) = 1 (was NaN)");
    assert_eq(f64_sinc(0x4340000000000000), 0, "sinc(2^53) = 0 (was NaN)");
    assert_eq(f64_sinc(0x7FF0000000000000), 0, "sinc(+Inf) = 0 (was NaN)");
    assert(f64_eq(f64_sinc(0x7FF8000000000000), f64_sinc(0x7FF8000000000000)) == 0, "sinc(NaN) is NaN");
    return 0;
}

# f64_round_half_away is the evaluator's round(). Through 2.4.8 it was
# floor(x + 0.5), and the addition itself rounds.
fn test_round_edges() {
    assert_eq(f64_round_half_away(0x3FDFFFFFFFFFFFFF), 0, "round(0.49999999999999994) = 0 (was 1)");
    assert_eq(f64_round_half_away(0xBFDFFFFFFFFFFFFF), 0x8000000000000000,
      "round(-0.49999999999999994) = -0 (was -1)");
    assert_eq(f64_round_half_away(0x4330000000000001), 0x4330000000000001,
      "round(2^52 + 1) is itself (was 2^52 + 2)");
    assert_eq(f64_round_half_away(0xC330000000000001), 0xC330000000000001, "round(-(2^52 + 1)) is itself");
    assert_eq(f64_round_half_away(f64_neg(f64_div(f64_from(3), f64_from(10)))), 0x8000000000000000,
      "round(-0.3) = -0");
    assert_eq(f64_round_half_away(0x8000000000000000), 0x8000000000000000, "round(-0) = -0");
    assert_eq(f64_round_half_away(0x7FF0000000000000), 0x7FF0000000000000, "round(+Inf) = +Inf");
    var n = f64_round_half_away(0x7FF8000000000000);
    assert(f64_eq(n, n) == 0, "round(NaN) is NaN");
    assert_eq(f64_round_half_away(f64_div(f64_from(5), f64_from(2))), f64_from(3), "round(2.5) = 3 still");
    assert_eq(f64_round_half_away(f64_div(f64_from(0 - 5), f64_from(2))), f64_from(0 - 3), "round(-2.5) = -3 still");
    return 0;
}

# The three dB constants were each 1 ulp off their correctly rounded values
# through 2.4.8 (CHANGELOG 2.4.9); pinned against an 80-digit derivation.
fn test_db_constants_exact() {
    assert_eq(DB_SCALE, 0x40215F2CED384F29, "DB_SCALE = 20/ln 10, correctly rounded");
    assert_eq(DB_EXP, 0x3FBD791C5F888822, "DB_EXP = ln 10/20, correctly rounded");
    assert_eq(DB_GAIN_EXP, 0x3FAD791C5F888822, "DB_GAIN_EXP = ln 10/40, correctly rounded");
    return 0;
}

fn test_nan_and_domain() {
    var nan = 0x7FF8000000000000;
    var r = amplitude_to_db(nan);
    assert(f64_eq(r, r) == 0, "amplitude_to_db(NaN) is NaN (was -Inf, i.e. silence)");
    r = freq_to_midi(nan);
    assert(f64_eq(r, r) == 0, "freq_to_midi(NaN) is NaN (was -Inf)");
    assert_eq(amplitude_to_db(f64_from(0 - 1)), 0xFFF0000000000000, "amplitude_to_db(-1) is still -Inf");
    # dBFS uses |a|, as documented (2.4.8: -Inf for any negative sample).
    var half = f64_div(f64_from(1), f64_from(2));
    assert_eq(amplitude_to_dbfs(f64_neg(half)), amplitude_to_dbfs(half), "dBFS(-0.5) = dBFS(0.5) (was -Inf)");
    # time_constant takes f64 Hz. An integer rate is a ~1e-319 Hz subnormal, and
    # through 2.4.8 it — and NaN — silently gave the one-sample exp(-1).
    near_rel(time_constant(f64_from(10), f64_from(44100)), 0x3FEFED71F0DD5FBD, "time_constant(10 ms, 44.1 kHz)");
    r = time_constant(f64_from(10), 44100);
    assert(f64_eq(r, r) == 0, "time_constant with an integer sample rate is NaN (was exp(-1))");
    r = time_constant(nan, f64_from(44100));
    assert(f64_eq(r, r) == 0, "time_constant(NaN ms) is NaN (was exp(-1))");
    r = time_constant(f64_from(0 - 5), f64_from(44100));
    assert(f64_eq(r, r) == 0, "time_constant(-5 ms) is NaN");
    near_rel(time_constant(f64_from(0), f64_from(44100)), 0x3FD78B56362CEF38, "time_constant(0 ms) clamps to one sample");
    # rms2 through hypot (2.4.8 squared first: +Inf and 0 here).
    near_rel(f64_rms2(0x6974E718D7D7625A, 0x6974E718D7D7625A), 0x6974E718D7D7625A, "rms2(1e200, 1e200) = 1e200");
    near_rel(f64_rms2(0x16687E92154EF7AC, 0x16687E92154EF7AC), 0x16687E92154EF7AC, "rms2(1e-200, 1e-200) = 1e-200");
    return 0;
}

fn test_interpolation() {
    # Cubic should pass through b at t=0 and through c at t=1.
    var a = f64_from(0);
    var b = f64_from(1);
    var c = f64_from(2);
    var d = f64_from(3);
    assert_f64_near(f64_cubic(a, b, c, d, f64_from(0)), b, 5, "cubic t=0 = b");
    assert_f64_near(f64_cubic(a, b, c, d, f64_from(1)), c, 5, "cubic t=1 = c");
    # For equally spaced collinear data cubic = lerp, t=0.5 -> 1.5.
    var half = f64_div(f64_from(1), f64_from(2));
    var three_halves = f64_div(f64_from(3), f64_from(2));
    assert_f64_near(f64_cubic(a, b, c, d, half), three_halves, 10, "cubic linear midpoint");
    # sinc(0) = 1.
    assert_f64_near(f64_sinc(f64_from(0)), f64_from(1), 5, "sinc 0 = 1");
    # sinc(1) = 0.
    assert_f64_near(f64_sinc(f64_from(1)), f64_from(0), 5, "sinc 1 = 0");
    # sinc_kernel outside half-width is 0.
    var zero = f64_from(0);
    assert_f64_near(sinc_kernel(f64_from(5), f64_from(4)), zero, 5, "sinc_kernel out");
    # At x=0 kernel equals Hann envelope midpoint which ~= 1 * 1 = 1.
    var kv = sinc_kernel(zero, f64_from(4));
    assert_f64_near(kv, f64_from(1), 10, "sinc_kernel 0");
    return 0;
}

fn test_chromagram() {
    # A4 (440 Hz) -> pitch class 9 (A).
    assert_eq(freq_to_pitch_class(DSP_A4_FREQ), 9, "A4 is A");
    # C4 = 261.625 Hz -> pitch class 0 (C).
    var c4 = f64_div(f64_from(2616250), f64_from(10000));
    assert_eq(freq_to_pitch_class(c4), 0, "C4 is C");
    # E5 -> pitch class 4.
    var e5 = f64_div(f64_from(6593000), f64_from(10000));
    assert_eq(freq_to_pitch_class(e5), 4, "E5 is E");
    # Negative / zero freq -> -1.
    assert_eq(freq_to_pitch_class(f64_from(0)), 0 - 1, "pc zero = -1");
    # Non-finite freq -> -1. +Inf leaned on x86's f64_to answering i64_MIN;
    # Cyrius 6.6.8+ saturates it to i64_MAX instead (CHANGELOG 2.4.7).
    assert_eq(freq_to_pitch_class(0x7FF0000000000000), 0 - 1, "pc +Inf = -1 (was 7)");
    assert_eq(freq_to_octave(0x7FF0000000000000), 0 - 1,
      "oct +Inf = -1 (was 768614336404564650)");
    assert_eq(freq_to_pitch_class(0x7FF8000000000000), 0 - 1, "pc NaN = -1");
    # Octave: A4 is octave 4.
    assert_eq(freq_to_octave(DSP_A4_FREQ), 4, "A4 oct 4");
    # DSP_C0_FREQ is the module's own MIDI 12. Through 2.4.7 it encoded
    # 16.703125 Hz, 2% sharp, so every pitch class ran 0.368 semitone flat and
    # a tone ~0.13 semitone flat of a note read as the note below (CHANGELOG
    # 2.4.8). The first row is what catches the bad constant; C0 reading as C0
    # holds under either, being true by definition.
    var c0_rel = f64_abs(f64_div(f64_sub(midi_to_freq(f64_from(12)), DSP_C0_FREQ), DSP_C0_FREQ));
    assert(f64_lt(c0_rel, f64_div(f64_from(1), f64_from(1000000000000))) == 1,
      "DSP_C0_FREQ = midi_to_freq(12) to 1e-12 (was 2% off)");
    assert_eq(freq_to_pitch_class(DSP_C0_FREQ), 0, "C0 is C");
    assert_eq(freq_to_octave(DSP_C0_FREQ), 0, "C0 is octave 0");
    assert_eq(freq_to_pitch_class(f64_from(435)), 9, "435 Hz (A4 - 0.20 st) is A (was G#)");
    assert_eq(freq_to_pitch_class(f64_from(455)), 10, "455 Hz (A4 + 0.58 st) is A# (was A)");
    assert_eq(freq_to_pitch_class(f64_from(257)), 0, "257 Hz (C4 - 0.31 st) is C (was B)");
    assert_eq(freq_to_octave(f64_from(257)), 4, "257 Hz is octave 4 (was 3)");
    assert_eq(freq_to_pitch_class(f64_from(16)), 0, "16 Hz rounds to C0 (was -1, below C0)");
    # Over-reach guards: sharp by under half a semitone, and whole octaves.
    assert_eq(freq_to_pitch_class(f64_from(447)), 9, "447 Hz (A4 + 0.27 st) is still A");
    assert_eq(freq_to_octave(f64_div(f64_from(55), f64_from(2))), 0, "A0 (27.5 Hz) is octave 0");
    assert_eq(freq_to_octave(f64_from(4186)), 8, "C8 (4186 Hz) is octave 8");
    # Names.
    assert(streq(pitch_class_name(0), "C") == 1, "name C");
    assert(streq(pitch_class_name(9), "A") == 1, "name A");
    assert(streq(pitch_class_name(11), "B") == 1, "name B");
    return 0;
}

fn test_dbfs() {
    assert_f64_near(amplitude_to_dbfs(f64_from(1)), f64_from(0), 10, "unity = 0 dBFS");
    assert_f64_near(dbfs_to_amplitude(f64_from(0)), f64_from(1), 10, "0 dBFS = unity");
    var half_dbfs = amplitude_to_dbfs(f64_div(f64_from(1), f64_from(2)));
    var expect = f64_neg(f64_div(f64_from(602), f64_from(100)));
    assert_f64_near(half_dbfs, expect, 100, "half = -6.02 dBFS");
    var amp = f64_div(f64_from(3), f64_from(4));
    var back = dbfs_to_amplitude(amplitude_to_dbfs(amp));
    assert_f64_near(back, amp, 10, "dBFS round trip");
    return 0;
}

fn test_audio_conv() {
    # 1 sample at 1000 Hz = 1 ms.
    assert_f64_near(samples_to_ms(f64_from(1), f64_from(1000)), f64_from(1), 5, "1 sample @ 1kHz = 1ms");
    # 441 samples at 44100 Hz = 10 ms.
    assert_f64_near(samples_to_ms(f64_from(441), f64_from(44100)), f64_from(10), 5, "441 smp @ 44.1k");
    # Round trip.
    var ms = f64_from(23);
    var sr = f64_from(48000);
    var back = samples_to_ms(ms_to_samples(ms, sr), sr);
    assert_f64_near(back, ms, 5, "samples<->ms round trip");
    # BPM <-> Hz.
    assert_f64_near(bpm_to_hz(f64_from(120)), f64_from(2), 5, "120 bpm = 2 Hz");
    assert_f64_near(hz_to_bpm(f64_from(1)), f64_from(60), 5, "1 Hz = 60 bpm");
    return 0;
}

fn main() {
    alloc_init();
    println("=== abaco dsp tests ===");
    test_angular_frequency();
    test_poly_blep();
    test_sanitize();
    test_clamp();
    test_max_min();
    test_lerp();
    test_hypot();
    test_trunc_fract_round();
    test_round_ties_away();
    test_sign();
    test_db();
    test_db_roundtrip();
    test_midi();
    test_time_constant();
    test_pan();
    test_crossfade();
    test_windows();
    test_interpolation();
    test_chromagram();
    test_audio_conv();
    test_dbfs();
    test_window_values();
    test_window_bounds();
    test_interp_values();
    test_round_edges();
    test_db_constants_exact();
    test_nan_and_domain();
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
