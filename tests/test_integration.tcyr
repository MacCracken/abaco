# abaco — end-to-end integration tests.
# Exercise full flows: nl_parse -> Evaluator / UnitRegistry -> history.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/hashmap.cyr"
include "lib/fnptr.cyr"
include "lib/math.cyr"
include "lib/io.cyr"
include "lib/net.cyr"
include "lib/http.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

include "src/core.cyr"
include "src/ntheory.cyr"
include "src/dsp.cyr"
include "src/eval.cyr"
include "src/units.cyr"
include "src/ai.cyr"

# NL input -> Evaluator, then push into history.
fn test_nl_to_eval_to_history() {
    var ev = Evaluator_new();
    var h = CalcHistory_new(10);

    var q = nl_parse("what is 2 + 3 * 4");
    assert(q != 0, "nl parsed");
    assert_eq(pq_kind(q), PQ_CALCULATION, "kind = calc");

    var result = Evaluator_eval(ev, pq_s1(q));
    assert_eq(eval_err(ev), ABACO_ERR_NONE, "eval clean");
    assert_eq(f64_to(result), 14, "14");

    CalcHistory_push(h, pq_s1(q), "14", "2026-04-14T00:00:00Z");
    assert_eq(CalcHistory_len(h), 1, "history len 1");
    return 0;
}

# Percent-of expansion actually evaluates.
fn test_percent_of_end_to_end() {
    var q = nl_parse("what is 15% of 230");
    assert(q != 0, "pct parsed");
    var ev = Evaluator_new();
    var r = Evaluator_eval(ev, pq_s1(q));
    assert_eq(eval_err(ev), ABACO_ERR_NONE, "eval pct clean");
    assert_eq(f64_to(r), 34, "15% of 230 = 34 (trunc)");
    return 0;
}

# NL conversion -> UnitRegistry.
fn test_nl_to_units() {
    var q = nl_parse("convert 100 celsius to fahrenheit");
    assert(q != 0, "conv parsed");
    assert_eq(pq_kind(q), PQ_CONVERSION, "kind = conversion");

    var reg = UnitRegistry_new();
    var result = UnitRegistry_convert(reg, pq_value(q), pq_s1(q), pq_s2(q));
    assert_eq(reg_err(reg), UERR_NONE, "conv clean");
    assert_eq(f64_to(result), 212, "100C = 212F");
    return 0;
}

# NL conversion with plural + alias.
fn test_nl_multiword_alias() {
    var q = nl_parse("convert 60 miles per hour to meters per second");
    assert(q != 0, "multi-word parsed");
    assert_eq(pq_kind(q), PQ_CONVERSION, "kind = conversion");
    var reg = UnitRegistry_new();
    var result = UnitRegistry_convert(reg, pq_value(q), pq_s1(q), pq_s2(q));
    assert_eq(reg_err(reg), UERR_NONE, "multi-word conv clean");
    # 60 mph ≈ 26.8 m/s; integer truncation = 26.
    assert_eq(f64_to(result), 26, "60 mph ~ 27 m/s");
    return 0;
}

# NL currency -> CurrencyCache.
fn test_nl_to_currency() {
    var q = nl_parse("100 usd to eur");
    assert(q != 0, "ccy parsed");
    assert_eq(pq_kind(q), PQ_CURRENCY, "kind = currency");

    var c = CurrencyCache_new("http://localhost:8088");
    var rates = map_new();
    map_set(rates, "EUR", f64_div(f64_from(92), f64_from(100)));
    CurrencyCache_set_rates(c, "USD", rates);

    var r = CurrencyCache_convert(c, pq_value(q), pq_s1(q), pq_s2(q));
    assert(r != 0, "ccy convert ok");
    assert_eq(f64_to(cr_to_value(r)), 92, "100 USD = 92 EUR");
    return 0;
}

# Variables persist across multiple eval calls.
fn test_variable_persistence() {
    var ev = Evaluator_new();
    Evaluator_set_variable(ev, "pi_sq", Evaluator_eval(ev, "pi * pi"));
    var r = Evaluator_eval(ev, "pi_sq + 1");
    # pi^2 ≈ 9.87, + 1 ≈ 10.87. truncated = 10.
    assert_eq(f64_to(r), 10, "var survives eval");
    return 0;
}

# History round-trip: push -> to_json -> from_json -> verify.
fn test_history_roundtrip_with_eval() {
    var ev = Evaluator_new();
    var h = CalcHistory_new(5);
    CalcHistory_push(h, "2 + 3", "5", "t0");
    CalcHistory_push(h, "10 * 10", "100", "t1");
    var s = CalcHistory_to_json(h);
    var cstr_len = str_len(s);
    var cbuf = alloc(cstr_len + 1);
    memcpy(cbuf, str_data(s), cstr_len);
    store8(cbuf + cstr_len, 0);
    var h2 = CalcHistory_new(5);
    assert_eq(CalcHistory_from_json(h2, cbuf), 0, "load clean");
    assert_eq(CalcHistory_len(h2), 2, "2 entries");
    # Re-evaluate the reloaded input — should match the stored result.
    var e = CalcHistory_get(h2, 0);
    var r = Evaluator_eval(ev, he_input(e));
    assert_eq(f64_to(r), 5, "reloaded input still evaluates correctly");
    return 0;
}

# DSP + units: convert 120 bpm to Hz, compare to bpm_to_hz helper.
fn test_bpm_two_ways() {
    var reg = UnitRegistry_new();
    var via_reg = UnitRegistry_convert(reg, f64_from(120), "bpm", "Hz");
    var via_dsp = bpm_to_hz(f64_from(120));
    assert_eq(f64_to(via_reg), f64_to(via_dsp), "bpm_to_hz matches registry");
    assert_eq(f64_to(via_reg), 2, "both = 2");
    return 0;
}

# Unparseable NL -> 0; doesn't crash pipeline.
fn test_unparseable_safe() {
    var q = nl_parse("hello world");
    assert_eq(q, 0, "unparseable returns 0");
    return 0;
}

fn test_value_to_latex() {
    # Value_to_latex had NO coverage before 2.4.4 despite being exported in
    # dist/abaco.cyr. Every non-whole float printed only its integer part, and
    # every non-finite printed i64_MIN as a literal.
    var q = f64_div(f64_from(1), f64_from(4));

    # Fractions survive. Through 2.4.3 all three of these rendered as "0"/"3".
    assert_streq(Value_to_latex(Value_float(q)), "0.250000", "0.25 keeps its fraction (was \"0\")");
    assert_streq(Value_to_latex(Value_float(f64_neg(q))), "-0.250000",
      "-0.25 keeps fraction AND sign (was \"0\")");
    assert_streq(Value_to_latex(Value_float(f64_div(f64_from(15), f64_from(4)))), "3.750000",
      "3.75 keeps its fraction (was \"3\")");

    # Whole floats keep the N.0 form — untouched by the fix.
    assert_streq(Value_to_latex(Value_float(f64_from(3))), "3.0", "3.0 stays N.0");
    assert_streq(Value_to_latex(Value_float(f64_from(0 - 3))), "-3.0", "-3.0 stays N.0");
    assert_streq(Value_to_latex(Value_integer(42)), "42", "integers unchanged");

    # Non-finite. f64_to saturates to i64_MIN for all three, which fmt_int_buf
    # printed verbatim as -9223372036854775808.
    assert_streq(Value_to_latex(Value_float(0x7FF0000000000000)), "{\\infty}",
      "+Inf is {\\infty} (was -9223372036854775808)");
    assert_streq(Value_to_latex(Value_float(0xFFF0000000000000)), "{-\\infty}",
      "-Inf is {-\\infty} (was -9223372036854775808)");
    assert_streq(Value_to_latex(Value_float(0x7FF8000000000000)), "\\mathrm{NaN}",
      "NaN is \\mathrm{NaN} (was -9223372036854775808)");

    # Finite but outside the range fixed notation can show. 1e300 is finite, so
    # the non-finite guard does not catch it, and lib/fmt.cyr's fmt_float_buf
    # saturates on it too — hence the scientific path.
    assert_streq(Value_to_latex(Value_float(0x7E37E43C8800759C)), "1.000000 \\times 10^{300}",
      "1e300 goes scientific (was -9223372036854775808)");
    assert_streq(Value_to_latex(Value_float(0xFE37E43C8800759C)), "-1.000000 \\times 10^{300}",
      "-1e300 keeps its sign through the scientific path");
    assert_streq(Value_to_latex(Value_float(0x3E7AD7F29ABCAF48)), "1.000000 \\times 10^{-7}",
      "1e-7 goes scientific rather than rendering as 0.000000");
    # The mantissa must not come back as 10.000000 x 10^{299}: v/10^e lands a
    # hair under 10 for 1e300, and a naive [1,10) renormalisation cancels itself.
    assert_streq(Value_to_latex(Value_float(0x4341C37937E08000)), "1.000000 \\times 10^{16}",
      "1e16, exactly at the threshold, normalises to a 1.x mantissa");

    # Complex carried the same truncation, and its sign test read a truncated
    # i64 — so a small negative imaginary part took the "+" arm.
    assert_streq(Value_to_latex(Value_complex(f64_div(f64_from(3), f64_from(2)),
          f64_div(f64_from(5), f64_from(2)))), "1.500000 + 2.500000i",
      "complex keeps both fractions (was \"1 + 2i\")");
    assert_streq(Value_to_latex(Value_complex(f64_from(0), f64_neg(q))), "0.000000 - 0.250000i",
      "small negative imaginary takes the minus arm (was \"0 + 0i\")");

    # A complex part outside fixed notation's range needs the SAME treatment as
    # a bare float. 2.4.4's first cut routed only the FLOAT branch through the
    # scientific path, so a 1e300 part still printed i64_MIN here and a 1e-9 one
    # printed 0.000000 — the very bug the release claims to close.
    assert_streq(Value_to_latex(Value_complex(0x7E37E43C8800759C, f64_from(1))),
      "1.000000 \\times 10^{300} + 1.000000i", "large complex part goes scientific too");
    assert_streq(Value_to_latex(Value_complex(0x3E112E0BE826D695, f64_from(1))),
      "1.000000 \\times 10^{-9} + 1.000000i", "tiny complex part goes scientific too");
    assert_streq(Value_to_latex(Value_complex(0x7FF0000000000000, f64_from(1))),
      "{\\infty} + 1.000000i", "non-finite complex part gets the LaTeX symbol");

    # The TEXT branch memcpy'd a caller-controlled string into this 128-byte
    # buffer unbounded. 400 bytes in must not run off the allocation.
    var big = alloc(512);
    var bi = 0;
    while (bi < 400) { store8(big + bi, 65); bi = bi + 1; }
    store8(big + 400, 0);
    assert_lte(strlen(Value_to_latex(Value_text(big))), 127,
      "TEXT is truncated to the buffer, not written past it");

    # TeX scans a control word greedily over letters, so a bare \\infty followed
    # by the imaginary unit is the single undefined macro \\inftyi and the
    # document fails to typeset. Braces terminate it.
    assert_streq(Value_to_latex(Value_complex(f64_from(1), 0x7FF0000000000000)),
      "1.000000 + {\\infty}i", "infinite imaginary part is braced, not \\inftyi");
    assert_streq(Value_to_latex(Value_complex(f64_from(1), 0xFFF0000000000000)),
      "1.000000 - {\\infty}i", "negative infinite imaginary part too");

    # f64_lt(-0, 0) is 0, so a negative-zero imaginary part took the "+" arm
    # while keeping its sign bit, and fmt_float_buf added its own "-".
    assert_streq(Value_to_latex(Value_complex(f64_from(1), 0x8000000000000000)),
      "1.000000 - 0.000000i", "negative-zero imaginary does not print \"+ -\"");

    # f64_pow(10, e) underflows to +0 for e <= -324, so dividing by it gave Inf
    # and the two smallest subnormals printed as infinity.
    assert_streq(Value_to_latex(Value_float(0x0000000000000001)),
      "4.940656 \\times 10^{-324}", "smallest subnormal is finite, not inf");
    assert_streq(Value_to_latex(Value_float(0x0000000000000002)),
      "9.881313 \\times 10^{-324}", "second subnormal likewise");
    return 0;
}

fn main() {
    alloc_init();
    println("=== abaco integration tests ===");
    test_nl_to_eval_to_history();
    test_percent_of_end_to_end();
    test_nl_to_units();
    test_nl_multiword_alias();
    test_nl_to_currency();
    test_variable_persistence();
    test_history_roundtrip_with_eval();
    test_bpm_two_ways();
    test_unparseable_safe();
    test_value_to_latex();
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}

var rr = main();
syscall(SYS_EXIT, rr);
