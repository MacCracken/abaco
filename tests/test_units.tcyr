# abaco units tests

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/hashmap.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

include "src/core.cyr"
include "src/units.cyr"

# LOW-9b regression: every registry lookup resolves through a cstr-keyed
# hashmap (open addressing, content hash, 16-slot initial cap). Stress it well
# past capacity so collisions + grows are guaranteed, then read every key back.
# A dropped or corrupted entry — the failure mode the audit flagged — surfaces
# here as a mismatch.
fn test_hashmap_collisions() {
    var m = map_new();
    var keys = vec_new();
    var n = 200;
    var i = 0;
    while (i < n) {
        var kbuf = alloc(16);
        store8(kbuf, 117);                # 'u'
        var dlen = fmt_int_buf(i, kbuf + 1);
        store8(kbuf + 1 + dlen, 0);
        vec_push(keys, kbuf);
        map_set(m, kbuf, i * 7 + 1);      # value never 0 (avoids miss sentinel)
        i = i + 1;
    }
    assert_eq(map_size(m), 200, "200 distinct keys stored");
    i = 0;
    var ok = 1;
    while (i < n) {
        if (map_get(m, vec_get(keys, i)) != i * 7 + 1) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "all 200 keys retrievable under collisions + grow");
    assert_eq(map_has(m, "u9999"), 0, "absent key misses (no false collision)");
    return 0;
}

# Registry integrity: a representative unit per category resolves, and a
# conversion still computes across that surface. A collision silently
# shadowing a unit/alias would show up as a 0 find or a wrong factor.
fn test_registry_integrity(r) {
    assert(UnitRegistry_find(r, "mile") != 0, "len mile (name)");
    assert(UnitRegistry_find(r, "mi") != 0, "len mi (symbol)");
    assert(UnitRegistry_find(r, "kilogram") != 0, "mass kilogram");
    assert(UnitRegistry_find(r, "lb") != 0, "mass lb");
    assert(UnitRegistry_find(r, "min") != 0, "time min");
    assert(UnitRegistry_find(r, "C") != 0, "temp C");
    assert(UnitRegistry_find(r, "kB") != 0, "data kB");
    assert(UnitRegistry_find(r, "Hz") != 0, "freq Hz");
    assert(UnitRegistry_find(r, "cent") != 0, "pitch cent");
    var v = UnitRegistry_convert(r, f64_from(2), "mi", "m");
    assert_eq(f64_to(v), 3218, "2 mi = 3218 m (collision-free factor)");
    return 0;
}

fn main() {
    alloc_init();
    println("=== abaco units tests ===");
    var r = UnitRegistry_new();
    var result = UnitRegistry_convert(r, f64_from(1000), "m", "km");
    assert_eq(f64_to(result), 1, "1000m->km");
    result = UnitRegistry_convert(r, f64_from(1), "km", "m");
    assert_eq(f64_to(result), 1000, "1km->m");
    result = UnitRegistry_convert(r, f64_from(0), "C", "F");
    assert_eq(f64_to(result), 32, "0C->F");
    result = UnitRegistry_convert(r, f64_from(100), "C", "F");
    assert_eq(f64_to(result), 212, "100C->F");
    result = UnitRegistry_convert(r, f64_from(32), "F", "C");
    assert_eq(f64_to(result), 0, "32F->C");
    result = UnitRegistry_convert(r, f64_from(60), "s", "min");
    assert_eq(f64_to(result), 1, "60s->min");
    result = UnitRegistry_convert(r, f64_from(1000), "B", "kB");
    assert_eq(f64_to(result), 1, "1000B->kB");
    result = UnitRegistry_convert(r, f64_from(42), "km", "km");
    assert_eq(f64_to(result), 42, "same unit");
    assert(UnitRegistry_find(r, "km") != 0, "find km");
    assert(UnitRegistry_find(r, "kph") != 0, "find kph");
    assert(UnitRegistry_find(r, "meters") != 0, "find meters");
    assert(UnitRegistry_find(r, "nonexistent") == 0, "find miss");
    UnitRegistry_convert(r, f64_from(1), "km", "kg");
    assert_eq(reg_err(r), UERR_INCOMPAT, "incompat");
    UnitRegistry_convert(r, f64_from(1), "xyz", "km");
    assert_eq(reg_err(r), UERR_UNKNOWN, "unknown");
    # Audio: BPM <-> Hz via registry.
    result = UnitRegistry_convert(r, f64_from(120), "bpm", "Hz");
    assert_eq(f64_to(result), 2, "120 bpm -> 2 Hz");
    result = UnitRegistry_convert(r, f64_from(1), "Hz", "bpm");
    assert_eq(f64_to(result), 60, "1 Hz -> 60 bpm");
    # Pitch.
    result = UnitRegistry_convert(r, f64_from(12), "semi", "oct");
    assert_eq(f64_to(result), 1, "12 semi = 1 oct");
    result = UnitRegistry_convert(r, f64_from(1), "oct", "cent");
    assert_eq(f64_to(result), 1200, "1 oct = 1200 cents");
    result = UnitRegistry_convert(r, f64_from(100), "cent", "semi");
    assert_eq(f64_to(result), 1, "100 cents = 1 semi");
    assert(UnitRegistry_find(r, "bpm") != 0, "find bpm");
    assert(UnitRegistry_find(r, "semitones") != 0, "find semitones alias");
    test_registry_integrity(r);
    test_hashmap_collisions();
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}
var rr = main();
syscall(SYS_EXIT, rr);
