# |got - want| <= 1e-12 * |want|.
fn near_rel(got, want, what) {
    var d = f64_abs(f64_sub(got, want));
    var tol = f64_mul(f64_abs(want), f64_div(f64_from(1), f64_from(1000000000000)));
    assert(f64_le(d, tol) == 1, what);
    return 0;
}

fn conv1(r, a, b) { return UnitRegistry_convert(r, f64_from(1), a, b); }

# Definitional identities between registered units.
fn test_unit_identities(r) {
    near_rel(conv1(r, "gal", "qt"), f64_from(4), "gal = 4 qt (was 3.999998)");
    near_rel(conv1(r, "qt", "pt"), f64_from(2), "qt = 2 pt");
    near_rel(conv1(r, "cup", "tbsp"), f64_from(16), "cup = 16 tbsp (was 15.999946)");
    near_rel(conv1(r, "tbsp", "tsp"), f64_from(3), "tbsp = 3 tsp (was 3.000008)");
    near_rel(conv1(r, "gal", "tsp"), f64_from(768), "gal = 768 tsp");
    near_rel(conv1(r, "ft2", "in2"), f64_from(144), "ft2 = 144 in2");
    near_rel(conv1(r, "ac", "ft2"), f64_from(43560), "acre = 43560 ft2");
    near_rel(conv1(r, "atm", "torr"), f64_from(760), "atm = 760 torr");
    near_rel(conv1(r, "st", "lb"), f64_from(14), "stone = 14 lb");
    near_rel(conv1(r, "lb", "oz"), f64_from(16), "lb = 16 oz");
    near_rel(conv1(r, "kn", "km/h"), f64_div(f64_from(1852), f64_from(1000)), "knot = 1.852 km/h");
    near_rel(conv1(r, "mi", "ft"), f64_from(5280), "mile = 5280 ft");
    near_rel(conv1(r, "kg", "lb"), f64_div(f64_from(100000000), f64_from(45359237)), "kg = 1/0.45359237 lb");
    near_rel(conv1(r, "hp", "W"), f64_mul(f64_from(550), f64_mul(conv1(r, "ft", "m"), conv1(r, "lbf", "N"))),
      "hp = 550 ft lbf/s");
    # torr and mmHg are different units (they were the same value).
    assert(conv1(r, "torr", "Pa") != conv1(r, "mmHg", "Pa"), "torr != mmHg");
    return 0;
}

fn test_temperature_and_inverse(r) {
    assert_eq(UnitRegistry_convert(r, f64_from(0), "C", "K"), 0x4071126666666666, "0 C = 273.15 K");
    assert_eq(UnitRegistry_convert(r, f64_from(0 - 40), "C", "F"), f64_from(0 - 40), "-40 C = -40 F");
    assert_eq(UnitRegistry_convert(r, f64_from(5), "L/100km", "km/L"), f64_from(20), "5 L/100km = 20 km/L");
    assert_eq(UnitRegistry_convert(r, f64_from(20), "km/L", "L/100km"), f64_from(5), "20 km/L = 5 L/100km");
    var back = UnitRegistry_convert(r, UnitRegistry_convert(r, f64_from(30), "mpg", "L/100km"), "L/100km", "mpg");
    near_rel(back, f64_from(30), "mpg -> L/100km -> mpg");
    # A reciprocal unit needs a finite amount > 0, and a finite answer.
    UnitRegistry_convert(r, f64_from(0), "L/100km", "km/L");
    assert_eq(reg_err(r), UERR_CONVERT, "0 L/100km refused");
    UnitRegistry_convert(r, f64_from(0 - 5), "L/100km", "km/L");
    assert_eq(reg_err(r), UERR_CONVERT, "-5 L/100km refused (was -20 km/L)");
    UnitRegistry_convert(r, f64_from(0 - 30), "mpg", "L/100km");
    assert_eq(reg_err(r), UERR_CONVERT, "-30 mpg to L/100km refused");
    UnitRegistry_convert(r, 0x7FF8000000000000, "L/100km", "km/L");
    assert_eq(reg_err(r), UERR_CONVERT, "NaN L/100km refused");
    UnitRegistry_convert(r, 1, "L/100km", "km/L");
    assert_eq(reg_err(r), UERR_CONVERT, "subnormal L/100km refused (was Inf)");
    UnitRegistry_convert(r, 1, "km/L", "L/100km");
    assert_eq(reg_err(r), UERR_CONVERT, "subnormal km/L to L/100km refused (was Inf)");
    # The same unit under two spellings still gets the domain check, and a
    # reciprocal amount whose linear result overflows is refused (2.4.9 final
    # review: -5 came back as -5, and 1e-306 L/100km to mpg as +Inf).
    UnitRegistry_convert(r, f64_from(0 - 5), "L/100km", "l/100km");
    assert_eq(reg_err(r), UERR_CONVERT, "-5 L/100km to l/100km refused");
    UnitRegistry_convert(r, 0x7FF8000000000000, "L/100km", "liters_per_100km");
    assert_eq(reg_err(r), UERR_CONVERT, "NaN L/100km to itself refused");
    assert_eq(UnitRegistry_convert(r, f64_from(5), "L/100km", "l/100km"), f64_from(5), "5 L/100km to itself is 5");
    assert_eq(reg_err(r), UERR_NONE, "and no error");
    UnitRegistry_convert(r, f64_div(f64_from(100), 0x7FE0000000000000), "L/100km", "mpg");
    assert_eq(reg_err(r), UERR_CONVERT, "an overflowing mpg result refused");
    return 0;
}

fn finds(r, q, sym, what) {
    var u = UnitRegistry_find(r, q);
    assert(u != 0, what);
    if (u != 0) { assert(streq(Unit_symbol(u), sym) == 1, what); }
    return 0;
}

fn unknown(r, q, what) {
    assert_eq(UnitRegistry_find(r, q), 0, what);
    return 0;
}

# 2.4.9 lookup policy: symbols exact, names and aliases in any case, plurals
# of names only. Through 2.4.8 every symbol was also matched case-folded, so
# MW became milliwatt and kN knot whenever case was lost, unregistered SI
# symbols landed on registered ones (mHz -> MHz, Mm -> mm, Mb -> MB), and the
# plural strip made "ms" a metre and "ns" a newton.
fn test_lookup_policy(r) {
    finds(r, "MW", "MW", "MW is megawatt");
    finds(r, "mW", "mW", "mW is milliwatt");
    unknown(r, "mw", "mw ambiguous (was milliwatt)");
    unknown(r, "Mw", "Mw ambiguous (was milliwatt)");
    finds(r, "kN", "kN", "kN is kilonewton");
    finds(r, "kn", "kn", "kn is knot");
    unknown(r, "KN", "KN ambiguous (was kilonewton)");
    unknown(r, "ms", "ms unknown (was metre)");
    unknown(r, "ns", "ns unknown (was newton)");
    unknown(r, "ks", "ks unknown (was kelvin)");
    unknown(r, "ps", "ps unknown (was poise)");
    unknown(r, "Ws", "Ws unknown (was watt)");
    unknown(r, "gs", "gs unknown (was gram)");
    unknown(r, "mHz", "mHz unknown (was MHz)");
    unknown(r, "Mm", "Mm unknown (was mm)");
    unknown(r, "Mb", "Mb unknown (was MB)");
    unknown(r, "b", "b (bit) unknown (was byte)");
    unknown(r, "kb", "kb (kilobit) unknown (was kB)");
    unknown(r, "Gb", "Gb unknown (was GB)");
    unknown(r, "G", "G unknown (was gram)");
    unknown(r, "T", "T unknown (was ton)");
    unknown(r, "Cal", "Cal unknown (was calorie)");
    unknown(r, "ML", "ML (megalitre) unknown");
    unknown(r, "HZ", "HZ unknown: lowercase spellings are exact");
    finds(r, "st", "st", "st is stone");
    finds(r, "ST", "st", "ST is stone (was semitone)");
    finds(r, "semi", "semi", "semi");
    finds(r, "Semitones", "semi", "Semitones");
    # Names and aliases match in any case; plurals of names resolve.
    finds(r, "KILOMETER", "km", "KILOMETER");
    finds(r, "Meters", "m", "Meters");
    finds(r, "Feet", "ft", "Feet");
    finds(r, "LBS", "lb", "LBS");
    finds(r, "Gal", "gal", "Gal");
    finds(r, "MPH", "mph", "MPH");
    finds(r, "gigabytes", "GB", "gigabytes");
    finds(r, "Kelvins", "K", "Kelvins");
    finds(r, "celsius", "C", "celsius ends in s");
    # British singulars (only the plurals resolved).
    finds(r, "metre", "m", "metre");
    finds(r, "kilometre", "km", "kilometre");
    finds(r, "centimetre", "cm", "centimetre");
    finds(r, "millimetre", "mm", "millimetre");
    finds(r, "tonne", "t", "tonne");
    finds(r, "metres", "m", "metres");
    finds(r, "tonnes", "t", "tonnes");
    # Lowercase spellings of SI symbols, exactly as written.
    finds(r, "hz", "Hz", "hz");
    finds(r, "khz", "kHz", "khz");
    finds(r, "ghz", "GHz", "ghz");
    finds(r, "ml", "mL", "ml");
    finds(r, "l", "L", "l");
    finds(r, "kwh", "kWh", "kwh");
    finds(r, "kpa", "kPa", "kpa");
    finds(r, "kw", "kW", "kw");
    finds(r, "c", "C", "c");
    finds(r, "f", "F", "f");
    finds(r, "k", "K", "k");
    finds(r, "l/100km", "L/100km", "l/100km");
    # NULL query.
    unknown(r, 0, "NULL query (was SIGSEGV)");
    UnitRegistry_convert(r, f64_from(1), 0, "m");
    assert_eq(reg_err(r), UERR_UNKNOWN, "NULL unit -> UERR_UNKNOWN");
    # No case-insensitive key is left ambiguous by a collision among the
    # built-in names and aliases: a new alias that clashes shows up here.
    var keys = map_keys(reg_low(r));
    var bad = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        if (map_get(reg_low(r), vec_get(keys, i)) == 0) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, "no ambiguous name or alias");
    assert_eq(vec_len(reg_units(r)), 112, "112 units (2.4.10: + short_ton, long_ton)");
    return 0;
}

# category_name gives display names ("Data Size"); category_from_str must
# take them back (through 2.4.8 it took none of the 19).
fn test_category_roundtrip(r) {
    var c = 0;
    var ok = 1;
    while (c < UNIT_CATEGORY_COUNT) {
        if (category_from_str(category_name(c)) != c) { ok = 0; }
        if (vec_len(UnitRegistry_list(r, category_from_str(category_name(c)))) == 0) { ok = 0; }
        c = c + 1;
    }
    assert_eq(ok, 1, "category_from_str(category_name(c)) == c for all 19");
    assert_eq(category_from_str("data size"), CAT_DATASIZE, "data size");
    assert_eq(category_from_str("DATA_SIZE"), CAT_DATASIZE, "DATA_SIZE");
    assert_eq(category_from_str("Fuel Economy"), CAT_FUELECONOMY, "Fuel Economy");
    assert_eq(category_from_str("nonsense"), 0 - 1, "unknown category");
    return 0;
}

# 2.4.10: the US short ton and UK long ton, exact (2000 lb, 2240 lb); bare
# "ton" stays the metric tonne. And a temperature below absolute zero is
# refused rather than converted.
fn test_tons_and_absolute_zero(r) {
    unit_factor_is(r, "short_ton", "kg", 0x408C597A58F7121B);   # 907.18474
    unit_factor_is(r, "long_ton", "kg", 0x408FC06011B88F28);    # 1016.0469088
    near_rel(conv1(r, "short_ton", "lb"), f64_from(2000), "short ton = 2000 lb");
    near_rel(conv1(r, "long_ton", "lb"), f64_from(2240), "long ton = 2240 lb");
    finds(r, "short tons", "short_ton", "short tons");
    finds(r, "US ton", "short_ton", "US ton");
    finds(r, "Long Ton", "long_ton", "Long Ton");
    finds(r, "imperial ton", "long_ton", "imperial ton");
    finds(r, "ton", "t", "bare ton is still the metric tonne");
    UnitRegistry_convert(r, f64_from(0 - 300), "C", "K");
    assert_eq(reg_err(r), UERR_CONVERT, "-300 C refused (was -26.85 K)");
    UnitRegistry_convert(r, f64_from(0 - 300), "C", "C");
    assert_eq(reg_err(r), UERR_CONVERT, "-300 C to C refused too");
    UnitRegistry_convert(r, f64_from(0 - 1), "K", "C");
    assert_eq(reg_err(r), UERR_CONVERT, "-1 K refused");
    UnitRegistry_convert(r, f64_from(0 - 500), "F", "C");
    assert_eq(reg_err(r), UERR_CONVERT, "-500 F refused");
    UnitRegistry_convert(r, f64_from(0), "K", "C");
    assert_eq(reg_err(r), UERR_NONE, "0 K is allowed");
    UnitRegistry_convert(r, f64_div(f64_from(0 - 45967), f64_from(100)), "F", "K");
    assert_eq(reg_err(r), UERR_NONE, "-459.67 F (absolute zero, with rounding) is allowed");
    UnitRegistry_convert(r, 0xC071126666666666, "C", "F");
    assert_eq(reg_err(r), UERR_NONE, "-273.15 C is allowed");
    return 0;
}

fn main() {
    alloc_init();
    println("=== abaco units tests ===");
    var r = UnitRegistry_new();
    var result = UnitRegistry_convert(r, f64_from(1000), "m", "km");
    assert_eq(f64_to(result), 1, "1000m->km");
    result = UnitRegistry_convert(r, f64_from(1), "km", "m");
    assert_eq(f64_to(result), 1000, "1km->m");
    result = UnitRegistry_convert(r, f64_from(0), "C", "F");
    assert_eq(f64_to(result), 32, "0C->F");
    result = UnitRegistry_convert(r, f64_from(100), "C", "F");
    assert_eq(f64_to(result), 212, "100C->F");
    result = UnitRegistry_convert(r, f64_from(32), "F", "C");
    assert_eq(f64_to(result), 0, "32F->C");
    result = UnitRegistry_convert(r, f64_from(60), "s", "min");
    assert_eq(f64_to(result), 1, "60s->min");
    result = UnitRegistry_convert(r, f64_from(1000), "B", "kB");
    assert_eq(f64_to(result), 1, "1000B->kB");
    result = UnitRegistry_convert(r, f64_from(42), "km", "km");
    assert_eq(f64_to(result), 42, "same unit");
    assert(UnitRegistry_find(r, "km") != 0, "find km");
    assert(UnitRegistry_find(r, "kph") != 0, "find kph");
    assert(UnitRegistry_find(r, "meters") != 0, "find meters");
    assert(UnitRegistry_find(r, "nonexistent") == 0, "find miss");
    UnitRegistry_convert(r, f64_from(1), "km", "kg");
    assert_eq(reg_err(r), UERR_INCOMPAT, "incompat");
    UnitRegistry_convert(r, f64_from(1), "xyz", "km");
    assert_eq(reg_err(r), UERR_UNKNOWN, "unknown");
    # Audio: BPM <-> Hz via registry.
    result = UnitRegistry_convert(r, f64_from(120), "bpm", "Hz");
    assert_eq(f64_to(result), 2, "120 bpm -> 2 Hz");
    result = UnitRegistry_convert(r, f64_from(1), "Hz", "bpm");
    assert_eq(f64_to(result), 60, "1 Hz -> 60 bpm");
    # Pitch.
    result = UnitRegistry_convert(r, f64_from(12), "semi", "oct");
    assert_eq(f64_to(result), 1, "12 semi = 1 oct");
    result = UnitRegistry_convert(r, f64_from(1), "oct", "cent");
    assert_eq(f64_to(result), 1200, "1 oct = 1200 cents");
    result = UnitRegistry_convert(r, f64_from(100), "cent", "semi");
    assert_eq(f64_to(result), 1, "100 cents = 1 semi");
    assert(UnitRegistry_find(r, "bpm") != 0, "find bpm");
    assert(UnitRegistry_find(r, "semitones") != 0, "find semitones alias");
    test_registry_integrity(r);
    test_hashmap_collisions();
    test_exact_factors(r);
    test_unit_identities(r);
    test_temperature_and_inverse(r);
    test_lookup_policy(r);
    test_category_roundtrip(r);
    test_tons_and_absolute_zero(r);
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}
var rr = main();
syscall(SYS_EXIT, rr);
