# abaco ntheory tests

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/tagged.cyr"
include "lib/hashmap.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

include "src/core.cyr"
include "src/ntheory.cyr"

fn test_is_prime() {
    # Small primes
    assert(is_prime(2) == 1, "2 is prime");
    assert(is_prime(3) == 1, "3 is prime");
    assert(is_prime(5) == 1, "5 is prime");
    assert(is_prime(7) == 1, "7 is prime");
    assert(is_prime(11) == 1, "11 is prime");
    assert(is_prime(13) == 1, "13 is prime");
    assert(is_prime(17) == 1, "17 is prime");
    assert(is_prime(19) == 1, "19 is prime");
    assert(is_prime(23) == 1, "23 is prime");
    assert(is_prime(29) == 1, "29 is prime");
    assert(is_prime(31) == 1, "31 is prime");
    assert(is_prime(37) == 1, "37 is prime");
    assert(is_prime(41) == 1, "41 is prime");
    assert(is_prime(43) == 1, "43 is prime");
    assert(is_prime(47) == 1, "47 is prime");

    # Small composites
    assert(is_prime(0) == 0, "0 not prime");
    assert(is_prime(1) == 0, "1 not prime");
    assert(is_prime(4) == 0, "4 not prime");
    assert(is_prime(6) == 0, "6 not prime");
    assert(is_prime(8) == 0, "8 not prime");
    assert(is_prime(9) == 0, "9 not prime");
    assert(is_prime(10) == 0, "10 not prime");
    assert(is_prime(12) == 0, "12 not prime");
    assert(is_prime(15) == 0, "15 not prime");
    assert(is_prime(25) == 0, "25 not prime");

    # Large primes
    assert(is_prime(104729) == 1, "104729 is prime");
    assert(is_prime(1000000007) == 1, "1000000007 is prime");

    # Carmichael numbers (fool simple Fermat tests)
    assert(is_prime(561) == 0, "561 carmichael");
    assert(is_prime(1105) == 0, "1105 carmichael");
    assert(is_prime(1729) == 0, "1729 carmichael");
    assert(is_prime(2465) == 0, "2465 carmichael");
    assert(is_prime(2821) == 0, "2821 carmichael");
    assert(is_prime(6601) == 0, "6601 carmichael");
    assert(is_prime(8911) == 0, "8911 carmichael");

    # Strong pseudoprimes to specific small bases (audit LOW-9a).
    # Each is a composite that fools Miller–Rabin under one witness but is
    # caught once the next witness joins the set. Abaco uses the 12-witness
    # set, so all of these must classify as composite.
    assert(is_prime(2047) == 0, "2047 strong psp base 2");
    assert(is_prime(1373653) == 0, "1373653 spsp bases 2,3");
    assert(is_prime(25326001) == 0, "25326001 spsp bases 2,3,5");
    assert(is_prime(3215031751) == 0, "3215031751 spsp bases 2,3,5,7");

    # Large known primes (past our small-prime fast-path).
    assert(is_prime(104729) == 1, "10000th prime");
    assert(is_prime(1000000007) == 1, "10^9 + 7 is prime");
    assert(is_prime(2147483647) == 1, "Mersenne M31");
    return 0;
}

fn test_next_prime() {
    assert_eq(next_prime(0), 2, "next_prime(0)");
    assert_eq(next_prime(1), 2, "next_prime(1)");
    assert_eq(next_prime(2), 3, "next_prime(2)");
    assert_eq(next_prime(4), 5, "next_prime(4)");
    assert_eq(next_prime(100), 101, "next_prime(100)");
    assert_eq(next_prime(113), 127, "next_prime(113)");
    return 0;
}

fn test_prev_prime() {
    # 6.6.x value form: prev_prime returns a (tag, payload) PAIR. Each case
    # binds its own fresh pair — there is no pair-reassignment form, and the
    # old `r = prev_prime(..)` shape would silently keep only the tag.
    var t2, v2 = prev_prime(2);
    assert(is_err_result(t2), "prev_prime(2) is Err");
    assert_eq(v2, 0, "prev_prime(2) Err payload is 0");
    var t3, v3 = prev_prime(3);
    assert(is_ok(t3), "prev_prime(3) is Ok");
    assert_eq(v3, 2, "prev_prime(3) == 2");
    var t10, v10 = prev_prime(10);
    assert(is_ok(t10), "prev_prime(10) is Ok");
    assert_eq(v10, 7, "prev_prime(10) == 7");
    var t100, v100 = prev_prime(100);
    assert(is_ok(t100), "prev_prime(100) is Ok");
    assert_eq(v100, 97, "prev_prime(100) == 97");
    var t128, v128 = prev_prime(128);
    assert(is_ok(t128), "prev_prime(128) is Ok");
    assert_eq(v128, 127, "prev_prime(128) == 127");
    return 0;
}

fn test_factor() {
    var f = factor(0);
    assert_eq(vec_len(f), 0, "factor(0) empty");
    f = factor(1);
    assert_eq(vec_len(f), 0, "factor(1) empty");
    f = factor(2);
    assert_eq(vec_len(f), 1, "factor(2) len");
    assert_eq(vec_get(f, 0), 2, "factor(2)[0]");
    f = factor(12);
    assert_eq(vec_len(f), 3, "factor(12) len");
    assert_eq(vec_get(f, 0), 2, "factor(12)[0]");
    assert_eq(vec_get(f, 1), 2, "factor(12)[1]");
    assert_eq(vec_get(f, 2), 3, "factor(12)[2]");
    f = factor(360);
    assert_eq(vec_len(f), 6, "factor(360) len");
    assert_eq(vec_get(f, 0), 2, "factor(360)[0]");
    assert_eq(vec_get(f, 1), 2, "factor(360)[1]");
    assert_eq(vec_get(f, 2), 2, "factor(360)[2]");
    assert_eq(vec_get(f, 3), 3, "factor(360)[3]");
    assert_eq(vec_get(f, 4), 3, "factor(360)[4]");
    assert_eq(vec_get(f, 5), 5, "factor(360)[5]");
    # Prime number factors to itself
    f = factor(97);
    assert_eq(vec_len(f), 1, "factor(97) len");
    assert_eq(vec_get(f, 0), 97, "factor(97)[0]");
    # Powers of two
    f = factor(64);
    assert_eq(vec_len(f), 6, "factor(64) len");
    return 0;
}

fn test_totient() {
    assert_eq(totient(0), 0, "totient(0)");
    assert_eq(totient(1), 1, "totient(1)");
    assert_eq(totient(2), 1, "totient(2)");
    assert_eq(totient(6), 2, "totient(6)");
    assert_eq(totient(12), 4, "totient(12)");
    assert_eq(totient(36), 12, "totient(36)");
    # totient(p) = p-1 for prime p
    assert_eq(totient(97), 96, "totient(97)");
    assert_eq(totient(101), 100, "totient(101)");
    # totient(2^k) = 2^(k-1)
    assert_eq(totient(8), 4, "totient(8)");
    assert_eq(totient(16), 8, "totient(16)");
    assert_eq(totient(1024), 512, "totient(1024)");
    return 0;
}

fn test_fibonacci() {
    assert_eq(fibonacci(0), 0, "fib(0)");
    assert_eq(fibonacci(1), 1, "fib(1)");
    assert_eq(fibonacci(2), 1, "fib(2)");
    assert_eq(fibonacci(3), 2, "fib(3)");
    assert_eq(fibonacci(4), 3, "fib(4)");
    assert_eq(fibonacci(5), 5, "fib(5)");
    assert_eq(fibonacci(6), 8, "fib(6)");
    assert_eq(fibonacci(7), 13, "fib(7)");
    assert_eq(fibonacci(8), 21, "fib(8)");
    assert_eq(fibonacci(9), 34, "fib(9)");
    assert_eq(fibonacci(10), 55, "fib(10)");
    assert_eq(fibonacci(20), 6765, "fib(20)");
    # Overflow returns -1
    assert_eq(fibonacci(93), 0 - 1, "fib(93) overflow");
    assert_eq(fibonacci(100), 0 - 1, "fib(100) overflow");
    return 0;
}

fn test_binomial() {
    assert_eq(binomial(0, 0), 1, "C(0,0)");
    assert_eq(binomial(5, 0), 1, "C(5,0)");
    assert_eq(binomial(5, 5), 1, "C(5,5)");
    assert_eq(binomial(5, 2), 10, "C(5,2)");
    assert_eq(binomial(10, 3), 120, "C(10,3)");
    assert_eq(binomial(20, 10), 184756, "C(20,10)");
    # k > n returns 0
    assert_eq(binomial(3, 5), 0, "C(3,5)");
    # Symmetry
    assert_eq(binomial(10, 3), binomial(10, 7), "C(10,3)==C(10,7)");
    assert_eq(binomial(15, 4), binomial(15, 11), "C(15,4)==C(15,11)");
    # Pascal's triangle: C(n,k) = C(n-1,k-1) + C(n-1,k)
    assert_eq(binomial(10, 5), binomial(9, 4) + binomial(9, 5), "pascal(10,5)");
    assert_eq(binomial(8, 3), binomial(7, 2) + binomial(7, 3), "pascal(8,3)");
    return 0;
}

fn test_mod_pow_boundaries() {
    # Ordinary case — the Miller-Rabin path every other ntheory test leans on.
    assert_eq(mod_pow(2, 10, 1000), 24, "mod_pow(2,10,1000) = 24");
    assert_eq(mod_pow(3, 200, 1000000007), 136318165, "mod_pow(3,200,1e9+7)");

    # Boundary rows that TRAPPED through 2.4.2. bayan_u64_mulmod fed its
    # operands straight to x86 `mul`/`div`, and DIV raises #DE when the
    # QUOTIENT overflows 64 bits, not only on a zero divisor — so both of
    # these killed the process with SIGFPE instead of returning a value.
    # bayan 1.5.2 (arriving with the Cyrius 6.5.35 pin) guards m == 0 and
    # reduces a and b before the divide. abaco's own is_prime never reached
    # either row — it passes small witnesses and a positive, pre-reduced n —
    # which is why 107 asserts here stayed green over a crashing primitive.
    # mod_pow is public surface (dist/abaco.cyr), so pin it.
    assert_eq(mod_pow(5, 3, 0), 0, "mod_pow with modulus 0 returns 0, does not trap");
    assert_eq(mod_pow(0 - 1, 3, 5), 0, "base read as negative i64 (>= 2^63) does not trap");
    assert_eq(mod_pow(0 - 7, 5, 1000003), 791664, "base >= 2^63 reduces correctly");
    return 0;
}

# Binding helpers for abaco_binomial's (tag, value) pair.
fn binom_val(n, k) {
    var t, v = abaco_binomial(n, k);
    if (is_ok(t) == 0) { return 0 - 1; }
    return v;
}
fn binom_refused(n, k) {
    var t, v = abaco_binomial(n, k);
    return is_err_result(t);
}

# abaco_binomial is exact for every C(n, k) that fits in i64 (CHANGELOG 2.4.9).
# ganita's binomial, which the evaluator used through 2.4.8, multiplies before
# it divides and refused every result above i64_MAX / k: each "ganita" row below
# is one it answered -1 for although the value fits.
fn test_abaco_binomial() {
    assert_eq(binom_val(0, 0), 1, "C(0,0)");
    assert_eq(binom_val(5, 2), 10, "C(5,2)");
    assert_eq(binom_val(5, 7), 0, "C(5,7) = 0, k > n");
    assert_eq(binom_val(100, 98), 4950, "C(100,98) folds to C(100,2)");
    assert_eq(binom_val(1000000, 3), 166666166667000000, "C(10^6,3)");
    assert_eq(binom_val(61, 30), 232714176627630544, "C(61,30), ganita's last central");
    assert_eq(binom_val(62, 31), 465428353255261088, "C(62,31) (ganita: -1)");
    assert_eq(binom_val(66, 33), 7219428434016265740, "C(66,33), largest central in i64 (ganita: -1)");
    assert_eq(binom_val(4294967296, 2), 9223372034707292160, "C(2^32,2) = 2^63 - 2^31 (ganita: -1)");
    assert_eq(binom_refused(4294967297, 2), 1, "C(2^32+1,2) = 2^63 + 2^31 overflows");
    assert_eq(binom_refused(67, 33), 1, "C(67,33) overflows");
    assert_eq(binom_refused(100, 50), 1, "C(100,50) overflows");
    assert_eq(binom_refused(9223372036854775807, 2), 1, "C(i64_MAX,2) overflows, no wrap");
    assert_eq(binom_refused(0 - 1, 2), 1, "C(-1,2) refused");
    assert_eq(binom_refused(2, 0 - 1), 1, "C(2,-1) refused");
    assert_eq(binom_val(9223372036854775807, 1), 9223372036854775807, "C(i64_MAX,1)");
    assert_eq(binom_val(9223372036854775807, 9223372036854775807), 1, "C(i64_MAX,i64_MAX)");

    # Every C(n, k) for n <= 70 against Pascal's triangle built by addition — an
    # independent algorithm — with a sum past i64 marking the cell as overflow.
    # Cells that fit must match exactly; cells that do not must be refused.
    var row = alloc(72 * 8);
    var i = 0;
    while (i < 72) { store64(row + i * 8, 0); i = i + 1; }
    store64(row, 1);
    var bad = 0;
    var n = 0;
    while (n <= 70) {
        if (n > 0) {
            var k = n;
            while (k >= 1) {
                var hi = load64(row + k * 8);
                var lo = load64(row + (k - 1) * 8);
                var sum = 0 - 1;
                if (hi >= 0 && lo >= 0) {
                    if (hi <= ABACO_I64_MAX - lo) { sum = hi + lo; }
                }
                store64(row + k * 8, sum);
                k = k - 1;
            }
        }
        var c = 0;
        while (c <= n) {
            var want = load64(row + c * 8);
            if (want < 0) {
                if (binom_refused(n, c) != 1) { bad = bad + 1; }
            } else {
                if (binom_val(n, c) != want) { bad = bad + 1; }
            }
            c = c + 1;
        }
        n = n + 1;
    }
    assert_eq(bad, 0, "every C(n,k), n <= 70, matches Pascal's triangle or is refused");
    return 0;
}

# 2.4.9 audit: losing 7 of the 12 Miller-Rabin witnesses, or a broken 128-bit
# mulmod, kept every suite green — nothing above 2^31 was tested. These are the
# OEIS A014233 strong pseudoprimes inside i64 (each fools every witness below
# the one that catches it) and primes near the top of the range.
fn test_is_prime_pseudoprimes() {
    assert_eq(is_prime(2152302898747), 0, "psp to bases 2..11 is composite");
    assert_eq(is_prime(3474749660383), 0, "psp to bases 2..13 is composite");
    assert_eq(is_prime(341550071728321), 0, "psp to bases 2..17 is composite");
    assert_eq(is_prime(3825123056546413051), 0, "psp to bases 2..31: only witness 37 catches it");
    assert_eq(is_prime(4294967311), 1, "first prime past 2^32");
    assert_eq(is_prime(2305843009213693951), 1, "Mersenne 2^61 - 1");
    assert_eq(is_prime(9223372036854775783), 1, "2^63 - 25, the largest i64 prime");
    assert_eq(is_prime(9223372036854775807), 0, "i64_MAX = 7^2 * 73 * ... is composite");
    assert_eq(mod_pow(2, 2305843009213693950, 2305843009213693951), 1, "Fermat 2^(p-1) mod p = 1 at p = 2^61 - 1");
    # Allocation-free: through 2.4.8 every call took a 96-byte witness table
    # from the never-freeing heap.
    var before = alloc_used();
    var k = 0;
    while (k < 1000) { is_prime(1000000007 + 2 * k); k = k + 1; }
    assert_eq(alloc_used() - before, 0, "is_prime allocates nothing");
    return 0;
}

# The top of i64. d * d <= n overflows once d passes 3037000499, so through
# 2.4.8 factor and totient of a prime this close to 2^63 never returned, and
# next_prime stepped past i64_MAX into negative candidates (~2^62 steps).
# ~10 s together: the honest trial-division bound is ~1.5e9 odd divisors.
fn test_top_of_i64() {
    var p = 9223372036854775783;
    var fs = factor(p);
    assert_eq(vec_len(fs), 1, "factor(2^63 - 25) is one factor (was: never returned)");
    assert_eq(vec_get(fs, 0), p, "factor(2^63 - 25) = [itself]");
    assert_eq(totient(p), p - 1, "totient(2^63 - 25) = p - 1 (was: never returned)");
    assert_eq(next_prime(p - 1), p, "next_prime(2^63 - 26) = 2^63 - 25");
    assert_eq(next_prime(p), 0, "next_prime(2^63 - 25) = 0, none in i64 (was: ~2^62 steps)");
    assert_eq(next_prime(9223372036854775807), 0, "next_prime(i64_MAX) = 0");
    assert_eq(next_prime(5), 7, "next_prime(5) = 7, strictly greater");
    # Small composites whose last cofactor is an odd prime squared — the fuzz
    # oracle (product only) passed a factor() that stopped one divisor early.
    var f9 = factor(9);
    assert_eq(vec_len(f9), 2, "factor(9) = [3, 3]");
    var f75 = factor(75);
    assert_eq(vec_len(f75), 3, "factor(75) = [3, 5, 5]");
    assert_eq(vec_get(f75, 2), 5, "factor(75) last factor 5");
    assert_eq(totient(0 - 12), 0, "totient(-12) = 0 (was -12)");
    assert_eq(totient(36), 12, "totient(36) = 12");
    # mod_pow's exponent is u64: a negative i64 is 2^63 or more (2.4.8: 1).
    assert_eq(mod_pow(3, 0 - 1, 7), 6, "mod_pow(3, 2^64 - 1, 7) = 6 (was 1)");
    assert_eq(mod_pow(2, 0 - 5, 13), 7, "mod_pow(2, 2^64 - 5, 13) = 7 (was 1)");
    return 0;
}

# _isqrt bounds factor and totient; it must be exact for every i64, including
# where f64_from(n) rounds (n past 2^53) and at the top of the range.
fn test_isqrt() {
    assert_eq(_isqrt(0), 0, "isqrt 0");
    assert_eq(_isqrt(1), 1, "isqrt 1");
    assert_eq(_isqrt(3), 1, "isqrt 3");
    assert_eq(_isqrt(4), 2, "isqrt 4");
    assert_eq(_isqrt(4611686018427387904), 2147483648, "isqrt 2^62");
    assert_eq(_isqrt(9223372036854775807), 3037000499, "isqrt i64_MAX");
    assert_eq(_isqrt(9223372030926249001), 3037000499, "isqrt 3037000499^2");
    assert_eq(_isqrt(9223372030926249000), 3037000498, "isqrt 3037000499^2 - 1");
    assert_eq(_isqrt(4503599761588224), 67108864, "isqrt (2^26+1)^2 - 1");
    assert_eq(_isqrt(4611686022722355200), 2147483648, "isqrt (2^31+1)^2 - 1 (f64 rounds up)");
    assert_eq(_isqrt(4611686022722355201), 2147483649, "isqrt (2^31+1)^2");
    assert_eq(_isqrt(1000000000000000000), 1000000000, "isqrt 10^18");
    assert_eq(_isqrt(999999999999999999), 999999999, "isqrt 10^18 - 1");
    return 0;
}

fn main() {
    alloc_init();
    println("=== abaco ntheory tests ===");
    test_is_prime();
    test_next_prime();
    test_prev_prime();
    test_factor();
    test_totient();
    test_fibonacci();
    test_binomial();
    test_abaco_binomial();
    test_is_prime_pseudoprimes();
    test_top_of_i64();
    test_isqrt();
    test_mod_pow_boundaries();
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
