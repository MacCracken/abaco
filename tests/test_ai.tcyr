    var q = nl_parse("hello world");
    assert_eq(q, 0, "unparseable = 0");
    return 0;
}

fn test_history_push() {
    var h = CalcHistory_new(100);
    CalcHistory_push(h, "2 + 3", "5", "2026-04-14T00:00:00Z");
    assert_eq(CalcHistory_len(h), 1, "len 1");
    var e = CalcHistory_get(h, 0);
    assert(streq(he_input(e), "2 + 3") == 1, "input");
    assert(streq(he_result(e), "5") == 1, "result");
    return 0;
}

fn test_history_limit() {
    var h = CalcHistory_new(3);
    CalcHistory_push(h, "1", "1", "t1");
    CalcHistory_push(h, "2", "2", "t2");
    CalcHistory_push(h, "3", "3", "t3");
    CalcHistory_push(h, "4", "4", "t4");
    assert_eq(CalcHistory_len(h), 3, "bounded to 3");
    var e0 = CalcHistory_get(h, 0);
    assert(streq(he_input(e0), "2") == 1, "oldest dropped, now starts at 2");
    return 0;
}

fn test_history_clear() {
    var h = CalcHistory_new(100);
    CalcHistory_push(h, "1", "1", "t");
    CalcHistory_push(h, "2", "2", "t");
    CalcHistory_clear(h);
    assert_eq(CalcHistory_is_empty(h), 1, "empty after clear");
    return 0;
}

fn test_currency_convert() {
    var c = CurrencyCache_new("http://localhost:8088");
    var rates = map_new();
    # 1 USD = 0.92 EUR, 0.79 GBP, 149.5 JPY
    var eur_rate = f64_div(f64_from(92), f64_from(100));
    var gbp_rate = f64_div(f64_from(79), f64_from(100));
    var jpy_rate = f64_div(f64_from(1495), f64_from(10));
    map_set(rates, "EUR", eur_rate);
    map_set(rates, "GBP", gbp_rate);
    map_set(rates, "JPY", jpy_rate);
    CurrencyCache_set_rates(c, "USD", rates);

    # 100 USD -> EUR = 92
    var r = CurrencyCache_convert(c, f64_from(100), "usd", "eur");
    assert(r != 0, "convert ok");
    var tv = f64_to(cr_to_value(r));
    assert_eq(tv, 92, "100 USD = 92 EUR");
    assert(streq(cr_from_currency(r), "USD") == 1, "from USD uppercase");
    assert(streq(cr_to_currency(r), "EUR") == 1, "to EUR uppercase");

    # 1 EUR -> JPY = 149.5 / 0.92 ≈ 162.5
    var r2 = CurrencyCache_convert(c, f64_from(1), "EUR", "JPY");
    assert(r2 != 0, "cross convert");
    var t2 = f64_to(cr_to_value(r2));
    assert(t2 >= 162, "cross >= 162");
    assert(t2 <= 163, "cross <= 163");

    # USD -> USD: identity.
    var r3 = CurrencyCache_convert(c, f64_from(100), "USD", "USD");
    assert(r3 != 0, "same ccy");
    assert_eq(f64_to(cr_to_value(r3)), 100, "USD->USD = 100");

    # Unknown currency -> 0 + last_err.
    var r4 = CurrencyCache_convert(c, f64_from(100), "USD", "XYZ");
    assert_eq(r4, 0, "unknown returns 0");
    assert_eq(ai_last_err(), AI_ERR_CURRENCY, "last_err = currency");
    return 0;
}

fn test_ccy_parse_body() {
    var c = CurrencyCache_new("http://localhost:8088");
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\"GBP\":0.79,\"JPY\":149.5}}";
    var err = _ccy_load_body(c, body, strlen(body));
    assert_eq(err, 0, "load_body ok");
    assert(streq(ccy_base(c), "USD") == 1, "base = USD");
    var r = CurrencyCache_convert(c, f64_from(100), "USD", "EUR");
    assert(r != 0, "convert after parse");
    assert_eq(f64_to(cr_to_value(r)), 92, "100 USD = 92 EUR after parse");
    var r2 = CurrencyCache_convert(c, f64_from(1), "USD", "JPY");
    assert(r2 != 0, "convert to JPY");
    assert_eq(f64_to(cr_to_value(r2)), 149, "1 USD ~ 149 JPY");
    return 0;
}

fn test_ccy_truncated_body() {
    # LOW-9b regression: a truncated body / lying Content-Length must be
    # rejected cleanly (AI_ERR_CURRENCY) — never fabricate a rate, never read
    # past the caller-supplied `len`. All extractors are len-bounded.
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\"GBP\":0.79}}";
    var full = strlen(body);

    # Baseline: honest length parses.
    var c0 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c0, body, full), 0, "full body ok");

    # Lying length cuts off the rates object before its closing brace —
    # _jf_get_object can't balance braces within len, so the load rejects.
    var c1 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c1, body, full - 4), AI_ERR_CURRENCY, "truncated rates rejected");

    # Length ends before the "rates" key appears at all.
    var c2 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c2, body, 14), AI_ERR_CURRENCY, "len before rates rejected");

    # Zero-length (empty transport).
    var c3 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c3, body, 0), AI_ERR_CURRENCY, "zero-len rejected");

    # Bounded read: with len ending mid-value, _jf_get_string stops at len
    # ("US") instead of scanning ahead to the real closing quote ("USD").
    var partial = _jf_get_string(body, 11, "base");
    assert(streq(partial, "US") == 1, "_jf_get_string bounded by len (no over-read)");
    return 0;
}

fn test_ccy_deep_nesting_rejected() {
    # MED-4 regression: a rates object nested past CCY_MAX_JSON_DEPTH (8) must be
    # rejected. A legitimate fiat-rate map is flat (depth 1), so this payload is
    # not a rates object whatever else it is. Depth here is 9 ('rates' + 8
    # inner). (Corrected at 2.4.4: this said "before bayan_json_parse recurses"
    # and called it a stack-exhaustion guard — that parser is a flat scanner and
    # does not recurse. The assertion is unchanged; only the reason was wrong.)
    var deep = "{\"base\":\"USD\",\"rates\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":0.5}}}}}}}}}";
    var c = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c, deep, strlen(deep)), AI_ERR_CURRENCY, "deep nesting rejected");

    # A flat (depth-1) rates object at the same key still parses fine.
    var flat = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92}}";
    var c2 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c2, flat, strlen(flat)), 0, "flat rates still ok");
    return 0;
}

fn test_history_json_roundtrip() {
    var h = CalcHistory_new(100);
    CalcHistory_push(h, "2 + 3", "5", "2026-04-14T00:00:00Z");
    CalcHistory_push(h, "sqrt(16)", "4", "2026-04-14T00:00:01Z");
    var s = CalcHistory_to_json(h);
    assert(str_len(s) > 20, "json nonempty");
    var h2 = CalcHistory_new(100);
    var cstr_len = str_len(s);
    var cbuf = alloc(cstr_len + 1);
    memcpy(cbuf, str_data(s), cstr_len);
    store8(cbuf + cstr_len, 0);
    var err = CalcHistory_from_json(h2, cbuf);
    assert_eq(err, 0, "from_json ok");
    assert_eq(CalcHistory_len(h2), 2, "2 entries after load");
    var e0 = CalcHistory_get(h2, 0);
    assert(streq(he_input(e0), "2 + 3") == 1, "entry 0 input");
    assert(streq(he_result(e0), "5") == 1, "entry 0 result");
    var e1 = CalcHistory_get(h2, 1);
    assert(streq(he_input(e1), "sqrt(16)") == 1, "entry 1 input");
    return 0;
}

fn test_history_json_escapes() {
    var h = CalcHistory_new(10);
    CalcHistory_push(h, "f(\"x\", 1)", "ok\\", "t\n");
    var s = CalcHistory_to_json(h);
    var h2 = CalcHistory_new(10);
    var cstr_len = str_len(s);
    var cbuf = alloc(cstr_len + 1);
    memcpy(cbuf, str_data(s), cstr_len);
    store8(cbuf + cstr_len, 0);
    var err = CalcHistory_from_json(h2, cbuf);
    assert_eq(err, 0, "escape roundtrip ok");
    var e = CalcHistory_get(h2, 0);
    assert(streq(he_input(e), "f(\"x\", 1)") == 1, "quote escape");
    assert(streq(he_result(e), "ok\\") == 1, "backslash escape");
    assert(streq(he_timestamp(e), "t\n") == 1, "newline escape");
    return 0;
}

fn test_security_percent_of_rejects_operators() {
    # CWE-917: "2+3% of 4" must NOT expand to "4 * 2+3 / 100".
    # Instead _nl_try_percent_of should reject and fall through.
    var q = nl_parse("2+3% of 4");
    # Allowed outcome: either reject entirely (q==0) or route as a plain
    # calculation with the original literal string (not the % expansion).
    if (q != 0) {
        # If accepted, must not be the percent expansion — it would say
        # "4 * 2+3 / 100" which contains "* 2+" and yields the wrong value.
        var s = pq_s1(q);
        # The unsafe form contains " * 2+" or " * 2+3 "; the safe fallthrough
        # just keeps the original literal.
        assert(streq(s, "4 * 2+3 / 100") == 0, "must not synthesise unsafe expr");
    }
    return 0;
}

# The percent-of rewrite must fire only when both operands are strict
# literals; otherwise the text goes on unchanged (or is refused). Through
# 2.4.8 the paren row here was "15%) of 100", which never contains the
# "% of " needle, so it passed with both guards deleted.
fn pct_kept_or_refused(input, what) {
    var q = nl_parse(input);
    if (q == 0) { return 0; }
    assert_eq(pq_kind(q), PQ_CALCULATION, what);
    assert(streq(pq_s1(q), input) == 1, what);
    return 0;
}

fn test_security_percent_of_paren_injection() {
    pct_kept_or_refused("15)% of 100", "pct slot with ')' not rewritten");
    pct_kept_or_refused("15% of (100", "base slot with '(' not rewritten");
    pct_kept_or_refused("15% of 2+3", "base slot with an operator not rewritten");
    pct_kept_or_refused("1.5.3% of 200", "multi-dot pct not rewritten");
    pct_kept_or_refused("15% of 1e", "bare exponent base not rewritten");
    # The base-slot case end to end: an error, not (2 + 3*15/100).
    var e = Evaluator_new();
    var q = nl_parse("15% of 2+3");
    if (q != 0) {
        Evaluator_eval(e, pq_s1(q));
        assert(eval_err(e) != ABACO_ERR_NONE, "15% of 2+3 is an error, not 2.45");
    }
    # Strict literals still rewrite, in any case.
    q = nl_parse("1.5% OF 200");
    assert(q != 0, "1.5% OF 200 parses");
    assert(streq(pq_s1(q), "200 * 1.5 / 100") == 1, "keyword case-insensitive, rewrite fires");
    return 0;
}

# 2.4.9: nl_parse lowered the whole input, so unit symbols lost their case
# and the registry could not tell MW from mW or kN from kn.
fn nl_convert(r, input) {
    var q = nl_parse(input);
    if (q == 0) { return 0x7FF8000000000000; }
    if (pq_kind(q) != PQ_CONVERSION) { return 0x7FF8000000000000; }
    var v = UnitRegistry_convert(r, pq_value(q), pq_s1(q), pq_s2(q));
    if (reg_err(r) != UERR_NONE) { return 0x7FF8000000000000; }
    return v;
}

fn test_nl_case_preserved() {
    var r = UnitRegistry_new();
    var q = nl_parse("convert 5 MW to kW");
    assert(q != 0, "MW query parses");
    assert(streq(pq_s1(q), "MW") == 1, "from unit keeps case");
    assert(streq(pq_s2(q), "kW") == 1, "to unit keeps case");
    assert_eq(nl_convert(r, "convert 5 MW to kW"), f64_from(5000), "5 MW = 5000 kW (was 0.000005)");
    assert_eq(nl_convert(r, "5 mW to W"), f64_div(f64_from(5), f64_from(1000)), "5 mW = 0.005 W");
    assert_eq(nl_convert(r, "10 kN to N"), f64_from(10000), "10 kN = 10000 N (was incompatible)");
    assert_eq(nl_convert(r, "1 kn to km/h"), f64_div(f64_from(1852), f64_from(1000)), "1 kn = 1.852 km/h");
    assert_eq(nl_convert(r, "CONVERT 5 km TO mi"), UnitRegistry_convert(r, f64_from(5), "km", "mi"),
      "keywords match in any case");
    assert_eq(nl_convert(r, "100 c to f"), f64_from(212), "lowercase c / f still work");
    assert_eq(nl_convert(r, "1 mHz to Hz"), 0x7FF8000000000000, "mHz is unknown, not MHz");
    # Expressions keep their case too: evaluator names are case-sensitive.
    q = nl_parse("what is X + 1");
    assert(streq(pq_s1(q), "X + 1") == 1, "expression keeps case");
    return 0;
}

fn test_nl_forms() {
    var q = nl_parse("convert 100 usd to eur");
    assert(q != 0, "convert + currency parses");
    assert_eq(pq_kind(q), PQ_CURRENCY, "convert + currency is a currency query (was a unit query)");
    q = nl_parse("what is 5 km in mi");
    assert_eq(pq_kind(q), PQ_CONVERSION, "what is + units is a conversion (was an expression)");
    q = nl_parse("what is 2 + 3?");
    assert(streq(pq_s1(q), "2 + 3") == 1, "trailing ? dropped");
    q = nl_parse("convert 5 m to in.");
    assert(streq(pq_s2(q), "in") == 1, "trailing . dropped");
    q = nl_parse("15% of 200?");
    assert(streq(pq_s1(q), "200 * 15 / 100") == 1, "percent-of with trailing ?");
    q = nl_parse("3 \xE2\x88\x92 2");
    assert(streq(pq_s1(q), "3 - 2") == 1, "U+2212 minus becomes '-'");
    # Currency is exactly four words; extra words are not dropped silently.
    q = nl_parse("100 usd to eur and more");
    assert(q == 0 || pq_kind(q) != PQ_CURRENCY, "currency with trailing words is not a currency query");
    q = nl_parse("convert 2+3");
    assert(q == 0 || streq(pq_s1(q), "2+3") == 0, "convert is not a calculation verb");
    assert_eq(nl_parse(0), 0, "null input");
    assert_eq(nl_parse("?"), 0, "lone ?");
    return 0;
}

# _nl_parse_f64 must accept exactly one literal and give it the value the
# evaluator gives the same text (correctly rounded).
fn nl_f64_is(text, what) {
    var t, v = _nl_parse_f64(text);
    assert(is_ok(t) == 1, what);
    var e = Evaluator_new();
    var want = Evaluator_eval(e, text);
    assert_eq(v, want, what);
    return 0;
}

fn nl_f64_refused(text, what) {
    var t, v = _nl_parse_f64(text);
    assert(is_ok(t) == 0, what);
    return 0;
}

fn test_nl_parse_f64_strict() {
    nl_f64_is("0.3", "0.3 correctly rounded");
    nl_f64_is("9.95", "9.95 correctly rounded");
    nl_f64_is("0.0001e310", "0.0001e310 = 1e306, not Inf");
    nl_f64_is("123e-310", "123e-310 subnormal, not 0");
    nl_f64_is("1.7976931348623157e308", "DBL_MAX");
    nl_f64_is("5.", "trailing dot");
    nl_f64_is(".5", "leading dot");
    var t, v = _nl_parse_f64("-2.5");
    assert_eq(v, f64_neg(f64_div(f64_from(5), f64_from(2))), "sign applied");
    nl_f64_refused("1.5.3", "two dots");
    nl_f64_refused("1..2", "double dot");
    nl_f64_refused("1e", "bare exponent");
    nl_f64_refused("1e+", "signed bare exponent");
    nl_f64_refused(".", "dot alone");
    nl_f64_refused("-", "sign alone");
    nl_f64_refused("1e400", "overflow to Inf");
    nl_f64_refused("2+3", "expression");
    nl_f64_refused("1 ", "trailing blank");
    nl_f64_refused("", "empty");
    return 0;
}

# 2.4.9: at capacity every push copied the whole vec (O(max) time and leaked
# memory per push), and a history of capacity 0 still held one entry.
fn test_history_ring() {
    var h = CalcHistory_new(3);
    var i = 1;
    while (i <= 7) {
        var b = alloc(4);
        store8(b, 48 + i);
        store8(b + 1, 0);
        CalcHistory_push(h, b, b, "t");
        i = i + 1;
    }
    assert_eq(CalcHistory_len(h), 3, "ring holds 3");
    assert(streq(he_input(CalcHistory_get(h, 0)), "5") == 1, "oldest is 5");
    assert(streq(he_input(CalcHistory_get(h, 1)), "6") == 1, "then 6");
    assert(streq(he_input(CalcHistory_get(h, 2)), "7") == 1, "newest is 7");
    assert_eq(CalcHistory_get(h, 3), 0, "past the end is 0");
    assert_eq(CalcHistory_get(h, 0 - 1), 0, "negative index is 0");
    var js = CalcHistory_to_json(h);
    var w5 = "[{\"input\":\"5\",\"result\":\"5\",\"timestamp\":\"t\"},";
    var w6 = "{\"input\":\"6\",\"result\":\"6\",\"timestamp\":\"t\"},";
    var want = cjoin(cjoin(w5, w6), "{\"input\":\"7\",\"result\":\"7\",\"timestamp\":\"t\"}]");
    assert(str_is(js, want) == 1, "to_json oldest first after wrap");
    var big = CalcHistory_new(100);
    i = 0;
    while (i < 100) { CalcHistory_push(big, "x", "1", "t"); i = i + 1; }
    var before = alloc_used();
    i = 0;
    while (i < 1000) { CalcHistory_push(big, "x", "1", "t"); i = i + 1; }
    assert(alloc_used() - before <= 1000 * 32, "push at capacity allocates only the entry (was ~1 KB each)");
    var z = CalcHistory_new(0);
    CalcHistory_push(z, "x", "1", "t");
    assert_eq(CalcHistory_len(z), 0, "capacity 0 stores nothing (held 1)");
    CalcHistory_clear(h);
    CalcHistory_push(h, "after", "1", "t");
    assert(streq(he_input(CalcHistory_get(h, 0)), "after") == 1, "clear resets the ring");
    return 0;
}

# A fresh C string holding a then b: long JSON fixtures are written in pieces
# to stay inside the 120-column lint limit.
fn cjoin(a, b) {
    var na = strlen(a);
    var nb = strlen(b);
    var r = alloc(na + nb + 1);
    memcpy(r, a, na);
    memcpy(r + na, b, nb);
    store8(r + na + nb, 0);
    return r;
}

# 1 when the Str s holds exactly the bytes of the C string want.
fn str_is(s, want) {
    var n = strlen(want);
    if (str_len(s) != n) { return 0; }
    return memeq(str_data(s), want, n);
}

fn json_rejected(json, what) {
    var h = CalcHistory_new(10);
    CalcHistory_push(h, "kept", "1", "t");
    assert_eq(CalcHistory_from_json(h, json), AI_ERR_PARSE, what);
    assert_eq(CalcHistory_len(h), 1, what);
    return 0;
}

# 2.4.9: from_json answered 0 for text with no array at all, for a missing
# ']' and for a trailing ',', and a bad later object left the earlier ones
# pushed while still returning AI_ERR_PARSE.
fn test_history_from_json_strict() {
    var ok = "{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"}";
    json_rejected("hello world", "no array");
    json_rejected("", "empty text");
    json_rejected(ok, "bare object");
    json_rejected("[", "unclosed array");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"}", "missing ]");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"},]", "trailing comma");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"}] x", "bytes after ]");
    var okb = "{\"input\":\"b\",\"result\":\"2\",\"timestamp\":\"t\"}";
    json_rejected(cjoin(cjoin("[", ok), cjoin(okb, "]")), "missing comma");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"},{\"input\":\"b\"}]",
      "bad second object leaves h unchanged");
    json_rejected("[{\"input\":\"a\\x\",\"result\":\"1\",\"timestamp\":\"t\"}]", "unknown escape");
    json_rejected("[{\"input\":\"\\ud83d\",\"result\":\"1\",\"timestamp\":\"t\"}]", "lone surrogate");
    json_rejected("[{\"input\":\"\\u0000\",\"result\":\"1\",\"timestamp\":\"t\"}]", "NUL escape");
    json_rejected("[{\"input\":\"\\u12\",\"result\":\"1\",\"timestamp\":\"t\"}]", "short \\u");
    # Object interiors are checked too (2.4.9 final review: these loaded).
    json_rejected("[{\"input\":\"a\" \"result\":\"1\" \"timestamp\":\"t\"}]", "members without commas");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\" garbage}]", "garbage in an object");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\",\"x\":}]", "a member with no value");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\",}]", "a trailing comma in an object");
    json_rejected("[{\"q\":\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"}]", "a value read as a key");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\",\"x\":\"\\q\"}]",
      "a bad escape in another member");
    json_rejected("[{\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\",\"n\":01}]", "a number with a leading zero");
    var h = CalcHistory_new(10);
    assert_eq(CalcHistory_from_json(h, " [ ] "), 0, "empty array with blanks");
    var spaced = cjoin("\n[ {\"input\":\"a\",\"result\":\"1\",\"timestamp\":\"t\"} ,\r\n ",
      "{\"input\":\"b\",\"result\":\"2\",\"timestamp\":\"t\"} ]\n");
    assert_eq(CalcHistory_from_json(h, spaced), 0, "whitespace between tokens");
    assert_eq(CalcHistory_len(h), 2, "two entries");
    return 0;
}

# 2.4.9: escapes beyond \" \\ \n \r \t were read as the bare letter
# ("\u00e9" became "u00e9"), and to_json wrote other control bytes raw.
fn test_history_json_unicode_and_controls() {
    var h = CalcHistory_new(10);
    var json = "[{\"input\":\"caf\\u00e9 \\ud83d\\ude00\",\"result\":\"\\b\\f\\/\",\"timestamp\":\"\\u00E9\"}]";
    assert_eq(CalcHistory_from_json(h, json), 0, "unicode escapes load");
    var e = CalcHistory_get(h, 0);
    assert(streq(he_input(e), "caf\xC3\xA9 \xF0\x9F\x98\x80") == 1, "\\u00e9 and a surrogate pair decode to UTF-8");
    assert(streq(he_result(e), "\x08\x0C/") == 1, "\\b \\f \\/ decode");
    assert(streq(he_timestamp(e), "\xC3\xA9") == 1, "uppercase hex");
    var c = CalcHistory_new(10);
    CalcHistory_push(c, "\x01\x1F\x08\x0C", "\x7F", "t");
    var s = CalcHistory_to_json(c);
    var want = "[{\"input\":\"\\u0001\\u001f\\b\\f\",\"result\":\"\x7F\",\"timestamp\":\"t\"}]";
    assert(str_is(s, want) == 1, "control bytes escaped per RFC 8259");
    var n = str_len(s);
    var cbuf = alloc(n + 1);
    memcpy(cbuf, str_data(s), n);
    store8(cbuf + n, 0);
    var back = CalcHistory_new(10);
    assert_eq(CalcHistory_from_json(back, cbuf), 0, "escaped controls load");
    assert(streq(he_input(CalcHistory_get(back, 0)), "\x01\x1F\x08\x0C") == 1, "control bytes round-trip");
    return 0;
}

# 2.4.9: load read at most 64 KiB while save wrote any size, so a history
# of a few hundred entries saved and then failed to load.
fn test_history_file_roundtrip() {
    var path = "/tmp/abaco-test-ai-history.json";
    var h = CalcHistory_new(5000);
    var i = 0;
    while (i < 2000) {
        CalcHistory_push(h, "sqrt(2) * 1234567.891011 + 0.000001", "1745920.453217", "2026-09-30T12:34:56.789+02:00");
        i = i + 1;
    }
    assert(str_len(CalcHistory_to_json(h)) > 65536, "history is over the old 64 KiB cap");
    assert_eq(CalcHistory_save_to_file(h, path), 0, "save");
    var h2 = CalcHistory_new(5000);
    assert_eq(CalcHistory_load_from_file(h2, path), 0, "load (was AI_ERR_PARSE)");
    assert_eq(CalcHistory_len(h2), 2000, "all 2000 entries back");
    # A NUL inside the file would hide what follows it from from_json.
    var nul = "[]\x00 [[[ not json";
    file_write_all(path, nul, 16);
    var hn = CalcHistory_new(10);
    assert_eq(CalcHistory_load_from_file(hn, path), AI_ERR_PARSE, "a file with a NUL in it is refused");
    file_write_all(path, "", 0);
    var h3 = CalcHistory_new(10);
    assert_eq(CalcHistory_load_from_file(h3, path), 0, "empty file is an empty history");
    assert_eq(CalcHistory_len(h3), 0, "nothing loaded");
    assert_eq(CalcHistory_load_from_file(h3, "/nonexistent-dir/abaco.json"), AI_ERR_HTTP, "missing file");
    return 0;
}

# 2.4.9: convert divided by whatever rate was cached, so a 0 rate from
# set_rates, or a tiny one as the source, came back as Inf with AI_OK.
fn test_currency_bad_rates() {
    var c = CurrencyCache_new("http://localhost:8088");
    var rates = map_new();
    map_set(rates, "ZER", f64_from(0));
    map_set(rates, "TNY", 0x0010000000000000);              # 2^-1022
    map_set(rates, "NAN", 0x7FF8000000000000);
    map_set(rates, "BIG", f64_from(1000000));
    map_set(rates, "EUR", f64_div(f64_from(92), f64_from(100)));
    CurrencyCache_set_rates(c, "USD", rates);
    assert_eq(CurrencyCache_convert(c, f64_from(1), "ZER", "EUR"), 0, "0 source rate refused");
    assert_eq(ai_last_err(), AI_ERR_CURRENCY, "as AI_ERR_CURRENCY");
    assert_eq(CurrencyCache_convert(c, f64_from(1), "USD", "ZER"), 0, "0 target rate refused");
    assert_eq(CurrencyCache_convert(c, f64_from(1), "TNY", "BIG"), 0, "Inf cross-rate refused");
    assert_eq(CurrencyCache_convert(c, f64_from(1000), "TNY", "EUR"), 0, "Inf result refused");
    assert_eq(CurrencyCache_convert(c, f64_from(1), "USD", "NAN"), 0, "NaN rate refused");
    assert_eq(CurrencyCache_convert(c, 0x7FF0000000000000, "USD", "EUR"), 0, "Inf amount refused");
    assert(CurrencyCache_convert(c, f64_from(1), "USD", "EUR") != 0, "good pair still converts");
    # The plausibility cap is <= 10^6, decided independently of the code.
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":999999999,\"GBP\":1000000}}";
    var c2 = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(c2, body, strlen(body)), 0, "body loads");
    assert_eq(CurrencyCache_convert(c2, f64_from(1), "USD", "EUR"), 0, "999999999 dropped");
    assert(CurrencyCache_convert(c2, f64_from(1), "USD", "GBP") != 0, "exactly 10^6 kept");
    # The base URL is copied.
    var ub = alloc(32);
    memcpy(ub, "http://localhost:1", 19);
    var c3 = CurrencyCache_new(ub);
    store8(ub + 7, 88);
    assert(streq(ccy_base_url(c3), "http://localhost:1") == 1, "base_url copied at construction");
    return 0;
}

# 2.4.9: a CRLF body lost its last rate ("0.79\r" failed to parse), a nested
# value dropped every pair after it, and a "base" inside "rates" won over
# the top-level one.
fn test_ccy_body_shapes() {
    var c = CurrencyCache_new("http://localhost:8088");
    var crlf = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\r\n\"GBP\":0.79\r\n}}";
    assert_eq(_ccy_load_body(c, crlf, strlen(crlf)), 0, "CRLF body loads");
    assert(CurrencyCache_convert(c, f64_from(100), "USD", "GBP") != 0, "last rate before CRLF kept");
    var tab = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92\t,\"GBP\":0.79}}";
    var ct = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(ct, tab, strlen(tab)), 0, "TAB body loads");
    assert(CurrencyCache_convert(ct, f64_from(100), "USD", "EUR") != 0, "rate before TAB kept");
    var nested = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\"X\":{\"a\":1},\"GBP\":0.79}}";
    var cn = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(cn, nested, strlen(nested)), AI_ERR_CURRENCY, "nested rates value refused");
    # A missing ':' made bayan_json_parse take the NEXT pair's value (2.4.9
    # final review: GBP loaded as 149.5).
    var nocolon = "{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\"GBP\" 0.79,\"JPY\":149.5}}";
    var cc = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(cc, nocolon, strlen(nocolon)), AI_ERR_CURRENCY, "a pair without ':' refuses the body");
    var nokey = "{\"base\":\"USD\",\"rates\":{\"EUR\",\"GBP\":0.79}}";
    assert_eq(_ccy_load_body(cc, nokey, strlen(nokey)), AI_ERR_CURRENCY, "a key without a value refuses the body");
    var pretty = "{\n  \"base\": \"USD\",\n  \"rates\": {\n    \"EUR\": 0.92,\n    \"GBP\": 0.79\n  }\n}\n";
    var cp = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(cp, pretty, strlen(pretty)), 0, "a pretty-printed body loads");
    assert(CurrencyCache_convert(cp, f64_from(100), "USD", "GBP") != 0, "and converts");
    var arr = "{\"base\":\"USD\",\"rates\":{\"EUR\":[0.92]}}";
    assert_eq(_ccy_load_body(cn, arr, strlen(arr)), AI_ERR_CURRENCY, "array rates value refused");
    var inner = "{\"rates\":{\"base\":\"EUR\",\"GBP\":0.79},\"base\":\"USD\"}";
    var cb = CurrencyCache_new("http://localhost:8088");
    assert_eq(_ccy_load_body(cb, inner, strlen(inner)), 0, "body with inner base loads");
    assert(streq(ccy_base(cb), "USD") == 1, "top-level base wins (was EUR)");
    return 0;
}

# 2.4.9: the CRLF fetch test used an https:// URL, which http_get cannot
# reach anyway, so it passed with the control-byte check removed.
fn test_security_url_control_bytes() {
    assert_eq(_ccy_validate_url("https://api.example.com/x\r\nX-Injected: 1"), AI_ERR_HTTP, "CRLF in https URL");
    assert_eq(_ccy_validate_url("http://localhost:8088/\r\nX: 1"), AI_ERR_HTTP, "CRLF in localhost URL");
    assert_eq(_ccy_validate_url("http://localhost:8088/\tx"), AI_ERR_HTTP, "TAB");
    assert_eq(_ccy_validate_url("http://localhost:8088/\x01"), AI_ERR_HTTP, "0x01");
    assert_eq(_ccy_validate_url("http://localhost:8088/\x7F"), AI_ERR_HTTP, "DEL");
    assert_eq(_ccy_validate_url("https://api.example.com/x"), 0, "clean https URL");
    assert_eq(_ccy_validate_url("http://localhost:8088/x"), 0, "clean localhost URL");
    return 0;
}

fn test_security_fetch_rejects_plaintext() {
    # HTTP fetch must refuse non-https URLs (except localhost).
    var c = CurrencyCache_new("http://evil.example.com");
    assert_eq(CurrencyCache_fetch(c), AI_ERR_HTTP, "plaintext non-local rejected");
    assert_eq(ai_last_err(), AI_ERR_HTTP, "last_err = HTTP");
    return 0;
}

fn test_security_fetch_rejects_crlf() {
    # CRLF in URL must be rejected before any wire-format construction.
    var c = CurrencyCache_new("https://evil\r\nX-Injected: 1.com");
    assert_eq(CurrencyCache_fetch(c), AI_ERR_HTTP, "CRLF rejected");
    return 0;
}

fn test_security_rate_sanity_rejects_nan() {
    var c = CurrencyCache_new("http://localhost:8088");
    # Fabricate a body where one rate is the NaN bit pattern literal.
    # Current parser doesn't read "NaN" tokens; simulate via too-huge number.
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":1e400,\"GBP\":0.79}}";
    var err = _ccy_load_body(c, body, strlen(body));
    # GBP is plausible, EUR is +inf — EUR gets dropped, GBP survives.
    assert_eq(err, 0, "body accepted with at least one valid rate");
    assert(streq(ccy_base(c), "USD") == 1, "base = USD");
    var r = CurrencyCache_convert(c, f64_from(100), "USD", "EUR");
    # EUR should have been dropped → convert fails.
    assert_eq(r, 0, "EUR dropped by sanity check");
    assert_eq(ai_last_err(), AI_ERR_CURRENCY, "err = currency");
    return 0;
}

fn test_security_rate_sanity_rejects_negative() {
    var c = CurrencyCache_new("http://localhost:8088");
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":-0.5,\"GBP\":0.79}}";
    var err = _ccy_load_body(c, body, strlen(body));
    assert_eq(err, 0, "body accepted");
    var r = CurrencyCache_convert(c, f64_from(100), "USD", "EUR");
    assert_eq(r, 0, "negative rate dropped");
    return 0;
}

fn test_security_rate_sanity_all_bad() {
    var c = CurrencyCache_new("http://localhost:8088");
    # Every rate is implausible → the response is rejected entirely.
    var body = "{\"base\":\"USD\",\"rates\":{\"EUR\":-1,\"GBP\":0}}";
    var err = _ccy_load_body(c, body, strlen(body));
    assert_eq(err, AI_ERR_CURRENCY, "all-bad response rejected");
    return 0;
}

fn test_security_fetch_accepts_localhost() {
    # Plaintext to localhost is allowed for local hoosh testing.
    # We don't actually connect — just verify validation passes.
    # Since there's no server, fetch will fail at the HTTP layer, not
    # validation. We only assert validation didn't short-circuit.
    var c1 = CurrencyCache_new("http://localhost:8088");
    var c2 = CurrencyCache_new("http://127.0.0.1:8088");
    # _ccy_validate_url is the gate; call it directly for a clean test.
    assert_eq(_ccy_validate_url("http://localhost:8088"), 0, "localhost ok");
    assert_eq(_ccy_validate_url("http://127.0.0.1:8088"), 0, "127.0.0.1 ok");
    assert_eq(_ccy_validate_url("https://api.example.com"), 0, "https ok");
    return 0;
}

# 2.4.7: the loopback exception was a bare prefix test, so a remote name that
# only STARTS with a loopback one passed as local. Inert while lib/http.cyr
# could reach no host; Cyrius 6.6.9's http_get resolves names and connects, so
# http://localhost.<domain> became a plaintext fetch from a remote server.
# Every "was accepted" row below is refused now.
fn test_security_loopback_must_be_whole_host() {
    assert_eq(_ccy_validate_url("http://localhost.example.net"), AI_ERR_HTTP,
      "localhost.<domain> rejected (was accepted)");
    assert_eq(_ccy_validate_url("http://localhost.example.net/rates"), AI_ERR_HTTP,
      "localhost.<domain>/path rejected (was accepted)");
    assert_eq(_ccy_validate_url("http://127.0.0.1.example.net"), AI_ERR_HTTP,
      "127.0.0.1.<domain> rejected (was accepted)");
    assert_eq(_ccy_validate_url("http://localhostile.example"), AI_ERR_HTTP,
      "localhost<more> rejected (was accepted)");
    assert_eq(_ccy_validate_url("http://127.0.0.10"), AI_ERR_HTTP,
      "127.0.0.1<digit> rejected (was accepted)");
    assert_eq(_ccy_validate_url("http://localhost@example.net"), AI_ERR_HTTP,
      "localhost@<host> rejected (was accepted)");
    # Loopback as the whole host still passes, with or without port and path.
    assert_eq(_ccy_validate_url("http://localhost"), 0, "bare localhost ok");
    assert_eq(_ccy_validate_url("http://localhost/"), 0, "localhost/ ok");
    assert_eq(_ccy_validate_url("http://localhost:8088/rates"), 0, "localhost:port/path ok");
    assert_eq(_ccy_validate_url("http://127.0.0.1"), 0, "bare 127.0.0.1 ok");
    assert_eq(_ccy_validate_url("http://127.0.0.1/rates"), 0, "127.0.0.1/path ok");
    return 0;
}

# 2.3.4: braces inside a field are legal JSON and need no escaping, so
# `to_json` emits them verbatim — but `from_json` used to find object
# boundaries by counting raw braces, ignoring string context. One '{' or '}'
# in any field shifted the boundary and made the whole remaining array
# unparseable: a two-entry history round-tripped to ZERO entries, silently,
# which meant save_to_file/load_from_file lost the entire history. Found by
# `fuzz/fuzz_ai.fcyr` on its first run.
fn test_history_json_braces() {
    var h = CalcHistory_new(10);
    CalcHistory_push(h, "a}b", "1", "t1");
    CalcHistory_push(h, "a{b", "2", "t2");
    CalcHistory_push(h, "{\"nested\":\"looking\"}", "3", "t3");
    CalcHistory_push(h, "plain", "4", "t4");
    var s = CalcHistory_to_json(h);
    var h2 = CalcHistory_new(10);
    var n = str_len(s);
    var cbuf = alloc(n + 1);
    memcpy(cbuf, str_data(s), n);
    store8(cbuf + n, 0);
    var err = CalcHistory_from_json(h2, cbuf);
    assert_eq(err, 0, "brace roundtrip ok");
    assert_eq(CalcHistory_len(h2), 4, "all 4 entries recovered (was 0)");
    assert(streq(he_input(CalcHistory_get(h2, 0)), "a}b") == 1, "close brace preserved");
    assert(streq(he_input(CalcHistory_get(h2, 1)), "a{b") == 1, "open brace preserved");
    assert(streq(he_input(CalcHistory_get(h2, 2)), "{\"nested\":\"looking\"}") == 1,
      "brace-and-quote payload preserved");
    assert(streq(he_input(CalcHistory_get(h2, 3)), "plain") == 1, "trailing entry intact");
    # A ']' inside a field must not end the array early either.
    h = CalcHistory_new(10);
    CalcHistory_push(h, "x]y", "1", "t1");
    CalcHistory_push(h, "after", "2", "t2");
    s = CalcHistory_to_json(h);
    h2 = CalcHistory_new(10);
    n = str_len(s);
    cbuf = alloc(n + 1);
    memcpy(cbuf, str_data(s), n);
    store8(cbuf + n, 0);
    CalcHistory_from_json(h2, cbuf);
    assert_eq(CalcHistory_len(h2), 2, "']' in a field does not end the array");
    return 0;
}

# 2.3.4: `_jf_find_value` matched a key name anywhere in the slice, including
# inside a value.
#
# 2.3.5 fix-audit: the original payload here ESCAPED the lookalike, so the
# pre-2.3.4 matcher never matched it either and the test passed identically
# before and after the fix. The discriminating payload is an UNESCAPED value
# that is exactly a key name: the old matcher matched the value "input", then
# scanned forward to the next ':' — the timestamp's — and returned HIJACK.
fn test_history_json_key_confusion() {
    # Discriminating case: "result" holds the bare text `input`, and the
    # genuine "input" key appears AFTER it.
    var h = CalcHistory_new(10);
    var json = "[{\"result\":\"input\",\"timestamp\":\"HIJACK\",\"input\":\"REAL\"}]";
    CalcHistory_from_json(h, json);
    assert_eq(CalcHistory_len(h), 1, "entry parsed");
    var e = CalcHistory_get(h, 0);
    assert(streq(he_input(e), "REAL") == 1, "genuine key beats a bare lookalike value");
    assert(streq(he_timestamp(e), "HIJACK") == 1, "timestamp still reads its own value");

    # Escaped lookalike: benign under both old and new matchers, kept as a
    # second case so the escape path stays covered.
    h = CalcHistory_new(10);
    json = "[{\"result\":\"\\\"input\\\":\\\"HIJACK\\\"\",\"input\":\"REAL\",\"timestamp\":\"t\"}]";
    CalcHistory_from_json(h, json);
    assert_eq(CalcHistory_len(h), 1, "escaped-lookalike entry parsed");
    assert(streq(he_input(CalcHistory_get(h, 0)), "REAL") == 1, "escaped lookalike ignored");

    # Since 2.4.9 the matcher is depth-aware: a key inside a nested object
    # never wins. This payload is still refused, but because "result" is an
    # object rather than a string — so it cannot show depth-awareness.
    h = CalcHistory_new(10);
    json = "[{\"result\":{\"input\":\"HIJACK\"},\"input\":\"REAL\",\"timestamp\":\"t\"}]";
    var err = CalcHistory_from_json(h, json);
    assert_eq(err, AI_ERR_PARSE, "a non-string result is refused");
    assert_eq(CalcHistory_len(h), 0, "no entry from the nested payload");
    # This one does: the nested "input" comes first and must lose.
    h = CalcHistory_new(10);
    json = "[{\"x\":{\"input\":\"HIJACK\"},\"input\":\"REAL\",\"result\":\"r\",\"timestamp\":\"t\"}]";
    assert_eq(CalcHistory_from_json(h, json), 0, "an extra nested member is fine");
    assert(streq(he_input(CalcHistory_get(h, 0)), "REAL") == 1, "the top-level input wins over a nested one");
    return 0;
}

# 2.3.5 fix-audit: _jf_get_object still counted raw braces after the 2.3.4 H-4
# fix rewrote the other scans, so a '}' inside a rates KEY truncated the object.
# _ccy_load_body's only completeness check is `kept == 0`, so a truncated object
# that still yielded one valid pair was reported as SUCCESS with a silently
# incomplete rate table — in the module's only network-facing parser.
fn test_ccy_brace_in_key() {
    var c = CurrencyCache_new("http://localhost:8088");
    # A key containing '}' must not end the rates object early: EUR and GBP
    # both follow it and must survive.
    var body = "{\"base\":\"USD\",\"rates\":{\"A}B\":1.0,\"EUR\":0.92,\"GBP\":0.79}}";
    var err = _ccy_load_body(c, body, strlen(body));
    assert_eq(err, 0, "brace-in-key body loads");
    var r = CurrencyCache_convert(c, f64_from(100), "USD", "EUR");
    assert(r != 0, "EUR survived a '}' in an earlier key");
    assert_eq(f64_to(cr_to_value(r)), 92, "100 USD = 92 EUR");
    r = CurrencyCache_convert(c, f64_from(100), "USD", "GBP");
    assert(r != 0, "GBP survived too");
    assert_eq(f64_to(cr_to_value(r)), 79, "100 USD = 79 GBP");
    return 0;
}

# 2.3.5 fix-audit: _ccy_json_depth_ok counted braces/brackets with no floor, so
# unbalanced CLOSERS drove the counter negative and masked genuine nesting from
# `maxd`. N ']' bytes bought N free levels — a FALSE ACCEPT, the one direction a
# DoS guard must never fail in, and the opposite of the "only ever rejects more
# aggressively" property the function's own comment claimed.
fn test_ccy_depth_guard_clamp() {
    # Shallow object accepted.
    var shallow = str_new("{\"EUR\":0.92}", 12);
    assert_eq(_ccy_json_depth_ok(shallow), 1, "flat rates object accepted");

    # Build a genuinely over-deep object: 12 levels > CCY_MAX_JSON_DEPTH (8).
    var depth = 12;
    var buf = alloc(depth * 8 + 32);
    var pos = 0;
    var i = 0;
    while (i < depth) { memcpy(buf + pos, "{\"a\":", 5); pos = pos + 5; i = i + 1; }
    memcpy(buf + pos, "1.0", 3); pos = pos + 3;
    i = 0;
    while (i < depth) { store8(buf + pos, 125); pos = pos + 1; i = i + 1; }
    assert_eq(_ccy_json_depth_ok(str_new(buf, pos)), 0, "12-level object rejected");

    # Same object prefixed with unbalanced ']' padding — must STILL be rejected.
    var pad = 20;
    var padded = alloc(pos + pad + 2);
    i = 0;
    while (i < pad) { store8(padded + i, 93); i = i + 1; }   # ']'
    memcpy(padded + pad, buf, pos);
    assert_eq(_ccy_json_depth_ok(str_new(padded, pad + pos)), 0,
      "']' padding does not buy free depth (false-accept guard)");
    return 0;
}

fn test_history_empty_json() {
    var h = CalcHistory_new(10);
    var s = CalcHistory_to_json(h);
    var cstr_len = str_len(s);
    var cbuf = alloc(cstr_len + 1);
    memcpy(cbuf, str_data(s), cstr_len);
    store8(cbuf + cstr_len, 0);
    var h2 = CalcHistory_new(10);
    var err = CalcHistory_from_json(h2, cbuf);
    assert_eq(err, 0, "empty json ok");
    assert_eq(CalcHistory_is_empty(h2), 1, "empty after load");
    return 0;
}

# ================================================================
# 2.4.12 HTTPS parsers — always compiled, so these run without -D ABACO_TLS.
# The transport itself is tests/test_ccy_tls.tcyr.
# ================================================================

# _ccy_https_split(url) == 0 with these parts.
fn _https_ok(url, host, port, path, name) {
    var parts[24];
    var r = _ccy_https_split(url, &parts);
    assert_eq(r, 0, name);
    if (r != 0) { return 0; }
    assert(streq(load64(&parts), host) == 1, name);
    assert_eq(load64(&parts + 8), port, name);
    assert(streq(load64(&parts + 16), path) == 1, name);
    return 0;
}

fn _https_bad(url, name) {
    var parts[24];
    assert_eq(_ccy_https_split(url, &parts), AI_ERR_HTTP, name);
    return 0;
}

fn test_https_split() {
    _https_ok("https://h", "h", 443, "/", "bare host");
    _https_ok("https://api.example.com:8443/v1/rates", "api.example.com", 8443, "/v1/rates", "host, port, path");
    _https_ok("https://127.0.0.1:1/x?y=1", "127.0.0.1", 1, "/x?y=1", "IPv4 literal, port 1, query");
    _https_ok("https://Example-1.COM:00443/", "Example-1.COM", 443, "/", "case kept, leading zeros");
    _https_ok("https://h:65535", "h", 65535, "/", "port 65535");
    _https_bad("http://h", "plaintext scheme");
    _https_bad("HTTPS://h", "scheme is case-sensitive here, as in _ccy_validate_url");
    _https_bad("https://", "empty host");
    _https_bad("https://:443/x", "empty host with port");
    _https_bad("https:///x", "empty host with path");
    _https_bad("https://user@h/x", "userinfo");
    _https_bad("https://h@evil.example/x", "userinfo before another host");
    _https_bad("https://h?x=1", "query straight after the host");
    _https_bad("https://h#frag", "fragment after the host");
    _https_bad("https://h/a#frag", "fragment in the path");
    _https_bad("https://h/a b", "space in the path");
    _https_bad("https://h/a\x7F", "DEL in the path");
    _https_bad("https://h/a\xC3\xA9", "non-ASCII in the path");
    _https_bad("https://h:0", "port 0");
    _https_bad("https://h:65536", "port 65536");
    _https_bad("https://h:", "empty port");
    _https_bad("https://h:123456", "six port digits");
    _https_bad("https://h:44x/", "junk after the port");
    _https_bad("https://[::1]/x", "IPv6 literal (IPv4-only resolver)");
    _https_bad("https://h_x.example/x", "underscore in the host");
    _https_bad("https://h\\x.example/x", "backslash in the host");
    _https_bad("https://h%2e.example/x", "percent in the host");
    var long = alloc(300);
    memcpy(long, "https://", 8);
    memset(long + 8, 97, 254);
    store8(long + 262, 0);
    _https_bad(long, "254-byte host");
    store8(long + 261, 0);
    var parts[24];
    assert_eq(_ccy_https_split(long, &parts), 0, "253-byte host");
    assert_eq(strlen(load64(&parts)), 253, "and it is copied whole");
    assert_eq(_ccy_https_split(0, &parts), AI_ERR_HTTP, "null URL");
    # The host is a copy: the URL buffer can change afterwards.
    var u = alloc(32);
    memcpy(u, "https://abc/x", 14);
    _ccy_https_split(u, &parts);
    store8(u + 8, 120);
    assert(streq(load64(&parts), "abc") == 1, "host copied");
    return 0;
}

fn test_https_request() {
    var r = _ccy_https_request("h.example", 443, "/rates");
    assert(streq(r, "GET /rates HTTP/1.0\r\nHost: h.example\r\nConnection: close\r\n\r\n") == 1,
      "request on 443: no port in Host");
    var r2 = _ccy_https_request("127.0.0.1", 8443, "/v1/rates?x=1");
    assert(streq(r2, "GET /v1/rates?x=1 HTTP/1.0\r\nHost: 127.0.0.1:8443\r\nConnection: close\r\n\r\n") == 1,
      "request on 8443: Host carries the port");
    var r3 = _ccy_https_request("h", 1, "/");
    assert(streq(r3, "GET / HTTP/1.0\r\nHost: h:1\r\nConnection: close\r\n\r\n") == 1, "port 1");
    # 2048 bytes with the NUL is the most a request may take.
    var fixed = 4 + 17 + 1 + 23 + 1;
    var path = alloc(2100);
    store8(path, 47);
    memset(path + 1, 97, 2047 - fixed);
    store8(path + 2048 - fixed, 0);
    var at = _ccy_https_request("h", 443, path);
    assert(at != 0, "a request of exactly 2048 bytes is built");
    assert_eq(strlen(at) + 1, 2048, "and is 2048 bytes with its NUL");
    store8(path + 2048 - fixed, 97);
    store8(path + 2049 - fixed, 0);
    assert_eq(_ccy_https_request("h", 443, path), 0, "one byte more is refused");
    return 0;
}

# _ccy_http_split on a cstr response.
fn _split(resp, out) { return _ccy_http_split(resp, strlen(resp), out); }

fn test_http_split() {
    var out[24];
    var ok = "HTTP/1.0 200 OK\r\nContent-Length: 46\r\n\r\n{\"base\":\"USD\",\"rates\":{\"EUR\":0.92,\"GBP\":0.79}}";
    assert_eq(_split(ok, &out), 0, "a framed 200");
    assert_eq(load64(&out), 200, "status 200");
    assert_eq(load64(&out + 16), 46, "body length 46");
    assert_eq(load64(&out + 8), ok + strlen(ok) - 46, "body pointer at the head's end");
    assert_eq(_split("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n", &out), 0, "a framed 404 splits");
    assert_eq(load64(&out), 404, "status 404");
    assert_eq(_split("HTTP/1.1 200\r\nContent-Length: 2\r\n\r\n{}", &out), 0, "a status line without a reason");
    assert_eq(_split("HTTP/1.1 200 OK\r\ncontent-LENGTH:2\r\n\r\n{}", &out), 0, "field names any case, no OWS");
    assert_eq(_split("HTTP/1.1 200 OK\r\nContent-Length: \t2 \t\r\n\r\n{}", &out), 0, "OWS around the value");
    assert_eq(_split("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Length: 2\r\n\r\n{}", &out), 0,
      "two equal Content-Lengths");
    assert_eq(_split("HTTP/1.1 200 OK\r\nContent-Length: 0002\r\n\r\n{}", &out), 0, "leading zeros");
    assert_eq(_split("HTTP/1.0 200 OK\r\nX-A: b\r\nContent-Length: 2\r\nX-C: \xC3\xA9\r\n\r\n{}", &out), 0,
      "other fields, obs-text in a value");
    # Refused framing.
    assert_eq(_split("HTTP/1.0 200 OK\r\n\r\n{}", &out), AI_ERR_HTTP, "no Content-Length");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 3\r\n\r\n{}", &out), AI_ERR_HTTP, "body shorter");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 1\r\n\r\n{}", &out), AI_ERR_HTTP, "body longer");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 2\r\nContent-Length: 3\r\n\r\n{}", &out), AI_ERR_HTTP,
      "two differing Content-Lengths");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 3\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP,
      "two differing Content-Lengths, the right one last");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 2, 2\r\n\r\n{}", &out), AI_ERR_HTTP, "a list value");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: +2\r\n\r\n{}", &out), AI_ERR_HTTP, "a signed value");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length:\r\n\r\n{}", &out), AI_ERR_HTTP, "an empty value");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 65537\r\n\r\n{}", &out), AI_ERR_HTTP, "past 64 KB");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 99999999999999999999999\r\n\r\n{}", &out), AI_ERR_HTTP,
      "a value that would overflow");
    assert_eq(_split("HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 2\r\n\r\n{}", &out),
      AI_ERR_HTTP, "Transfer-Encoding");
    assert_eq(_split("HTTP/1.0 200 OK\r\nX: a\r\n Content-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "obs-fold");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length : 2\r\n\r\n{}", &out), AI_ERR_HTTP,
      "whitespace before the colon");
    assert_eq(_split("HTTP/1.0 200 OK\r\nNoColon\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP,
      "a field line without ':'");
    assert_eq(_split("HTTP/1.0 200 OK\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "a bare LF");
    assert_eq(_split("HTTP/1.0 200 OK\rX: 1\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "a bare CR");
    assert_eq(_split("HTTP/1.0 200 OK\r\nX: \x01\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP,
      "a control byte in the head");
    assert_eq(_split("HTTP/1.0 200 OK\r\nContent-Length: 2\r\n", &out), AI_ERR_HTTP, "head not finished");
    # Refused status lines.
    assert_eq(_split("HTTP/2 200 OK\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "HTTP/2");
    assert_eq(_split("HTTP/1.0 099 X\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "status under 100");
    assert_eq(_split("HTTP/1.0 2000 X\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "four-digit status");
    assert_eq(_split("HTTP/1.0 2x0 X\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "non-digit status");
    assert_eq(_split("ICY 200 OK\r\nContent-Length: 2\r\n\r\n{}", &out), AI_ERR_HTTP, "not HTTP");
    assert_eq(_ccy_http_split(ok, 0, &out), AI_ERR_HTTP, "zero length");
    assert_eq(_ccy_http_split(0, 10, &out), AI_ERR_HTTP, "null buffer");
    # The incremental head parse the read loop uses: 0 = keep reading.
    var h[24];
    assert_eq(_ccy_http_head(ok, 20, &h), 0, "head incomplete: keep reading");
    assert_eq(_ccy_http_head(ok, 41, &h), strlen(ok), "head complete: the whole message length");
    assert_eq(load64(&h + 8), 39, "body offset");
    assert_eq(_ccy_http_head("HTTP/1.0 200 OK\r\n\r\n", 19, &h), 0 - 1, "complete head without a length: refused");
    return 0;
}

# Without -D ABACO_TLS (this suite) an https:// URL is refused as AI_ERR_TLS
# once it parses — not AI_ERR_HTTP, which it was through 2.4.11.
fn test_https_without_tls() {
    var c = CurrencyCache_new("https://localhost:1");
    assert_eq(CurrencyCache_fetch(c), AI_ERR_TLS, "https:// without -D ABACO_TLS: AI_ERR_TLS");
    assert_eq(ai_last_err(), AI_ERR_TLS, "last_err = TLS");
    assert_eq(abaco_tls_init(), AI_ERR_TLS, "abaco_tls_init: no TLS in this build");
    var cb = CurrencyCache_new("https://user@localhost:1");
    assert_eq(CurrencyCache_fetch(cb), AI_ERR_HTTP, "a malformed https URL is still AI_ERR_HTTP");
    assert_eq(AI_ERR_HTTP, 4, "AiError values before AI_ERR_TLS unchanged");
    assert_eq(AI_ERR_TLS, 5, "AI_ERR_TLS appended");
    # The CA path is copied, like the base URL; 0 restores the system store.
    var p = alloc(32);
    memcpy(p, "/tmp/ca.crt", 12);
    CurrencyCache_set_ca_file(c, p);
    store8(p + 5, 88);
    assert(streq(ccy_ca_file(c), "/tmp/ca.crt") == 1, "CA path copied");
    assert_eq(ccy_ca_file(CurrencyCache_new("https://h")), 0, "a new cache trusts the system store");
    CurrencyCache_set_ca_file(c, 0);
    assert_eq(ccy_ca_file(c), 0, "path 0 restores the system store");
    return 0;
}

# ================================================================
# 2.4.12 review: the IP-literal SAN check and the CA bundle count — pure, so
# they run here; the fetches that use them are tests/test_ccy_tls.tcyr.
# ================================================================

# Hex digits (no separators) into out; returns the byte count.
fn _unhex(hex, out) {
    var n = 0;
    var i = 0;
    while (load8(hex + i) != 0) {
        var v = 0;
        var k = 0;
        while (k < 2) {
            var c = load8(hex + i + k);
            if (c >= 97) { c = c - 87; }
            elif (c >= 65) { c = c - 55; }
            else { c = c - 48; }
            v = v * 16 + c;
            k = k + 1;
        }
        store8(out + n, v);
        n = n + 1;
        i = i + 2;
    }
    return n;
}

# _ccy_cert_ip_san against 127.0.0.1 on the DER spelled by hex `a` then `b`
# (two parts so a long one fits on a line).
fn _ipsan_hex(a, b) {
    var d = alloc(256);
    var n = _unhex(a, d);
    n = n + _unhex(b, d + n);
    var ip[8];
    store64(&ip, 0x0100007F);
    return _ccy_cert_ip_san(d, n, &ip);
}

# _ccy_cert_ip_san on a fixture certificate against a.b.c.d.
fn _ipsan_file(path, a, b, c, d) {
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4096);
    if (n <= 0) { return 0 - 1; }
    var ip[8];
    store64(&ip, a + b * 256 + c * 65536 + d * 16777216);
    return _ccy_cert_ip_san(buf, n, &ip);
}

fn test_der_tlv() {
    var b = alloc(300);
    var t[16];
    _unhex("0403616263", b);
    assert_eq(_ccy_der_tlv(b, 5, 0, &t), 4, "short form: tag");
    assert_eq(load64(&t), 2, "short form: content offset");
    assert_eq(load64(&t + 8), 3, "short form: length");
    assert_eq(_ccy_der_tlv(b, 4, 0, &t), 0 - 1, "content past end refused");
    assert_eq(_ccy_der_tlv(b, 1, 0, &t), 0 - 1, "no length byte");
    assert_eq(_ccy_der_tlv(b, 5, 5, &t), 0 - 1, "at end");
    _unhex("308103616263", b);
    assert_eq(_ccy_der_tlv(b, 6, 0, &t), 48, "0x81 long form");
    assert_eq(load64(&t), 3, "0x81: content after 3 header bytes");
    _unhex("30820003616263", b);
    assert_eq(_ccy_der_tlv(b, 7, 0, &t), 48, "0x82 long form, not minimal: accepted");
    assert_eq(load64(&t + 8), 3, "0x82: length");
    _unhex("3083000003616263", b);
    assert_eq(_ccy_der_tlv(b, 8, 0, &t), 48, "0x83 long form");
    _unhex("308400000003616263", b);
    assert_eq(_ccy_der_tlv(b, 9, 0, &t), 0 - 1, "0x84 refused");
    _unhex("3080616263", b);
    assert_eq(_ccy_der_tlv(b, 5, 0, &t), 0 - 1, "indefinite length refused");
    _unhex("1F0100", b);
    assert_eq(_ccy_der_tlv(b, 3, 0, &t), 0 - 1, "high tag number refused");
    _unhex("3082FFFF00", b);
    assert_eq(_ccy_der_tlv(b, 5, 0, &t), 0 - 1, "declared length past end refused");
    return 0;
}

fn test_cert_ip_san() {
    # Built in DER by hand: Certificate > tbsCertificate > [3] > SEQUENCE OF
    # Extension > { 2.5.29.17, [critical,] OCTET STRING > GeneralNames }.
    assert_eq(_ipsan_hex("301A3018A316301430120603551D11", "0101FF0408300687047F000001"), 1,
      "critical SAN with the iPAddress");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D11", "0408300687047F000001"), 1, "SAN, not critical");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D11", "0408300687047F000002"), 0, "another address");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D12", "0408300687047F000001"), 0,
      "issuerAltName is not the subject's");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D11", "0408300682047F000001"), 0,
      "the same 4 bytes as a dNSName do not count");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D11", "04083006A7047F000001"), 0,
      "a constructed [7] is not an iPAddress");
    assert_eq(_ipsan_hex("30173015A2133011300F0603551D11", "0408300687047F000001"), 0,
      "extensions under [2], not [3]: none");
    assert_eq(_ipsan_hex("302D302BA329302730140603551D11040D300B8209612E6578616D706C65",
        "300F0603551D110408300687047F000001"), 0, "only the first SAN extension counts");
    assert_eq(_ipsan_hex("3081173015A3133011300F0603551D11", "0408300687047F000001"), 1, "long-form outer length");
    assert_eq(_ipsan_hex("302C302AA328302630240603551D11041D301B871000000000000000000000",
        "00000000000082017887047F000001"), 1, "an IPv6 entry, a DNS entry, then the IPv4 one");
    assert_eq(_ipsan_hex("302D302BA00302010202020102A320301E300B0603551D0F040403020780",
        "300F0603551D110408300687047F000001"), 1, "version, serial and a key-usage extension first");
    assert_eq(_ipsan_hex("30173015A3133011300F0603551D11", "0408300787047F000001"), 0,
      "GeneralNames longer than its OCTET STRING: refused");
    # The fixtures (scripts/gen-tls-fixtures.sh).
    assert_eq(_ipsan_file("tests/fixtures/tls/server-cert.der", 127, 0, 0, 1), 1,
      "server-cert: IP:127.0.0.1 listed");
    assert_eq(_ipsan_file("tests/fixtures/tls/p384-cert.der", 127, 0, 0, 1), 1, "p384-cert: IP:127.0.0.1 listed");
    assert_eq(_ipsan_file("tests/fixtures/tls/server-cert.der", 127, 0, 0, 2), 0, "server-cert: not 127.0.0.2");
    assert_eq(_ipsan_file("tests/fixtures/tls/dns-ip-cert.der", 127, 0, 0, 1), 0,
      "DNS:127.0.0.1 is not an iPAddress (RFC 9525 §6.3)");
    assert_eq(_ipsan_file("tests/fixtures/tls/wild-ip-cert.der", 127, 0, 0, 1), 0, "DNS:*.0.0.1 is not either");
    assert_eq(_ipsan_file("tests/fixtures/tls/wrong-name-cert.der", 127, 0, 0, 1), 0, "DNS:abaco.invalid: no");
    # Every truncation of a matching certificate is refused, and bytes past
    # its end never change the verdict.
    var buf = alloc(4200);
    var n = file_read_all("tests/fixtures/tls/server-cert.der", buf, 4096);
    assert(n > 100, "server-cert read");
    var ip[8];
    store64(&ip, 0x0100007F);
    var cut = 0;
    var bad = 0;
    while (cut < n) {
        if (_ccy_cert_ip_san(buf, cut, &ip) != 0) { bad = bad + 1; }
        cut = cut + 1;
    }
    assert_eq(bad, 0, "no truncation of server-cert matches");
    memset(buf + n, 135, 64);
    assert_eq(_ccy_cert_ip_san(buf, n, &ip), 1, "trailing bytes ignored");
    assert_eq(_ccy_cert_ip_san(0, n, &ip), 0, "null DER");
    return 0;
}

fn test_pem_cert_count() {
    var m = "-----BEGIN CERTIFICATE-----";
    assert_eq(_ccy_pem_cert_count(m, 27), 1, "one marker");
    assert_eq(_ccy_pem_cert_count(m, 26), 0, "a marker cut short is not counted");
    assert_eq(_ccy_pem_cert_count("", 0), 0, "empty");
    var two = "x\n-----BEGIN CERTIFICATE-----\nAA\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n";
    assert_eq(_ccy_pem_cert_count(two, strlen(two)), 2, "two blocks");
    assert_eq(_ccy_pem_cert_count("-----BEGIN PRIVATE KEY-----", 27), 0, "a key block is not a certificate");
    var buf = alloc(8192);
    var n = file_read_all("tests/fixtures/tls/rsa-ca.crt", buf, 8192);
    assert_eq(_ccy_pem_cert_count(buf, n), 1, "rsa-ca.crt: one certificate");
    return 0;
}

