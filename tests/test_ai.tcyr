    test_security_percent_of_paren_injection();
    test_security_fetch_rejects_plaintext();
    test_security_fetch_rejects_crlf();
    test_security_url_control_bytes();
    test_nl_case_preserved();
    test_nl_forms();
    test_nl_parse_f64_strict();
    test_history_ring();
    test_history_from_json_strict();
    test_history_json_unicode_and_controls();
    test_history_file_roundtrip();
    test_currency_bad_rates();
    test_ccy_body_shapes();
    test_security_fetch_accepts_localhost();
    test_security_loopback_must_be_whole_host();
    test_security_rate_sanity_rejects_nan();
    test_security_rate_sanity_rejects_negative();
    test_security_rate_sanity_all_bad();
    test_https_split();
    test_https_request();
    test_http_split();
    test_https_without_tls();
    test_der_tlv();
    test_cert_ip_san();
    test_pem_cert_count();
    # Propagate failure to the process exit code. assert_summary() RETURNS
    # _assert_fail; discarding it and returning 0 made a red suite exit 0, and
    # CI gates on the exit code — so failures shipped green (fixed 2.4.4).
    #
    # Collapsed to 1 rather than returned raw: a Linux exit code is 8 bits, so
    # returning the count directly would make EXACTLY 256 failures (or 512, ...)
    # exit 0 — the same silent-green bug in a narrower window. Verified: a
    # program returning 256 exits 0. The count itself stays visible on the
    # summary line, which CI also parses.
    if (assert_summary() != 0) { return 1; }
    return 0;
}

var rr = main();
syscall(SYS_EXIT, rr);
